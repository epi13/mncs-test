mncs 0.19;

// Native selection of Test inventory records from bounded substring filters.
// V2 scans each bounded search text as one MNCS value; the host supplies only
// UTF-8-safe segments needed to transport up to 8192 bytes.
module mncs.test.inventory_filter_v2;

use mncs.std.application.v1;

record SearchTextPartV2 {
    bytes: [byte; up_to 4096]
}

record SearchTextV2 {
    byte_count: u64,
    part_count: u64,
    parts: [SearchTextPartV2; up_to 3]
}

record SearchByteStateV2 {
    offset: u64,
    found: bool,
    value: byte
}

record SearchStartStateV2 {
    base_offset: u64,
    found: bool
}

record SearchCandidateV2 {
    test_index: u64,
    search_text: SearchTextV2
}

record InventoryFilterRequestV2 {
    schema_version: [byte; up_to 64],
    candidate_count: u64,
    candidates: [SearchCandidateV2; up_to 16],
    filter_count: u64,
    filters: [[byte; up_to 1024]; up_to 16]
}

record SelectedIndexBuilderV2 {
    values: [u64; 16],
    length: u64
}

record InventoryFilterResultV2 {
    schema_version: [byte; up_to 64],
    selected_count: u64,
    selected_indices: [u64; up_to 16]
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 105, 110, 118, 101, 110, 116, 111, 114, 121, 45, 102, 105, 108, 116, 101, 114, 45, 114, 101, 113, 117, 101, 115, 116, 47, 50];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 105, 110, 118, 101, 110, 116, 111, 114, 121, 45, 102, 105, 108, 116, 101, 114, 47, 50];
}

fn same_bytes(left: [byte; up_to 1024], right: [byte; up_to 1024]) -> (result: bool) {
    if left.len != right.len {
        return false;
    }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn valid_search_text(search_text: SearchTextV2) -> (result: bool) {
    iterate i over search_text.parts carrying total: u64 = 0 {
        next total = total +% search_text.parts[i].bytes.len;
    }
    return search_text.part_count == search_text.parts.len
        && search_text.byte_count <= 8192
        && search_text.byte_count == total
        && ((search_text.byte_count == 0 && search_text.part_count == 0)
            || search_text.part_count > 0);
}

fn local_start_count(part_length: u64, needle_length: u64) -> (result: u64) {
    if needle_length > part_length {
        return 0;
    }
    return part_length - needle_length +% 1;
}

fn search_byte_step(
    state: SearchByteStateV2,
    part: SearchTextPartV2,
    index: u64
) -> (result: SearchByteStateV2) {
    if !state.found && index >= state.offset && index < state.offset +% part.bytes.len {
        return SearchByteStateV2 {
            offset: state.offset +% part.bytes.len,
            found: true,
            value: part.bytes[index - state.offset]
        };
    }
    return SearchByteStateV2 {
        offset: state.offset +% part.bytes.len,
        found: state.found,
        value: state.value
    };
}

fn search_text_byte(search_text: SearchTextV2, index: u64) -> (result: byte) {
    let seed: SearchByteStateV2 = SearchByteStateV2 {
        offset: 0,
        found: false,
        value: 0
    };
    iterate i over search_text.parts carrying state: SearchByteStateV2 = seed {
        next state = search_byte_step(state, search_text.parts[i], index);
    }
    return state.value;
}

fn substring_at(
    haystack: SearchTextV2,
    needle: [byte; up_to 1024],
    start: u64
) -> (result: bool) {
    if start > haystack.byte_count {
        return false;
    }
    if needle.len > haystack.byte_count - start {
        return false;
    }
    if search_text_byte(haystack, start) != needle[0] {
        return false;
    }
    let last_index: u64 = needle.len - 1;
    if search_text_byte(haystack, start + last_index) != needle[last_index] {
        return false;
    }
    iterate i over needle carrying same: bool = true {
        next same = same && search_text_byte(haystack, start + i) == needle[i];
    }
    return same;
}

fn substring_at_part(
    haystack: [byte; up_to 4096],
    needle: [byte; up_to 1024],
    start: u64
) -> (result: bool) {
    if start > haystack.len {
        return false;
    }
    if needle.len > haystack.len - start {
        return false;
    }
    if haystack[start] != needle[0] {
        return false;
    }
    let last_index: u64 = needle.len - 1;
    if haystack[start + last_index] != needle[last_index] {
        return false;
    }
    iterate i over needle carrying same: bool = true {
        next same = same && haystack[start + i] == needle[i];
    }
    return same;
}

fn scan_start_matches(
    found: bool,
    haystack: SearchTextV2,
    part: SearchTextPartV2,
    needle: [byte; up_to 1024],
    local_starts: u64,
    total_starts: u64,
    base_offset: u64,
    part_index: u64
) -> (result: bool) {
    if found {
        return true;
    }
    let global_start: u64 = base_offset +% part_index;
    if global_start >= total_starts {
        return false;
    }
    if part_index < local_starts {
        return substring_at_part(part.bytes, needle, part_index);
    }
    return substring_at(haystack, needle, global_start);
}

fn scan_part_starts(
    state: SearchStartStateV2,
    haystack: SearchTextV2,
    part: SearchTextPartV2,
    needle: [byte; up_to 1024],
    total_starts: u64
) -> (result: SearchStartStateV2) {
    if state.found {
        return state;
    }
    let local_starts: u64 = local_start_count(part.bytes.len, needle.len);
    iterate i over part.bytes carrying found: bool = state.found {
        next found = scan_start_matches(
            found,
            haystack,
            part,
            needle,
            local_starts,
            total_starts,
            state.base_offset,
            i
        );
    }
    return SearchStartStateV2 {
        base_offset: state.base_offset +% part.bytes.len,
        found: found
    };
}

fn contains_substring(
    haystack: SearchTextV2,
    needle: [byte; up_to 1024]
) -> (result: bool) {
    if needle.len == 0 {
        return true;
    }
    if needle.len > haystack.byte_count {
        return false;
    }
    let total_starts: u64 = haystack.byte_count - needle.len +% 1;
    let seed: SearchStartStateV2 = SearchStartStateV2 { base_offset: 0, found: false };
    iterate i over haystack.parts carrying state: SearchStartStateV2 = seed {
        next state = scan_part_starts(
            state,
            haystack,
            haystack.parts[i],
            needle,
            total_starts
        );
    }
    return state.found;
}

fn candidate_matches(request: InventoryFilterRequestV2, candidate: SearchCandidateV2) -> (result: bool) {
    if request.filter_count == 0 {
        return true;
    }
    iterate i over request.filters carrying found: bool = false {
        next found = filter_matches_step(request, candidate, i, found);
    }
    return found;
}

fn filter_matches_step(
    request: InventoryFilterRequestV2,
    candidate: SearchCandidateV2,
    filter_index: u64,
    found: bool
) -> (result: bool) {
    if found {
        return true;
    }
    if filter_index >= request.filter_count {
        return false;
    }
    return contains_substring(candidate.search_text, request.filters[filter_index]);
}

fn empty_index_builder() -> (result: SelectedIndexBuilderV2) {
    return SelectedIndexBuilderV2 {
        values: [0; 16],
        length: 0
    };
}

fn push_index(
    builder: SelectedIndexBuilderV2,
    index: u64,
    include: bool
) -> (result: SelectedIndexBuilderV2) {
    if !include || builder.length >= 16 {
        return builder;
    }
    return SelectedIndexBuilderV2 {
        values: replace(builder.values, builder.length, index),
        length: builder.length +% 1
    };
}

fn candidate_texts_valid(request: InventoryFilterRequestV2) -> (result: bool) {
    iterate i over request.candidates carrying valid: bool = true {
        next valid = valid && valid_search_text(request.candidates[i].search_text);
    }
    return valid;
}

fn valid_request(request: InventoryFilterRequestV2) -> (result: bool) {
    return same_bytes(request.schema_version, request_schema())
        && request.candidate_count == request.candidates.len
        && request.filter_count == request.filters.len
        && request.candidate_count <= 16
        && request.filter_count <= 16
        && candidate_texts_valid(request);
}

fn select_indices(request: InventoryFilterRequestV2) -> (result: [u64; up_to 16]) {
    let seed: SelectedIndexBuilderV2 = empty_index_builder();
    iterate i over request.candidates carrying selected: SelectedIndexBuilderV2 = seed {
        next selected = push_index(
            selected,
            request.candidates[i].test_index,
            i < request.candidate_count
        && candidate_matches(request, request.candidates[i])
        );
    }
    return selected.values[0..selected.length];
}

fn inventory_filter_app_v2(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 116, 101, 115, 116, 32, 105, 110, 118, 101, 110, 116, 111, 114, 121, 32, 102, 105, 108, 116, 101, 114, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: InventoryFilterRequestV2 = structured_read(context.argv[0], request_schema());
    if !valid_request(request) {
        return failure([105, 110, 118, 97, 108, 105, 100, 32, 84, 101, 115, 116, 32, 105, 110, 118, 101, 110, 116, 111, 114, 121, 32, 102, 105, 108, 116, 101, 114, 32, 114, 101, 113, 117, 101, 115, 116], 4);
    }
    let selected: [u64; up_to 16] = select_indices(request);
    let response: InventoryFilterResultV2 = InventoryFilterResultV2 {
        schema_version: result_schema(),
        selected_count: selected.len,
        selected_indices: selected
    };
    let published: u64 = structured_write(context.argv[1], result_schema(), response);
    if published == 0 {
        return failure([116, 101, 115, 116, 32, 105, 110, 118, 101, 110, 116, 111, 114, 121, 32, 102, 105, 108, 116, 101, 114, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
