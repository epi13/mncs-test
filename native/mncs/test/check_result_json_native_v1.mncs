mncs 0.18;

// Validate the retained TestResult and produced CheckResult with bounded
// native cursor scans. Project CheckResult and family policy fields without
// building value trees; preserve opaque selection as a source span. Unescaped
// message bytes remain packed UTF-8 spans; escaped messages use the decoder.
module mncs.test.check_result_json_native_v1;

use mncs.std.application.v1;
use mncs.std.json.v1 as json;
use mncs.std.json_cursor.v1 as json_cursor;
use mncs.test.public_result_json_key_order_v1 as json_order;
use mncs.test.check_result_projection_v1 as check_result;

record CheckResultJsonNativeRequestV1 {
    schema_version: [byte; up_to 64],
    document: json_order.JsonTokenDocumentV1,
    input_sha256: [byte; up_to 64],
    check_document_present: bool,
    check_document: json_order.JsonTokenDocumentV1,
    check_input_sha256: [byte; up_to 64],
    selection_expectation_present: bool,
    expected_test_identities: [[byte; up_to 512]; up_to 256],
    inventory_expectation_present: bool,
    expected_inventory_identity: [byte; up_to 64],
    projection_document_only: bool,
    check_id: [byte; up_to 1024],
    claim: [byte; up_to 1024],
    result_digest: [byte; up_to 64]
}

record CheckResultJsonNativeResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    projection_document_supported: bool,
    projection: check_result.CheckResultProjectionV1,
    family_metadata: FamilyResultMetadataV1,
    check_artifact: CheckArtifactMetadataV1
}

record FamilyResultMetadataV1 {
    supported: bool,
    test_result_schema_valid: bool,
    verdict: [byte; up_to 16],
    selected_test_identities: [[byte; up_to 512]; up_to 256],
    selection_present: bool,
    selection_start: u64,
    selection_length: u64,
    selection_comparison_supported: bool,
    selection_matches_expected: bool,
    inventory_identity_present: bool,
    inventory_identity_null: bool,
    inventory_identity: [byte; up_to 64],
    inventory_comparison_supported: bool,
    inventory_matches_expected: bool,
    run_identity_present: bool,
    run_identity_null: bool,
    run_identity: [byte; up_to 512]
}

record CheckArtifactMetadataV1 {
    supported: bool,
    schema_valid: bool,
    verdict_valid: bool,
    verdict: [byte; up_to 16],
    verdict_comparison_supported: bool,
    verdict_matches_test_result: bool
}

record CheckResultPublicDocumentV1 {
    schema_version: [byte; up_to 64],
    id: [byte; up_to 1024],
    provider: [byte; up_to 256],
    verdict: [byte; up_to 16],
    scope: [byte; up_to 1024],
    claim: [byte; up_to 1024],
    summary: [byte; up_to 1024],
    contract_revision: [byte; up_to 64],
    producer_revision: [byte; up_to 1024],
    digest: [byte; up_to 1024],
    unresolved: [[byte; up_to 1024]; up_to 1],
    references: [check_result.CheckReferenceV1; up_to 1],
    result_ref: check_result.CheckResultReferenceV1,
    classification: [byte; up_to 128],
    failure_class: [byte; up_to 128]
}

record IdentityMinimumV1 {
    identities: [[byte; up_to 512]; 256],
    minimum_index: u64
}

record TokenValueSpanV1 { found: bool, kind: byte, start: u64, length: u64 }

record FieldLookupV1 { found: bool, value: TokenValueSpanV1 }

record TextValueV1 {
    valid: bool,
    present: bool,
    bytes: [byte; up_to 1024],
    length: u64
}

record TextDecodeStateV1 {
    bytes: [byte; 1024],
    length: u64,
    escaped: bool,
    skip: u64,
    valid: bool
}

record MessageChunksV1 {
    chunks: [[byte; up_to 1024]; 256],
    count: u64,
    offset: u64,
    decoder: TextDecodeStateV1,
    valid: bool
}

record MessageProjectionV1 {
    valid: bool,
    present: bool,
    chunks: [[byte; up_to 1024]; 256],
    count: u64
}

record RawMessageBuildStateV1 {
    projection: MessageProjectionV1,
    base: u64,
    start: u64,
    end: u64
}

record NumberValueV1 { valid: bool, value: u64 }
record NumberParseV1 { valid: bool, value: u64 }

record TestRowsV1 {
    valid: bool,
    rows: [check_result.CheckTestV1; 256],
    count: u64
}

enum TokenTestRowsListV1 {
    Nil,
    Cons { head: check_result.CheckTestV1, tail: TokenTestRowsListV1 }
}

record TokenTestRowsV1 {
    valid: bool,
    rows: TokenTestRowsListV1,
    count: u64
}

record TokenRowsBuildStateV1 {
    rows: [check_result.CheckTestV1; 256],
    source: TokenTestRowsListV1
}

record ExtractedTestResultV1 {
    supported: bool,
    request: check_result.CheckResultProjectionRequestV1
}

enum TokenKeyListV1 { Nil, Cons { head: json_order.KeyV1, tail: TokenKeyListV1 } }

record CheckResultTokenStateV1 {
    cursor: json_cursor.Cursor,
    scanner_string_has_escape: bool,
    contexts: [byte; 12],
    pending_tags: [byte; 12],
    member_counts: [u64; 12],
    key_history: [TokenKeyListV1; 12],
    value_count: u64,
    valid: bool,
    root_is_object: bool,
    id_seen: bool,
    provider_seen: bool,
    verdict_seen: bool,
    classification_seen: bool,
    failure_class_seen: bool,
    test_result_schema_seen: bool,
    id: TokenValueSpanV1,
    provider: TokenValueSpanV1,
    verdict: TokenValueSpanV1,
    classification: TokenValueSpanV1,
    failure_class: TokenValueSpanV1,
    test_result_schema: TokenValueSpanV1,
    selection_seen: bool,
    selection_valid: bool,
    selection_span: TokenValueSpanV1,
    selected_test_identities_seen: bool,
    selected_test_identities_valid: bool,
    selected_test_identities: [[byte; up_to 512]; 256],
    selected_test_identity_count: u64,
    test_inventory_seen: bool,
    test_inventory_valid: bool,
    inventory_identity_seen: bool,
    inventory_identity: TokenValueSpanV1,
    experiment_seen: bool,
    experiment_valid: bool,
    run_identity_seen: bool,
    family_run_identity: TokenValueSpanV1,
    scope_seen: bool,
    scope_valid: bool,
    manifest: TokenValueSpanV1,
    summary_seen: bool,
    summary_valid: bool,
    summary: check_result.CheckSummaryV1,
    tests_seen: bool,
    tests_valid: bool,
    tests: TokenTestRowsV1,
    failure_is_object: bool,
    failure_message: TokenValueSpanV1,
    failure_message_has_escape: bool,
    source_sha256: TokenValueSpanV1,
    run_id: TokenValueSpanV1,
    row_id: TokenValueSpanV1,
    row_verdict: TokenValueSpanV1,
    row_valid: bool,
    row_seen_id: bool,
    row_seen_verdict: bool
}

record TokenKeyHistoryScanV1 {
    remaining: TokenKeyListV1,
    duplicate: bool
}

record TokenEventV1 {
    kind: byte,
    event: byte,
    start: u64,
    end: u64,
    depth: byte,
    has_escape: bool
}

record TokenCaptureStateV1 {
    cursor: json_cursor.Cursor,
    events: [TokenEventV1; 64],
    string_had_escape: bool,
    count: u64
}

record StringSkipStateV1 {
    cursor: json_cursor.Cursor,
    closed: bool,
    had_escape: bool
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 99, 104, 101, 99, 107, 45, 114, 101, 115, 117, 108, 116, 45, 106, 115, 111, 110, 45, 110, 97, 116, 105, 118, 101, 45, 114, 101, 113, 117, 101, 115, 116, 47, 52];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 99, 104, 101, 99, 107, 45, 114, 101, 115, 117, 108, 116, 45, 106, 115, 111, 110, 45, 110, 97, 116, 105, 118, 101, 47, 53];
}

fn empty_span() -> (result: TokenValueSpanV1) {
    return TokenValueSpanV1 { found: false, kind: 0, start: 0, length: 0 };
}

fn invalid_span() -> (result: TokenValueSpanV1) {
    return TokenValueSpanV1 { found: true, kind: 0, start: 0, length: 0 };
}

fn empty_text() -> (result: TextValueV1) {
    return TextValueV1 { valid: true, present: false, bytes: [], length: 0 };
}

fn empty_message_chunks() -> (result: MessageChunksV1) {
    let empty_chunk: [byte; up_to 1024] = [];
    let decoder: TextDecodeStateV1 = TextDecodeStateV1 {
        bytes: [0; 1024], length: 0, escaped: false, skip: 0, valid: true
    };
    return MessageChunksV1 {
        chunks: [empty_chunk; 256], count: 0, offset: 0, decoder: decoder, valid: true
    };
}

fn is_utf8_continuation(value: byte) -> (result: bool) {
    return value >= 128 && value <= 191;
}

fn raw_message_block_end(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    offset: u64
) -> (result: u64) {
    let limit: u64 = select(length < offset +% 1024, length, offset +% 1024);
    iterate i up_to 3 carrying end: u64 = limit {
        let splits_codepoint: bool = end > offset && end < length
            && is_utf8_continuation(json_order.located_byte(document, start +% end));
        next end = select(splits_codepoint, end -% 1, end);
    }
    return end;
}

fn decode_message_block_step(
    state: TextDecodeStateV1,
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    block_start: u64,
    block_length: u64,
    index: u64
) -> (result: TextDecodeStateV1) {
    if index >= block_length { return state; }
    return decode_text_step(state, document, start, length, block_start +% index);
}

fn decode_message_block(
    state: TextDecodeStateV1,
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    block_start: u64,
    block_length: u64
) -> (result: TextDecodeStateV1) {
    iterate i up_to 1024 carrying decoded: TextDecodeStateV1 = state {
        next decoded = decode_message_block_step(
            decoded, document, start, length, block_start, block_length, i
        );
    }
    return decoded;
}

fn append_decoded_message_block(
    state: MessageChunksV1,
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: MessageChunksV1) {
    if !state.valid || state.offset >= length { return state; }
    let end: u64 = raw_message_block_end(document, start, length, state.offset);
    if end <= state.offset { return MessageChunksV1 { ..state, valid: false }; }
    let decoded: TextDecodeStateV1 = decode_message_block(
        state.decoder, document, start, length, state.offset, end -% state.offset
    );
    if !decoded.valid { return MessageChunksV1 { ..state, decoder: decoded, valid: false }; }
    if decoded.length > 0 && state.count >= 256 {
        return MessageChunksV1 { ..state, decoder: decoded, valid: false };
    }
    let chunk: [byte; up_to 1024] = decoded.bytes[0..decoded.length];
    let chunks: [[byte; up_to 1024]; 256] = select(
        decoded.length > 0,
        replace(state.chunks, state.count, chunk),
        state.chunks
    );
    let count: u64 = select(decoded.length > 0, state.count +% 1, state.count);
    let next_decoder: TextDecodeStateV1 = TextDecodeStateV1 {
        ..decoded, bytes: [0; 1024], length: 0
    };
    return MessageChunksV1 {
        ..state,
        chunks: chunks,
        count: count,
        offset: end,
        decoder: next_decoder
    };
}

fn empty_message_projection(valid: bool, present: bool) -> (result: MessageProjectionV1) {
    let empty_chunk: [byte; up_to 1024] = [];
    return MessageProjectionV1 {
        valid: valid, present: present, chunks: [empty_chunk; 256], count: 0
    };
}

fn decode_message_span(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: MessageProjectionV1) {
    if length > 10240 { return empty_message_projection(false, true); }
    let initial: MessageChunksV1 = empty_message_chunks();
    iterate i up_to 12 carrying state: MessageChunksV1 = initial {
        next state = append_decoded_message_block(state, document, start, length);
    }
    let valid: bool = state.valid && state.offset == length
        && !state.decoder.escaped && state.decoder.skip == 0;
    return MessageProjectionV1 {
        valid: valid, present: true, chunks: state.chunks, count: state.count
    };
}

fn append_raw_message_chunk(
    state: RawMessageBuildStateV1,
    chunk: json_order.JsonTokenInputChunkV1
) -> (result: RawMessageBuildStateV1) {
    let chunk_end: u64 = state.base +% chunk.length;
    let overlap_start: u64 = select(state.start > state.base, state.start, state.base);
    let overlap_end: u64 = select(state.end < chunk_end, state.end, chunk_end);
    if overlap_start < overlap_end && state.projection.count < 64 {
        let begin: u64 = overlap_start -% state.base;
        let finish: u64 = overlap_end -% state.base;
        let bytes: [byte; up_to 1024] = chunk.bytes[begin..finish];
        let next_projection: MessageProjectionV1 = MessageProjectionV1 {
            ..state.projection,
            chunks: replace(state.projection.chunks, state.projection.count, bytes),
            count: state.projection.count +% 1
        };
        return RawMessageBuildStateV1 {
            ..state, projection: next_projection, base: chunk_end
        };
    }
    return RawMessageBuildStateV1 { ..state, base: chunk_end };
}

fn raw_message_span(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: MessageProjectionV1) {
    // Input chunks are already UTF-8-safe; an unescaped JSON string has the
    // same bytes as its decoded value, so retain source slices directly.
    if length > 10240 { return empty_message_projection(false, true); }
    let initial: RawMessageBuildStateV1 = RawMessageBuildStateV1 {
        projection: empty_message_projection(true, true),
        base: 0,
        start: start,
        end: start +% length
    };
    iterate i over document.chunks carrying built: RawMessageBuildStateV1 = initial {
        next built = append_raw_message_chunk(built, document.chunks[i]);
    }
    return MessageProjectionV1 {
        ..built.projection,
        valid: built.projection.valid && built.base >= built.end
            && built.projection.count <= 64
    };
}

fn decode_failure_message(
    document: json_order.JsonTokenDocumentV1,
    field: FieldLookupV1,
    has_escape: bool
) -> (result: MessageProjectionV1) {
    if !field.found { return empty_message_projection(true, false); }
    if field.value.kind != 2 { return empty_message_projection(false, false); }
    if !has_escape {
        return raw_message_span(
            document,
            field.value.start +% 1,
            field.value.length -% 2
        );
    }
    return decode_message_span(
        document,
        field.value.start +% 1,
        field.value.length -% 2
    );
}

fn key_value(name: [byte; up_to 256]) -> (result: json_order.KeyV1) {
    return json_order.KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: name,
        ordered_length: name.len,
        valid: true
    };
}

fn widen_text_step<N: Nat>(
    output: [byte; N],
    input: [byte; up_to 1024],
    index: u64,
    length: u64,
    capacity: u64
) -> (result: [byte; N]) {
    if index >= length || index >= capacity { return output; }
    return replace(output, index, input[index]);
}

fn widen_text_16(input: [byte; up_to 1024], length: u64) -> (result: [byte; up_to 16]) {
    iterate i up_to 16 carrying output: [byte; 16] = [0; 16] {
        next output = widen_text_step<16>(output, input, i, length, 16);
    }
    let bounded_length: u64 = select(length < 16, length, 16);
    return output[0..bounded_length];
}

fn widen_text_64(input: [byte; up_to 1024], length: u64) -> (result: [byte; up_to 64]) {
    iterate i up_to 64 carrying output: [byte; 64] = [0; 64] {
        next output = widen_text_step<64>(output, input, i, length, 64);
    }
    let bounded_length: u64 = select(length < 64, length, 64);
    return output[0..bounded_length];
}

fn widen_text_128(input: [byte; up_to 1024], length: u64) -> (result: [byte; up_to 128]) {
    iterate i up_to 128 carrying output: [byte; 128] = [0; 128] {
        next output = widen_text_step<128>(output, input, i, length, 128);
    }
    let bounded_length: u64 = select(length < 128, length, 128);
    return output[0..bounded_length];
}

fn widen_text_256(input: [byte; up_to 1024], length: u64) -> (result: [byte; up_to 256]) {
    iterate i up_to 256 carrying output: [byte; 256] = [0; 256] {
        next output = widen_text_step<256>(output, input, i, length, 256);
    }
    let bounded_length: u64 = select(length < 256, length, 256);
    return output[0..bounded_length];
}

fn widen_text_512(input: [byte; up_to 1024], length: u64) -> (result: [byte; up_to 512]) {
    iterate i up_to 512 carrying output: [byte; 512] = [0; 512] {
        next output = widen_text_step<512>(output, input, i, length, 512);
    }
    let bounded_length: u64 = select(length < 512, length, 512);
    return output[0..bounded_length];
}

fn widen_text_1024(input: [byte; up_to 1024], length: u64) -> (result: [byte; up_to 1024]) {
    iterate i up_to 1024 carrying output: [byte; 1024] = [0; 1024] {
        next output = widen_text_step<1024>(output, input, i, length, 1024);
    }
    let bounded_length: u64 = select(length < 1024, length, 1024);
    return output[0..bounded_length];
}

fn text_decoded_byte(state: TextDecodeStateV1, value: byte) -> (result: TextDecodeStateV1) {
    if !state.valid || state.length >= 1024 {
        return TextDecodeStateV1 { ..state, valid: false };
    }
    return TextDecodeStateV1 {
        ..state,
        bytes: replace(state.bytes, state.length, value),
        length: state.length +% 1
    };
}

fn text_decoded_codepoint(state: TextDecodeStateV1, value: u64) -> (result: TextDecodeStateV1) {
    if value <= 127 { return text_decoded_byte(state, value as byte); }
    if value <= 2047 {
        let first: TextDecodeStateV1 = text_decoded_byte(state, (192 +% (value / 64)) as byte);
        return text_decoded_byte(first, (128 +% (value % 64)) as byte);
    }
    if value <= 65535 && !(value >= 55296 && value <= 57343) {
        let first: TextDecodeStateV1 = text_decoded_byte(state, (224 +% (value / 4096)) as byte);
        let second: TextDecodeStateV1 = text_decoded_byte(first, (128 +% ((value / 64) % 64)) as byte);
        return text_decoded_byte(second, (128 +% (value % 64)) as byte);
    }
    if value <= 1114111 {
        let first: TextDecodeStateV1 = text_decoded_byte(state, (240 +% (value / 262144)) as byte);
        let second: TextDecodeStateV1 = text_decoded_byte(first, (128 +% ((value / 4096) % 64)) as byte);
        let third: TextDecodeStateV1 = text_decoded_byte(second, (128 +% ((value / 64) % 64)) as byte);
        return text_decoded_byte(third, (128 +% (value % 64)) as byte);
    }
    return TextDecodeStateV1 { ..state, valid: false };
}

fn decode_text_step(
    state: TextDecodeStateV1,
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: TextDecodeStateV1) {
    if index >= length || !state.valid { return state; }
    let value: byte = json_order.located_byte(document, start +% index);
    if state.skip > 0 {
        return TextDecodeStateV1 { ..state, skip: state.skip -% 1 };
    }
    if state.escaped {
        if value == 117 {
            if index +% 4 >= length {
                return TextDecodeStateV1 { ..state, valid: false, escaped: false };
            }
            let code: u64 = json_order.decode_hex4(document, start, index +% 1);
            if code >= 55296 && code <= 56319 {
                if index +% 10 >= length
                    || json_order.located_byte(document, start +% index +% 5) != 92
                    || json_order.located_byte(document, start +% index +% 6) != 117 {
                    return TextDecodeStateV1 { ..state, valid: false, escaped: false };
                }
                let low: u64 = json_order.decode_hex4(document, start, index +% 7);
                if low < 56320 || low > 57343 {
                    return TextDecodeStateV1 { ..state, valid: false, escaped: false };
                }
                let point: u64 = 65536 +% (code -% 55296) *% 1024 +% (low -% 56320);
                return TextDecodeStateV1 {
                    ..text_decoded_codepoint(state, point),
                    escaped: false,
                    skip: 10
                };
            }
            if code >= 56320 && code <= 57343 {
                return TextDecodeStateV1 { ..state, valid: false, escaped: false };
            }
            return TextDecodeStateV1 {
                ..text_decoded_codepoint(state, code),
                escaped: false,
                skip: 4
            };
        }
        if value == 34 || value == 92 || value == 47 {
            return TextDecodeStateV1 { ..text_decoded_byte(state, value), escaped: false };
        }
        if value == 98 { return TextDecodeStateV1 { ..text_decoded_byte(state, 8), escaped: false }; }
        if value == 102 { return TextDecodeStateV1 { ..text_decoded_byte(state, 12), escaped: false }; }
        if value == 110 { return TextDecodeStateV1 { ..text_decoded_byte(state, 10), escaped: false }; }
        if value == 114 { return TextDecodeStateV1 { ..text_decoded_byte(state, 13), escaped: false }; }
        if value == 116 { return TextDecodeStateV1 { ..text_decoded_byte(state, 9), escaped: false }; }
        return TextDecodeStateV1 { ..state, valid: false, escaped: false };
    }
    if value == 92 { return TextDecodeStateV1 { ..state, escaped: true }; }
    return text_decoded_byte(state, value);
}

fn decode_text_block(
    state: TextDecodeStateV1,
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    block_start: u64
) -> (result: TextDecodeStateV1) {
    iterate i up_to 1024 carrying decoded: TextDecodeStateV1 = state {
        next decoded = decode_text_step(decoded, document, start, length, block_start +% i);
    }
    return decoded;
}

fn decoded_text_value(decoded: TextDecodeStateV1) -> (result: TextValueV1) {
    return TextValueV1 {
        valid: decoded.valid && !decoded.escaped && decoded.skip == 0,
        present: true,
        bytes: decoded.bytes[0..decoded.length],
        length: decoded.length
    };
}

fn decode_text_span(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: TextValueV1) {
    if length > 6144 { return TextValueV1 { ..empty_text(), valid: false }; }
    if length == 0 { return TextValueV1 { valid: true, present: true, bytes: [], length: 0 }; }
    let initial: TextDecodeStateV1 = TextDecodeStateV1 {
        bytes: [0; 1024], length: 0, escaped: false, skip: 0, valid: true
    };
    if length <= 1024 {
        return decoded_text_value(decode_text_block(initial, document, start, length, 0));
    }
    iterate block up_to 6 carrying decoded: TextDecodeStateV1 = initial {
        next decoded = decode_text_block(decoded, document, start, length, block *% 1024);
    }
    return decoded_text_value(decoded);
}

fn decode_text_value(
    document: json_order.JsonTokenDocumentV1,
    field: FieldLookupV1,
    missing_allowed: bool
) -> (result: TextValueV1) {
    if !field.found { return TextValueV1 { ..empty_text(), valid: missing_allowed }; }
    if field.value.kind != 2 { return TextValueV1 { ..empty_text(), valid: false }; }
    return decode_text_span(
        document,
        field.value.start +% 1,
        field.value.length -% 2
    );
}

fn parse_number_step(
    state: NumberParseV1,
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: NumberParseV1) {
    if index >= length || !state.valid { return state; }
    let digit_byte: byte = json_order.located_byte(document, start +% index);
    if digit_byte < 48 || digit_byte > 57 || index >= 20 {
        return NumberParseV1 { ..state, valid: false };
    }
    let digit: u64 = (digit_byte as u64) -% 48;
    let within_u64: bool = state.value < 1844674407370955161
        || (state.value == 1844674407370955161 && digit <= 5);
    if !within_u64 { return NumberParseV1 { ..state, valid: false }; }
    return NumberParseV1 { value: state.value *% 10 +% digit, valid: true };
}

fn parse_unsigned_span(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: NumberValueV1) {
    if length == 0 || length > 20 { return NumberValueV1 { valid: false, value: 0 }; }
    let initial: NumberParseV1 = NumberParseV1 { valid: true, value: 0 };
    iterate i up_to 20 carrying parsed: NumberParseV1 = initial {
        next parsed = parse_number_step(parsed, document, start, length, i);
    }
    return NumberValueV1 { valid: parsed.valid, value: parsed.value };
}

fn unsigned_value(
    document: json_order.JsonTokenDocumentV1,
    field: FieldLookupV1,
    missing_allowed: bool
) -> (result: NumberValueV1) {
    if !field.found { return NumberValueV1 { valid: missing_allowed, value: 0 }; }
    if field.value.kind != 3 { return NumberValueV1 { valid: false, value: 0 }; }
    return parse_unsigned_span(document, field.value.start, field.value.length);
}

fn empty_projection_request(metadata: CheckResultJsonNativeRequestV1) -> (result: check_result.CheckResultProjectionRequestV1) {
    return check_result.CheckResultProjectionRequestV1 {
        schema_version: check_result.request_schema(),
        id: metadata.check_id,
        provider: [],
        verdict: [80, 65, 83, 83],
        scope_manifest: [],
        scope_manifest_present: false,
        claim: metadata.claim,
        classification: [],
        failure_class: [],
        result_digest: metadata.result_digest,
        source_sha256: [],
        summary: check_result.CheckSummaryV1 { passed: 0, failed: 0, skipped: 0 },
        failure_message_present: false,
        failure_message_count: 0,
        failure_message_chunks: [],
        run_id: [],
        test_count: 0,
        tests: []
    };
}

fn empty_token_state() -> (result: CheckResultTokenStateV1) {
    let zero_summary: check_result.CheckSummaryV1 = check_result.CheckSummaryV1 {
        passed: 0, failed: 0, skipped: 0
    };
    let empty_identity: [byte; up_to 512] = [];
    return CheckResultTokenStateV1 {
        cursor: json_cursor.init(),
        scanner_string_has_escape: false,
        contexts: [0; 12],
        pending_tags: [0; 12],
        member_counts: [0; 12],
        key_history: [TokenKeyListV1.Nil; 12],
        value_count: 0,
        valid: true,
        root_is_object: false,
        id_seen: false,
        provider_seen: false,
        verdict_seen: false,
        classification_seen: false,
        failure_class_seen: false,
        test_result_schema_seen: false,
        id: empty_span(),
        provider: empty_span(),
        verdict: empty_span(),
        classification: empty_span(),
        failure_class: empty_span(),
        test_result_schema: empty_span(),
        selection_seen: false,
        selection_valid: true,
        selection_span: empty_span(),
        selected_test_identities_seen: false,
        selected_test_identities_valid: true,
        selected_test_identities: [empty_identity; 256],
        selected_test_identity_count: 0,
        test_inventory_seen: false,
        test_inventory_valid: true,
        inventory_identity_seen: false,
        inventory_identity: empty_span(),
        experiment_seen: false,
        experiment_valid: true,
        run_identity_seen: false,
        family_run_identity: empty_span(),
        scope_seen: false,
        scope_valid: true,
        manifest: empty_span(),
        summary_seen: false,
        summary_valid: true,
        summary: zero_summary,
        tests_seen: false,
        tests_valid: true,
        tests: empty_token_rows(),
        failure_is_object: false,
        failure_message: empty_span(),
        failure_message_has_escape: false,
        source_sha256: empty_span(),
        run_id: empty_span(),
        row_id: empty_span(),
        row_verdict: empty_span(),
        row_valid: true,
        row_seen_id: false,
        row_seen_verdict: false
    };
}

fn token_key_equal(key: json_order.KeyV1, name: [byte; up_to 256]) -> (result: bool) {
    return match json_order.compare_key(key, key_value(name)) {
        json_order.KeyOrderV1.Equal => true,
        json_order.KeyOrderV1.Before => false,
        json_order.KeyOrderV1.After => false
    };
}

fn token_key_tag(context: byte, key: json_order.KeyV1) -> (result: byte) {
    if context == 1 {
        if token_key_equal(key, [105, 100]) { return 1; }
        if token_key_equal(key, [112, 114, 111, 118, 105, 100, 101, 114]) { return 2; }
        if token_key_equal(key, [118, 101, 114, 100, 105, 99, 116]) { return 3; }
        if token_key_equal(key, [115, 99, 111, 112, 101]) { return 4; }
        if token_key_equal(key, [115, 117, 109, 109, 97, 114, 121]) { return 5; }
        if token_key_equal(key, [116, 101, 115, 116, 115]) { return 6; }
        if token_key_equal(key, [102, 97, 105, 108, 117, 114, 101]) { return 7; }
        if token_key_equal(key, [112, 114, 111, 118, 101, 110, 97, 110, 99, 101]) { return 8; }
        if token_key_equal(key, [114, 117, 110, 95, 105, 100]) { return 9; }
        if token_key_equal(key, [99, 108, 97, 115, 115, 105, 102, 105, 99, 97, 116, 105, 111, 110]) { return 10; }
        if token_key_equal(key, [102, 97, 105, 108, 117, 114, 101, 95, 99, 108, 97, 115, 115]) { return 11; }
        if token_key_equal(key, [115, 99, 104, 101, 109, 97, 95, 118, 101, 114, 115, 105, 111, 110]) { return 12; }
        if token_key_equal(key, [115, 101, 108, 101, 99, 116, 105, 111, 110]) { return 13; }
        if token_key_equal(key, [116, 101, 115, 116, 95, 105, 110, 118, 101, 110, 116, 111, 114, 121]) { return 14; }
        if token_key_equal(key, [101, 120, 112, 101, 114, 105, 109, 101, 110, 116]) { return 15; }
    }
    if context == 2 && token_key_equal(key, [109, 97, 110, 105, 102, 101, 115, 116]) { return 1; }
    if context == 3 {
        if token_key_equal(key, [112, 97, 115, 115, 101, 100]) { return 1; }
        if token_key_equal(key, [102, 97, 105, 108, 101, 100]) { return 2; }
        if token_key_equal(key, [115, 107, 105, 112, 112, 101, 100]) { return 3; }
    }
    if context == 5 {
        if token_key_equal(key, [105, 100]) { return 1; }
        if token_key_equal(key, [118, 101, 114, 100, 105, 99, 116]) { return 2; }
    }
    if context == 6 && token_key_equal(key, [109, 101, 115, 115, 97, 103, 101]) { return 1; }
    if context == 7 && token_key_equal(key, [114, 117, 110, 110, 101, 114]) { return 1; }
    if context == 8 && token_key_equal(key, [115, 111, 117, 114, 99, 101, 95, 115, 104, 97, 50, 53, 54]) { return 1; }
    if context == 9 && token_key_equal(key, [115, 101, 108, 101, 99, 116, 101, 100, 95, 116, 101, 115, 116, 95, 105, 100, 101, 110, 116, 105, 116, 105, 101, 115]) { return 1; }
    if context == 11 && token_key_equal(key, [105, 110, 118, 101, 110, 116, 111, 114, 121, 95, 105, 100, 101, 110, 116, 105, 116, 121]) { return 1; }
    if context == 12 && token_key_equal(key, [114, 117, 110, 95, 105, 100, 101, 110, 116, 105, 116, 121]) { return 1; }
    return 0;
}

fn token_value_field(token: json_cursor.Cursor) -> (result: FieldLookupV1) {
    return FieldLookupV1 {
        found: true,
        value: TokenValueSpanV1 {
            found: true,
            kind: token.token_kind,
            start: token.token_start,
            length: token.token_end -% token.token_start
        }
    };
}

fn key_history_scan_match(
    head: json_order.KeyV1,
    tail: TokenKeyListV1,
    key: json_order.KeyV1
) -> (result: TokenKeyHistoryScanV1) {
    let equal: bool = match json_order.compare_key(key, head) {
        json_order.KeyOrderV1.Equal => true,
        json_order.KeyOrderV1.Before => false,
        json_order.KeyOrderV1.After => false
    };
    return TokenKeyHistoryScanV1 { remaining: tail, duplicate: equal };
}

fn key_history_scan_step(
    state: TokenKeyHistoryScanV1,
    key: json_order.KeyV1
) -> (result: TokenKeyHistoryScanV1) {
    if state.duplicate { return TokenKeyHistoryScanV1 { ..state, remaining: TokenKeyListV1.Nil }; }
    return match state.remaining {
        TokenKeyListV1.Nil => state,
        TokenKeyListV1.Cons { head: head, tail: tail } =>
            key_history_scan_match(head, tail, key)
    };
}

fn key_history_has_duplicate(
    history: TokenKeyListV1,
    key: json_order.KeyV1
) -> (result: bool) {
    let initial: TokenKeyHistoryScanV1 = TokenKeyHistoryScanV1 {
        remaining: history, duplicate: false
    };
    iterate i up_to 64 carrying scanned: TokenKeyHistoryScanV1 = initial {
        next scanned = key_history_scan_step(scanned, key);
    }
    return scanned.duplicate;
}

fn mark_token_key(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1,
    token: json_cursor.Cursor
) -> (result: CheckResultTokenStateV1) {
    if token.token_depth == 0 || token.token_depth > 12 {
        return CheckResultTokenStateV1 { ..state, valid: false };
    }
    let frame_index: u64 = (token.token_depth as u64) -% 1;
    let raw_start: u64 = token.token_start +% 1;
    let raw_length: u64 = token.token_end -% token.token_start -% 2;
    let key: json_order.KeyV1 = json_order.decode_key(document, raw_start, raw_length);
    let context: byte = state.contexts[frame_index];
    let tag: byte = token_key_tag(context, key);
    let count: u64 = state.member_counts[frame_index];
    let in_bounds: bool = raw_length <= 256 && key.valid && count < 64;
    let history: TokenKeyListV1 = state.key_history[frame_index];
    let duplicate: bool = key_history_has_duplicate(history, key);
    let next_history: TokenKeyListV1 = TokenKeyListV1.Cons { head: key, tail: history };
    let next_histories: [TokenKeyListV1; 12] = replace(
        state.key_history, frame_index, next_history
    );
    let next_tags: [byte; 12] = replace(state.pending_tags, frame_index, tag);
    let next_counts: [u64; 12] = replace(state.member_counts, frame_index, count +% 1);
    let recognized: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state,
        key_history: next_histories,
        pending_tags: next_tags,
        member_counts: next_counts,
        valid: state.valid && in_bounds && !duplicate
    };
    if context == 1 && tag == 1 { return CheckResultTokenStateV1 { ..recognized, id_seen: true }; }
    if context == 1 && tag == 2 { return CheckResultTokenStateV1 { ..recognized, provider_seen: true }; }
    if context == 1 && tag == 3 { return CheckResultTokenStateV1 { ..recognized, verdict_seen: true }; }
    if context == 1 && tag == 4 { return CheckResultTokenStateV1 { ..recognized, scope_seen: true }; }
    if context == 1 && tag == 5 { return CheckResultTokenStateV1 { ..recognized, summary_seen: true }; }
    if context == 1 && tag == 6 { return CheckResultTokenStateV1 { ..recognized, tests_seen: true }; }
    if context == 1 && tag == 10 { return CheckResultTokenStateV1 { ..recognized, classification_seen: true }; }
    if context == 1 && tag == 11 { return CheckResultTokenStateV1 { ..recognized, failure_class_seen: true }; }
    if context == 1 && tag == 12 { return CheckResultTokenStateV1 { ..recognized, test_result_schema_seen: true }; }
    if context == 1 && tag == 13 { return CheckResultTokenStateV1 { ..recognized, selection_seen: true }; }
    if context == 1 && tag == 14 { return CheckResultTokenStateV1 { ..recognized, test_inventory_seen: true }; }
    if context == 1 && tag == 15 { return CheckResultTokenStateV1 { ..recognized, experiment_seen: true }; }
    if context == 5 && tag == 1 { return CheckResultTokenStateV1 { ..recognized, row_seen_id: true }; }
    if context == 5 && tag == 2 { return CheckResultTokenStateV1 { ..recognized, row_seen_verdict: true }; }
    if context == 9 && tag == 1 { return CheckResultTokenStateV1 { ..recognized, selected_test_identities_seen: true }; }
    if context == 11 && tag == 1 { return CheckResultTokenStateV1 { ..recognized, inventory_identity_seen: true }; }
    if context == 12 && tag == 1 { return CheckResultTokenStateV1 { ..recognized, run_identity_seen: true }; }
    return recognized;
}

fn empty_token_rows() -> (result: TokenTestRowsV1) {
    return TokenTestRowsV1 {
        valid: true,
        rows: TokenTestRowsListV1.Nil,
        count: 0
    };
}

fn token_rows_materialize_step(
    state: TokenRowsBuildStateV1,
    count: u64,
    index: u64
) -> (result: TokenRowsBuildStateV1) {
    return match state.source {
        TokenTestRowsListV1.Nil => state,
        TokenTestRowsListV1.Cons { head: head, tail: tail } =>
            TokenRowsBuildStateV1 {
                rows: replace(state.rows, count -% 1 -% index, head),
                source: tail
            }
    };
}

fn materialize_token_rows(source: TokenTestRowsV1) -> (result: TestRowsV1) {
    let empty: check_result.CheckTestV1 = check_result.CheckTestV1 { id: [], verdict: [] };
    let initial: TokenRowsBuildStateV1 = TokenRowsBuildStateV1 {
        rows: [empty; 256], source: source.rows
    };
    iterate i up_to 256 carrying built: TokenRowsBuildStateV1 = initial {
        next built = token_rows_materialize_step(built, source.count, i);
    }
    return TestRowsV1 {
        valid: source.valid,
        rows: built.rows,
        count: source.count
    };
}

fn token_row_start(state: CheckResultTokenStateV1) -> (result: CheckResultTokenStateV1) {
    return CheckResultTokenStateV1 {
        ..state,
        row_id: empty_span(),
        row_verdict: empty_span(),
        row_valid: true,
        row_seen_id: false,
        row_seen_verdict: false
    };
}

fn token_row_finish(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: CheckResultTokenStateV1) {
    let id: TextValueV1 = decode_text_value(
        document,
        FieldLookupV1 { found: state.row_id.found, value: state.row_id },
        true
    );
    let verdict: TextValueV1 = decode_text_value(
        document,
        FieldLookupV1 { found: state.row_verdict.found, value: state.row_verdict },
        true
    );
    if !state.row_valid || !id.valid || !verdict.valid
        || id.length > 512 || verdict.length > 16 || state.tests.count >= 256 {
        return CheckResultTokenStateV1 {
            ..state,
            tests_valid: false,
            tests: TokenTestRowsV1 { ..state.tests, valid: false }
        };
    }
    let row: check_result.CheckTestV1 = check_result.CheckTestV1 {
        id: widen_text_512(id.bytes, id.length),
        verdict: widen_text_16(verdict.bytes, verdict.length)
    };
    let rows: TokenTestRowsListV1 = TokenTestRowsListV1.Cons {
        head: row, tail: state.tests.rows
    };
    return CheckResultTokenStateV1 {
        ..state,
        tests: TokenTestRowsV1 { ..state.tests, rows: rows, count: state.tests.count +% 1 }
    };
}

fn token_value_context(
    state: CheckResultTokenStateV1,
    parent_context: byte,
    tag: byte,
    kind: byte,
    frame_index: u64,
    token_start: u64
) -> (result: CheckResultTokenStateV1) {
    let ignored: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state,
        contexts: replace(state.contexts, frame_index, 0)
    };
    if parent_context == 1 {
        if tag == 1 { return CheckResultTokenStateV1 { ..ignored, id: invalid_span() }; }
        if tag == 2 { return CheckResultTokenStateV1 { ..ignored, provider: invalid_span() }; }
        if tag == 3 { return CheckResultTokenStateV1 { ..ignored, verdict: invalid_span() }; }
        if tag == 4 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                scope_valid: state.scope_valid && good,
                contexts: replace(state.contexts, frame_index, select(good, 2, 0))
            };
        }
        if tag == 5 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                summary_valid: state.summary_valid && good,
                contexts: replace(state.contexts, frame_index, select(good, 3, 0))
            };
        }
        if tag == 6 {
            let good: bool = kind == 8;
            return CheckResultTokenStateV1 {
                ..ignored,
                tests_valid: state.tests_valid && good,
                contexts: replace(state.contexts, frame_index, select(good, 4, 0))
            };
        }
        if tag == 7 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                failure_is_object: good,
                contexts: replace(state.contexts, frame_index, select(good, 6, 0))
            };
        }
        if tag == 8 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                contexts: replace(state.contexts, frame_index, select(good, 7, 0))
            };
        }
        if tag == 9 { return CheckResultTokenStateV1 { ..ignored, run_id: invalid_span() }; }
        if tag == 10 { return CheckResultTokenStateV1 { ..ignored, classification: invalid_span() }; }
        if tag == 11 { return CheckResultTokenStateV1 { ..ignored, failure_class: invalid_span() }; }
        if tag == 12 { return CheckResultTokenStateV1 { ..ignored, test_result_schema: invalid_span() }; }
        if tag == 13 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                selection_valid: state.selection_valid && good,
                selection_span: TokenValueSpanV1 {
                    found: good, kind: kind, start: token_start, length: 0
                },
                contexts: replace(state.contexts, frame_index, select(good, 9, 0))
            };
        }
        if tag == 14 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                test_inventory_valid: state.test_inventory_valid && good,
                contexts: replace(state.contexts, frame_index, select(good, 11, 0))
            };
        }
        if tag == 15 {
            let good: bool = kind == 7;
            return CheckResultTokenStateV1 {
                ..ignored,
                experiment_valid: state.experiment_valid && good,
                contexts: replace(state.contexts, frame_index, select(good, 12, 0))
            };
        }
        return ignored;
    }
    if parent_context == 2 && tag == 1 {
        return CheckResultTokenStateV1 { ..ignored, manifest: invalid_span() };
    }
    if parent_context == 3 && tag > 0 && tag <= 3 {
        return CheckResultTokenStateV1 { ..ignored, summary_valid: false };
    }
    if parent_context == 4 && kind == 7 { return token_row_start(CheckResultTokenStateV1 {
        ..ignored, contexts: replace(state.contexts, frame_index, 5)
    }); }
    if parent_context == 5 && tag == 1 {
        return CheckResultTokenStateV1 { ..ignored, row_valid: false, row_id: invalid_span() };
    }
    if parent_context == 5 && tag == 2 {
        return CheckResultTokenStateV1 { ..ignored, row_valid: false, row_verdict: invalid_span() };
    }
    if parent_context == 6 && tag == 1 {
        return CheckResultTokenStateV1 {
            ..ignored,
            failure_message: invalid_span()
        };
    }
    if parent_context == 7 && tag == 1 && kind == 7 {
        return CheckResultTokenStateV1 {
            ..ignored,
            contexts: replace(state.contexts, frame_index, 8)
        };
    }
    if parent_context == 8 && tag == 1 {
        return CheckResultTokenStateV1 { ..ignored, source_sha256: invalid_span() };
    }
    if parent_context == 9 && tag == 1 {
        let good: bool = kind == 8;
        return CheckResultTokenStateV1 {
            ..ignored,
            selection_valid: state.selection_valid && good,
            selected_test_identities_valid: state.selected_test_identities_valid && good,
            contexts: replace(state.contexts, frame_index, select(good, 10, 0))
        };
    }
    if parent_context == 10 {
        return CheckResultTokenStateV1 {
            ..ignored,
            selected_test_identities_valid: false
        };
    }
    if parent_context == 11 && tag == 1 {
        return CheckResultTokenStateV1 {
            ..ignored,
            test_inventory_valid: false,
            inventory_identity: invalid_span()
        };
    }
    if parent_context == 12 && tag == 1 {
        return CheckResultTokenStateV1 {
            ..ignored,
            experiment_valid: false,
            family_run_identity: invalid_span()
        };
    }
    return ignored;
}

fn token_open_container(
    state: CheckResultTokenStateV1,
    token: json_cursor.Cursor
) -> (result: CheckResultTokenStateV1) {
    if token.token_depth >= 12 {
        return CheckResultTokenStateV1 { ..state, valid: false };
    }
    let frame_index: u64 = token.token_depth as u64;
    if token.token_depth == 0 {
        let is_object: bool = token.token_kind == 7;
        let root_context: byte = select(is_object, 1, 0);
        let reset_counts: [u64; 12] = replace(state.member_counts, frame_index, 0);
        let reset_history: [TokenKeyListV1; 12] = replace(
            state.key_history, frame_index, TokenKeyListV1.Nil
        );
        return CheckResultTokenStateV1 {
            ..state,
            root_is_object: is_object,
            contexts: replace(state.contexts, frame_index, root_context),
            key_history: reset_history,
            member_counts: reset_counts
        };
    }
    let parent_index: u64 = frame_index -% 1;
    let parent_context: byte = state.contexts[parent_index];
    let tag: byte = state.pending_tags[parent_index];
    let reset_counts: [u64; 12] = replace(state.member_counts, frame_index, 0);
    let reset_history: [TokenKeyListV1; 12] = replace(
        state.key_history, frame_index, TokenKeyListV1.Nil
    );
    let reset_tags: [byte; 12] = replace(state.pending_tags, frame_index, 0);
    let prepared: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state,
        pending_tags: replace(reset_tags, parent_index, 0),
        key_history: reset_history,
        member_counts: reset_counts
    };
    return token_value_context(
        prepared, parent_context, tag, token.token_kind, frame_index, token.token_start
    );
}

fn token_store_scalar(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1,
    token: json_cursor.Cursor
) -> (result: CheckResultTokenStateV1) {
    let within_values: bool = state.value_count < 512;
    if token.token_depth == 0 {
        return CheckResultTokenStateV1 {
            ..state,
            value_count: state.value_count +% 1,
            valid: state.valid && within_values
        };
    }
    let frame_index: u64 = (token.token_depth as u64) -% 1;
    let context: byte = state.contexts[frame_index];
    let tag: byte = state.pending_tags[frame_index];
    let field: FieldLookupV1 = token_value_field(token);
    let scalar: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state,
        value_count: state.value_count +% 1,
        pending_tags: replace(state.pending_tags, frame_index, 0),
        valid: state.valid && within_values
    };
    if context == 1 {
        if tag == 1 { return CheckResultTokenStateV1 { ..scalar, id: field.value }; }
        if tag == 2 { return CheckResultTokenStateV1 { ..scalar, provider: field.value }; }
        if tag == 3 { return CheckResultTokenStateV1 { ..scalar, verdict: field.value }; }
        if tag == 4 { return CheckResultTokenStateV1 { ..scalar, scope_valid: false }; }
        if tag == 5 { return CheckResultTokenStateV1 { ..scalar, summary_valid: false }; }
        if tag == 6 { return CheckResultTokenStateV1 { ..scalar, tests_valid: false }; }
        if tag == 7 { return CheckResultTokenStateV1 { ..scalar, failure_is_object: false }; }
        if tag == 9 { return CheckResultTokenStateV1 { ..scalar, run_id: field.value }; }
        if tag == 10 { return CheckResultTokenStateV1 { ..scalar, classification: field.value }; }
        if tag == 11 { return CheckResultTokenStateV1 { ..scalar, failure_class: field.value }; }
        if tag == 12 { return CheckResultTokenStateV1 { ..scalar, test_result_schema: field.value }; }
        if tag == 13 { return CheckResultTokenStateV1 { ..scalar, selection_valid: false }; }
        if tag == 14 { return CheckResultTokenStateV1 { ..scalar, test_inventory_valid: false }; }
        if tag == 15 { return CheckResultTokenStateV1 { ..scalar, experiment_valid: false }; }
        return scalar;
    }
    if context == 2 && tag == 1 {
        return CheckResultTokenStateV1 { ..scalar, manifest: field.value };
    }
    if context == 3 && tag > 0 && tag <= 3 {
        let number: NumberValueV1 = unsigned_value(document, field, false);
        if !number.valid { return CheckResultTokenStateV1 { ..scalar, summary_valid: false }; }
        if tag == 1 { return CheckResultTokenStateV1 { ..scalar, summary: check_result.CheckSummaryV1 { ..scalar.summary, passed: number.value } }; }
        if tag == 2 { return CheckResultTokenStateV1 { ..scalar, summary: check_result.CheckSummaryV1 { ..scalar.summary, failed: number.value } }; }
        return CheckResultTokenStateV1 { ..scalar, summary: check_result.CheckSummaryV1 { ..scalar.summary, skipped: number.value } };
    }
    if context == 5 && tag == 1 {
        return CheckResultTokenStateV1 { ..scalar, row_id: field.value };
    }
    if context == 5 && tag == 2 {
        return CheckResultTokenStateV1 { ..scalar, row_verdict: field.value };
    }
    if context == 6 && tag == 1 {
        return CheckResultTokenStateV1 {
            ..scalar,
            failure_message: field.value
        };
    }
    if context == 8 && tag == 1 {
        return CheckResultTokenStateV1 {
            ..scalar,
            source_sha256: field.value
        };
    }
    if context == 10 {
        let identity: TextValueV1 = decode_text_value(document, field, false);
        let within_bound: bool = identity.valid && identity.length <= 512
            && scalar.selected_test_identity_count < 256;
        let row: [byte; up_to 512] = widen_text_512(identity.bytes, identity.length);
        let safe_index: u64 = select(
            scalar.selected_test_identity_count < 256,
            scalar.selected_test_identity_count,
            255
        );
        let identities: [[byte; up_to 512]; 256] = select(
            within_bound,
            replace(scalar.selected_test_identities, safe_index, row),
            scalar.selected_test_identities
        );
        return CheckResultTokenStateV1 {
            ..scalar,
            selected_test_identities: identities,
            selected_test_identity_count: select(
                within_bound, scalar.selected_test_identity_count +% 1, scalar.selected_test_identity_count
            ),
            selected_test_identities_valid: scalar.selected_test_identities_valid && within_bound
        };
    }
    if context == 11 && tag == 1 {
        let kind_supported: bool = field.value.kind == 2 || field.value.kind == 6;
        return CheckResultTokenStateV1 {
            ..scalar,
            inventory_identity: select(kind_supported, field.value, invalid_span()),
            test_inventory_valid: scalar.test_inventory_valid && kind_supported
        };
    }
    if context == 12 && tag == 1 {
        let kind_supported: bool = field.value.kind == 2 || field.value.kind == 6;
        return CheckResultTokenStateV1 {
            ..scalar,
            family_run_identity: select(kind_supported, field.value, invalid_span()),
            experiment_valid: scalar.experiment_valid && kind_supported
        };
    }
    return scalar;
}

fn token_close_container(
    state: CheckResultTokenStateV1,
    frame_index: u64,
    document: json_order.JsonTokenDocumentV1,
    token_end: u64
) -> (result: CheckResultTokenStateV1) {
    if frame_index >= 12 || state.value_count >= 512 {
        return CheckResultTokenStateV1 { ..state, valid: false };
    }
    let context: byte = state.contexts[frame_index];
    let closed: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state,
        contexts: replace(state.contexts, frame_index, 0),
        value_count: state.value_count +% 1
    };
    if context == 5 { return token_row_finish(closed, document); }
    if context == 9 {
        let span_valid: bool = state.selection_span.found
            && token_end >= state.selection_span.start;
        return CheckResultTokenStateV1 {
            ..closed,
            selection_span: TokenValueSpanV1 {
                ..state.selection_span,
                length: select(span_valid, token_end -% state.selection_span.start, 0)
            },
            selection_valid: state.selection_valid && span_valid
        };
    }
    return closed;
}

fn process_cursor_token(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: CheckResultTokenStateV1) {
    let token: json_cursor.Cursor = state.cursor;
    if !token.token_event { return state; }
    if token.token_kind == 1 { return mark_token_key(state, document, token); }
    if token.token_kind == 2 || (token.token_kind >= 3 && token.token_kind <= 6) {
        return token_store_scalar(state, document, token);
    }
    if token.token_kind == 7 || token.token_kind == 8 {
        return token_open_container(state, token);
    }
    if token.token_kind == 9 || token.token_kind == 10 {
        return token_close_container(
            state, token.token_depth as u64, document, token.token_end
        );
    }
    return state;
}


fn empty_token_capture(
    cursor: json_cursor.Cursor,
    string_had_escape: bool
) -> (result: TokenCaptureStateV1) {
    let empty: TokenEventV1 = TokenEventV1 {
        kind: 0, event: 0, start: 0, end: 0, depth: 0, has_escape: false
    };
    return TokenCaptureStateV1 {
        cursor: cursor,
        events: [empty; 64],
        string_had_escape: string_had_escape,
        count: 0
    };
}

fn capture_cursor_event_with_escape(
    state: TokenCaptureStateV1,
    has_escape: bool
) -> (result: TokenCaptureStateV1) {
    if !state.cursor.token_event || state.count >= 64 { return state; }
    let event: TokenEventV1 = TokenEventV1 {
        kind: state.cursor.token_kind,
        event: state.cursor.event,
        start: state.cursor.token_start,
        end: state.cursor.token_end,
        depth: state.cursor.token_depth,
        has_escape: has_escape
    };
    return TokenCaptureStateV1 {
        ..state,
        events: replace(state.events, state.count, event),
        count: state.count +% 1
    };
}

fn capture_cursor_event(state: TokenCaptureStateV1) -> (result: TokenCaptureStateV1) {
    return capture_cursor_event_with_escape(state, false);
}

fn capture_cursor_byte(
    state: TokenCaptureStateV1,
    value: byte
) -> (result: TokenCaptureStateV1) {
    let next_cursor: json_cursor.Cursor = json_cursor.feed_byte(state.cursor, value);
    let advanced: TokenCaptureStateV1 = TokenCaptureStateV1 {
        ..state, cursor: next_cursor
    };
    if next_cursor.token_event { return capture_cursor_event(advanced); }
    return advanced;
}

fn skip_string_byte(
    state: StringSkipStateV1,
    chunk: json_order.JsonTokenInputChunkV1,
    chunk_base: u64,
    index: u64
) -> (result: StringSkipStateV1) {
    if state.closed || index >= chunk.length { return state; }
    let value: byte = chunk.bytes[index];
    let position: u64 = chunk_base +% index +% 1;
    if state.cursor.escaped {
        return StringSkipStateV1 {
            cursor: json_cursor.Cursor {
                ..state.cursor,
                escaped: false,
                event: 0,
                token_event: false,
                position: position
            },
            closed: false,
            had_escape: state.had_escape
        };
    }
    if value == 92 {
        return StringSkipStateV1 {
            cursor: json_cursor.Cursor {
                ..state.cursor,
                escaped: true,
                event: 0,
                token_event: false,
                position: position
            },
            closed: false,
            had_escape: true
        };
    }
    if value == 34 {
        let is_key: bool = state.cursor.string_is_key;
        let closed: json_cursor.Cursor = json_cursor.Cursor {
            ..state.cursor,
            in_string: false,
            expect_key: false,
            escaped: false,
            unicode_remaining: 0,
            pending_high_surrogate: false,
            utf8_remaining: 0,
            utf8_lead: 0,
            event: select(is_key, 2, 4),
            string_end: position -% 1,
            string_length: 0,
            pending_key: is_key,
            position: position,
            token_event: true,
            token_kind: select(is_key, 1, 2),
            token_end: position
        };
        return StringSkipStateV1 {
            cursor: closed, closed: true, had_escape: state.had_escape
        };
    }
    return StringSkipStateV1 {
        cursor: json_cursor.Cursor {
            ..state.cursor,
            event: 0,
            token_event: false,
            position: position
        },
        closed: false,
        had_escape: state.had_escape
    };
}

fn skip_string_block_step(
    state: StringSkipStateV1,
    chunk: json_order.JsonTokenInputChunkV1,
    chunk_base: u64,
    block_start: u64,
    block_end: u64,
    start: u64,
    index: u64
) -> (result: StringSkipStateV1) {
    let local: u64 = block_start +% index;
    if local < start || local >= block_end { return state; }
    return skip_string_byte(state, chunk, chunk_base, local);
}

fn skip_string_block(
    capture: TokenCaptureStateV1,
    chunk: json_order.JsonTokenInputChunkV1,
    chunk_base: u64,
    block_start: u64,
    block_end: u64,
    start: u64
) -> (result: TokenCaptureStateV1) {
    let initial: StringSkipStateV1 = StringSkipStateV1 {
        cursor: json_cursor.Cursor { ..capture.cursor, event: 0, token_event: false },
        closed: false,
        had_escape: capture.string_had_escape
    };
    iterate i up_to 64 carrying skipped: StringSkipStateV1 = initial {
        next skipped = skip_string_block_step(
            skipped, chunk, chunk_base, block_start, block_end, start, i
        );
    }
    let scanned: TokenCaptureStateV1 = TokenCaptureStateV1 {
        ..capture,
        cursor: skipped.cursor,
        string_had_escape: select(skipped.closed, false, skipped.had_escape)
    };
    if scanned.cursor.token_event {
        return capture_cursor_event_with_escape(scanned, skipped.had_escape);
    }
    return scanned;
}

fn capture_token_block_step(
    state: TokenCaptureStateV1,
    chunk: json_order.JsonTokenInputChunkV1,
    chunk_base: u64,
    block_start: u64,
    block_end: u64,
    index: u64
) -> (result: TokenCaptureStateV1) {
    let local: u64 = block_start +% index;
    if local >= block_end { return state; }
    let cursor_local: u64 = state.cursor.position -% chunk_base;
    if local < cursor_local { return state; }
    if state.cursor.in_string {
        return skip_string_block(
            state, chunk, chunk_base, block_start, block_end, local
        );
    }
    return capture_cursor_byte(state, chunk.bytes[local]);
}

fn capture_token_block(
    cursor: json_cursor.Cursor,
    string_had_escape: bool,
    chunk: json_order.JsonTokenInputChunkV1,
    chunk_base: u64,
    block_start: u64
) -> (result: TokenCaptureStateV1) {
    let candidate_end: u64 = block_start +% 64;
    let block_end: u64 = select(candidate_end < chunk.length, candidate_end, chunk.length);
    let initial: TokenCaptureStateV1 = empty_token_capture(cursor, string_had_escape);
    if block_start >= block_end { return initial; }
    iterate i up_to 64 carrying captured: TokenCaptureStateV1 = initial {
        next captured = capture_token_block_step(
            captured, chunk, chunk_base, block_start, block_end, i
        );
    }
    return captured;
}

fn close_number_parent(
    state: CheckResultTokenStateV1,
    token: json_cursor.Cursor,
    document: json_order.JsonTokenDocumentV1
) -> (result: CheckResultTokenStateV1) {
    if token.token_kind != 3 || (token.event != 7 && token.event != 8) {
        return state;
    }
    if token.token_depth == 0 { return CheckResultTokenStateV1 { ..state, valid: false }; }
    return token_close_container(
        state, (token.token_depth as u64) -% 1, document, token.token_end
    );
}

fn is_failure_message_token(
    state: CheckResultTokenStateV1,
    token: json_cursor.Cursor
) -> (result: bool) {
    if token.token_kind != 2 || token.token_depth == 0 || token.token_depth > 12 {
        return false;
    }
    let frame_index: u64 = (token.token_depth as u64) -% 1;
    return state.contexts[frame_index] == 6
        && state.pending_tags[frame_index] == 1;
}

fn token_cursor_event(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1,
    has_escape: bool
) -> (result: CheckResultTokenStateV1) {
    let token: json_cursor.Cursor = state.cursor;
    let is_message: bool = is_failure_message_token(state, token);
    let processed: CheckResultTokenStateV1 = process_cursor_token(state, document);
    if is_message {
        let tracked: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
            ..processed, failure_message_has_escape: has_escape
        };
        return close_number_parent(tracked, token, document);
    }
    return close_number_parent(processed, token, document);
}

fn process_captured_event(
    state: CheckResultTokenStateV1,
    event: TokenEventV1,
    document: json_order.JsonTokenDocumentV1,
    final_cursor: json_cursor.Cursor
) -> (result: CheckResultTokenStateV1) {
    let token_cursor: json_cursor.Cursor = json_cursor.Cursor {
        ..final_cursor,
        event: event.event,
        token_event: true,
        token_kind: event.kind,
        token_start: event.start,
        token_end: event.end,
        token_depth: event.depth
    };
    let token_state: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state, cursor: token_cursor
    };
    let processed: CheckResultTokenStateV1 = token_cursor_event(
        token_state, document, event.has_escape
    );
    return CheckResultTokenStateV1 { ..processed, cursor: final_cursor };
}

fn consume_token_events_step(
    state: CheckResultTokenStateV1,
    captured: TokenCaptureStateV1,
    document: json_order.JsonTokenDocumentV1,
    index: u64
) -> (result: CheckResultTokenStateV1) {
    if index >= captured.count { return state; }
    return process_captured_event(
        state, captured.events[index], document, captured.cursor
    );
}

fn consume_token_events(
    state: CheckResultTokenStateV1,
    captured: TokenCaptureStateV1,
    document: json_order.JsonTokenDocumentV1,
    final_cursor: json_cursor.Cursor
) -> (result: CheckResultTokenStateV1) {
    if captured.count == 0 { return CheckResultTokenStateV1 { ..state, cursor: final_cursor }; }
    iterate i up_to 64 carrying processed: CheckResultTokenStateV1 = state {
        next processed = consume_token_events_step(processed, captured, document, i);
    }
    return CheckResultTokenStateV1 { ..processed, cursor: final_cursor };
}

fn token_scan_block(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1,
    chunk: json_order.JsonTokenInputChunkV1,
    chunk_base: u64,
    block_start: u64
) -> (result: CheckResultTokenStateV1) {
    let captured: TokenCaptureStateV1 = capture_token_block(
        state.cursor, state.scanner_string_has_escape, chunk, chunk_base, block_start
    );
    let scanned: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state,
        cursor: captured.cursor,
        scanner_string_has_escape: captured.string_had_escape,
        valid: state.valid && captured.cursor.valid
    };
    return consume_token_events(
        scanned, captured, document, captured.cursor
    );
}

fn token_scan_chunk(
    state: CheckResultTokenStateV1,
    document: json_order.JsonTokenDocumentV1,
    chunk: json_order.JsonTokenInputChunkV1
) -> (result: CheckResultTokenStateV1) {
    let chunk_base: u64 = state.cursor.position;
    iterate block up_to 16 carrying current: CheckResultTokenStateV1 = state {
        next current = token_scan_block(
            current, document, chunk, chunk_base, block *% 64
        );
    }
    return current;
}

fn token_scan_document(document: json_order.JsonTokenDocumentV1) -> (result: CheckResultTokenStateV1) {
    iterate i over document.chunks carrying state: CheckResultTokenStateV1 = empty_token_state() {
        next state = token_scan_chunk(state, document, document.chunks[i]);
    }
    let finished: json_cursor.Cursor = json_cursor.finish(state.cursor);
    let with_finish: CheckResultTokenStateV1 = CheckResultTokenStateV1 {
        ..state, cursor: finished, valid: state.valid && finished.valid
    };
    if finished.token_event { return token_cursor_event(with_finish, document, false); }
    return with_finish;
}

fn checked_token_scan(
    document: json_order.JsonTokenDocumentV1,
    request_valid: bool,
    syntax_valid: bool
) -> (result: CheckResultTokenStateV1) {
    if request_valid && syntax_valid { return token_scan_document(document); }
    return CheckResultTokenStateV1 { ..empty_token_state(), valid: false };
}

fn extract_token_result(
    document: json_order.JsonTokenDocumentV1,
    state: CheckResultTokenStateV1,
    metadata: CheckResultJsonNativeRequestV1
) -> (result: ExtractedTestResultV1) {
    let id_text: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.id.found, value: state.id }, false
    );
    let provider: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.provider.found, value: state.provider }, false
    );
    let verdict: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.verdict.found, value: state.verdict }, false
    );
    let classification: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.classification.found, value: state.classification }, false
    );
    let failure_class: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.failure_class.found, value: state.failure_class }, false
    );
    let manifest: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.manifest.found, value: state.manifest }, true
    );
    let source_sha: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.source_sha256.found, value: state.source_sha256 }, true
    );
    let run_id: TextValueV1 = decode_text_value(
        document, FieldLookupV1 { found: state.run_id.found, value: state.run_id }, true
    );
    let failure_message: MessageProjectionV1 = decode_failure_message(
        document,
        FieldLookupV1 { found: state.failure_message.found, value: state.failure_message },
        state.failure_message_has_escape
    );
    let tests: TestRowsV1 = materialize_token_rows(state.tests);
    let source_id: [byte; up_to 1024] = widen_text_1024(id_text.bytes, id_text.length);
    let check_id: [byte; up_to 1024] = select(metadata.check_id.len > 0, metadata.check_id, source_id);
    let message_chunks: [[byte; up_to 1024]; up_to 256] =
        failure_message.chunks[0..failure_message.count];
    let request: check_result.CheckResultProjectionRequestV1 = check_result.CheckResultProjectionRequestV1 {
        schema_version: check_result.request_schema(),
        id: check_id,
        provider: widen_text_256(provider.bytes, provider.length),
        verdict: widen_text_16(verdict.bytes, verdict.length),
        scope_manifest: widen_text_1024(manifest.bytes, manifest.length),
        scope_manifest_present: manifest.present,
        claim: metadata.claim,
        classification: widen_text_128(classification.bytes, classification.length),
        failure_class: widen_text_128(failure_class.bytes, failure_class.length),
        result_digest: metadata.result_digest,
        source_sha256: widen_text_64(source_sha.bytes, source_sha.length),
        summary: state.summary,
        failure_message_present: state.failure_is_object && failure_message.present,
        failure_message_count: failure_message.count,
        failure_message_chunks: message_chunks,
        run_id: widen_text_512(run_id.bytes, run_id.length),
        test_count: tests.count,
        tests: tests.rows[0..tests.count]
    };
    let supported: bool = state.valid && json_cursor.is_valid(state.cursor) && state.root_is_object
        && (metadata.check_id.len > 0 || (state.id_seen && id_text.valid && id_text.length <= 1024))
        && state.provider_seen && provider.valid
        && state.verdict_seen && verdict.valid
        && state.classification_seen && classification.valid
        && state.failure_class_seen && failure_class.valid
        && state.scope_valid && manifest.valid
        && state.summary_valid && state.tests_valid && state.tests.valid
        && failure_message.valid && source_sha.valid && run_id.valid
        && provider.length <= 256 && verdict.length <= 16
        && classification.length <= 128 && failure_class.length <= 128
        && manifest.length <= 1024 && source_sha.length <= 64
        && run_id.length <= 512
        && check_result.valid_request(request);
    return ExtractedTestResultV1 { supported: supported, request: request };
}

fn test_result_schema_matches(value: TextValueV1) -> (result: bool) {
    let expected: [byte; up_to 64] = [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 114, 101, 115, 117, 108, 116, 47, 49];
    if !value.valid || value.length != expected.len { return false; }
    iterate i over expected carrying matches: bool = true {
        next matches = matches && value.bytes[i] == expected[i];
    }
    return matches;
}

fn check_result_schema_matches(value: TextValueV1) -> (result: bool) {
    let expected: [byte; up_to 64] = [109, 110, 99, 115, 46, 99, 104, 101, 99, 107, 45, 114, 101, 115, 117, 108, 116, 47, 49];
    if !value.valid || value.length != expected.len { return false; }
    iterate i over expected carrying matches: bool = true {
        next matches = matches && value.bytes[i] == expected[i];
    }
    return matches;
}

fn identity_compare_step(
    order: byte,
    left: [byte; up_to 512],
    right: [byte; up_to 512],
    common_length: u64,
    index: u64
) -> (result: byte) {
    if order != 0 || index >= common_length { return order; }
    if left[index] < right[index] { return 1; }
    if left[index] > right[index] { return 3; }
    return 0;
}

fn identity_compare(left: [byte; up_to 512], right: [byte; up_to 512]) -> (result: byte) {
    let common_length: u64 = select(left.len < right.len, left.len, right.len);
    iterate i up_to 512 carrying order: byte = 0 {
        next order = identity_compare_step(order, left, right, common_length, i);
    }
    if order != 0 { return order; }
    if left.len < right.len { return 1; }
    if left.len > right.len { return 3; }
    return 2;
}

fn identity_minimum_step(
    state: IdentityMinimumV1,
    index: u64,
    count: u64
) -> (result: IdentityMinimumV1) {
    if index >= count || index <= state.minimum_index { return state; }
    let current: [byte; up_to 512] = state.identities[index];
    let minimum: [byte; up_to 512] = state.identities[state.minimum_index];
    if identity_compare(current, minimum) == 1 {
        return IdentityMinimumV1 { ..state, minimum_index: index };
    }
    return state;
}

fn identity_sort_step(
    identities: [[byte; up_to 512]; 256],
    count: u64,
    index: u64
) -> (result: [[byte; up_to 512]; 256]) {
    if index >= count { return identities; }
    let initial: IdentityMinimumV1 = IdentityMinimumV1 {
        identities: identities, minimum_index: index
    };
    iterate scan_index up_to 256 carrying minimum: IdentityMinimumV1 = initial {
        next minimum = identity_minimum_step(minimum, scan_index, count);
    }
    if minimum.minimum_index == index { return identities; }
    let selected: [byte; up_to 512] = identities[index];
    let smallest: [byte; up_to 512] = identities[minimum.minimum_index];
    let with_smallest: [[byte; up_to 512]; 256] = replace(identities, index, smallest);
    return replace(with_smallest, minimum.minimum_index, selected);
}

fn sort_selected_identities(
    identities: [[byte; up_to 512]; 256],
    count: u64
) -> (result: [[byte; up_to 512]; 256]) {
    iterate index up_to 256 carrying sorted: [[byte; up_to 512]; 256] = identities {
        next sorted = identity_sort_step(sorted, count, index);
    }
    return sorted;
}

fn selected_identities_match_expected(
    selected: [[byte; up_to 512]; 256],
    selected_count: u64,
    expected: [[byte; up_to 512]; up_to 256]
) -> (result: bool) {
    if selected_count != expected.len { return false; }
    let sorted: [[byte; up_to 512]; 256] = sort_selected_identities(
        selected, selected_count
    );
    iterate i over expected carrying matches: bool = true {
        next matches = matches && identity_compare(sorted[i], expected[i]) == 2;
    }
    return matches;
}

fn inventory_identity_matches_expected(
    value: TextValueV1,
    expected: [byte; up_to 64]
) -> (result: bool) {
    if !value.valid || value.length != expected.len { return false; }
    iterate i over expected carrying matches: bool = true {
        next matches = matches && value.bytes[i] == expected[i];
    }
    return matches;
}

fn verdict_matches_test_result(
    check_verdict: TextValueV1,
    test_verdict: [byte; up_to 16]
) -> (result: bool) {
    if !check_verdict.valid || check_verdict.length > 16
        || check_verdict.length != test_verdict.len {
        return false;
    }
    iterate i over test_verdict carrying matches: bool = true {
        next matches = matches && check_verdict.bytes[i] == test_verdict[i];
    }
    return matches;
}

fn extract_family_metadata(
    document: json_order.JsonTokenDocumentV1,
    state: CheckResultTokenStateV1,
    request: CheckResultJsonNativeRequestV1
) -> (result: FamilyResultMetadataV1) {
    let schema_value: TextValueV1 = decode_text_value(
        document,
        FieldLookupV1 { found: state.test_result_schema_seen, value: state.test_result_schema },
        false
    );
    let verdict_value: TextValueV1 = decode_text_value(
        document,
        FieldLookupV1 { found: state.verdict_seen, value: state.verdict },
        false
    );
    let inventory_value: TextValueV1 = decode_text_value(
        document,
        FieldLookupV1 { found: state.inventory_identity_seen, value: state.inventory_identity },
        true
    );
    let run_identity_value: TextValueV1 = decode_text_value(
        document,
        FieldLookupV1 { found: state.run_identity_seen, value: state.family_run_identity },
        true
    );
    let inventory_is_null: bool = state.inventory_identity_seen
        && state.inventory_identity.kind == 6;
    let run_identity_is_null: bool = state.run_identity_seen
        && state.family_run_identity.kind == 6;
    let inventory_value_valid: bool = !state.inventory_identity_seen
        || inventory_is_null
        || (inventory_value.valid && inventory_value.length <= 64);
    let run_identity_value_valid: bool = !state.run_identity_seen
        || run_identity_is_null
        || (run_identity_value.valid && run_identity_value.length <= 512);
    let selection_span_valid: bool = !state.selection_seen
        || (state.selection_span.found && state.selection_span.kind == 7
            && state.selection_span.length > 0);
    let selection_comparison_supported: bool = request.selection_expectation_present
        && state.selected_test_identities_valid
        && state.selected_test_identity_count <= 256;
    let selection_matches_expected: bool = selection_comparison_supported
        && selected_identities_match_expected(
            state.selected_test_identities,
            state.selected_test_identity_count,
            request.expected_test_identities
        );
    let inventory_comparison_supported: bool = request.inventory_expectation_present
        && inventory_value_valid;
    let inventory_matches_expected: bool = inventory_comparison_supported
        && state.inventory_identity_seen && !inventory_is_null
        && inventory_identity_matches_expected(
            inventory_value, request.expected_inventory_identity
        );
    let supported: bool = state.valid && json_cursor.is_valid(state.cursor)
        && state.root_is_object && state.verdict_seen && verdict_value.valid
        && verdict_value.length <= 16 && state.selection_valid
        && state.selected_test_identities_valid && state.selected_test_identity_count <= 256
        && selection_span_valid
        && (!state.test_inventory_seen || state.test_inventory_valid)
        && (!state.experiment_seen || state.experiment_valid)
        && inventory_value_valid && run_identity_value_valid;
    return FamilyResultMetadataV1 {
        supported: supported,
        test_result_schema_valid: test_result_schema_matches(schema_value),
        verdict: widen_text_16(verdict_value.bytes, verdict_value.length),
        selected_test_identities: state.selected_test_identities[0..state.selected_test_identity_count],
        selection_present: state.selection_seen,
        selection_start: state.selection_span.start,
        selection_length: state.selection_span.length,
        selection_comparison_supported: selection_comparison_supported,
        selection_matches_expected: selection_matches_expected,
        inventory_identity_present: state.inventory_identity_seen,
        inventory_identity_null: inventory_is_null,
        inventory_identity: widen_text_64(inventory_value.bytes, inventory_value.length),
        inventory_comparison_supported: inventory_comparison_supported,
        inventory_matches_expected: inventory_matches_expected,
        run_identity_present: state.run_identity_seen,
        run_identity_null: run_identity_is_null,
        run_identity: widen_text_512(run_identity_value.bytes, run_identity_value.length)
    };
}

fn empty_check_artifact_metadata() -> (result: CheckArtifactMetadataV1) {
    return CheckArtifactMetadataV1 {
        supported: false,
        schema_valid: false,
        verdict_valid: false,
        verdict: [],
        verdict_comparison_supported: false,
        verdict_matches_test_result: false
    };
}

fn inspect_check_artifact(
    request: CheckResultJsonNativeRequestV1,
    family_metadata: FamilyResultMetadataV1
) -> (result: CheckArtifactMetadataV1) {
    if !request.check_document_present { return empty_check_artifact_metadata(); }
    let order_request: json_order.JsonOrderRequestV1 = json_order.JsonOrderRequestV1 {
        schema_version: json_order.request_schema_v1(),
        document: request.check_document,
        input_sha256: request.check_input_sha256
    };
    let shape: json_order.DocumentShapeV1 = json_order.document_shape(request.check_document);
    let transport_valid: bool = json_order.valid_order_request(order_request, shape);
    let scanned: json.ScanState = json_order.scan_document(request.check_document);
    let syntax_valid: bool = json.is_valid(scanned);
    let tokenized: CheckResultTokenStateV1 = checked_token_scan(
        request.check_document, transport_valid, syntax_valid
    );
    let supported: bool = transport_valid && syntax_valid && tokenized.valid
        && json_cursor.is_valid(tokenized.cursor);
    let schema_value: TextValueV1 = decode_text_value(
        request.check_document,
        FieldLookupV1 {
            found: tokenized.test_result_schema_seen,
            value: tokenized.test_result_schema
        },
        false
    );
    let verdict_value: TextValueV1 = decode_text_value(
        request.check_document,
        FieldLookupV1 { found: tokenized.verdict_seen, value: tokenized.verdict },
        false
    );
    let verdict_comparison_supported: bool = supported && family_metadata.supported;
    return CheckArtifactMetadataV1 {
        supported: supported,
        schema_valid: supported && tokenized.root_is_object
            && check_result_schema_matches(schema_value),
        verdict_valid: supported && tokenized.root_is_object
            && verdict_value.valid && verdict_value.length <= 16,
        verdict: widen_text_16(verdict_value.bytes, verdict_value.length),
        verdict_comparison_supported: verdict_comparison_supported,
        verdict_matches_test_result: verdict_comparison_supported
            && verdict_matches_test_result(verdict_value, family_metadata.verdict)
    };
}

fn first_public_unresolved(
    projection: check_result.CheckResultProjectionV1
) -> (result: [byte; up_to 1024]) {
    if projection.unresolved_chunks.len > 0 {
        return projection.unresolved_chunks[0];
    }
    return [];
}

fn public_check_result_document(
    projection: check_result.CheckResultProjectionV1
) -> (result: CheckResultPublicDocumentV1) {
    let empty_unresolved: [[byte; up_to 1024]; up_to 1] = [];
    let first_unresolved: [byte; up_to 1024] = first_public_unresolved(projection);
    let one_unresolved: [[byte; up_to 1024]; up_to 1] = select(
        projection.unresolved_present && projection.unresolved_chunks.len == 1,
        [first_unresolved],
        empty_unresolved
    );
    return CheckResultPublicDocumentV1 {
        schema_version: projection.result_schema_version,
        id: projection.id,
        provider: projection.provider,
        verdict: projection.verdict,
        scope: projection.scope,
        claim: projection.claim,
        summary: projection.summary,
        contract_revision: projection.contract_revision,
        producer_revision: projection.producer_revision,
        digest: projection.digest,
        unresolved: one_unresolved,
        references: projection.references,
        result_ref: projection.result_ref,
        classification: projection.classification,
        failure_class: projection.failure_class
    };
}

fn publish_public_check_result_document(
    context: ApplicationContext,
    document: CheckResultPublicDocumentV1,
    eligible: bool
) -> (result: u64)
    capability test_artifact
    effect structured_write authorized_by test_artifact
{
    if !eligible || context.argv_count < 3 { return 0; }
    return structured_write(context.argv[2], document.schema_version, document);
}

fn json_result(
    supported: bool,
    projection_document_supported: bool,
    projection: check_result.CheckResultProjectionV1,
    family_metadata: FamilyResultMetadataV1,
    check_artifact: CheckArtifactMetadataV1
) -> (result: CheckResultJsonNativeResultV1) {
    return CheckResultJsonNativeResultV1 {
        schema_version: result_schema(),
        supported: supported,
        projection_document_supported: projection_document_supported,
        projection: projection,
        family_metadata: family_metadata,
        check_artifact: check_artifact
    };
}

fn check_result_json_native_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 67, 104, 101, 99, 107, 82, 101, 115, 117, 108, 116, 32, 74, 83, 79, 78, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: CheckResultJsonNativeRequestV1 = structured_read(context.argv[0], request_schema());
    let order_request: json_order.JsonOrderRequestV1 = json_order.JsonOrderRequestV1 {
        schema_version: json_order.request_schema_v1(),
        document: request.document,
        input_sha256: request.input_sha256
    };
    let shape: json_order.DocumentShapeV1 = json_order.document_shape(request.document);
    let transport_valid: bool = json_order.valid_order_request(order_request, shape);
    // Keep json.v1's independent syntax pass before cursor token extraction;
    // the streaming cursor supplies spans and events, not full JSON syntax.
    let scanned: json.ScanState = json_order.scan_document(request.document);
    let syntax_valid: bool = json.is_valid(scanned);
    let tokenized: CheckResultTokenStateV1 = checked_token_scan(
        request.document, transport_valid, syntax_valid
    );
    let extracted: ExtractedTestResultV1 = extract_token_result(
        request.document, tokenized, request
    );
    let family_metadata: FamilyResultMetadataV1 = extract_family_metadata(
        request.document, tokenized, request
    );
    let check_artifact: CheckArtifactMetadataV1 = inspect_check_artifact(
        request, family_metadata
    );
    let supported: bool = transport_valid && syntax_valid && extracted.supported;
    let selected_request: check_result.CheckResultProjectionRequestV1 = select(
        supported, extracted.request, empty_projection_request(request)
    );
    let projection: check_result.CheckResultProjectionV1 = check_result.build_result(
        selected_request
    );
    let public_projection: CheckResultPublicDocumentV1 = public_check_result_document(
        projection
    );
    let projection_document_eligible: bool = request.projection_document_only
        && context.argv_count >= 3 && supported && family_metadata.supported
        && (!projection.unresolved_present || projection.unresolved_chunks.len == 1);
    let public_projection_published: u64 = publish_public_check_result_document(
        context, public_projection, projection_document_eligible
    );
    let projection_document_supported: bool = projection_document_eligible
        && public_projection_published > 0;
    let response_projection: check_result.CheckResultProjectionV1 = select(
        request.projection_document_only && projection_document_supported,
        check_result.build_result(empty_projection_request(request)),
        projection
    );
    let output: CheckResultJsonNativeResultV1 = json_result(
        supported, projection_document_supported, response_projection,
        family_metadata, check_artifact
    );
    let published: u64 = structured_write(context.argv[1], result_schema(), output);
    if published == 0 {
        return failure([67, 104, 101, 99, 107, 82, 101, 115, 117, 108, 116, 32, 74, 83, 79, 78, 32, 112, 114, 111, 106, 101, 99, 116, 105, 111, 110, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
