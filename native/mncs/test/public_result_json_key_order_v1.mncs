mncs 0.18;

// Canonicalize compact public-result JSON without a host-built value tree.
// Input and output stay within sixty-four UTF-8-safe 1 KiB chunks. JSON values are
// represented as bounded recursive MNCS variants; small objects use ordered
// insertion, while larger bounded objects use bottom-up merge sorting on close.
module mncs.test.public_result_json_key_order_v1;

use mncs.std.application.v1;
use mncs.std.json.v1 as json;
use mncs.std.sha256.v1 as sha256;

record JsonTokenInputChunkV1 {
    bytes: [byte; up_to 1024],
    length: u64
}

record JsonEscapedSourceStateV1 { writer: JsonOrderWriterV1, base: u64 }

record JsonTokenDocumentV1 {
    chunks: [JsonTokenInputChunkV1; up_to 64],
    byte_length: u64
}

record DocumentShapeV1 { total: u64, valid: bool }

record KeyV1 {
    raw_start: u64,
    raw_length: u64,
    ordered: [byte; up_to 256],
    ordered_length: u64,
    ordered_prefix: u64,
    json_escaped: bool,
    valid: bool
}

enum JsonValueV1 {
    Empty,
    Null,
    Boolean { value: bool },
    Integer { negative: bool, magnitude: u64 },
    Raw { start: u64, length: u64 },
    String { start: u64, length: u64 },
    Utf8String { start: u64, length: u64 },
    Array { items: JsonValueV1 },
    Object { fields: JsonValueV1 },
    ArrayNil,
    ArrayCons { head: JsonValueV1, tail: JsonValueV1 },
    ObjectNil,
    ObjectCons { key: KeyV1, value: JsonValueV1, tail: JsonValueV1 }
}

// Python transports the public result as a bounded typed value tape. String
// bytes are packed once into a UTF-8 document; nodes carry spans instead of
// rebuilding compact JSON in the host and asking MNCS to parse it again.
record PublicValueNodeV1 {
    kind: byte,
    has_key: bool,
    key_start: u64,
    key_length: u64,
    text_start: u64,
    text_length: u64,
    magnitude: u64,
    negative: bool,
    child_count: u64,
    valid: bool
}

record PublicValueRequestV1 {
    schema_version: [byte; up_to 64],
    text: JsonTokenDocumentV1,
    node_tape: [JsonTokenInputChunkV1; up_to 64],
    node_count: u64
}

record PublicValueHexResultV1 { value: u64, next_offset: u64, valid: bool }
record PublicValueHexScanStateV1 {
    value: u64,
    position: u64,
    digits: u64,
    done: bool,
    valid: bool
}
record PublicValueKeySpanResultV1 {
    start: u64,
    length: u64,
    next_offset: u64,
    valid: bool
}
record PublicValuePayloadResultV1 {
    text_start: u64,
    text_length: u64,
    magnitude: u64,
    child_count: u64,
    next_offset: u64,
    valid: bool
}
record PublicValueNodeReadResultV1 {
    node: PublicValueNodeV1,
    next_offset: u64
}
record PublicValueKeyCopyV1 { bytes: [byte; 256], ordered_prefix: u64, valid: bool }
record PublicValueNumberBytesV1 { bytes: [byte; 64], valid: bool }
record PublicValueTapeShapeStateV1 { total: u64, valid: bool }

record PublicValueBuildResultV1 {
    value: JsonValueV1,
    next_node: u64,
    writer_steps: u64,
    valid: bool
}

record PublicValueInputResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    node_count: u64,
    document_length: u64,
    chunk_count: u64,
    output_sha256: [byte; up_to 64],
    chunks: [JsonOrderChunkV1; up_to 64]
}

record FrameV1 {
    kind: byte,
    items: JsonValueV1,
    source_start: u64,
    pending_key: KeyV1,
    last_source_key: KeyV1,
    has_pending_key: bool,
    contains_object: bool,
    compact: bool,
    child_count: u64,
    merge_sort_needed: bool,
    source_order: byte,
    writer_steps: u64,
    expect: byte
}

record PublicValueBuildFrameV1 {
    node_kind: byte,
    remaining: u64,
    child_key: KeyV1,
    items: JsonValueV1,
    child_count: u64,
    writer_steps: u64
}

record PublicValueBuildStateV1 {
    frames: [PublicValueBuildFrameV1; 12],
    depth: u64,
    root: JsonValueV1,
    root_writer_steps: u64,
    has_root: bool,
    valid: bool
}

record PublicValueTapeCursorV1 {
    build: PublicValueBuildStateV1,
    offset: u64,
    remaining_nodes: u64
}

record ContainerValueV1 { value: JsonValueV1, writer_steps: u64, valid: bool }
record ObjectSortResultV1 { fields: JsonValueV1, valid: bool }
record ObjectReverseStateV1 {
    remaining: JsonValueV1,
    reversed: JsonValueV1,
    count: u64,
    index: u64,
    valid: bool
}
record ObjectMergeStateV1 {
    source_count: u64,
    width: u64,
    remaining: JsonValueV1,
    remaining_count: u64,
    left: JsonValueV1,
    left_count: u64,
    right: JsonValueV1,
    right_count: u64,
    right_total: u64,
    pair_count: u64,
    run_remaining: u64,
    output: JsonValueV1,
    output_count: u64,
    valid: bool
}
record ObjectMergeSortStateV1 {
    fields: JsonValueV1,
    count: u64,
    width: u64,
    valid: bool
}

record ParseStateV1 {
    frames: [FrameV1; 12],
    depth: u64,
    span_compact_arrays: bool,
    root: JsonValueV1,
    root_writer_steps: u64,
    has_root: bool,
    string_start: u64,
    in_string: bool,
    string_escape: bool,
    string_is_key: bool,
    scalar_start: u64,
    scalar_active: bool,
    value_count: u64,
    valid: bool
}

record DecodeStateV1 {
    bytes: [byte; 512],
    length: u64,
    escaped: bool,
    skip: u64,
    valid: bool
}
record KeyCopyV1 { bytes: [byte; 256], length: u64, ordered_prefix: u64 }
record JsonDecodedStringV1 { bytes: [byte; up_to 512], length: u64, valid: bool }

record LocatedByteV1 { base: u64, value: byte }

enum KeyOrderV1 { Before, Equal, After }

record JsonOrderRequestV1 {
    schema_version: [byte; up_to 64],
    document: JsonTokenDocumentV1,
    input_sha256: [byte; up_to 64]
}

record JsonOrderChunkV1 { bytes: [byte; 1024], length: u64 }

enum JsonOrderChunkListV1 {
    ChunkNil,
    ChunkCons { head: JsonOrderChunkV1, tail: JsonOrderChunkListV1 }
}

record JsonOrderWriterV1 {
    current_bytes: [byte; 1024],
    current_length: u64,
    completed: JsonOrderChunkListV1,
    completed_count: u64,
    length: u64,
    ok: bool
}

record JsonDigestWriterV1 {
    digest: sha256.DigestState,
    bytes: [byte; 64],
    length: u64,
    ok: bool
}

record IntegerDigitBufferV1 {
    bytes: [byte; 20],
    length: u64,
    remaining: u64
}

record WriterSourceStateV1 { writer: JsonOrderWriterV1, base: u64 }

record ArrayReverseStateV1 { remaining: JsonValueV1, reversed: JsonValueV1 }

enum JsonWriteTaskV1 {
    Empty,
    Value { value: JsonValueV1 },
    ArrayNext { remaining: JsonValueV1, first: bool },
    ObjectNext { remaining: JsonValueV1, first: bool }
}

enum JsonPrettyWriteTaskV1 {
    Empty,
    Value { value: JsonValueV1, indent: u64 },
    ArrayNext { remaining: JsonValueV1, first: bool, indent: u64 },
    ObjectNext { remaining: JsonValueV1, first: bool, indent: u64 }
}

record JsonWriteStateV1 {
    tasks: [JsonWriteTaskV1; 16],
    depth: u64,
    writer: JsonOrderWriterV1
}

record JsonPrettyWriteStateV1 {
    tasks: [JsonPrettyWriteTaskV1; 16],
    depth: u64,
    writer: JsonOrderWriterV1
}

record JsonOrderChunkBuilderV1 {
    chunks: [JsonOrderChunkV1; 64],
    count: u64
}

record JsonOrderResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    input_sha256: [byte; up_to 64],
    document_length: u64,
    chunk_count: u64,
    chunks: [JsonOrderChunkV1; up_to 64]
}

fn request_schema_v1() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 107, 101, 121, 45, 111, 114, 100, 101, 114, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn result_schema_v1() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 107, 101, 121, 45, 111, 114, 100, 101, 114, 47, 49];
}

fn public_value_request_schema_v1() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 118, 97, 108, 117, 101, 45, 105, 110, 112, 117, 116, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn public_value_result_schema_v1() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 118, 97, 108, 117, 101, 45, 105, 110, 112, 117, 116, 47, 51];
}

fn same_bytes(left: [byte; up_to 64], right: [byte; up_to 64]) -> (result: bool) {
    if left.len != right.len { return false; }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn document_shape(document: JsonTokenDocumentV1) -> (result: DocumentShapeV1) {
    let initial: DocumentShapeV1 = DocumentShapeV1 { total: 0, valid: true };
    iterate i over document.chunks carrying shape: DocumentShapeV1 = initial {
        let chunk: JsonTokenInputChunkV1 = document.chunks[i];
        let valid_chunk: bool = chunk.length > 0 && chunk.length <= 1024
            && chunk.length == chunk.bytes.len && shape.total +% chunk.length <= 65536;
        next shape = DocumentShapeV1 {
            total: shape.total +% chunk.length,
            valid: shape.valid && valid_chunk
        };
    }
    return DocumentShapeV1 {
        total: shape.total,
        valid: shape.valid && document.chunks.len > 0 && document.chunks.len <= 64
            && document.byte_length == shape.total && document.byte_length <= 65536
    };
}

fn document_offset_step(total: u64, chunk: JsonTokenInputChunkV1, index: u64, target: u64) -> (result: u64) {
    if index < target { return total +% chunk.length; }
    return total;
}

fn document_offset_at(document: JsonTokenDocumentV1, chunk_index: u64, chunk_offset: u64) -> (result: u64) {
    iterate i over document.chunks carrying total: u64 = 0 {
        next total = document_offset_step(total, document.chunks[i], i, chunk_index);
    }
    if chunk_index >= document.chunks.len { return total; }
    return total +% chunk_offset;
}

fn json_space(value: byte) -> (result: bool) {
    return value == 9 || value == 10 || value == 13 || value == 32;
}

fn scalar_boundary(value: byte) -> (result: bool) {
    return json_space(value) || value == 34 || value == 123 || value == 125
        || value == 91 || value == 93 || value == 44 || value == 58;
}

fn hex_value(value: byte) -> (result: u64) {
    let number: u64 = value as u64;
    if number >= 48 && number <= 57 { return number -% 48; }
    if number >= 65 && number <= 70 { return number -% 55; }
    return number -% 87;
}

fn decode_hex4(document: JsonTokenDocumentV1, start: u64, index: u64) -> (result: u64) {
    let a: u64 = hex_value(located_byte(document, start +% index));
    let b: u64 = hex_value(located_byte(document, start +% index +% 1));
    let c: u64 = hex_value(located_byte(document, start +% index +% 2));
    let d: u64 = hex_value(located_byte(document, start +% index +% 3));
    return a *% 4096 +% b *% 256 +% c *% 16 +% d;
}

fn decoded_byte(state: DecodeStateV1, value: byte) -> (result: DecodeStateV1) {
    if !state.valid || state.length >= 512 {
        return DecodeStateV1 { ..state, valid: false };
    }
    return DecodeStateV1 {
        ..state,
        bytes: replace(state.bytes, state.length, value),
        length: state.length +% 1
    };
}

fn decoded_codepoint(state: DecodeStateV1, value: u64) -> (result: DecodeStateV1) {
    if value <= 127 { return decoded_byte(state, value as byte); }
    if value <= 2047 {
        let first: DecodeStateV1 = decoded_byte(state, (192 +% (value / 64)) as byte);
        return decoded_byte(first, (128 +% (value % 64)) as byte);
    }
    if value <= 65535 && !(value >= 55296 && value <= 57343) {
        let first: DecodeStateV1 = decoded_byte(state, (224 +% (value / 4096)) as byte);
        let second: DecodeStateV1 = decoded_byte(first, (128 +% ((value / 64) % 64)) as byte);
        return decoded_byte(second, (128 +% (value % 64)) as byte);
    }
    if value <= 1114111 {
        let first: DecodeStateV1 = decoded_byte(state, (240 +% (value / 262144)) as byte);
        let second: DecodeStateV1 = decoded_byte(first, (128 +% ((value / 4096) % 64)) as byte);
        let third: DecodeStateV1 = decoded_byte(second, (128 +% ((value / 64) % 64)) as byte);
        return decoded_byte(third, (128 +% (value % 64)) as byte);
    }
    return DecodeStateV1 { ..state, valid: false };
}

fn decode_key_step(
    state: DecodeStateV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: DecodeStateV1) {
    if index >= length { return state; }
    let value: byte = located_byte(document, start +% index);
    if state.skip > 0 {
        return DecodeStateV1 { ..state, skip: state.skip -% 1 };
    }
    if state.escaped {
        if value == 117 {
            if index +% 4 >= length {
                return DecodeStateV1 { ..state, valid: false, escaped: false };
            }
            let code: u64 = decode_hex4(document, start, index +% 1);
            if code >= 55296 && code <= 56319 {
                if index +% 10 >= length
                    || located_byte(document, start +% index +% 5) != 92
                    || located_byte(document, start +% index +% 6) != 117 {
                    return DecodeStateV1 { ..state, valid: false, escaped: false };
                }
                let low: u64 = decode_hex4(document, start, index +% 7);
                if low < 56320 || low > 57343 {
                    return DecodeStateV1 { ..state, valid: false, escaped: false };
                }
                let point: u64 = 65536 +% (code -% 55296) *% 1024 +% (low -% 56320);
                return DecodeStateV1 {
                    ..decoded_codepoint(state, point),
                    escaped: false,
                    skip: 10
                };
            }
            if code >= 56320 && code <= 57343 {
                return DecodeStateV1 { ..state, valid: false, escaped: false };
            }
            return DecodeStateV1 {
                ..decoded_codepoint(state, code),
                escaped: false,
                skip: 4
            };
        }
        if value == 34 || value == 92 || value == 47 {
            return DecodeStateV1 { ..decoded_byte(state, value), escaped: false };
        }
        if value == 98 { return DecodeStateV1 { ..decoded_byte(state, 8), escaped: false }; }
        if value == 102 { return DecodeStateV1 { ..decoded_byte(state, 12), escaped: false }; }
        if value == 110 { return DecodeStateV1 { ..decoded_byte(state, 10), escaped: false }; }
        if value == 114 { return DecodeStateV1 { ..decoded_byte(state, 13), escaped: false }; }
        if value == 116 { return DecodeStateV1 { ..decoded_byte(state, 9), escaped: false }; }
        return DecodeStateV1 { ..state, valid: false, escaped: false };
    }
    if value == 92 { return DecodeStateV1 { ..state, escaped: true }; }
    return decoded_byte(state, value);
}

fn copy_decoded_key_byte(state: KeyCopyV1, decoded: DecodeStateV1, index: u64) -> (result: KeyCopyV1) {
    if index >= 256 { return state; }
    let prefix_byte: byte = select(index < decoded.length, decoded.bytes[index], 0);
    let ordered_prefix: u64 = select(
        index < 8,
        state.ordered_prefix *% 256 +% (prefix_byte as u64),
        state.ordered_prefix
    );
    if index >= decoded.length {
        return KeyCopyV1 { ..state, ordered_prefix: ordered_prefix };
    }
    return KeyCopyV1 {
        ..state,
        bytes: replace(state.bytes, state.length, decoded.bytes[index]),
        length: state.length +% 1,
        ordered_prefix: ordered_prefix
    };
}

fn decode_short_key(
    document: JsonTokenDocumentV1, raw_start: u64, raw_length: u64
) -> (result: DecodeStateV1) {
    let initial: DecodeStateV1 = DecodeStateV1 {
        bytes: [0; 512], length: 0, escaped: false, skip: 0, valid: true
    };
    iterate i up_to 16 carrying decoded: DecodeStateV1 = initial {
        next decoded = decode_key_step(decoded, document, raw_start, raw_length, i);
    }
    return decoded;
}

fn copy_short_decoded_key(decoded: DecodeStateV1) -> (result: KeyCopyV1) {
    let initial: KeyCopyV1 = KeyCopyV1 {
        bytes: [0; 256], length: 0, ordered_prefix: 0
    };
    iterate i up_to 16 carrying copied: KeyCopyV1 = initial {
        next copied = copy_decoded_key_byte(copied, decoded, i);
    }
    return copied;
}

fn compare_key_step(order: i64, left: KeyV1, right: KeyV1, index: u64, common: u64) -> (result: i64) {
    if index >= common || order != 0 { return order; }
    if left.ordered[index] < right.ordered[index] { return -1; }
    if left.ordered[index] > right.ordered[index] { return 1; }
    return order;
}

fn decode_key(document: JsonTokenDocumentV1, raw_start: u64, raw_length: u64) -> (result: KeyV1) {
    if raw_length <= 16 {
        let decoded_short: DecodeStateV1 = decode_short_key(document, raw_start, raw_length);
        let key_bytes_short: KeyCopyV1 = copy_short_decoded_key(decoded_short);
        return KeyV1 {
            raw_start: raw_start,
            raw_length: raw_length,
            ordered: key_bytes_short.bytes[0..key_bytes_short.length],
            ordered_length: decoded_short.length,
            ordered_prefix: key_bytes_short.ordered_prefix,
            json_escaped: true,
            valid: decoded_short.valid && !decoded_short.escaped
                && decoded_short.skip == 0 && key_bytes_short.length == decoded_short.length
        };
    }
    let initial: DecodeStateV1 = DecodeStateV1 {
        bytes: [0; 512], length: 0, escaped: false, skip: 0, valid: true
    };
    iterate i up_to 256 carrying decoded: DecodeStateV1 = initial {
        next decoded = decode_key_step(decoded, document, raw_start, raw_length, i);
    }
    let key_initial: KeyCopyV1 = KeyCopyV1 {
        bytes: [0; 256], length: 0, ordered_prefix: 0
    };
    iterate i up_to 256 carrying key_bytes: KeyCopyV1 = key_initial {
        next key_bytes = copy_decoded_key_byte(key_bytes, decoded, i);
    }
    return KeyV1 {
        raw_start: raw_start,
        raw_length: raw_length,
        ordered: key_bytes.bytes[0..key_bytes.length],
        ordered_length: decoded.length,
        ordered_prefix: key_bytes.ordered_prefix,
        json_escaped: true,
        valid: raw_length <= 256 && decoded.valid && !decoded.escaped
            && decoded.skip == 0 && key_bytes.length == decoded.length
    };
}

fn decode_string(document: JsonTokenDocumentV1, raw_start: u64, raw_length: u64) -> (result: JsonDecodedStringV1) {
    let initial: DecodeStateV1 = DecodeStateV1 {
        bytes: [0; 512], length: 0, escaped: false, skip: 0, valid: true
    };
    iterate i up_to 512 carrying decoded: DecodeStateV1 = initial {
        next decoded = decode_key_step(decoded, document, raw_start, raw_length, i);
    }
    return JsonDecodedStringV1 {
        bytes: decoded.bytes[0..decoded.length],
        length: decoded.length,
        valid: raw_length <= 512 && decoded.valid && !decoded.escaped && decoded.skip == 0
    };
}

fn compare_key(left: KeyV1, right: KeyV1) -> (result: KeyOrderV1) {
    if left.ordered_prefix < right.ordered_prefix { return KeyOrderV1.Before; }
    if left.ordered_prefix > right.ordered_prefix { return KeyOrderV1.After; }
    let common: u64 = select(left.ordered_length < right.ordered_length, left.ordered_length, right.ordered_length);
    let tail_start: u64 = select(common < 8, common, 8);
    let shared: [byte; up_to 256] = left.ordered[tail_start..common];
    iterate i over shared carrying order: i64 = 0 {
        next order = compare_key_step(order, left, right, tail_start +% i, common);
    }
    if order < 0 { return KeyOrderV1.Before; }
    if order > 0 { return KeyOrderV1.After; }
    if left.ordered_length < right.ordered_length { return KeyOrderV1.Before; }
    if left.ordered_length > right.ordered_length { return KeyOrderV1.After; }
    return KeyOrderV1.Equal;
}

fn wrap_inserted_field(key: KeyV1, value: JsonValueV1, tail: JsonValueV1) -> (result: JsonValueV1) {
    if is_empty_value(tail) { return JsonValueV1.Empty; }
    return JsonValueV1.ObjectCons { key: key, value: value, tail: tail };
}

fn insert_field(fields: JsonValueV1, key: KeyV1, value: JsonValueV1) -> (result: JsonValueV1) {
    return match fields {
        ObjectNil => JsonValueV1.ObjectCons { key: key, value: value, tail: JsonValueV1.ObjectNil },
        ObjectCons { key: current_key, value: current_value, tail: tail } => match compare_key(key, current_key) {
            Before => JsonValueV1.ObjectCons { key: key, value: value, tail: fields },
            Equal => JsonValueV1.Empty,
            After => wrap_inserted_field(current_key, current_value, insert_field(tail, key, value))
        },
        Empty => JsonValueV1.Empty,
        Null => JsonValueV1.Empty,
        Raw { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        String { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        Boolean { value: flag } => JsonValueV1.Empty,
        Integer { negative: negative, magnitude: magnitude } => JsonValueV1.Empty,
        Utf8String { start: start, length: length } => JsonValueV1.Empty,
        Array { items: items } => JsonValueV1.Empty,
        Object { fields: nested } => JsonValueV1.Empty,
        ArrayNil => JsonValueV1.Empty,
        ArrayCons { head: head, tail: tail } => JsonValueV1.Empty
    };
}

fn append_object_field(fields: JsonValueV1, key: KeyV1, value: JsonValueV1) -> (result: JsonValueV1) {
    return JsonValueV1.ObjectCons { key: key, value: value, tail: fields };
}

fn append_object_field_by_mode(
    fields: JsonValueV1, key: KeyV1, value: JsonValueV1,
    use_merge_sort: bool, prior_count: u64, reverse_prefix: bool
) -> (result: JsonValueV1) {
    if use_merge_sort && prior_count == 32 && reverse_prefix {
        let reversed: ObjectReverseStateV1 = reverse_object_fields(fields, prior_count);
        if !reversed.valid || reversed.index != prior_count { return JsonValueV1.Empty; }
        return append_object_field(reversed.reversed, key, value);
    }
    if use_merge_sort { return append_object_field(fields, key, value); }
    return insert_field(fields, key, value);
}

fn object_field_tail(fields: JsonValueV1) -> (result: JsonValueV1) {
    return match fields {
        ObjectCons { key: key, value: value, tail: tail } => tail,
        ObjectNil => JsonValueV1.ObjectNil,
        Empty => JsonValueV1.Empty,
        Null => JsonValueV1.Empty,
        Raw { start: start, length: length } => JsonValueV1.Empty,
        String { start: start, length: length } => JsonValueV1.Empty,
        Boolean { value: flag } => JsonValueV1.Empty,
        Integer { negative: negative, magnitude: magnitude } => JsonValueV1.Empty,
        Utf8String { start: start, length: length } => JsonValueV1.Empty,
        Array { items: items } => JsonValueV1.Empty,
        Object { fields: nested } => JsonValueV1.Empty,
        ArrayNil => JsonValueV1.Empty,
        ArrayCons { head: head, tail: tail } => JsonValueV1.Empty
    };
}

fn advance_object_fields_2(fields: JsonValueV1) -> (result: JsonValueV1) {
    return object_field_tail(object_field_tail(fields));
}

fn advance_object_fields_4(fields: JsonValueV1) -> (result: JsonValueV1) {
    return advance_object_fields_2(advance_object_fields_2(fields));
}

fn advance_object_fields_8(fields: JsonValueV1) -> (result: JsonValueV1) {
    return advance_object_fields_4(advance_object_fields_4(fields));
}

fn advance_object_fields_16(fields: JsonValueV1) -> (result: JsonValueV1) {
    return advance_object_fields_8(advance_object_fields_8(fields));
}

fn advance_object_fields_32(fields: JsonValueV1) -> (result: JsonValueV1) {
    return advance_object_fields_16(advance_object_fields_16(fields));
}

fn advance_object_fields_64(fields: JsonValueV1) -> (result: JsonValueV1) {
    return advance_object_fields_32(advance_object_fields_32(fields));
}

fn advance_object_fields_128(fields: JsonValueV1) -> (result: JsonValueV1) {
    return advance_object_fields_64(advance_object_fields_64(fields));
}

fn advance_object_fields_by_width(fields: JsonValueV1, width: u64) -> (result: JsonValueV1) {
    if width == 1 { return object_field_tail(fields); }
    if width == 2 { return advance_object_fields_2(fields); }
    if width == 4 { return advance_object_fields_4(fields); }
    if width == 8 { return advance_object_fields_8(fields); }
    if width == 16 { return advance_object_fields_16(fields); }
    if width == 32 { return advance_object_fields_32(fields); }
    if width == 64 { return advance_object_fields_64(fields); }
    if width == 128 { return advance_object_fields_128(fields); }
    if width == 256 {
        return advance_object_fields_128(advance_object_fields_128(fields));
    }
    if width == 512 {
        let halfway: JsonValueV1 = advance_object_fields_128(
            advance_object_fields_128(fields)
        );
        return advance_object_fields_128(
            advance_object_fields_128(halfway)
        );
    }
    return JsonValueV1.Empty;
}

fn reverse_object_field_step(state: ObjectReverseStateV1) -> (result: ObjectReverseStateV1) {
    if !state.valid || state.index >= state.count { return state; }
    return match state.remaining {
        ObjectCons { key: key, value: value, tail: tail } => ObjectReverseStateV1 {
            ..state,
            remaining: tail,
            reversed: JsonValueV1.ObjectCons {
                key: key, value: value, tail: state.reversed
            },
            index: state.index +% 1
        },
        ObjectNil => ObjectReverseStateV1 { ..state, valid: false },
        Empty => ObjectReverseStateV1 { ..state, valid: false },
        Null => ObjectReverseStateV1 { ..state, valid: false },
        Raw { start: start, length: length } => ObjectReverseStateV1 { ..state, valid: false },
        String { start: start, length: length } => ObjectReverseStateV1 { ..state, valid: false },
        Boolean { value: flag } => ObjectReverseStateV1 { ..state, valid: false },
        Integer { negative: negative, magnitude: magnitude } => ObjectReverseStateV1 { ..state, valid: false },
        Utf8String { start: start, length: length } => ObjectReverseStateV1 { ..state, valid: false },
        Array { items: items } => ObjectReverseStateV1 { ..state, valid: false },
        Object { fields: fields } => ObjectReverseStateV1 { ..state, valid: false },
        ArrayNil => ObjectReverseStateV1 { ..state, valid: false },
        ArrayCons { head: head, tail: tail } => ObjectReverseStateV1 { ..state, valid: false }
    };
}

fn reverse_object_fields(fields: JsonValueV1, count: u64) -> (result: ObjectReverseStateV1) {
    let initial: ObjectReverseStateV1 = ObjectReverseStateV1 {
        remaining: fields,
        reversed: JsonValueV1.ObjectNil,
        count: count,
        index: 0,
        valid: count <= 642
    };
    iterate i up_to 642 carrying reversed: ObjectReverseStateV1 = initial {
        next reversed = reverse_object_field_step(reversed);
    }
    return reversed;
}

fn begin_object_merge_run(state: ObjectMergeStateV1) -> (result: ObjectMergeStateV1) {
    if !state.valid || state.remaining_count == 0 { return state; }
    let left_count: u64 = select(state.width < state.remaining_count, state.width, state.remaining_count);
    let right_start: JsonValueV1 = advance_object_fields_by_width(state.remaining, state.width);
    let after_left: u64 = state.remaining_count -% left_count;
    let right_count: u64 = select(state.width < after_left, state.width, after_left);
    return ObjectMergeStateV1 {
        ..state,
        left: state.remaining,
        left_count: left_count,
        right: right_start,
        right_count: right_count,
        right_total: right_count,
        pair_count: left_count +% right_count,
        run_remaining: left_count +% right_count
    };
}

fn advance_object_merge_run(state: ObjectMergeStateV1) -> (result: ObjectMergeStateV1) {
    if state.right_total == 0 {
        return ObjectMergeStateV1 {
            ..state,
            remaining: state.left,
            remaining_count: state.remaining_count -% state.pair_count,
            left: JsonValueV1.ObjectNil,
            left_count: 0,
            right: JsonValueV1.ObjectNil,
            right_count: 0,
            right_total: 0,
            pair_count: 0,
            run_remaining: 0
        };
    }
    return ObjectMergeStateV1 {
        ..state,
        remaining: state.right,
        remaining_count: state.remaining_count -% state.pair_count,
        left: JsonValueV1.ObjectNil,
        left_count: 0,
        right: JsonValueV1.ObjectNil,
        right_count: 0,
        right_total: 0,
        pair_count: 0,
        run_remaining: 0
    };
}

fn take_object_merge_left(state: ObjectMergeStateV1) -> (result: ObjectMergeStateV1) {
    return match state.left {
        ObjectCons { key: key, value: value, tail: tail } => ObjectMergeStateV1 {
            ..state,
            left: tail,
            left_count: state.left_count -% 1,
            run_remaining: state.run_remaining -% 1,
            output: JsonValueV1.ObjectCons { key: key, value: value, tail: state.output },
            output_count: state.output_count +% 1
        },
        ObjectNil => ObjectMergeStateV1 { ..state, valid: false },
        Empty => ObjectMergeStateV1 { ..state, valid: false },
        Null => ObjectMergeStateV1 { ..state, valid: false },
        Raw { start: start, length: length } => ObjectMergeStateV1 { ..state, valid: false },
        String { start: start, length: length } => ObjectMergeStateV1 { ..state, valid: false },
        Boolean { value: flag } => ObjectMergeStateV1 { ..state, valid: false },
        Integer { negative: negative, magnitude: magnitude } => ObjectMergeStateV1 { ..state, valid: false },
        Utf8String { start: start, length: length } => ObjectMergeStateV1 { ..state, valid: false },
        Array { items: items } => ObjectMergeStateV1 { ..state, valid: false },
        Object { fields: fields } => ObjectMergeStateV1 { ..state, valid: false },
        ArrayNil => ObjectMergeStateV1 { ..state, valid: false },
        ArrayCons { head: head, tail: tail } => ObjectMergeStateV1 { ..state, valid: false }
    };
}

fn take_object_merge_right(state: ObjectMergeStateV1) -> (result: ObjectMergeStateV1) {
    return match state.right {
        ObjectCons { key: key, value: value, tail: tail } => ObjectMergeStateV1 {
            ..state,
            right: tail,
            right_count: state.right_count -% 1,
            run_remaining: state.run_remaining -% 1,
            output: JsonValueV1.ObjectCons { key: key, value: value, tail: state.output },
            output_count: state.output_count +% 1
        },
        ObjectNil => ObjectMergeStateV1 { ..state, valid: false },
        Empty => ObjectMergeStateV1 { ..state, valid: false },
        Null => ObjectMergeStateV1 { ..state, valid: false },
        Raw { start: start, length: length } => ObjectMergeStateV1 { ..state, valid: false },
        String { start: start, length: length } => ObjectMergeStateV1 { ..state, valid: false },
        Boolean { value: flag } => ObjectMergeStateV1 { ..state, valid: false },
        Integer { negative: negative, magnitude: magnitude } => ObjectMergeStateV1 { ..state, valid: false },
        Utf8String { start: start, length: length } => ObjectMergeStateV1 { ..state, valid: false },
        Array { items: items } => ObjectMergeStateV1 { ..state, valid: false },
        Object { fields: fields } => ObjectMergeStateV1 { ..state, valid: false },
        ArrayNil => ObjectMergeStateV1 { ..state, valid: false },
        ArrayCons { head: head, tail: tail } => ObjectMergeStateV1 { ..state, valid: false }
    };
}

fn object_merge_compared(
    active: ObjectMergeStateV1, left_key: KeyV1, right_key: KeyV1
) -> (result: ObjectMergeStateV1) {
    return match compare_key(left_key, right_key) {
        Before => take_object_merge_left(active),
        Equal => ObjectMergeStateV1 { ..active, valid: false },
        After => take_object_merge_right(active)
    };
}

fn object_merge_item_active(active: ObjectMergeStateV1) -> (result: ObjectMergeStateV1) {
    if !active.valid { return active; }
    if active.left_count == 0 { return take_object_merge_right(active); }
    if active.right_count == 0 { return take_object_merge_left(active); }
    return match active.left {
        ObjectCons { key: left_key, value: left_value, tail: left_tail } => match active.right {
            ObjectCons { key: right_key, value: right_value, tail: right_tail } =>
                match compare_key(left_key, right_key) {
                    Before => ObjectMergeStateV1 {
                        ..active,
                        left: left_tail,
                        left_count: active.left_count -% 1,
                        run_remaining: active.run_remaining -% 1,
                        output: JsonValueV1.ObjectCons {
                            key: left_key, value: left_value, tail: active.output
                        },
                        output_count: active.output_count +% 1
                    },
                    Equal => ObjectMergeStateV1 { ..active, valid: false },
                    After => ObjectMergeStateV1 {
                        ..active,
                        right: right_tail,
                        right_count: active.right_count -% 1,
                        run_remaining: active.run_remaining -% 1,
                        output: JsonValueV1.ObjectCons {
                            key: right_key, value: right_value, tail: active.output
                        },
                        output_count: active.output_count +% 1
                    }
                },
            ObjectNil => ObjectMergeStateV1 { ..active, valid: false },
            Empty => ObjectMergeStateV1 { ..active, valid: false },
            Null => ObjectMergeStateV1 { ..active, valid: false },
            Raw { start: start, length: length } => ObjectMergeStateV1 { ..active, valid: false },
            String { start: start, length: length } => ObjectMergeStateV1 { ..active, valid: false },
            Boolean { value: flag } => ObjectMergeStateV1 { ..active, valid: false },
            Integer { negative: negative, magnitude: magnitude } => ObjectMergeStateV1 { ..active, valid: false },
            Utf8String { start: start, length: length } => ObjectMergeStateV1 { ..active, valid: false },
            Array { items: items } => ObjectMergeStateV1 { ..active, valid: false },
            Object { fields: fields } => ObjectMergeStateV1 { ..active, valid: false },
            ArrayNil => ObjectMergeStateV1 { ..active, valid: false },
            ArrayCons { head: head, tail: tail } => ObjectMergeStateV1 { ..active, valid: false }
        },
        ObjectNil => ObjectMergeStateV1 { ..active, valid: false },
        Empty => ObjectMergeStateV1 { ..active, valid: false },
        Null => ObjectMergeStateV1 { ..active, valid: false },
        Raw { start: start, length: length } => ObjectMergeStateV1 { ..active, valid: false },
        String { start: start, length: length } => ObjectMergeStateV1 { ..active, valid: false },
        Boolean { value: flag } => ObjectMergeStateV1 { ..active, valid: false },
        Integer { negative: negative, magnitude: magnitude } => ObjectMergeStateV1 { ..active, valid: false },
        Utf8String { start: start, length: length } => ObjectMergeStateV1 { ..active, valid: false },
        Array { items: items } => ObjectMergeStateV1 { ..active, valid: false },
        Object { fields: fields } => ObjectMergeStateV1 { ..active, valid: false },
        ArrayNil => ObjectMergeStateV1 { ..active, valid: false },
        ArrayCons { head: head, tail: tail } => ObjectMergeStateV1 { ..active, valid: false }
    };
}

fn object_merge_item_step(state: ObjectMergeStateV1) -> (result: ObjectMergeStateV1) {
    if !state.valid || state.output_count >= state.source_count { return state; }
    if state.run_remaining == 0 {
        let next_run: ObjectMergeStateV1 = advance_object_merge_run(state);
        return object_merge_item_active(begin_object_merge_run(next_run));
    }
    return object_merge_item_active(state);
}

fn merge_object_fields_pass(fields: JsonValueV1, count: u64, width: u64) -> (result: ObjectSortResultV1) {
    let initial: ObjectMergeStateV1 = ObjectMergeStateV1 {
        source_count: count,
        width: width,
        remaining: fields,
        remaining_count: count,
        left: JsonValueV1.ObjectNil,
        left_count: 0,
        right: JsonValueV1.ObjectNil,
        right_count: 0,
        right_total: 0,
        pair_count: 0,
        run_remaining: 0,
        output: JsonValueV1.ObjectNil,
        output_count: 0,
        valid: count <= 642
    };
    let first_run: ObjectMergeStateV1 = begin_object_merge_run(initial);
    iterate i up_to 642 carrying merged: ObjectMergeStateV1 = first_run {
        next merged = object_merge_item_step(merged);
    }
    if !merged.valid || merged.output_count != count {
        return ObjectSortResultV1 { fields: JsonValueV1.Empty, valid: false };
    }
    let restored: ObjectReverseStateV1 = reverse_object_fields(merged.output, count);
    return ObjectSortResultV1 {
        fields: restored.reversed,
        valid: restored.valid && restored.index == count
    };
}

fn object_merge_sort_step(sorted: ObjectMergeSortStateV1) -> (result: ObjectMergeSortStateV1) {
    if !sorted.valid || sorted.width >= sorted.count { return sorted; }
    let merged: ObjectSortResultV1 = merge_object_fields_pass(
        sorted.fields, sorted.count, sorted.width
    );
    return ObjectMergeSortStateV1 {
        fields: merged.fields,
        count: sorted.count,
        width: sorted.width *% 2,
        valid: merged.valid
    };
}

fn sort_object_fields_merge(fields: JsonValueV1, count: u64) -> (result: ObjectSortResultV1) {
    let initial: ObjectMergeSortStateV1 = ObjectMergeSortStateV1 {
        fields: fields,
        count: count,
        width: 1,
        valid: count <= 642
    };
    iterate pass up_to 10 carrying sorted: ObjectMergeSortStateV1 = initial {
        next sorted = object_merge_sort_step(sorted);
    }
    return ObjectSortResultV1 {
        fields: sorted.fields,
        valid: sorted.valid && sorted.width >= sorted.count
    };
}

fn sort_object_fields_at_close(frame: FrameV1) -> (result: ObjectSortResultV1) {
    if frame.merge_sort_needed && frame.source_order == 1 {
        let reversed: ObjectReverseStateV1 = reverse_object_fields(
            frame.items, frame.child_count
        );
        return ObjectSortResultV1 {
            fields: reversed.reversed,
            valid: reversed.valid && reversed.index == frame.child_count
        };
    }
    if frame.merge_sort_needed && frame.source_order == 2 {
        return ObjectSortResultV1 { fields: frame.items, valid: true };
    }
    if frame.merge_sort_needed {
        return sort_object_fields_merge(frame.items, frame.child_count);
    }
    return ObjectSortResultV1 { fields: frame.items, valid: true };
}

fn prepend_array(items: JsonValueV1, value: JsonValueV1) -> (result: JsonValueV1) {
    return match items {
        ArrayNil => JsonValueV1.ArrayCons { head: value, tail: JsonValueV1.ArrayNil },
        ArrayCons { head: head, tail: tail } => JsonValueV1.ArrayCons { head: value, tail: items },
        Empty => JsonValueV1.Empty,
        Null => JsonValueV1.Empty,
        Raw { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        String { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        Boolean { value: flag } => JsonValueV1.Empty,
        Integer { negative: negative, magnitude: magnitude } => JsonValueV1.Empty,
        Utf8String { start: start, length: length } => JsonValueV1.Empty,
        Array { items: nested } => JsonValueV1.Empty,
        Object { fields: nested } => JsonValueV1.Empty,
        ObjectNil => JsonValueV1.Empty,
        ObjectCons { key: key, value: inner, tail: tail } => JsonValueV1.Empty
    };
}

fn reverse_array_step(state: ArrayReverseStateV1) -> (result: ArrayReverseStateV1) {
    return match state.remaining {
        ArrayNil => state,
        ArrayCons { head: head, tail: tail } => ArrayReverseStateV1 {
            remaining: tail,
            reversed: JsonValueV1.ArrayCons { head: head, tail: state.reversed }
        },
        Empty => state,
        Null => state,
        Raw { start: raw_start, length: raw_length } => state,
        String { start: raw_start, length: raw_length } => state,
        Boolean { value: flag } => state,
        Integer { negative: negative, magnitude: magnitude } => state,
        Utf8String { start: start, length: length } => state,
        Array { items: nested } => state,
        Object { fields: nested } => state,
        ObjectNil => state,
        ObjectCons { key: key, value: inner, tail: rest } => state
    };
}

fn reverse_array(items: JsonValueV1, accumulated: JsonValueV1) -> (result: JsonValueV1) {
    let initial: ArrayReverseStateV1 = ArrayReverseStateV1 {
        remaining: items,
        reversed: accumulated
    };
    iterate i up_to 1024 carrying reversed: ArrayReverseStateV1 = initial {
        next reversed = reverse_array_step(reversed);
    }
    return reversed.reversed;
}

fn empty_key() -> (result: KeyV1) {
    return KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: [0; 0],
        ordered_length: 0,
        ordered_prefix: 0,
        json_escaped: false,
        valid: true
    };
}

fn key_prefix_step(prefix: u64, name: [byte; up_to 256], index: u64) -> (result: u64) {
    if index < name.len { return prefix *% 256 +% (name[index] as u64); }
    return prefix *% 256;
}

fn key_from_bytes(name: [byte; up_to 256]) -> (result: KeyV1) {
    iterate i up_to 8 carrying prefix: u64 = 0 {
        next prefix = key_prefix_step(prefix, name, i);
    }
    return KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: name,
        ordered_length: name.len,
        ordered_prefix: prefix,
        json_escaped: false,
        valid: true
    };
}

fn is_empty_value(value: JsonValueV1) -> (result: bool) {
    return match value {
        Empty => true,
        Null => false,
        Raw { start: raw_start, length: raw_length } => false,
        String { start: raw_start, length: raw_length } => false,
        Boolean { value: flag } => false,
        Integer { negative: negative, magnitude: magnitude } => false,
        Utf8String { start: start, length: length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn empty_frame(kind: byte) -> (result: FrameV1) {
    return FrameV1 {
        kind: kind,
        items: select(kind == 1, JsonValueV1.ObjectNil, JsonValueV1.ArrayNil),
        source_start: 0,
        pending_key: empty_key(),
        last_source_key: empty_key(),
        has_pending_key: false,
        contains_object: false,
        compact: true,
        child_count: 0,
        merge_sort_needed: false,
        source_order: 0,
        writer_steps: 0,
        expect: select(kind == 1, 1, 5)
    };
}

fn locate_byte_step(found: LocatedByteV1, chunk: JsonTokenInputChunkV1, position: u64) -> (result: LocatedByteV1) {
    let local: u64 = position -% found.base;
    if position >= found.base && local < chunk.length {
        return LocatedByteV1 { base: found.base +% chunk.length, value: chunk.bytes[local] };
    }
    return LocatedByteV1 { ..found, base: found.base +% chunk.length };
}

fn located_byte(document: JsonTokenDocumentV1, position: u64) -> (result: byte) {
    let initial: LocatedByteV1 = LocatedByteV1 { base: 0, value: 0 };
    iterate i over document.chunks carrying found: LocatedByteV1 = initial {
        next found = locate_byte_step(found, document.chunks[i], position);
    }
    return found.value;
}

fn append_value(
    state: ParseStateV1,
    value: JsonValueV1,
    writer_steps: u64
) -> (result: ParseStateV1) {
    if !state.valid || state.value_count >= 1024 { return ParseStateV1 { ..state, valid: false }; }
    if state.depth == 0 {
        if state.has_root { return ParseStateV1 { ..state, valid: false }; }
        return ParseStateV1 {
            ..state,
            root: value,
            root_writer_steps: writer_steps,
            has_root: true,
            value_count: state.value_count +% 1
        };
    }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    if frame.kind == 2 && frame.expect == 5 {
        let prepended: JsonValueV1 = prepend_array(frame.items, value);
        let updated_frame: FrameV1 = FrameV1 {
            ..frame,
            items: prepended,
            child_count: frame.child_count +% 1,
            writer_steps: frame.writer_steps +% writer_steps +% 1,
            expect: 6
        };
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, updated_frame),
            value_count: state.value_count +% 1,
            valid: !is_empty_value(prepended)
        };
    }
    if frame.kind == 1 && frame.expect == 3 && frame.has_pending_key && frame.child_count < 642 {
        let use_merge_sort: bool = frame.merge_sort_needed || frame.child_count >= 32;
        let inserted: JsonValueV1 = append_object_field_by_mode(
            frame.items, frame.pending_key, value, use_merge_sort, frame.child_count,
            frame.source_order == 1
        );
        let updated_frame: FrameV1 = FrameV1 {
            ..frame,
            items: inserted,
            pending_key: empty_key(),
            has_pending_key: false,
            child_count: frame.child_count +% 1,
            merge_sort_needed: use_merge_sort,
            writer_steps: frame.writer_steps +% writer_steps +% 1,
            expect: 4
        };
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, updated_frame),
            value_count: state.value_count +% 1,
            valid: !is_empty_value(inserted)
        };
    }
    return ParseStateV1 { ..state, valid: false };
}

fn finalize_scalar(state: ParseStateV1, position: u64) -> (result: ParseStateV1) {
    if !state.scalar_active { return state; }
    if position <= state.scalar_start {
        return ParseStateV1 { ..state, scalar_active: false, valid: false };
    }
    let appended: ParseStateV1 = append_value(
        ParseStateV1 { ..state, scalar_active: false },
        JsonValueV1.Raw { start: state.scalar_start, length: position -% state.scalar_start },
        1
    );
    return appended;
}

fn maybe_finalize_scalar(state: ParseStateV1, position: u64, boundary: bool) -> (result: ParseStateV1) {
    if boundary { return finalize_scalar(state, position); }
    return state;
}

fn container_value(
    frame: FrameV1, end_position: u64, span_compact_arrays: bool
) -> (result: ContainerValueV1) {
    if frame.kind == 1 {
        let ordered: ObjectSortResultV1 = sort_object_fields_at_close(frame);
        if !ordered.valid { return ContainerValueV1 {
            value: JsonValueV1.Empty,
            writer_steps: frame.writer_steps +% 2,
            valid: false
        }; }
        return ContainerValueV1 {
            value: JsonValueV1.Object { fields: ordered.fields },
            writer_steps: frame.writer_steps +% 2,
            valid: true
        };
    }
    if span_compact_arrays && !frame.contains_object && frame.compact {
        return ContainerValueV1 {
            value: JsonValueV1.Raw {
                start: frame.source_start,
                length: end_position -% frame.source_start +% 1
            },
            writer_steps: 1,
            valid: true
        };
    }
    return ContainerValueV1 {
        value: JsonValueV1.Array { items: reverse_array(frame.items, JsonValueV1.ArrayNil) },
        writer_steps: frame.writer_steps +% 2,
        valid: true
    };
}

fn parse_chunk_step(parsed: ParseStateV1, document: JsonTokenDocumentV1, base: u64, chunk: JsonTokenInputChunkV1, index: u64) -> (result: ParseStateV1) {
    if index < chunk.length {
        return parse_step(parsed, document, base +% index, chunk.bytes[index]);
    }
    return parsed;
}

fn parse_expects_key(state: ParseStateV1) -> (result: bool) {
    if state.depth == 0 { return false; }
    let frame: FrameV1 = state.frames[state.depth -% 1];
    return frame.kind == 1 && frame.expect == 1;
}

fn parse_expects_value(state: ParseStateV1) -> (result: bool) {
    if state.depth == 0 { return !state.has_root; }
    let frame: FrameV1 = state.frames[state.depth -% 1];
    return (frame.kind == 1 && frame.expect == 3)
        || (frame.kind == 2 && frame.expect == 5);
}

fn next_object_source_order(frame: FrameV1, key: KeyV1) -> (result: byte) {
    if frame.child_count == 0 { return 0; }
    let relation: KeyOrderV1 = compare_key(frame.last_source_key, key);
    if frame.source_order == 0 {
        return match relation {
            Before => 1,
            Equal => 3,
            After => 2
        };
    }
    if frame.source_order == 1 {
        return match relation {
            Before => 1,
            Equal => 3,
            After => 3
        };
    }
    if frame.source_order == 2 {
        return match relation {
            Before => 3,
            Equal => 3,
            After => 2
        };
    }
    return 3;
}

fn parse_string_step(
    state: ParseStateV1,
    document: JsonTokenDocumentV1,
    position: u64,
    value: byte
) -> (result: ParseStateV1) {
    if state.string_escape {
        return ParseStateV1 { ..state, string_escape: false };
    }
    if value == 92 { return ParseStateV1 { ..state, string_escape: true }; }
    if value != 34 { return state; }
    let closed: ParseStateV1 = ParseStateV1 { ..state, in_string: false };
    let raw_start: u64 = state.string_start +% 1;
    let raw_length: u64 = position -% raw_start;
    if state.string_is_key {
        if closed.depth == 0 || raw_length > 256 {
            return ParseStateV1 { ..closed, valid: false };
        }
        let frame_index: u64 = closed.depth -% 1;
        let frame: FrameV1 = closed.frames[frame_index];
        let key: KeyV1 = decode_key(document, raw_start, raw_length);
        if frame.kind != 1 || frame.expect != 1 || frame.has_pending_key || !key.valid {
            return ParseStateV1 { ..closed, valid: false };
        }
        let source_order: byte = next_object_source_order(frame, key);
        return ParseStateV1 {
            ..closed,
            frames: replace(closed.frames, frame_index, FrameV1 {
                ..frame,
                pending_key: key,
                last_source_key: key,
                has_pending_key: true,
                source_order: source_order,
                expect: 2
            })
        };
    }
    return append_value(
        closed,
        JsonValueV1.String { start: raw_start, length: raw_length },
        1
    );
}

fn mark_array_object_step(frames: [FrameV1; 12], depth: u64, index: u64) -> (result: [FrameV1; 12]) {
    if index >= depth { return frames; }
    let frame: FrameV1 = frames[index];
    if frame.kind != 2 { return frames; }
    return replace(frames, index, FrameV1 { ..frame, contains_object: true });
}

fn mark_object_in_array_ancestors(
    frames: [FrameV1; 12], depth: u64, is_object: bool
) -> (result: [FrameV1; 12]) {
    if !is_object { return frames; }
    iterate i up_to 12 carrying marked: [FrameV1; 12] = frames {
        next marked = mark_array_object_step(marked, depth, i);
    }
    return marked;
}

fn mark_array_noncompact_step(frames: [FrameV1; 12], depth: u64, index: u64) -> (result: [FrameV1; 12]) {
    if index >= depth { return frames; }
    let frame: FrameV1 = frames[index];
    if frame.kind != 2 { return frames; }
    return replace(frames, index, FrameV1 { ..frame, compact: false });
}

fn mark_array_ancestors_noncompact(frames: [FrameV1; 12], depth: u64) -> (result: [FrameV1; 12]) {
    iterate i up_to 12 carrying marked: [FrameV1; 12] = frames {
        next marked = mark_array_noncompact_step(marked, depth, i);
    }
    return marked;
}

fn parse_open_container(state: ParseStateV1, position: u64, value: byte) -> (result: ParseStateV1) {
    if !parse_expects_value(state) || state.depth >= 12 {
        return ParseStateV1 { ..state, valid: false };
    }
    let kind: byte = select(value == 123, 1, 2);
    let marked: [FrameV1; 12] = mark_object_in_array_ancestors(
        state.frames, state.depth, value == 123
    );
    let frame: FrameV1 = FrameV1 { ..empty_frame(kind), source_start: position };
    return ParseStateV1 {
        ..state,
        frames: replace(marked, state.depth, frame),
        depth: state.depth +% 1
    };
}

fn parse_close_container(state: ParseStateV1, position: u64, value: byte) -> (result: ParseStateV1) {
    if state.depth == 0 { return ParseStateV1 { ..state, valid: false }; }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    let correct: bool = (value == 125 && frame.kind == 1 && (frame.expect == 1 || frame.expect == 4))
        || (value == 93 && frame.kind == 2 && (frame.expect == 5 || frame.expect == 6));
    if !correct || frame.has_pending_key { return ParseStateV1 { ..state, valid: false }; }
    let container: ContainerValueV1 = container_value(
        frame, position, state.span_compact_arrays
    );
    if !container.valid { return ParseStateV1 { ..state, valid: false }; }
    let popped: ParseStateV1 = ParseStateV1 { ..state, depth: frame_index };
    return append_value(popped, container.value, container.writer_steps);
}

fn parse_comma(state: ParseStateV1) -> (result: ParseStateV1) {
    if state.depth == 0 { return ParseStateV1 { ..state, valid: false }; }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    if frame.kind == 1 && frame.expect == 4 {
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, FrameV1 { ..frame, expect: 1 })
        };
    }
    if frame.kind == 2 && frame.expect == 6 {
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, FrameV1 { ..frame, expect: 5 })
        };
    }
    return ParseStateV1 { ..state, valid: false };
}

fn parse_colon(state: ParseStateV1) -> (result: ParseStateV1) {
    if state.depth == 0 { return ParseStateV1 { ..state, valid: false }; }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    if frame.kind == 1 && frame.expect == 2 && frame.has_pending_key {
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, FrameV1 { ..frame, expect: 3 })
        };
    }
    return ParseStateV1 { ..state, valid: false };
}

fn parse_step(state: ParseStateV1, document: JsonTokenDocumentV1, position: u64, value: byte) -> (result: ParseStateV1) {
    if state.in_string { return parse_string_step(state, document, position, value); }
    let boundary: bool = scalar_boundary(value);
    let advanced: ParseStateV1 = maybe_finalize_scalar(state, position, boundary);
    if !advanced.valid { return advanced; }
    if json_space(value) {
        return ParseStateV1 {
            ..advanced,
            frames: mark_array_ancestors_noncompact(advanced.frames, advanced.depth)
        };
    }
    if value == 34 {
        if parse_expects_key(advanced) {
            return ParseStateV1 {
                ..advanced,
                string_start: position,
                in_string: true,
                string_escape: false,
                string_is_key: true
            };
        }
        if parse_expects_value(advanced) {
            return ParseStateV1 {
                ..advanced,
                string_start: position,
                in_string: true,
                string_escape: false,
                string_is_key: false
            };
        }
        return ParseStateV1 { ..advanced, valid: false };
    }
    if value == 123 || value == 91 { return parse_open_container(advanced, position, value); }
    if value == 125 || value == 93 { return parse_close_container(advanced, position, value); }
    if value == 44 { return parse_comma(advanced); }
    if value == 58 { return parse_colon(advanced); }
    if !advanced.scalar_active {
        if !parse_expects_value(advanced) { return ParseStateV1 { ..advanced, valid: false }; }
        return ParseStateV1 { ..advanced, scalar_start: position, scalar_active: true };
    }
    return advanced;
}

fn empty_parse_state(span_compact_arrays: bool) -> (result: ParseStateV1) {
    let frame: FrameV1 = empty_frame(0);
    return ParseStateV1 {
        frames: [frame; 12],
        depth: 0,
        span_compact_arrays: span_compact_arrays,
        root: JsonValueV1.Empty,
        root_writer_steps: 0,
        has_root: false,
        string_start: 0,
        in_string: false,
        string_escape: false,
        string_is_key: false,
        scalar_start: 0,
        scalar_active: false,
        value_count: 0,
        valid: true
    };
}

fn parse_chunk(state: ParseStateV1, document: JsonTokenDocumentV1, chunk_index: u64) -> (result: ParseStateV1) {
    let chunk: JsonTokenInputChunkV1 = document.chunks[chunk_index];
    let base: u64 = document_offset_at(document, chunk_index, 0);
    iterate i up_to 1024 carrying parsed: ParseStateV1 = state {
        next parsed = parse_chunk_step(parsed, document, base, chunk, i);
    }
    return parsed;
}

fn initial_json_scan_state() -> (result: json.ScanState) {
    return json.init();
}

fn scan_document_part(scanned: json.ScanState, chunk: JsonTokenInputChunkV1, index: u64) -> (result: json.ScanState) {
    let start: u64 = index *% 64;
    if start >= chunk.length { return scanned; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    let source: [byte; up_to 64] = chunk.bytes[start..start +% size];
    iterate i over source carrying current: json.ScanState = scanned {
        next current = json.scan_step(current, source[i]);
    }
    return current;
}

fn scan_document_chunk(scanned: json.ScanState, chunk: JsonTokenInputChunkV1) -> (result: json.ScanState) {
    iterate i up_to 16 carrying current: json.ScanState = scanned {
        next current = scan_document_part(current, chunk, i);
    }
    return current;
}

fn scan_document(document: JsonTokenDocumentV1) -> (result: json.ScanState) {
    iterate i over document.chunks carrying scanned: json.ScanState = initial_json_scan_state() {
        next scanned = scan_document_chunk(scanned, document.chunks[i]);
    }
    return json.scan_finish_end(scanned);
}

fn json_scan_is_valid(scanned: json.ScanState) -> (result: bool) {
    return scanned.valid && scanned.depth == 0 && scanned.mode == 0 && scanned.expect == 7;
}

fn parse_document_with_array_spans(
    document: JsonTokenDocumentV1, span_compact_arrays: bool
) -> (result: ParseStateV1) {
    iterate i over document.chunks carrying parsed: ParseStateV1 = empty_parse_state(span_compact_arrays) {
        next parsed = parse_chunk(parsed, document, i);
    }
    let finalized: ParseStateV1 = finalize_scalar(parsed, document.byte_length);
    return ParseStateV1 {
        ..finalized,
        valid: finalized.valid && !finalized.in_string
            && finalized.depth == 0 && finalized.has_root
    };
}

fn parse_document(document: JsonTokenDocumentV1) -> (result: ParseStateV1) {
    return parse_document_with_array_spans(document, false);
}

fn parse_key_order_document(document: JsonTokenDocumentV1) -> (result: ParseStateV1) {
    return parse_document_with_array_spans(document, true);
}

fn writer_empty() -> (result: JsonOrderWriterV1) {
    return JsonOrderWriterV1 {
        current_bytes: [0; 1024],
        current_length: 0,
        completed: JsonOrderChunkListV1.ChunkNil,
        completed_count: 0,
        length: 0,
        ok: true
    };
}

fn writer_next_chunk(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    let finished: JsonOrderChunkV1 = JsonOrderChunkV1 {
        bytes: writer.current_bytes,
        length: 1024
    };
    let empty: [byte; 1024] = [0; 1024];
    return JsonOrderWriterV1 {
        ..writer,
        current_bytes: replace(empty, 0, value),
        current_length: 1,
        completed: JsonOrderChunkListV1.ChunkCons {
            head: finished,
            tail: writer.completed
        },
        completed_count: writer.completed_count +% 1,
        length: writer.length +% 1
    };
}

fn writer_byte(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    if !writer.ok || writer.length >= 65536 { return JsonOrderWriterV1 { ..writer, ok: false }; }
    if writer.current_length >= 1024 { return writer_next_chunk(writer, value); }
    let updated: [byte; 1024] = replace(writer.current_bytes, writer.current_length, value);
    return JsonOrderWriterV1 {
        ..writer,
        current_bytes: updated,
        current_length: writer.current_length +% 1,
        length: writer.length +% 1
    };
}

fn writer_bytes(writer: JsonOrderWriterV1, input: [byte; up_to 1024]) -> (result: JsonOrderWriterV1) {
    iterate i over input carrying output: JsonOrderWriterV1 = writer {
        next output = writer_append_step(output, input[i]);
    }
    return output;
}

fn writer_append_step(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    if writer.ok { return writer_byte(writer, value); }
    return writer;
}

fn canonical_lower_hex_digit(value: u64) -> (result: byte) {
    if value < 10 { return (48 +% value) as byte; }
    return (87 +% value) as byte;
}

fn canonical_escaped_control(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    let number: u64 = value as u64;
    let first: JsonOrderWriterV1 = writer_byte(writer, 92);
    let second: JsonOrderWriterV1 = writer_byte(first, 117);
    let third: JsonOrderWriterV1 = writer_byte(second, 48);
    let fourth: JsonOrderWriterV1 = writer_byte(third, 48);
    let fifth: JsonOrderWriterV1 = writer_byte(fourth, canonical_lower_hex_digit(number / 16));
    return writer_byte(fifth, canonical_lower_hex_digit(number % 16));
}

fn canonical_string_step(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    if !writer.ok { return writer; }
    if value == 34 || value == 92 {
        return writer_byte(writer_byte(writer, 92), value);
    }
    if value == 8 { return writer_bytes(writer, [92, 98]); }
    if value == 9 { return writer_bytes(writer, [92, 116]); }
    if value == 10 { return writer_bytes(writer, [92, 110]); }
    if value == 12 { return writer_bytes(writer, [92, 102]); }
    if value == 13 { return writer_bytes(writer, [92, 114]); }
    if value < 32 { return canonical_escaped_control(writer, value); }
    return writer_byte(writer, value);
}

fn write_canonical_string(writer: JsonOrderWriterV1, value: [byte; up_to 512]) -> (result: JsonOrderWriterV1) {
    let opened: JsonOrderWriterV1 = writer_byte(writer, 34);
    iterate i over value carrying current: JsonOrderWriterV1 = opened {
        next current = canonical_string_step(current, value[i]);
    }
    return writer_byte(current, 34);
}

fn digest_writer_empty(initial: sha256.DigestState) -> (result: JsonDigestWriterV1) {
    return JsonDigestWriterV1 { digest: initial, bytes: [0; 64], length: 0, ok: true };
}

fn digest_writer_flush(writer: JsonDigestWriterV1) -> (result: JsonDigestWriterV1) {
    if !writer.ok || writer.length == 0 { return writer; }
    let digest: sha256.DigestState = sha256.update_standard(
        writer.digest, writer.bytes[0..writer.length], writer.length
    );
    return JsonDigestWriterV1 { digest: digest, bytes: [0; 64], length: 0, ok: true };
}

fn digest_writer_store_byte(writer: JsonDigestWriterV1, value: byte) -> (result: JsonDigestWriterV1) {
    return JsonDigestWriterV1 {
        ..writer,
        bytes: replace(writer.bytes, writer.length, value),
        length: writer.length +% 1
    };
}

fn digest_writer_byte(writer: JsonDigestWriterV1, value: byte) -> (result: JsonDigestWriterV1) {
    if !writer.ok { return writer; }
    if writer.length >= 64 {
        return digest_writer_store_byte(digest_writer_flush(writer), value);
    }
    return digest_writer_store_byte(writer, value);
}

fn digest_writer_bytes(
    writer: JsonDigestWriterV1,
    values: [byte; up_to 64]
) -> (result: JsonDigestWriterV1) {
    iterate i over values carrying current: JsonDigestWriterV1 = writer {
        next current = digest_writer_byte(current, values[i]);
    }
    return current;
}

fn digest_writer_string_step(
    writer: JsonDigestWriterV1,
    value: byte
) -> (result: JsonDigestWriterV1) {
    // Stream the common unescaped byte directly. Materializing the six-byte
    // escape record for every ordinary UTF-8 byte inflated the VM work even
    // though only control characters need that representation.
    if value == 34 || value == 92 {
        return digest_writer_byte(digest_writer_byte(writer, 92), value);
    }
    if value == 8 { return digest_writer_byte(digest_writer_byte(writer, 92), 98); }
    if value == 9 { return digest_writer_byte(digest_writer_byte(writer, 92), 116); }
    if value == 10 { return digest_writer_byte(digest_writer_byte(writer, 92), 110); }
    if value == 12 { return digest_writer_byte(digest_writer_byte(writer, 92), 102); }
    if value == 13 { return digest_writer_byte(digest_writer_byte(writer, 92), 114); }
    if value < 32 {
        let number: u64 = value as u64;
        let escaped: JsonDigestWriterV1 = digest_writer_byte(writer, 92);
        let marker: JsonDigestWriterV1 = digest_writer_byte(escaped, 117);
        let first_zero: JsonDigestWriterV1 = digest_writer_byte(marker, 48);
        let second_zero: JsonDigestWriterV1 = digest_writer_byte(first_zero, 48);
        let high: JsonDigestWriterV1 = digest_writer_byte(
            second_zero, canonical_lower_hex_digit(number / 16)
        );
        return digest_writer_byte(high, canonical_lower_hex_digit(number % 16));
    }
    return digest_writer_byte(writer, value);
}

fn digest_writer_canonical_string(
    writer: JsonDigestWriterV1,
    value: [byte; up_to 512]
) -> (result: JsonDigestWriterV1) {
    let opened: JsonDigestWriterV1 = digest_writer_byte(writer, 34);
    iterate i over value carrying current: JsonDigestWriterV1 = opened {
        next current = digest_writer_string_step(current, value[i]);
    }
    return digest_writer_byte(current, 34);
}

fn digest_writer_finish(writer: JsonDigestWriterV1) -> (result: [byte; up_to 64]) {
    if !writer.ok { return []; }
    let flushed: JsonDigestWriterV1 = digest_writer_flush(writer);
    return encode_digest(sha256.finalize_standard(flushed.digest));
}

fn is_array_nil(value: JsonValueV1) -> (result: bool) {
    return match value {
        ArrayNil => true,
        Empty => false,
        Null => false,
        Raw { start: raw_start, length: raw_length } => false,
        String { start: raw_start, length: raw_length } => false,
        Boolean { value: flag } => false,
        Integer { negative: negative, magnitude: magnitude } => false,
        Utf8String { start: start, length: length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn is_object_nil(value: JsonValueV1) -> (result: bool) {
    return match value {
        ObjectNil => true,
        Empty => false,
        Null => false,
        Raw { start: raw_start, length: raw_length } => false,
        String { start: raw_start, length: raw_length } => false,
        Boolean { value: flag } => false,
        Integer { negative: negative, magnitude: magnitude } => false,
        Utf8String { start: start, length: length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn writer_source_chunk_step(
    state: WriterSourceStateV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: WriterSourceStateV1) {
    let chunk: JsonTokenInputChunkV1 = document.chunks[index];
    let chunk_start: u64 = state.base;
    let chunk_end: u64 = chunk_start +% chunk.length;
    let range_end: u64 = start +% length;
    let copy_start: u64 = select(start > chunk_start, start, chunk_start);
    let copy_end: u64 = select(range_end < chunk_end, range_end, chunk_end);
    if copy_start < copy_end {
        let source_start: u64 = copy_start -% chunk_start;
        let source_end: u64 = copy_end -% chunk_start;
        let source: [byte; up_to 1024] = chunk.bytes[source_start..source_end];
        return WriterSourceStateV1 {
            writer: writer_bytes(state.writer, source),
            base: chunk_end
        };
    }
    return WriterSourceStateV1 { ..state, base: chunk_end };
}

fn writer_source_range(
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: JsonOrderWriterV1) {
    if length > 65536 || start > document.byte_length || length > document.byte_length -% start {
        return JsonOrderWriterV1 { ..writer, ok: false };
    }
    let initial: WriterSourceStateV1 = WriterSourceStateV1 { writer: writer, base: 0 };
    iterate i over document.chunks carrying output: WriterSourceStateV1 = initial {
        next output = writer_source_chunk_step(output, document, start, length, i);
    }
    return output.writer;
}

fn json_hex_digit(value: u64) -> (result: byte) {
    if value < 10 { return (value +% 48) as byte; }
    return (value -% 10 +% 97) as byte;
}

fn writer_escape_byte(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    if value == 34 || value == 92 {
        return writer_byte(writer_byte(writer, 92), value);
    }
    if value == 8 { return writer_bytes(writer, [92, 98]); }
    if value == 9 { return writer_bytes(writer, [92, 116]); }
    if value == 10 { return writer_bytes(writer, [92, 110]); }
    if value == 12 { return writer_bytes(writer, [92, 102]); }
    if value == 13 { return writer_bytes(writer, [92, 114]); }
    if value < 32 {
        let high: byte = json_hex_digit((value as u64) / 16);
        let low: byte = json_hex_digit((value as u64) % 16);
        return writer_bytes(writer, [92, 117, 48, 48, high, low]);
    }
    return writer_byte(writer, value);
}

fn writer_escape_bytes(writer: JsonOrderWriterV1, bytes: [byte; up_to 1024]) -> (result: JsonOrderWriterV1) {
    iterate i over bytes carrying output: JsonOrderWriterV1 = writer {
        next output = writer_escape_byte(output, bytes[i]);
    }
    return output;
}

fn writer_escape_key_bytes(writer: JsonOrderWriterV1, bytes: [byte; up_to 256]) -> (result: JsonOrderWriterV1) {
    iterate i over bytes carrying output: JsonOrderWriterV1 = writer {
        next output = writer_escape_byte(output, bytes[i]);
    }
    return output;
}

fn writer_escape_source_chunk(
    state: JsonEscapedSourceStateV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: JsonEscapedSourceStateV1) {
    let chunk: JsonTokenInputChunkV1 = document.chunks[index];
    let chunk_start: u64 = state.base;
    let chunk_end: u64 = chunk_start +% chunk.length;
    let range_end: u64 = start +% length;
    let copy_start: u64 = select(start > chunk_start, start, chunk_start);
    let copy_end: u64 = select(range_end < chunk_end, range_end, chunk_end);
    if copy_start < copy_end {
        let source_start: u64 = copy_start -% chunk_start;
        let source_end: u64 = copy_end -% chunk_start;
        let source: [byte; up_to 1024] = chunk.bytes[source_start..source_end];
        return JsonEscapedSourceStateV1 {
            writer: writer_escape_bytes(state.writer, source),
            base: chunk_end
        };
    }
    return JsonEscapedSourceStateV1 { ..state, base: chunk_end };
}

fn writer_escape_source_range(
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: JsonOrderWriterV1) {
    if length > 65536 || start > document.byte_length || length > document.byte_length -% start {
        return JsonOrderWriterV1 { ..writer, ok: false };
    }
    let initial: JsonEscapedSourceStateV1 = JsonEscapedSourceStateV1 { writer: writer, base: 0 };
    iterate i over document.chunks carrying output: JsonEscapedSourceStateV1 = initial {
        next output = writer_escape_source_chunk(output, document, start, length, i);
    }
    return output.writer;
}

fn writer_quoted_source_range(
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: JsonOrderWriterV1) {
    let opened: JsonOrderWriterV1 = writer_byte(writer, 34);
    let escaped: JsonOrderWriterV1 = writer_escape_source_range(opened, document, start, length);
    return writer_byte(escaped, 34);
}

fn writer_quoted_key_bytes(writer: JsonOrderWriterV1, key: KeyV1) -> (result: JsonOrderWriterV1) {
    let opened: JsonOrderWriterV1 = writer_byte(writer, 34);
    let escaped: JsonOrderWriterV1 = writer_escape_key_bytes(opened, key.ordered[0..key.ordered_length]);
    return writer_byte(escaped, 34);
}

fn integer_digits_step(state: IntegerDigitBufferV1) -> (result: IntegerDigitBufferV1) {
    if state.remaining == 0 || state.length >= 20 { return state; }
    let digit: byte = ((state.remaining % 10) +% 48) as byte;
    return IntegerDigitBufferV1 {
        bytes: replace(state.bytes, state.length, digit),
        length: state.length +% 1,
        remaining: state.remaining / 10
    };
}

fn write_integer_digit_step(
    writer: JsonOrderWriterV1,
    digits: IntegerDigitBufferV1,
    length: u64,
    index: u64
) -> (result: JsonOrderWriterV1) {
    if index >= length { return writer; }
    return writer_byte(writer, digits.bytes[length -% index -% 1]);
}

fn integer_digit_buffer(magnitude: u64) -> (result: IntegerDigitBufferV1) {
    let initial: IntegerDigitBufferV1 = IntegerDigitBufferV1 {
        bytes: [0; 20], length: 0, remaining: magnitude
    };
    iterate i up_to 20 carrying digits: IntegerDigitBufferV1 = initial {
        next digits = integer_digits_step(digits);
    }
    return digits;
}

fn integer_digit_length(magnitude: u64) -> (result: u64) {
    if magnitude == 0 { return 1; }
    return integer_digit_buffer(magnitude).length;
}

fn writer_integer(writer: JsonOrderWriterV1, negative: bool, magnitude: u64) -> (result: JsonOrderWriterV1) {
    let sign: JsonOrderWriterV1 = select(negative, writer_byte(writer, 45), writer);
    if magnitude == 0 { return writer_byte(sign, 48); }
    let digits: IntegerDigitBufferV1 = integer_digit_buffer(magnitude);
    let length: u64 = digits.length;
    iterate i up_to 20 carrying output: JsonOrderWriterV1 = sign {
        next output = write_integer_digit_step(output, digits, length, i);
    }
    return output;
}

fn writer_key(
    writer: JsonOrderWriterV1,
    key: KeyV1,
    document: JsonTokenDocumentV1
) -> (result: JsonOrderWriterV1) {
    if key.json_escaped {
        let open: JsonOrderWriterV1 = writer_byte(writer, 34);
        let raw: JsonOrderWriterV1 = writer_source_range(open, document, key.raw_start, key.raw_length);
        return writer_byte(raw, 34);
    }
    return writer_quoted_key_bytes(writer, key);
}

fn write_json_recursive(
    value: JsonValueV1,
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1
) -> (result: JsonOrderWriterV1) {
    return match value {
        Empty => JsonOrderWriterV1 { ..writer, ok: false },
        Null => writer_bytes(writer, [110, 117, 108, 108]),
        Boolean { value: value } => select(
            value,
            writer_bytes(writer, [116, 114, 117, 101]),
            writer_bytes(writer, [102, 97, 108, 115, 101])
        ),
        Integer { negative: negative, magnitude: magnitude } =>
            writer_integer(writer, negative, magnitude),
        Raw { start: start, length: length } => writer_source_range(writer, document, start, length),
        String { start: start, length: length } => writer_byte(
            writer_source_range(writer_byte(writer, 34), document, start, length),
            34
        ),
        Utf8String { start: start, length: length } =>
            writer_quoted_source_range(writer, document, start, length),
        Array { items: items } => writer_byte(
            write_json_recursive(items, writer_byte(writer, 91), document), 93
        ),
        Object { fields: fields } => writer_byte(
            write_json_recursive(fields, writer_byte(writer, 123), document), 125
        ),
        ArrayNil => writer,
        ArrayCons { head: head, tail: tail } => match tail {
            ArrayNil => write_json_recursive(head, writer, document),
            Empty => JsonOrderWriterV1 { ..writer, ok: false },
            Null => JsonOrderWriterV1 { ..writer, ok: false },
            Raw { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            String { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            Boolean { value: flag } => JsonOrderWriterV1 { ..writer, ok: false },
            Integer { negative: negative, magnitude: magnitude } => JsonOrderWriterV1 { ..writer, ok: false },
            Utf8String { start: start, length: length } => JsonOrderWriterV1 { ..writer, ok: false },
            Array { items: items } => JsonOrderWriterV1 { ..writer, ok: false },
            Object { fields: fields } => JsonOrderWriterV1 { ..writer, ok: false },
            ArrayCons { head: next_head, tail: next_tail } => write_json_recursive(
                tail,
                writer_byte(write_json_recursive(head, writer, document), 44),
                document
            ),
            ObjectNil => JsonOrderWriterV1 { ..writer, ok: false },
            ObjectCons { key: key, value: inner, tail: rest } => JsonOrderWriterV1 { ..writer, ok: false }
        },
        ObjectNil => writer,
        ObjectCons { key: key, value: inner, tail: tail } => match tail {
            ObjectNil => write_json_recursive(
                inner, writer_byte(writer_key(writer, key, document), 58), document
            ),
            Empty => JsonOrderWriterV1 { ..writer, ok: false },
            Null => JsonOrderWriterV1 { ..writer, ok: false },
            Raw { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            String { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            Boolean { value: flag } => JsonOrderWriterV1 { ..writer, ok: false },
            Integer { negative: negative, magnitude: magnitude } => JsonOrderWriterV1 { ..writer, ok: false },
            Utf8String { start: start, length: length } => JsonOrderWriterV1 { ..writer, ok: false },
            Array { items: items } => JsonOrderWriterV1 { ..writer, ok: false },
            Object { fields: fields } => JsonOrderWriterV1 { ..writer, ok: false },
            ArrayNil => JsonOrderWriterV1 { ..writer, ok: false },
            ArrayCons { head: next_head, tail: next_tail } => JsonOrderWriterV1 { ..writer, ok: false },
            ObjectCons { key: next_key, value: next_value, tail: next_tail } => write_json_recursive(
                tail,
                writer_byte(
                    write_json_recursive(inner, writer_byte(writer_key(writer, key, document), 58), document),
                    44
                ),
                document
            )
        }
    };
}

fn write_json_task_push(
    state: JsonWriteStateV1,
    task: JsonWriteTaskV1
) -> (result: JsonWriteStateV1) {
    if state.depth >= 16 { return JsonWriteStateV1 {
        ..state,
        tasks: [JsonWriteTaskV1.Empty; 16],
        depth: 0,
        writer: JsonOrderWriterV1 { ..state.writer, ok: false }
    }; }
    return JsonWriteStateV1 {
        ..state,
        tasks: replace(state.tasks, state.depth, task),
        depth: state.depth +% 1
    };
}

fn write_json_task_failure(state: JsonWriteStateV1) -> (result: JsonWriteStateV1) {
    return JsonWriteStateV1 {
        ..state,
        tasks: [JsonWriteTaskV1.Empty; 16],
        depth: 0,
        writer: JsonOrderWriterV1 { ..state.writer, ok: false }
    };
}

fn write_json_array_next_step(
    state: JsonWriteStateV1,
    remaining: JsonValueV1,
    head: JsonValueV1,
    first: bool
) -> (result: JsonWriteStateV1) {
    let separated: JsonOrderWriterV1 = select(
        first, state.writer, writer_byte(state.writer, 44)
    );
    let queued: JsonWriteStateV1 = write_json_task_push(
        JsonWriteStateV1 { ..state, writer: separated },
        JsonWriteTaskV1.ArrayNext { remaining: remaining, first: false }
    );
    return write_json_task_push(queued, JsonWriteTaskV1.Value { value: head });
}

fn write_json_object_next_step(
    state: JsonWriteStateV1,
    remaining: JsonValueV1,
    key: KeyV1,
    value: JsonValueV1,
    first: bool,
    document: JsonTokenDocumentV1
) -> (result: JsonWriteStateV1) {
    let separated: JsonOrderWriterV1 = select(
        first, state.writer, writer_byte(state.writer, 44)
    );
    let member: JsonOrderWriterV1 = writer_byte(
        writer_key(separated, key, document), 58
    );
    let queued: JsonWriteStateV1 = write_json_task_push(
        JsonWriteStateV1 { ..state, writer: member },
        JsonWriteTaskV1.ObjectNext { remaining: remaining, first: false }
    );
    return write_json_task_push(queued, JsonWriteTaskV1.Value { value: value });
}

fn write_json_task_step(
    state: JsonWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonWriteStateV1) {
    if state.depth == 0 || !state.writer.ok { return state; }
    let task_index: u64 = state.depth -% 1;
    let task: JsonWriteTaskV1 = state.tasks[task_index];
    let popped: JsonWriteStateV1 = JsonWriteStateV1 {
        ..state,
        tasks: replace(state.tasks, task_index, JsonWriteTaskV1.Empty),
        depth: task_index
    };
    return match task {
        Empty => write_json_task_failure(popped),
        Value { value: value } => match value {
            Empty => write_json_task_failure(popped),
            Null => JsonWriteStateV1 {
                ..popped,
                writer: writer_bytes(popped.writer, [110, 117, 108, 108])
            },
            Boolean { value: value } => JsonWriteStateV1 {
                ..popped,
                writer: select(
                    value,
                    writer_bytes(popped.writer, [116, 114, 117, 101]),
                    writer_bytes(popped.writer, [102, 97, 108, 115, 101])
                )
            },
            Integer { negative: negative, magnitude: magnitude } => JsonWriteStateV1 {
                ..popped,
                writer: writer_integer(popped.writer, negative, magnitude)
            },
            Raw { start: start, length: length } => JsonWriteStateV1 {
                ..popped,
                writer: writer_source_range(popped.writer, document, start, length)
            },
            String { start: start, length: length } => JsonWriteStateV1 {
                ..popped,
                writer: writer_byte(
                    writer_source_range(writer_byte(popped.writer, 34), document, start, length),
                    34
                )
            },
            Utf8String { start: start, length: length } => JsonWriteStateV1 {
                ..popped,
                writer: writer_quoted_source_range(popped.writer, document, start, length)
            },
            Array { items: items } => write_json_task_push(
                JsonWriteStateV1 { ..popped, writer: writer_byte(popped.writer, 91) },
                JsonWriteTaskV1.ArrayNext { remaining: items, first: true }
            ),
            Object { fields: fields } => write_json_task_push(
                JsonWriteStateV1 { ..popped, writer: writer_byte(popped.writer, 123) },
                JsonWriteTaskV1.ObjectNext { remaining: fields, first: true }
            ),
            ArrayNil => write_json_task_failure(popped),
            ArrayCons { head: head, tail: tail } => write_json_task_failure(popped),
            ObjectNil => write_json_task_failure(popped),
            ObjectCons { key: key, value: inner, tail: tail } => write_json_task_failure(popped)
        },
        ArrayNext { remaining: remaining, first: first } => match remaining {
            ArrayNil => JsonWriteStateV1 { ..popped, writer: writer_byte(popped.writer, 93) },
            ArrayCons { head: head, tail: tail } => write_json_array_next_step(
                popped, tail, head, first
            ),
            Empty => write_json_task_failure(popped),
            Null => write_json_task_failure(popped),
            Raw { start: start, length: length } => write_json_task_failure(popped),
            String { start: start, length: length } => write_json_task_failure(popped),
            Boolean { value: value } => write_json_task_failure(popped),
            Integer { negative: negative, magnitude: magnitude } => write_json_task_failure(popped),
            Utf8String { start: start, length: length } => write_json_task_failure(popped),
            Array { items: items } => write_json_task_failure(popped),
            Object { fields: fields } => write_json_task_failure(popped),
            ObjectNil => write_json_task_failure(popped),
            ObjectCons { key: key, value: value, tail: tail } => write_json_task_failure(popped)
        },
        ObjectNext { remaining: remaining, first: first } => match remaining {
            ObjectNil => JsonWriteStateV1 { ..popped, writer: writer_byte(popped.writer, 125) },
            ObjectCons { key: key, value: value, tail: tail } => write_json_object_next_step(
                popped, tail, key, value, first, document
            ),
            Empty => write_json_task_failure(popped),
            Null => write_json_task_failure(popped),
            Raw { start: start, length: length } => write_json_task_failure(popped),
            String { start: start, length: length } => write_json_task_failure(popped),
            Boolean { value: value } => write_json_task_failure(popped),
            Integer { negative: negative, magnitude: magnitude } => write_json_task_failure(popped),
            Utf8String { start: start, length: length } => write_json_task_failure(popped),
            Array { items: items } => write_json_task_failure(popped),
            Object { fields: fields } => write_json_task_failure(popped),
            ArrayNil => write_json_task_failure(popped),
            ArrayCons { head: head, tail: tail } => write_json_task_failure(popped)
        }
    };
}

fn write_json_advance_three(
    state: JsonWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonWriteStateV1) {
    let first: JsonWriteStateV1 = write_json_task_step(state, document);
    let second: JsonWriteStateV1 = write_json_task_step(first, document);
    return write_json_task_step(second, document);
}

fn write_json_run_512(
    state: JsonWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonWriteStateV1) {
    iterate i up_to 512 carrying current: JsonWriteStateV1 = state {
        next current = write_json_advance_three(current, document);
    }
    return current;
}

fn write_json_run_1024(
    state: JsonWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonWriteStateV1) {
    iterate i up_to 1024 carrying current: JsonWriteStateV1 = state {
        next current = write_json_advance_three(current, document);
    }
    return current;
}

fn write_json_finish(state: JsonWriteStateV1) -> (result: JsonOrderWriterV1) {
    if state.depth == 0 { return state.writer; }
    return JsonOrderWriterV1 { ..state.writer, ok: false };
}

fn write_json(
    value: JsonValueV1,
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1,
    task_bound: u64
) -> (result: JsonOrderWriterV1) {
    if task_bound <= 1200 { return write_json_recursive(value, writer, document); }
    let empty: [JsonWriteTaskV1; 16] = [JsonWriteTaskV1.Empty; 16];
    let initial: JsonWriteStateV1 = write_json_task_push(
        JsonWriteStateV1 { tasks: empty, depth: 0, writer: writer },
        JsonWriteTaskV1.Value { value: value }
    );
    if task_bound <= 1536 { return write_json_finish(write_json_run_512(initial, document)); }
    return write_json_finish(write_json_run_1024(initial, document));
}

fn pretty_indent_step(
    writer: JsonOrderWriterV1,
    indent: u64,
    index: u64
) -> (result: JsonOrderWriterV1) {
    if index < indent *% 2 { return writer_byte(writer, 32); }
    return writer;
}

fn pretty_newline_indent(writer: JsonOrderWriterV1, indent: u64) -> (result: JsonOrderWriterV1) {
    if indent > 12 { return JsonOrderWriterV1 { ..writer, ok: false }; }
    let newline: JsonOrderWriterV1 = writer_byte(writer, 10);
    iterate i up_to 24 carrying output: JsonOrderWriterV1 = newline {
        next output = pretty_indent_step(output, indent, i);
    }
    return output;
}

fn pretty_write_push(
    state: JsonPrettyWriteStateV1,
    task: JsonPrettyWriteTaskV1
) -> (result: JsonPrettyWriteStateV1) {
    if state.depth >= 16 { return JsonPrettyWriteStateV1 {
        ..state,
        tasks: [JsonPrettyWriteTaskV1.Empty; 16],
        depth: 0,
        writer: JsonOrderWriterV1 { ..state.writer, ok: false }
    }; }
    return JsonPrettyWriteStateV1 {
        ..state,
        tasks: replace(state.tasks, state.depth, task),
        depth: state.depth +% 1
    };
}

fn pretty_write_failure(state: JsonPrettyWriteStateV1) -> (result: JsonPrettyWriteStateV1) {
    return JsonPrettyWriteStateV1 {
        ..state,
        tasks: [JsonPrettyWriteTaskV1.Empty; 16],
        depth: 0,
        writer: JsonOrderWriterV1 { ..state.writer, ok: false }
    };
}

fn pretty_array_next_step(
    state: JsonPrettyWriteStateV1,
    head: JsonValueV1,
    next_items: JsonValueV1,
    first: bool,
    indent: u64
) -> (result: JsonPrettyWriteStateV1) {
    let separated: JsonOrderWriterV1 = select(
        first, state.writer, writer_byte(state.writer, 44)
    );
    let member: JsonOrderWriterV1 = pretty_newline_indent(separated, indent +% 1);
    let queued: JsonPrettyWriteStateV1 = pretty_write_push(
        JsonPrettyWriteStateV1 { ..state, writer: member },
        JsonPrettyWriteTaskV1.ArrayNext {
            remaining: next_items, first: false, indent: indent
        }
    );
    return pretty_write_push(
        queued,
        JsonPrettyWriteTaskV1.Value { value: head, indent: indent +% 1 }
    );
}

fn pretty_object_next_step(
    state: JsonPrettyWriteStateV1,
    next_fields: JsonValueV1,
    key: KeyV1,
    value: JsonValueV1,
    first: bool,
    indent: u64,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    let separated: JsonOrderWriterV1 = select(
        first, state.writer, writer_byte(state.writer, 44)
    );
    let line: JsonOrderWriterV1 = pretty_newline_indent(separated, indent +% 1);
    let key_written: JsonOrderWriterV1 = writer_byte(writer_key(line, key, document), 58);
    let member: JsonOrderWriterV1 = writer_byte(key_written, 32);
    let queued: JsonPrettyWriteStateV1 = pretty_write_push(
        JsonPrettyWriteStateV1 { ..state, writer: member },
        JsonPrettyWriteTaskV1.ObjectNext {
            remaining: next_fields, first: false, indent: indent
        }
    );
    return pretty_write_push(
        queued,
        JsonPrettyWriteTaskV1.Value { value: value, indent: indent +% 1 }
    );
}

fn pretty_write_array_value(
    state: JsonPrettyWriteStateV1,
    items: JsonValueV1,
    indent: u64
) -> (result: JsonPrettyWriteStateV1) {
    if is_array_nil(items) {
        return JsonPrettyWriteStateV1 {
            ..state, writer: writer_bytes(state.writer, [91, 93])
        };
    }
    return pretty_write_push(
        JsonPrettyWriteStateV1 { ..state, writer: writer_byte(state.writer, 91) },
        JsonPrettyWriteTaskV1.ArrayNext {
            remaining: items, first: true, indent: indent
        }
    );
}

fn pretty_write_object_value(
    state: JsonPrettyWriteStateV1,
    fields: JsonValueV1,
    indent: u64
) -> (result: JsonPrettyWriteStateV1) {
    if is_object_nil(fields) {
        return JsonPrettyWriteStateV1 {
            ..state, writer: writer_bytes(state.writer, [123, 125])
        };
    }
    return pretty_write_push(
        JsonPrettyWriteStateV1 { ..state, writer: writer_byte(state.writer, 123) },
        JsonPrettyWriteTaskV1.ObjectNext {
            remaining: fields, first: true, indent: indent
        }
    );
}

fn pretty_write_task_step(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    if state.depth == 0 || !state.writer.ok { return state; }
    let task_index: u64 = state.depth -% 1;
    let task: JsonPrettyWriteTaskV1 = state.tasks[task_index];
    let popped: JsonPrettyWriteStateV1 = JsonPrettyWriteStateV1 {
        ..state,
        tasks: replace(state.tasks, task_index, JsonPrettyWriteTaskV1.Empty),
        depth: task_index
    };
    return match task {
        Empty => pretty_write_failure(popped),
        Value { value: value, indent: indent } => match value {
            Empty => pretty_write_failure(popped),
            Null => JsonPrettyWriteStateV1 {
                ..popped, writer: writer_bytes(popped.writer, [110, 117, 108, 108])
            },
            Boolean { value: flag } => JsonPrettyWriteStateV1 {
                ..popped,
                writer: select(
                    flag,
                    writer_bytes(popped.writer, [116, 114, 117, 101]),
                    writer_bytes(popped.writer, [102, 97, 108, 115, 101])
                )
            },
            Integer { negative: negative, magnitude: magnitude } => JsonPrettyWriteStateV1 {
                ..popped, writer: writer_integer(popped.writer, negative, magnitude)
            },
            Raw { start: start, length: length } => JsonPrettyWriteStateV1 {
                ..popped, writer: writer_source_range(popped.writer, document, start, length)
            },
            String { start: start, length: length } => JsonPrettyWriteStateV1 {
                ..popped,
                writer: writer_byte(
                    writer_source_range(writer_byte(popped.writer, 34), document, start, length),
                    34
                )
            },
            Utf8String { start: start, length: length } => JsonPrettyWriteStateV1 {
                ..popped, writer: writer_quoted_source_range(popped.writer, document, start, length)
            },
            Array { items: items } => pretty_write_array_value(popped, items, indent),
            Object { fields: fields } => pretty_write_object_value(popped, fields, indent),
            ArrayNil => pretty_write_failure(popped),
            ArrayCons { head: head, tail: tail } => pretty_write_failure(popped),
            ObjectNil => pretty_write_failure(popped),
            ObjectCons { key: key, value: inner, tail: tail } => pretty_write_failure(popped)
        },
        ArrayNext { remaining: remaining, first: first, indent: indent } => match remaining {
            ArrayNil => JsonPrettyWriteStateV1 {
                ..popped,
                writer: writer_byte(pretty_newline_indent(popped.writer, indent), 93)
            },
            ArrayCons { head: head, tail: tail } => pretty_array_next_step(
                popped, head, tail, first, indent
            ),
            Empty => pretty_write_failure(popped),
            Null => pretty_write_failure(popped),
            Raw { start: start, length: length } => pretty_write_failure(popped),
            String { start: start, length: length } => pretty_write_failure(popped),
            Boolean { value: flag } => pretty_write_failure(popped),
            Integer { negative: negative, magnitude: magnitude } => pretty_write_failure(popped),
            Utf8String { start: start, length: length } => pretty_write_failure(popped),
            Array { items: items } => pretty_write_failure(popped),
            Object { fields: fields } => pretty_write_failure(popped),
            ObjectNil => pretty_write_failure(popped),
            ObjectCons { key: key, value: value, tail: tail } => pretty_write_failure(popped)
        },
        ObjectNext { remaining: remaining, first: first, indent: indent } => match remaining {
            ObjectNil => JsonPrettyWriteStateV1 {
                ..popped,
                writer: writer_byte(pretty_newline_indent(popped.writer, indent), 125)
            },
            ObjectCons { key: key, value: value, tail: tail } => pretty_object_next_step(
                popped, tail, key, value, first, indent, document
            ),
            Empty => pretty_write_failure(popped),
            Null => pretty_write_failure(popped),
            Raw { start: start, length: length } => pretty_write_failure(popped),
            String { start: start, length: length } => pretty_write_failure(popped),
            Boolean { value: flag } => pretty_write_failure(popped),
            Integer { negative: negative, magnitude: magnitude } => pretty_write_failure(popped),
            Utf8String { start: start, length: length } => pretty_write_failure(popped),
            Array { items: items } => pretty_write_failure(popped),
            Object { fields: fields } => pretty_write_failure(popped),
            ArrayNil => pretty_write_failure(popped),
            ArrayCons { head: head, tail: tail } => pretty_write_failure(popped)
        }
    };
}

fn pretty_write_advance_three(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    let first: JsonPrettyWriteStateV1 = pretty_write_task_step(state, document);
    let second: JsonPrettyWriteStateV1 = pretty_write_task_step(first, document);
    return pretty_write_task_step(second, document);
}

fn pretty_write_run_16(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    iterate i up_to 16 carrying current: JsonPrettyWriteStateV1 = state {
        next current = pretty_write_advance_three(current, document);
    }
    return current;
}

fn pretty_write_run_64(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    iterate i up_to 64 carrying current: JsonPrettyWriteStateV1 = state {
        next current = pretty_write_advance_three(current, document);
    }
    return current;
}

fn pretty_write_run_256(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    iterate i up_to 256 carrying current: JsonPrettyWriteStateV1 = state {
        next current = pretty_write_advance_three(current, document);
    }
    return current;
}

fn pretty_write_run_512(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    iterate i up_to 512 carrying current: JsonPrettyWriteStateV1 = state {
        next current = pretty_write_advance_three(current, document);
    }
    return current;
}

fn pretty_write_run_1024(
    state: JsonPrettyWriteStateV1,
    document: JsonTokenDocumentV1
) -> (result: JsonPrettyWriteStateV1) {
    iterate i up_to 1024 carrying current: JsonPrettyWriteStateV1 = state {
        next current = pretty_write_advance_three(current, document);
    }
    return current;
}

fn pretty_write_finish(state: JsonPrettyWriteStateV1) -> (result: JsonOrderWriterV1) {
    if state.depth == 0 { return writer_byte(state.writer, 10); }
    return JsonOrderWriterV1 { ..state.writer, ok: false };
}

fn write_pretty_json(
    value: JsonValueV1,
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1,
    node_count: u64
) -> (result: JsonOrderWriterV1) {
    let empty: [JsonPrettyWriteTaskV1; 16] = [JsonPrettyWriteTaskV1.Empty; 16];
    let initial: JsonPrettyWriteStateV1 = pretty_write_push(
        JsonPrettyWriteStateV1 { tasks: empty, depth: 0, writer: writer },
        JsonPrettyWriteTaskV1.Value { value: value, indent: 0 }
    );
    if node_count <= 16 {
        return pretty_write_finish(pretty_write_run_16(initial, document));
    }
    if node_count <= 64 {
        return pretty_write_finish(pretty_write_run_64(initial, document));
    }
    if node_count <= 256 {
        return pretty_write_finish(pretty_write_run_256(initial, document));
    }
    if node_count <= 512 {
        return pretty_write_finish(pretty_write_run_512(initial, document));
    }
    return pretty_write_finish(pretty_write_run_1024(initial, document));
}

fn empty_output_chunk() -> (result: JsonOrderChunkV1) {
    return JsonOrderChunkV1 { bytes: [0; 1024], length: 0 };
}

fn output_completed_chunks(
    completed: JsonOrderChunkListV1,
    chunks: [JsonOrderChunkV1; 64],
    index: u64
) -> (result: [JsonOrderChunkV1; 64]) {
    return match completed {
        ChunkNil => chunks,
        ChunkCons { head: head, tail: tail } => output_completed_chunks(
            tail,
            replace(chunks, index, head),
            index -% 1
        )
    };
}

fn output_chunks(writer: JsonOrderWriterV1) -> (result: JsonOrderChunkBuilderV1) {
    let empty: JsonOrderChunkV1 = empty_output_chunk();
    let initial: [JsonOrderChunkV1; 64] = [empty; 64];
    let completed: [JsonOrderChunkV1; 64] = output_completed_chunks(
        writer.completed,
        initial,
        writer.completed_count -% 1
    );
    if writer.current_length == 0 {
        return JsonOrderChunkBuilderV1 {
            chunks: completed,
            count: writer.completed_count
        };
    }
    let current: JsonOrderChunkV1 = JsonOrderChunkV1 {
        bytes: writer.current_bytes,
        length: writer.current_length
    };
    return JsonOrderChunkBuilderV1 {
        chunks: replace(completed, writer.completed_count, current),
        count: writer.completed_count +% 1
    };
}

fn digest_writer_chunk_part(
    digest: sha256.DigestState,
    chunk: JsonOrderChunkV1,
    part: u64
) -> (result: sha256.DigestState) {
    let start: u64 = part *% 64;
    if start >= chunk.length { return digest; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    return sha256.update_standard(digest, chunk.bytes[start..start +% size], size);
}

fn digest_writer_chunk(
    digest: sha256.DigestState,
    chunk: JsonOrderChunkV1
) -> (result: sha256.DigestState) {
    iterate part up_to 16 carrying current: sha256.DigestState = digest {
        next current = digest_writer_chunk_part(current, chunk, part);
    }
    return current;
}

fn digest_writer_seeded(
    writer: JsonOrderWriterV1,
    initial: sha256.DigestState
) -> (result: sha256.DigestState) {
    let output: JsonOrderChunkBuilderV1 = output_chunks(writer);
    iterate i over output.chunks[0..output.count] carrying digest: sha256.DigestState = initial {
        next digest = digest_writer_chunk(digest, output.chunks[i]);
    }
    return digest;
}

fn order_result(supported: bool, input_sha256: [byte; up_to 64], writer: JsonOrderWriterV1) -> (result: JsonOrderResultV1) {
    let built: JsonOrderChunkBuilderV1 = output_chunks(writer);
    let ready: bool = supported && writer.ok;
    return JsonOrderResultV1 {
        schema_version: result_schema_v1(),
        supported: ready,
        input_sha256: input_sha256,
        document_length: select(ready, writer.length, 0),
        chunk_count: select(ready, built.count, 0),
        chunks: select(ready, built.chunks[0..built.count], built.chunks[0..0])
    };
}

fn document_digest(document: JsonTokenDocumentV1) -> (result: [byte; up_to 64]) {
    let initial: sha256.DigestState = sha256.init();
    iterate i over document.chunks carrying hashed: sha256.DigestState = initial {
        next hashed = document_digest_chunk(hashed, document.chunks[i]);
    }
    let digest: [byte; 32] = sha256.finalize_standard(hashed);
    return encode_digest(digest);
}

fn document_digest_part(hashed: sha256.DigestState, chunk: JsonTokenInputChunkV1, index: u64) -> (result: sha256.DigestState) {
    let start: u64 = index *% 64;
    if start >= chunk.length { return hashed; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    let part: [byte; up_to 64] = chunk.bytes[start..start +% size];
    return sha256.update_standard(hashed, part, size);
}

fn document_digest_chunk(hashed: sha256.DigestState, chunk: JsonTokenInputChunkV1) -> (result: sha256.DigestState) {
    iterate i up_to 16 carrying current: sha256.DigestState = hashed {
        next current = document_digest_part(current, chunk, i);
    }
    return current;
}

fn hex_digit(value: u64) -> (result: byte) {
    if value < 10 { return (value +% 48) as byte; }
    return (value -% 10 +% 97) as byte;
}

fn encode_digest(raw: [byte; 32]) -> (result: [byte; up_to 64]) {
    let initial: [byte; 64] = [0; 64];
    iterate i over raw carrying encoded: [byte; 64] = initial {
        let value: u64 = raw[i] as u64;
        let high: [byte; 64] = replace(encoded, i *% 2, hex_digit(value / 16));
        next encoded = replace(high, i *% 2 +% 1, hex_digit(value % 16));
    }
    return encoded;
}

fn parse_checked(document: JsonTokenDocumentV1, request_valid: bool) -> (result: ParseStateV1) {
    if request_valid {
        let scanned: json.ScanState = scan_document(document);
        if json_scan_is_valid(scanned) { return parse_document(document); }
    }
    return ParseStateV1 { ..empty_parse_state(false), valid: false };
}

fn parse_key_order_checked(document: JsonTokenDocumentV1, request_valid: bool) -> (result: ParseStateV1) {
    if request_valid {
        let scanned: json.ScanState = scan_document(document);
        if json_scan_is_valid(scanned) { return parse_key_order_document(document); }
    }
    return ParseStateV1 { ..empty_parse_state(true), valid: false };
}

fn writer_for_parse(parsed: ParseStateV1, document: JsonTokenDocumentV1) -> (result: JsonOrderWriterV1) {
    if parsed.valid {
        return write_json(parsed.root, writer_empty(), document, parsed.root_writer_steps);
    }
    return JsonOrderWriterV1 { ..writer_empty(), ok: false };
}

fn public_value_text_shape(document: JsonTokenDocumentV1) -> (result: DocumentShapeV1) {
    if document.byte_length == 0 && document.chunks.len == 0 {
        return DocumentShapeV1 { total: 0, valid: true };
    }
    return document_shape(document);
}

fn public_value_tape_digit(value: byte) -> (result: u64) {
    let number: u64 = value as u64;
    if number >= 48 && number <= 57 { return number -% 48; }
    if number >= 97 && number <= 102 { return number -% 87; }
    return 16;
}

fn invalid_public_value_node() -> (result: PublicValueNodeV1) {
    return PublicValueNodeV1 {
        kind: 255,
        has_key: false,
        key_start: 0,
        key_length: 0,
        text_start: 0,
        text_length: 0,
        magnitude: 0,
        negative: false,
        child_count: 0,
        valid: false
    };
}

fn public_value_tape_hex_step(
    state: PublicValueHexScanStateV1,
    chunk: JsonTokenInputChunkV1,
    terminator: byte,
    index: u64
) -> (result: PublicValueHexScanStateV1) {
    if !state.valid || state.done { return state; }
    if state.position >= chunk.length {
        return PublicValueHexScanStateV1 { ..state, valid: false };
    }
    let current: byte = chunk.bytes[state.position];
    if current == terminator {
        return PublicValueHexScanStateV1 {
            ..state,
            position: state.position +% 1,
            done: state.digits > 0,
            valid: state.digits > 0
        };
    }
    if index >= 16 || state.digits >= 16 {
        return PublicValueHexScanStateV1 { ..state, valid: false };
    }
    let digit: u64 = public_value_tape_digit(current);
    if digit > 15 { return PublicValueHexScanStateV1 { ..state, valid: false }; }
    return PublicValueHexScanStateV1 {
        ..state,
        value: state.value *% 16 +% digit,
        position: state.position +% 1,
        digits: state.digits +% 1
    };
}

fn public_value_tape_hex(
    chunk: JsonTokenInputChunkV1,
    start: u64,
    terminator: byte
) -> (result: PublicValueHexResultV1) {
    let initial: PublicValueHexScanStateV1 = PublicValueHexScanStateV1 {
        value: 0,
        position: start,
        digits: 0,
        done: false,
        valid: start < chunk.length
    };
    iterate i up_to 17 carrying scanned: PublicValueHexScanStateV1 = initial {
        next scanned = public_value_tape_hex_step(scanned, chunk, terminator, i);
    }
    return PublicValueHexResultV1 {
        value: scanned.value,
        next_offset: scanned.position,
        valid: scanned.valid && scanned.done
    };
}

fn public_value_key_span(
    chunk: JsonTokenInputChunkV1,
    start: u64,
    has_key: bool
) -> (result: PublicValueKeySpanResultV1) {
    if !has_key {
        return PublicValueKeySpanResultV1 {
            start: 0, length: 0, next_offset: start, valid: true
        };
    }
    let key_start: PublicValueHexResultV1 = public_value_tape_hex(chunk, start, 44);
    let key_length: PublicValueHexResultV1 = public_value_tape_hex(
        chunk, key_start.next_offset, 44
    );
    return PublicValueKeySpanResultV1 {
        start: key_start.value,
        length: key_length.value,
        next_offset: key_length.next_offset,
        valid: key_start.valid && key_length.valid
    };
}

fn public_value_payload(
    chunk: JsonTokenInputChunkV1,
    kind: byte,
    start: u64
) -> (result: PublicValuePayloadResultV1) {
    if kind <= 2 {
        let terminator_ok: bool = start < chunk.length && chunk.bytes[start] == 59;
        return PublicValuePayloadResultV1 {
            text_start: 0, text_length: 0, magnitude: 0, child_count: 0,
            next_offset: start +% 1, valid: terminator_ok
        };
    }
    if kind == 3 {
        let magnitude: PublicValueHexResultV1 = public_value_tape_hex(chunk, start, 59);
        return PublicValuePayloadResultV1 {
            text_start: 0, text_length: 0, magnitude: magnitude.value, child_count: 0,
            next_offset: magnitude.next_offset, valid: magnitude.valid
        };
    }
    if kind == 4 || kind == 7 {
        let text_start: PublicValueHexResultV1 = public_value_tape_hex(chunk, start, 44);
        let text_length: PublicValueHexResultV1 = public_value_tape_hex(
            chunk, text_start.next_offset, 59
        );
        return PublicValuePayloadResultV1 {
            text_start: text_start.value, text_length: text_length.value,
            magnitude: 0, child_count: 0, next_offset: text_length.next_offset,
            valid: text_start.valid && text_length.valid
        };
    }
    if kind == 5 || kind == 6 {
        let child_count: PublicValueHexResultV1 = public_value_tape_hex(chunk, start, 59);
        return PublicValuePayloadResultV1 {
            text_start: 0, text_length: 0, magnitude: 0,
            child_count: child_count.value, next_offset: child_count.next_offset,
            valid: child_count.valid
        };
    }
    return PublicValuePayloadResultV1 {
        text_start: 0, text_length: 0, magnitude: 0, child_count: 0,
        next_offset: start, valid: false
    };
}

fn public_value_node(chunk: JsonTokenInputChunkV1, start: u64) -> (result: PublicValueNodeReadResultV1) {
    if start > chunk.length || 2 as u64 > chunk.length -% start {
        return PublicValueNodeReadResultV1 { node: invalid_public_value_node(), next_offset: start };
    }
    let raw_kind: u64 = public_value_tape_digit(chunk.bytes[start]);
    let flags: u64 = public_value_tape_digit(chunk.bytes[start +% 1]);
    let kind_valid: bool = raw_kind <= 7;
    let kind: byte = select(kind_valid, raw_kind as byte, 255);
    let has_key: bool = flags == 1 || flags == 3;
    let negative: bool = flags == 2 || flags == 3;
    let key: PublicValueKeySpanResultV1 = public_value_key_span(
        chunk, start +% 2, has_key
    );
    let payload: PublicValuePayloadResultV1 = public_value_payload(
        chunk, kind, key.next_offset
    );
    let node: PublicValueNodeV1 = PublicValueNodeV1 {
        kind: kind,
        has_key: has_key,
        key_start: key.start,
        key_length: key.length,
        text_start: payload.text_start,
        text_length: payload.text_length,
        magnitude: payload.magnitude,
        negative: negative,
        child_count: payload.child_count,
        valid: kind_valid && flags <= 3 && key.valid && payload.valid
    };
    return PublicValueNodeReadResultV1 { node: node, next_offset: payload.next_offset };
}

fn public_value_tape_shape_step(
    state: PublicValueTapeShapeStateV1,
    chunk: JsonTokenInputChunkV1
) -> (result: PublicValueTapeShapeStateV1) {
    let valid_chunk: bool = chunk.length > 0 && chunk.length <= 1024
        && chunk.length == chunk.bytes.len;
    return PublicValueTapeShapeStateV1 {
        total: state.total +% chunk.length,
        valid: state.valid && valid_chunk
    };
}

fn public_value_tape_shape(request: PublicValueRequestV1) -> (result: DocumentShapeV1) {
    if request.node_count == 0 || request.node_count > 1024
        || request.node_tape.len == 0 || request.node_tape.len > 64 {
        return DocumentShapeV1 { total: 0, valid: false };
    }
    let initial: PublicValueTapeShapeStateV1 = PublicValueTapeShapeStateV1 {
        total: 0, valid: true
    };
    iterate i over request.node_tape carrying shape: PublicValueTapeShapeStateV1 = initial {
        next shape = public_value_tape_shape_step(shape, request.node_tape[i]);
    }
    return DocumentShapeV1 {
        total: shape.total,
        valid: shape.valid && shape.total > 0 && shape.total <= 65536
    };
}

fn valid_public_value_request(request: PublicValueRequestV1) -> (result: bool) {
    let text_shape: DocumentShapeV1 = public_value_text_shape(request.text);
    let tape_shape: DocumentShapeV1 = public_value_tape_shape(request);
    return same_bytes(request.schema_version, public_value_request_schema_v1())
        && request.node_count > 0 && request.node_count <= 1024
        && request.text.byte_length <= 65536 && text_shape.valid && tape_shape.valid;
}

fn public_value_number_byte_step(
    state: PublicValueNumberBytesV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: PublicValueNumberBytesV1) {
    if !state.valid || index >= length { return state; }
    return PublicValueNumberBytesV1 {
        bytes: replace(state.bytes, index, located_byte(document, start +% index)),
        valid: true
    };
}

fn public_value_number_slice(
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: [byte; up_to 64]) {
    if length == 0 || length > 64 || start > document.byte_length
        || length > document.byte_length -% start { return [0; 0]; }
    let initial: PublicValueNumberBytesV1 = PublicValueNumberBytesV1 {
        bytes: [0; 64],
        valid: true
    };
    iterate i up_to 64 carrying copied: PublicValueNumberBytesV1 = initial {
        next copied = public_value_number_byte_step(
            copied, document, start, length, i
        );
    }
    if !copied.valid { return [0; 0]; }
    return copied.bytes[0..length];
}

fn valid_public_value_node(
    document: JsonTokenDocumentV1,
    node: PublicValueNodeV1,
    expects_key: bool
) -> (result: bool) {
    let text_length: u64 = document.byte_length;
    if !node.valid || node.has_key != expects_key { return false; }
    if expects_key {
        if node.key_length > 256 || node.key_start > text_length
            || node.key_length > text_length -% node.key_start { return false; }
    }
    if !expects_key && (node.key_start != 0 || node.key_length != 0) { return false; }
    if node.kind == 4 {
        return node.text_start <= text_length
            && node.text_length <= text_length -% node.text_start
            && node.child_count == 0 && node.magnitude == 0 && !node.negative;
    }
    if node.kind == 7 {
        return node.text_start <= text_length
            && node.text_length > 0 && node.text_length <= 64
            && node.text_length <= text_length -% node.text_start
            && node.child_count == 0 && node.magnitude == 0 && !node.negative
            && json.scan(public_value_number_slice(
                document, node.text_start, node.text_length
            )) > 0;
    }
    if node.text_start != 0 || node.text_length != 0 { return false; }
    if node.kind <= 2 {
        return node.child_count == 0 && node.magnitude == 0 && !node.negative;
    }
    if node.kind == 3 { return node.child_count == 0; }
    if node.kind == 5 {
        return node.child_count <= 1024 && node.magnitude == 0 && !node.negative;
    }
    if node.kind == 6 {
        return node.child_count <= 642 && node.magnitude == 0 && !node.negative;
    }
    return false;
}

fn public_value_key_byte_step(
    state: PublicValueKeyCopyV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: PublicValueKeyCopyV1) {
    if !state.valid || index >= 256 { return state; }
    if index < length {
        let value: byte = located_byte(document, start +% index);
        let ordered_prefix: u64 = select(
            index < 8,
            state.ordered_prefix *% 256 +% (value as u64),
            state.ordered_prefix
        );
        return PublicValueKeyCopyV1 {
            ..state,
            bytes: replace(state.bytes, index, value),
            ordered_prefix: ordered_prefix,
            valid: true
        };
    }
    if index < 8 {
        return PublicValueKeyCopyV1 {
            ..state,
            ordered_prefix: state.ordered_prefix *% 256
        };
    }
    return state;
}

fn public_value_key(document: JsonTokenDocumentV1, node: PublicValueNodeV1) -> (result: KeyV1) {
    if !node.has_key || node.key_length > 256 || node.key_start > document.byte_length
        || node.key_length > document.byte_length -% node.key_start {
        return KeyV1 { ..empty_key(), valid: false };
    }
    let initial: PublicValueKeyCopyV1 = PublicValueKeyCopyV1 {
        bytes: [0; 256],
        ordered_prefix: 0,
        valid: true
    };
    iterate i up_to 256 carrying copied: PublicValueKeyCopyV1 = initial {
        next copied = public_value_key_byte_step(
            copied, document, node.key_start, node.key_length, i
        );
    }
    return KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: copied.bytes[0..node.key_length],
        ordered_length: node.key_length,
        ordered_prefix: copied.ordered_prefix,
        json_escaped: false,
        valid: copied.valid
    };
}

fn empty_public_build_frame() -> (result: PublicValueBuildFrameV1) {
    return PublicValueBuildFrameV1 {
        node_kind: 0,
        remaining: 0,
        child_key: empty_key(),
        items: JsonValueV1.Empty,
        child_count: 0,
        writer_steps: 0
    };
}

fn empty_public_build_state() -> (result: PublicValueBuildStateV1) {
    return PublicValueBuildStateV1 {
        frames: [empty_public_build_frame(); 12],
        depth: 0,
        root: JsonValueV1.Empty,
        root_writer_steps: 0,
        has_root: false,
        valid: true
    };
}

fn public_value_can_accept(state: PublicValueBuildStateV1) -> (result: bool) {
    if !state.valid { return false; }
    if state.depth == 0 { return !state.has_root; }
    return state.frames[state.depth -% 1].remaining > 0;
}

fn public_value_expects_key(state: PublicValueBuildStateV1) -> (result: bool) {
    if state.depth == 0 { return false; }
    return state.frames[state.depth -% 1].node_kind == 6;
}

fn public_value_append_child(
    state: PublicValueBuildStateV1,
    value: JsonValueV1,
    value_writer_steps: u64,
    key: KeyV1
) -> (result: PublicValueBuildStateV1) {
    if !public_value_can_accept(state) || is_empty_value(value) {
        return PublicValueBuildStateV1 { ..state, valid: false };
    }
    if state.depth == 0 {
        return PublicValueBuildStateV1 {
            ..state,
            root: value,
            root_writer_steps: value_writer_steps,
            has_root: true
        };
    }
    let frame_index: u64 = state.depth -% 1;
    let build_frame: PublicValueBuildFrameV1 = state.frames[frame_index];
    if build_frame.node_kind == 5 {
        let updated_build_frame: PublicValueBuildFrameV1 = PublicValueBuildFrameV1 {
            ..build_frame,
            remaining: build_frame.remaining -% 1,
            items: prepend_array(build_frame.items, value),
            child_count: build_frame.child_count +% 1,
            writer_steps: build_frame.writer_steps +% value_writer_steps +% 1
        };
        return PublicValueBuildStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, updated_build_frame),
            valid: !is_empty_value(updated_build_frame.items)
        };
    }
    if build_frame.node_kind == 6 && key.valid {
        let updated_build_frame: PublicValueBuildFrameV1 = PublicValueBuildFrameV1 {
            ..build_frame,
            remaining: build_frame.remaining -% 1,
            items: append_object_field(build_frame.items, key, value),
            child_count: build_frame.child_count +% 1,
            writer_steps: build_frame.writer_steps +% value_writer_steps +% key.ordered_length +% 1
        };
        return PublicValueBuildStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, updated_build_frame),
            valid: !is_empty_value(updated_build_frame.items)
        };
    }
    return PublicValueBuildStateV1 { ..state, valid: false };
}

fn public_value_close_one(state: PublicValueBuildStateV1) -> (result: PublicValueBuildStateV1) {
    let frame_index: u64 = state.depth -% 1;
    let build_frame: PublicValueBuildFrameV1 = state.frames[frame_index];
    if build_frame.remaining != 0 {
        return state;
    }
    if build_frame.node_kind == 5 {
        let value: JsonValueV1 = JsonValueV1.Array {
            items: reverse_array(build_frame.items, JsonValueV1.ArrayNil)
        };
        let popped: PublicValueBuildStateV1 = PublicValueBuildStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, empty_public_build_frame()),
            depth: frame_index
        };
        return public_value_append_child(
            popped, value, build_frame.writer_steps, build_frame.child_key
        );
    }
    let sorted: ObjectSortResultV1 = sort_object_fields_merge(
        build_frame.items, build_frame.child_count
    );
    if !sorted.valid { return PublicValueBuildStateV1 { ..state, valid: false }; }
    let object: JsonValueV1 = JsonValueV1.Object { fields: sorted.fields };
    let popped: PublicValueBuildStateV1 = PublicValueBuildStateV1 {
        ..state,
        frames: replace(state.frames, frame_index, empty_public_build_frame()),
        depth: frame_index
    };
    return public_value_append_child(
        popped, object, build_frame.writer_steps, build_frame.child_key
    );
}

fn public_value_settle_step(
    state: PublicValueBuildStateV1,
    index: u64
) -> (result: PublicValueBuildStateV1) {
    if !state.valid || state.depth == 0 { return state; }
    let frame: PublicValueBuildFrameV1 = state.frames[state.depth -% 1];
    if frame.remaining == 0 { return public_value_close_one(state); }
    return state;
}

fn public_value_settle(state: PublicValueBuildStateV1) -> (result: PublicValueBuildStateV1) {
    if !state.valid || state.depth == 0 { return state; }
    let top: PublicValueBuildFrameV1 = state.frames[state.depth -% 1];
    if top.remaining != 0 { return state; }
    iterate i up_to 12 carrying settled: PublicValueBuildStateV1 = state {
        next settled = public_value_settle_step(settled, i);
    }
    return settled;
}

fn public_value_open_container(
    state: PublicValueBuildStateV1,
    node: PublicValueNodeV1,
    key: KeyV1
) -> (result: PublicValueBuildStateV1) {
    if !public_value_can_accept(state) || state.depth >= 12 {
        return PublicValueBuildStateV1 { ..state, valid: false };
    }
    let is_array: bool = node.kind == 5;
    let items: JsonValueV1 = select(
        is_array,
        JsonValueV1.ArrayNil,
        JsonValueV1.ObjectNil
    );
    let build_frame: PublicValueBuildFrameV1 = PublicValueBuildFrameV1 {
        node_kind: node.kind,
        remaining: node.child_count,
        child_key: key,
        items: items,
        child_count: 0,
        writer_steps: 2
    };
    let opened: PublicValueBuildStateV1 = PublicValueBuildStateV1 {
        ..state,
        frames: replace(state.frames, state.depth, build_frame),
        depth: state.depth +% 1
    };
    return public_value_settle(opened);
}

fn public_value_process_node(
    state: PublicValueBuildStateV1,
    document: JsonTokenDocumentV1,
    node: PublicValueNodeV1,
    key: KeyV1
) -> (result: PublicValueBuildStateV1) {
    let expects_key: bool = public_value_expects_key(state);
    if !public_value_can_accept(state)
        || !valid_public_value_node(document, node, expects_key) {
        return PublicValueBuildStateV1 { ..state, valid: false };
    }
    if node.kind == 5 || node.kind == 6 {
        return public_value_open_container(state, node, key);
    }
    let value: JsonValueV1 = select(
        node.kind == 0,
        JsonValueV1.Null,
        select(
            node.kind == 1 || node.kind == 2,
            JsonValueV1.Boolean { value: node.kind == 2 },
            select(
                node.kind == 3,
                JsonValueV1.Integer { negative: node.negative, magnitude: node.magnitude },
                select(
                    node.kind == 4,
                    JsonValueV1.Utf8String { start: node.text_start, length: node.text_length },
                    JsonValueV1.Raw { start: node.text_start, length: node.text_length }
                )
            )
        )
    );
    let writer_steps: u64 = select(
        node.kind == 3,
        integer_digit_length(node.magnitude) +% select(node.negative, 1, 0),
        select(node.kind == 4, node.text_length +% 2,
            select(node.kind == 7, node.text_length, 1))
    );
    let leaf_key: KeyV1 = select(expects_key, key, empty_key());
    return public_value_settle(
        public_value_append_child(state, value, writer_steps, leaf_key)
    );
}

fn public_value_tape_node_step(
    cursor: PublicValueTapeCursorV1,
    chunk: JsonTokenInputChunkV1,
    document: JsonTokenDocumentV1
) -> (result: PublicValueTapeCursorV1) {
    if !cursor.build.valid || cursor.remaining_nodes == 0
        || cursor.offset >= chunk.length {
        return cursor;
    }
    let read: PublicValueNodeReadResultV1 = public_value_node(chunk, cursor.offset);
    let key: KeyV1 = public_value_node_key(cursor.build, document, read.node);
    let built: PublicValueBuildStateV1 = public_value_process_node(
        cursor.build, document, read.node, key
    );
    return PublicValueTapeCursorV1 {
        build: built,
        offset: read.next_offset,
        remaining_nodes: cursor.remaining_nodes -% 1
    };
}

fn public_value_node_key(
    state: PublicValueBuildStateV1,
    document: JsonTokenDocumentV1,
    node: PublicValueNodeV1
) -> (result: KeyV1) {
    if public_value_expects_key(state) { return public_value_key(document, node); }
    return empty_key();
}

fn public_value_tape_chunk_step(
    cursor: PublicValueTapeCursorV1,
    chunk: JsonTokenInputChunkV1,
    document: JsonTokenDocumentV1
) -> (result: PublicValueTapeCursorV1) {
    iterate i up_to 64 carrying parsed: PublicValueTapeCursorV1 = cursor {
        next parsed = public_value_tape_node_step(
            parsed, chunk, document
        );
    }
    if parsed.offset != chunk.length {
        return PublicValueTapeCursorV1 {
            ..parsed,
            build: PublicValueBuildStateV1 { ..parsed.build, valid: false },
            offset: 0
        };
    }
    return PublicValueTapeCursorV1 { ..parsed, offset: 0 };
}

fn empty_public_value_build() -> (result: PublicValueBuildResultV1) {
    return PublicValueBuildResultV1 {
        value: JsonValueV1.Empty,
        next_node: 0,
        writer_steps: 0,
        valid: false
    };
}

fn build_public_value(request: PublicValueRequestV1) -> (result: PublicValueBuildResultV1) {
    let initial: PublicValueTapeCursorV1 = PublicValueTapeCursorV1 {
        build: empty_public_build_state(),
        offset: 0,
        remaining_nodes: request.node_count
    };
    iterate i over request.node_tape carrying cursor: PublicValueTapeCursorV1 = initial {
        next cursor = public_value_tape_chunk_step(
            cursor, request.node_tape[i], request.text
        );
    }
    let built: PublicValueBuildStateV1 = public_value_settle(cursor.build);
    let valid: bool = built.valid && built.depth == 0 && built.has_root
        && cursor.remaining_nodes == 0;
    return PublicValueBuildResultV1 {
        value: built.root,
        next_node: request.node_count,
        writer_steps: built.root_writer_steps,
        valid: valid
    };
}

fn public_value_input_result(
    supported: bool,
    node_count: u64,
    writer: JsonOrderWriterV1
) -> (result: PublicValueInputResultV1) {
    let built: JsonOrderChunkBuilderV1 = output_chunks(writer);
    let ready: bool = supported && writer.ok && writer.length > 0
        && writer.length <= 65536 && built.count > 0 && built.count <= 64;
    let output_digest: [byte; up_to 64] = select(
        ready,
        encode_digest(sha256.finalize_standard(
            digest_writer_seeded(writer, sha256.init())
        )),
        []
    );
    return PublicValueInputResultV1 {
        schema_version: public_value_result_schema_v1(),
        supported: ready,
        node_count: select(ready, node_count, 0),
        document_length: select(ready, writer.length, 0),
        chunk_count: select(ready, built.count, 0),
        output_sha256: output_digest,
        chunks: select(ready, built.chunks[0..built.count], built.chunks[0..0])
    };
}

fn public_result_json_value_input_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 118, 97, 108, 117, 101, 45, 105, 110, 112, 117, 116, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: PublicValueRequestV1 = structured_read(
        context.argv[0], public_value_request_schema_v1()
    );
    let request_valid: bool = valid_public_value_request(request);
    let built: PublicValueBuildResultV1 = select(
        request_valid,
        build_public_value(request),
        empty_public_value_build()
    );
    let complete: bool = request_valid && built.valid && built.next_node == request.node_count;
    let writer: JsonOrderWriterV1 = select(
        complete,
        write_pretty_json(built.value, writer_empty(), request.text, request.node_count),
        JsonOrderWriterV1 { ..writer_empty(), ok: false }
    );
    let result: PublicValueInputResultV1 = public_value_input_result(
        complete && writer.ok, request.node_count, writer
    );
    let published: u64 = structured_write(
        context.argv[1], public_value_result_schema_v1(), result
    );
    if published == 0 {
        return failure([112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 118, 97, 108, 117, 101, 32, 105, 110, 112, 117, 116, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}

fn valid_order_request(request: JsonOrderRequestV1, shape: DocumentShapeV1) -> (result: bool) {
    if !same_bytes(request.schema_version, request_schema_v1()) || !shape.valid
        || request.document.byte_length > 65536 || request.input_sha256.len != 64 {
        return false;
    }
    return same_bytes(request.input_sha256, document_digest(request.document));
}

fn public_result_json_key_order_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 107, 101, 121, 45, 111, 114, 100, 101, 114, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: JsonOrderRequestV1 = structured_read(context.argv[0], request_schema_v1());
    let shape: DocumentShapeV1 = document_shape(request.document);
    let request_valid: bool = valid_order_request(request, shape);
    let parsed: ParseStateV1 = parse_key_order_checked(request.document, request_valid);
    let writer: JsonOrderWriterV1 = writer_for_parse(parsed, request.document);
    let result: JsonOrderResultV1 = order_result(request_valid && parsed.valid, request.input_sha256, writer);
    let published: u64 = structured_write(context.argv[1], result_schema_v1(), result);
    if published == 0 {
        return failure([112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 107, 101, 121, 45, 111, 114, 100, 101, 114, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
