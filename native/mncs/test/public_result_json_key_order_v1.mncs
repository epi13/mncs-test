mncs 0.18;

// Canonicalize compact public-result JSON without a host-built value tree.
// Input and output stay within sixty-four UTF-8-safe 1 KiB chunks. JSON values are
// represented as bounded recursive MNCS variants; object members are inserted
// into Unicode-ordered lists as the token cursor closes each value.
module mncs.test.public_result_json_key_order_v1;

use mncs.std.application.v1;
use mncs.std.json.v1 as json;
use mncs.std.sha256.v1 as sha256;

record JsonTokenInputChunkV1 {
    bytes: [byte; up_to 1024],
    length: u64
}

record JsonTokenDocumentV1 {
    chunks: [JsonTokenInputChunkV1; up_to 64],
    byte_length: u64
}

record DocumentShapeV1 { total: u64, valid: bool }

record KeyV1 {
    raw_start: u64,
    raw_length: u64,
    ordered: [byte; up_to 256],
    ordered_length: u64,
    valid: bool
}

enum JsonValueV1 {
    Empty,
    Null,
    Raw { start: u64, length: u64 },
    String { start: u64, length: u64 },
    Array { items: JsonValueV1 },
    Object { fields: JsonValueV1 },
    ArrayNil,
    ArrayCons { head: JsonValueV1, tail: JsonValueV1 },
    ObjectNil,
    ObjectCons { key: KeyV1, value: JsonValueV1, tail: JsonValueV1 }
}

record FrameV1 {
    kind: byte,
    items: JsonValueV1,
    pending_key: KeyV1,
    has_pending_key: bool,
    child_count: u64,
    expect: byte
}

record ParseStateV1 {
    frames: [FrameV1; 12],
    depth: u64,
    root: JsonValueV1,
    has_root: bool,
    string_start: u64,
    in_string: bool,
    string_escape: bool,
    string_is_key: bool,
    scalar_start: u64,
    scalar_active: bool,
    value_count: u64,
    valid: bool
}

record DecodeStateV1 {
    bytes: [byte; 512],
    length: u64,
    escaped: bool,
    skip: u64,
    valid: bool
}
record KeyCopyV1 { bytes: [byte; 256], length: u64 }
record JsonDecodedStringV1 { bytes: [byte; up_to 512], length: u64, valid: bool }

record LocatedByteV1 { base: u64, value: byte }

enum KeyOrderV1 { Before, Equal, After }

record JsonOrderRequestV1 {
    schema_version: [byte; up_to 64],
    document: JsonTokenDocumentV1,
    input_sha256: [byte; up_to 64]
}

record JsonOrderChunkV1 { bytes: [byte; 1024], length: u64 }

enum JsonOrderChunkListV1 {
    ChunkNil,
    ChunkCons { head: JsonOrderChunkV1, tail: JsonOrderChunkListV1 }
}

record JsonOrderWriterV1 {
    current_bytes: [byte; 1024],
    current_length: u64,
    completed: JsonOrderChunkListV1,
    completed_count: u64,
    length: u64,
    ok: bool
}

record WriterSourceStateV1 { writer: JsonOrderWriterV1, base: u64 }

record JsonOrderChunkBuilderV1 {
    chunks: [JsonOrderChunkV1; 64],
    count: u64
}

record JsonOrderResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    input_sha256: [byte; up_to 64],
    document_length: u64,
    chunk_count: u64,
    chunks: [JsonOrderChunkV1; up_to 64]
}

fn request_schema_v1() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 107, 101, 121, 45, 111, 114, 100, 101, 114, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn result_schema_v1() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 107, 101, 121, 45, 111, 114, 100, 101, 114, 47, 49];
}

fn same_bytes(left: [byte; up_to 64], right: [byte; up_to 64]) -> (result: bool) {
    if left.len != right.len { return false; }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn document_shape(document: JsonTokenDocumentV1) -> (result: DocumentShapeV1) {
    let initial: DocumentShapeV1 = DocumentShapeV1 { total: 0, valid: true };
    iterate i over document.chunks carrying shape: DocumentShapeV1 = initial {
        let chunk: JsonTokenInputChunkV1 = document.chunks[i];
        let valid_chunk: bool = chunk.length > 0 && chunk.length <= 1024
            && chunk.length == chunk.bytes.len && shape.total +% chunk.length <= 65536;
        next shape = DocumentShapeV1 {
            total: shape.total +% chunk.length,
            valid: shape.valid && valid_chunk
        };
    }
    return DocumentShapeV1 {
        total: shape.total,
        valid: shape.valid && document.chunks.len > 0 && document.chunks.len <= 64
            && document.byte_length == shape.total && document.byte_length <= 65536
    };
}

fn document_offset_step(total: u64, chunk: JsonTokenInputChunkV1, index: u64, target: u64) -> (result: u64) {
    if index < target { return total +% chunk.length; }
    return total;
}

fn document_offset_at(document: JsonTokenDocumentV1, chunk_index: u64, chunk_offset: u64) -> (result: u64) {
    iterate i over document.chunks carrying total: u64 = 0 {
        next total = document_offset_step(total, document.chunks[i], i, chunk_index);
    }
    if chunk_index >= document.chunks.len { return total; }
    return total +% chunk_offset;
}

fn json_space(value: byte) -> (result: bool) {
    return value == 9 || value == 10 || value == 13 || value == 32;
}

fn scalar_boundary(value: byte) -> (result: bool) {
    return json_space(value) || value == 34 || value == 123 || value == 125
        || value == 91 || value == 93 || value == 44 || value == 58;
}

fn hex_value(value: byte) -> (result: u64) {
    let number: u64 = value as u64;
    if number >= 48 && number <= 57 { return number -% 48; }
    if number >= 65 && number <= 70 { return number -% 55; }
    return number -% 87;
}

fn decode_hex4(document: JsonTokenDocumentV1, start: u64, index: u64) -> (result: u64) {
    let a: u64 = hex_value(located_byte(document, start +% index));
    let b: u64 = hex_value(located_byte(document, start +% index +% 1));
    let c: u64 = hex_value(located_byte(document, start +% index +% 2));
    let d: u64 = hex_value(located_byte(document, start +% index +% 3));
    return a *% 4096 +% b *% 256 +% c *% 16 +% d;
}

fn decoded_byte(state: DecodeStateV1, value: byte) -> (result: DecodeStateV1) {
    if !state.valid || state.length >= 512 {
        return DecodeStateV1 { ..state, valid: false };
    }
    return DecodeStateV1 {
        ..state,
        bytes: replace(state.bytes, state.length, value),
        length: state.length +% 1
    };
}

fn decoded_codepoint(state: DecodeStateV1, value: u64) -> (result: DecodeStateV1) {
    if value <= 127 { return decoded_byte(state, value as byte); }
    if value <= 2047 {
        let first: DecodeStateV1 = decoded_byte(state, (192 +% (value / 64)) as byte);
        return decoded_byte(first, (128 +% (value % 64)) as byte);
    }
    if value <= 65535 && !(value >= 55296 && value <= 57343) {
        let first: DecodeStateV1 = decoded_byte(state, (224 +% (value / 4096)) as byte);
        let second: DecodeStateV1 = decoded_byte(first, (128 +% ((value / 64) % 64)) as byte);
        return decoded_byte(second, (128 +% (value % 64)) as byte);
    }
    if value <= 1114111 {
        let first: DecodeStateV1 = decoded_byte(state, (240 +% (value / 262144)) as byte);
        let second: DecodeStateV1 = decoded_byte(first, (128 +% ((value / 4096) % 64)) as byte);
        let third: DecodeStateV1 = decoded_byte(second, (128 +% ((value / 64) % 64)) as byte);
        return decoded_byte(third, (128 +% (value % 64)) as byte);
    }
    return DecodeStateV1 { ..state, valid: false };
}

fn decode_key_step(
    state: DecodeStateV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: DecodeStateV1) {
    if index >= length { return state; }
    let value: byte = located_byte(document, start +% index);
    if state.skip > 0 {
        return DecodeStateV1 { ..state, skip: state.skip -% 1 };
    }
    if state.escaped {
        if value == 117 {
            if index +% 4 >= length {
                return DecodeStateV1 { ..state, valid: false, escaped: false };
            }
            let code: u64 = decode_hex4(document, start, index +% 1);
            if code >= 55296 && code <= 56319 {
                if index +% 10 >= length
                    || located_byte(document, start +% index +% 5) != 92
                    || located_byte(document, start +% index +% 6) != 117 {
                    return DecodeStateV1 { ..state, valid: false, escaped: false };
                }
                let low: u64 = decode_hex4(document, start, index +% 7);
                if low < 56320 || low > 57343 {
                    return DecodeStateV1 { ..state, valid: false, escaped: false };
                }
                let point: u64 = 65536 +% (code -% 55296) *% 1024 +% (low -% 56320);
                return DecodeStateV1 {
                    ..decoded_codepoint(state, point),
                    escaped: false,
                    skip: 10
                };
            }
            if code >= 56320 && code <= 57343 {
                return DecodeStateV1 { ..state, valid: false, escaped: false };
            }
            return DecodeStateV1 {
                ..decoded_codepoint(state, code),
                escaped: false,
                skip: 4
            };
        }
        if value == 34 || value == 92 || value == 47 {
            return DecodeStateV1 { ..decoded_byte(state, value), escaped: false };
        }
        if value == 98 { return DecodeStateV1 { ..decoded_byte(state, 8), escaped: false }; }
        if value == 102 { return DecodeStateV1 { ..decoded_byte(state, 12), escaped: false }; }
        if value == 110 { return DecodeStateV1 { ..decoded_byte(state, 10), escaped: false }; }
        if value == 114 { return DecodeStateV1 { ..decoded_byte(state, 13), escaped: false }; }
        if value == 116 { return DecodeStateV1 { ..decoded_byte(state, 9), escaped: false }; }
        return DecodeStateV1 { ..state, valid: false, escaped: false };
    }
    if value == 92 { return DecodeStateV1 { ..state, escaped: true }; }
    return decoded_byte(state, value);
}

fn copy_decoded_key_byte(state: KeyCopyV1, decoded: DecodeStateV1, index: u64) -> (result: KeyCopyV1) {
    if index >= decoded.length || index >= 256 { return state; }
    return KeyCopyV1 {
        bytes: replace(state.bytes, state.length, decoded.bytes[index]),
        length: state.length +% 1
    };
}

fn compare_key_step(order: i64, left: KeyV1, right: KeyV1, index: u64, common: u64) -> (result: i64) {
    if index >= common || order != 0 { return order; }
    if left.ordered[index] < right.ordered[index] { return -1; }
    if left.ordered[index] > right.ordered[index] { return 1; }
    return order;
}

fn decode_key(document: JsonTokenDocumentV1, raw_start: u64, raw_length: u64) -> (result: KeyV1) {
    let initial: DecodeStateV1 = DecodeStateV1 {
        bytes: [0; 512], length: 0, escaped: false, skip: 0, valid: true
    };
    iterate i up_to 256 carrying decoded: DecodeStateV1 = initial {
        next decoded = decode_key_step(decoded, document, raw_start, raw_length, i);
    }
    let key_initial: KeyCopyV1 = KeyCopyV1 { bytes: [0; 256], length: 0 };
    iterate i up_to 256 carrying key_bytes: KeyCopyV1 = key_initial {
        next key_bytes = copy_decoded_key_byte(key_bytes, decoded, i);
    }
    return KeyV1 {
        raw_start: raw_start,
        raw_length: raw_length,
        ordered: key_bytes.bytes[0..key_bytes.length],
        ordered_length: decoded.length,
        valid: raw_length <= 256 && decoded.valid && !decoded.escaped
            && decoded.skip == 0 && key_bytes.length == decoded.length
    };
}

fn decode_string(document: JsonTokenDocumentV1, raw_start: u64, raw_length: u64) -> (result: JsonDecodedStringV1) {
    let initial: DecodeStateV1 = DecodeStateV1 {
        bytes: [0; 512], length: 0, escaped: false, skip: 0, valid: true
    };
    iterate i up_to 512 carrying decoded: DecodeStateV1 = initial {
        next decoded = decode_key_step(decoded, document, raw_start, raw_length, i);
    }
    return JsonDecodedStringV1 {
        bytes: decoded.bytes[0..decoded.length],
        length: decoded.length,
        valid: raw_length <= 512 && decoded.valid && !decoded.escaped && decoded.skip == 0
    };
}

fn compare_key(left: KeyV1, right: KeyV1) -> (result: KeyOrderV1) {
    let common: u64 = select(left.ordered_length < right.ordered_length, left.ordered_length, right.ordered_length);
    let shared: [byte; up_to 256] = left.ordered[0..common];
    iterate i over shared carrying order: i64 = 0 {
        next order = compare_key_step(order, left, right, i, common);
    }
    if order < 0 { return KeyOrderV1.Before; }
    if order > 0 { return KeyOrderV1.After; }
    if left.ordered_length < right.ordered_length { return KeyOrderV1.Before; }
    if left.ordered_length > right.ordered_length { return KeyOrderV1.After; }
    return KeyOrderV1.Equal;
}

fn wrap_inserted_field(key: KeyV1, value: JsonValueV1, tail: JsonValueV1) -> (result: JsonValueV1) {
    if is_empty_value(tail) { return JsonValueV1.Empty; }
    return JsonValueV1.ObjectCons { key: key, value: value, tail: tail };
}

fn insert_field(fields: JsonValueV1, key: KeyV1, value: JsonValueV1) -> (result: JsonValueV1) {
    return match fields {
        ObjectNil => JsonValueV1.ObjectCons { key: key, value: value, tail: JsonValueV1.ObjectNil },
        ObjectCons { key: current_key, value: current_value, tail: tail } => match compare_key(key, current_key) {
            Before => JsonValueV1.ObjectCons { key: key, value: value, tail: fields },
            Equal => JsonValueV1.Empty,
            After => wrap_inserted_field(current_key, current_value, insert_field(tail, key, value))
        },
        Empty => JsonValueV1.Empty,
        Null => JsonValueV1.Empty,
        Raw { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        String { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        Array { items: items } => JsonValueV1.Empty,
        Object { fields: nested } => JsonValueV1.Empty,
        ArrayNil => JsonValueV1.Empty,
        ArrayCons { head: head, tail: tail } => JsonValueV1.Empty
    };
}

fn prepend_array(items: JsonValueV1, value: JsonValueV1) -> (result: JsonValueV1) {
    return match items {
        ArrayNil => JsonValueV1.ArrayCons { head: value, tail: JsonValueV1.ArrayNil },
        ArrayCons { head: head, tail: tail } => JsonValueV1.ArrayCons { head: value, tail: items },
        Empty => JsonValueV1.Empty,
        Null => JsonValueV1.Empty,
        Raw { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        String { start: raw_start, length: raw_length } => JsonValueV1.Empty,
        Array { items: nested } => JsonValueV1.Empty,
        Object { fields: nested } => JsonValueV1.Empty,
        ObjectNil => JsonValueV1.Empty,
        ObjectCons { key: key, value: inner, tail: tail } => JsonValueV1.Empty
    };
}

fn reverse_array(items: JsonValueV1, accumulated: JsonValueV1) -> (result: JsonValueV1) {
    return match items {
        ArrayNil => accumulated,
        ArrayCons { head: head, tail: tail } => reverse_array(
            tail, JsonValueV1.ArrayCons { head: head, tail: accumulated }
        ),
        Empty => accumulated,
        Null => accumulated,
        Raw { start: raw_start, length: raw_length } => accumulated,
        String { start: raw_start, length: raw_length } => accumulated,
        Array { items: nested } => accumulated,
        Object { fields: nested } => accumulated,
        ObjectNil => accumulated,
        ObjectCons { key: key, value: inner, tail: rest } => accumulated
    };
}

fn empty_key() -> (result: KeyV1) {
    return KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: [0; 0],
        ordered_length: 0,
        valid: true
    };
}

fn is_empty_value(value: JsonValueV1) -> (result: bool) {
    return match value {
        Empty => true,
        Null => false,
        Raw { start: raw_start, length: raw_length } => false,
        String { start: raw_start, length: raw_length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn empty_frame(kind: byte) -> (result: FrameV1) {
    return FrameV1 {
        kind: kind,
        items: select(kind == 1, JsonValueV1.ObjectNil, JsonValueV1.ArrayNil),
        pending_key: empty_key(),
        has_pending_key: false,
        child_count: 0,
        expect: select(kind == 1, 1, 5)
    };
}

fn locate_byte_step(found: LocatedByteV1, chunk: JsonTokenInputChunkV1, position: u64) -> (result: LocatedByteV1) {
    let local: u64 = position -% found.base;
    if position >= found.base && local < chunk.length {
        return LocatedByteV1 { base: found.base +% chunk.length, value: chunk.bytes[local] };
    }
    return LocatedByteV1 { ..found, base: found.base +% chunk.length };
}

fn located_byte(document: JsonTokenDocumentV1, position: u64) -> (result: byte) {
    let initial: LocatedByteV1 = LocatedByteV1 { base: 0, value: 0 };
    iterate i over document.chunks carrying found: LocatedByteV1 = initial {
        next found = locate_byte_step(found, document.chunks[i], position);
    }
    return found.value;
}

fn append_value(state: ParseStateV1, value: JsonValueV1) -> (result: ParseStateV1) {
    if !state.valid || state.value_count >= 512 { return ParseStateV1 { ..state, valid: false }; }
    if state.depth == 0 {
        if state.has_root { return ParseStateV1 { ..state, valid: false }; }
        return ParseStateV1 { ..state, root: value, has_root: true, value_count: state.value_count +% 1 };
    }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    if frame.kind == 2 && frame.expect == 5 {
        let prepended: JsonValueV1 = prepend_array(frame.items, value);
        let updated_frame: FrameV1 = FrameV1 {
            ..frame,
            items: prepended,
            child_count: frame.child_count +% 1,
            expect: 6
        };
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, updated_frame),
            value_count: state.value_count +% 1,
            valid: !is_empty_value(prepended)
        };
    }
    if frame.kind == 1 && frame.expect == 3 && frame.has_pending_key && frame.child_count < 64 {
        let inserted: JsonValueV1 = insert_field(frame.items, frame.pending_key, value);
        let updated_frame: FrameV1 = FrameV1 {
            ..frame,
            items: inserted,
            pending_key: empty_key(),
            has_pending_key: false,
            child_count: frame.child_count +% 1,
            expect: 4
        };
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, updated_frame),
            value_count: state.value_count +% 1,
            valid: !is_empty_value(inserted)
        };
    }
    return ParseStateV1 { ..state, valid: false };
}

fn finalize_scalar(state: ParseStateV1, position: u64) -> (result: ParseStateV1) {
    if !state.scalar_active { return state; }
    if position <= state.scalar_start {
        return ParseStateV1 { ..state, scalar_active: false, valid: false };
    }
    let appended: ParseStateV1 = append_value(
        ParseStateV1 { ..state, scalar_active: false },
        JsonValueV1.Raw { start: state.scalar_start, length: position -% state.scalar_start }
    );
    return appended;
}

fn maybe_finalize_scalar(state: ParseStateV1, position: u64, boundary: bool) -> (result: ParseStateV1) {
    if boundary { return finalize_scalar(state, position); }
    return state;
}

fn container_value(frame: FrameV1) -> (result: JsonValueV1) {
    if frame.kind == 1 { return JsonValueV1.Object { fields: frame.items }; }
    return JsonValueV1.Array { items: reverse_array(frame.items, JsonValueV1.ArrayNil) };
}

fn parse_chunk_step(parsed: ParseStateV1, document: JsonTokenDocumentV1, base: u64, chunk: JsonTokenInputChunkV1, index: u64) -> (result: ParseStateV1) {
    if index < chunk.length {
        return parse_step(parsed, document, base +% index, chunk.bytes[index]);
    }
    return parsed;
}

fn parse_expects_key(state: ParseStateV1) -> (result: bool) {
    if state.depth == 0 { return false; }
    let frame: FrameV1 = state.frames[state.depth -% 1];
    return frame.kind == 1 && frame.expect == 1;
}

fn parse_expects_value(state: ParseStateV1) -> (result: bool) {
    if state.depth == 0 { return !state.has_root; }
    let frame: FrameV1 = state.frames[state.depth -% 1];
    return (frame.kind == 1 && frame.expect == 3)
        || (frame.kind == 2 && frame.expect == 5);
}

fn parse_string_step(
    state: ParseStateV1,
    document: JsonTokenDocumentV1,
    position: u64,
    value: byte
) -> (result: ParseStateV1) {
    if state.string_escape {
        return ParseStateV1 { ..state, string_escape: false };
    }
    if value == 92 { return ParseStateV1 { ..state, string_escape: true }; }
    if value != 34 { return state; }
    let closed: ParseStateV1 = ParseStateV1 { ..state, in_string: false };
    let raw_start: u64 = state.string_start +% 1;
    let raw_length: u64 = position -% raw_start;
    if state.string_is_key {
        if closed.depth == 0 || raw_length > 256 {
            return ParseStateV1 { ..closed, valid: false };
        }
        let frame_index: u64 = closed.depth -% 1;
        let frame: FrameV1 = closed.frames[frame_index];
        let key: KeyV1 = decode_key(document, raw_start, raw_length);
        if frame.kind != 1 || frame.expect != 1 || frame.has_pending_key || !key.valid {
            return ParseStateV1 { ..closed, valid: false };
        }
        return ParseStateV1 {
            ..closed,
            frames: replace(closed.frames, frame_index, FrameV1 {
                ..frame,
                pending_key: key,
                has_pending_key: true,
                expect: 2
            })
        };
    }
    return append_value(
        closed,
        JsonValueV1.String { start: raw_start, length: raw_length }
    );
}

fn parse_open_container(state: ParseStateV1, value: byte) -> (result: ParseStateV1) {
    if !parse_expects_value(state) || state.depth >= 12 {
        return ParseStateV1 { ..state, valid: false };
    }
    let kind: byte = select(value == 123, 1, 2);
    let frame: FrameV1 = empty_frame(kind);
    return ParseStateV1 {
        ..state,
        frames: replace(state.frames, state.depth, frame),
        depth: state.depth +% 1
    };
}

fn parse_close_container(state: ParseStateV1, value: byte) -> (result: ParseStateV1) {
    if state.depth == 0 { return ParseStateV1 { ..state, valid: false }; }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    let correct: bool = (value == 125 && frame.kind == 1 && (frame.expect == 1 || frame.expect == 4))
        || (value == 93 && frame.kind == 2 && (frame.expect == 5 || frame.expect == 6));
    if !correct || frame.has_pending_key { return ParseStateV1 { ..state, valid: false }; }
    let container: JsonValueV1 = container_value(frame);
    let popped: ParseStateV1 = ParseStateV1 { ..state, depth: frame_index };
    return append_value(popped, container);
}

fn parse_comma(state: ParseStateV1) -> (result: ParseStateV1) {
    if state.depth == 0 { return ParseStateV1 { ..state, valid: false }; }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    if frame.kind == 1 && frame.expect == 4 {
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, FrameV1 { ..frame, expect: 1 })
        };
    }
    if frame.kind == 2 && frame.expect == 6 {
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, FrameV1 { ..frame, expect: 5 })
        };
    }
    return ParseStateV1 { ..state, valid: false };
}

fn parse_colon(state: ParseStateV1) -> (result: ParseStateV1) {
    if state.depth == 0 { return ParseStateV1 { ..state, valid: false }; }
    let frame_index: u64 = state.depth -% 1;
    let frame: FrameV1 = state.frames[frame_index];
    if frame.kind == 1 && frame.expect == 2 && frame.has_pending_key {
        return ParseStateV1 {
            ..state,
            frames: replace(state.frames, frame_index, FrameV1 { ..frame, expect: 3 })
        };
    }
    return ParseStateV1 { ..state, valid: false };
}

fn parse_step(state: ParseStateV1, document: JsonTokenDocumentV1, position: u64, value: byte) -> (result: ParseStateV1) {
    if state.in_string { return parse_string_step(state, document, position, value); }
    let boundary: bool = scalar_boundary(value);
    let advanced: ParseStateV1 = maybe_finalize_scalar(state, position, boundary);
    if !advanced.valid { return advanced; }
    if json_space(value) { return advanced; }
    if value == 34 {
        if parse_expects_key(advanced) {
            return ParseStateV1 {
                ..advanced,
                string_start: position,
                in_string: true,
                string_escape: false,
                string_is_key: true
            };
        }
        if parse_expects_value(advanced) {
            return ParseStateV1 {
                ..advanced,
                string_start: position,
                in_string: true,
                string_escape: false,
                string_is_key: false
            };
        }
        return ParseStateV1 { ..advanced, valid: false };
    }
    if value == 123 || value == 91 { return parse_open_container(advanced, value); }
    if value == 125 || value == 93 { return parse_close_container(advanced, value); }
    if value == 44 { return parse_comma(advanced); }
    if value == 58 { return parse_colon(advanced); }
    if !advanced.scalar_active {
        if !parse_expects_value(advanced) { return ParseStateV1 { ..advanced, valid: false }; }
        return ParseStateV1 { ..advanced, scalar_start: position, scalar_active: true };
    }
    return advanced;
}

fn empty_parse_state() -> (result: ParseStateV1) {
    let frame: FrameV1 = empty_frame(0);
    return ParseStateV1 {
        frames: [frame; 12],
        depth: 0,
        root: JsonValueV1.Empty,
        has_root: false,
        string_start: 0,
        in_string: false,
        string_escape: false,
        string_is_key: false,
        scalar_start: 0,
        scalar_active: false,
        value_count: 0,
        valid: true
    };
}

fn parse_chunk(state: ParseStateV1, document: JsonTokenDocumentV1, chunk_index: u64) -> (result: ParseStateV1) {
    let chunk: JsonTokenInputChunkV1 = document.chunks[chunk_index];
    let base: u64 = document_offset_at(document, chunk_index, 0);
    iterate i up_to 1024 carrying parsed: ParseStateV1 = state {
        next parsed = parse_chunk_step(parsed, document, base, chunk, i);
    }
    return parsed;
}

fn scan_document_part(scanned: json.ScanState, chunk: JsonTokenInputChunkV1, index: u64) -> (result: json.ScanState) {
    let start: u64 = index *% 64;
    if start >= chunk.length { return scanned; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    return json.feed_chunk(scanned, chunk.bytes[start..start +% size]);
}

fn scan_document_chunk(scanned: json.ScanState, chunk: JsonTokenInputChunkV1) -> (result: json.ScanState) {
    iterate i up_to 16 carrying current: json.ScanState = scanned {
        next current = scan_document_part(current, chunk, i);
    }
    return current;
}

fn scan_document(document: JsonTokenDocumentV1) -> (result: json.ScanState) {
    iterate i over document.chunks carrying scanned: json.ScanState = json.init() {
        next scanned = scan_document_chunk(scanned, document.chunks[i]);
    }
    return json.finish(scanned);
}

fn parse_document(document: JsonTokenDocumentV1) -> (result: ParseStateV1) {
    iterate i over document.chunks carrying parsed: ParseStateV1 = empty_parse_state() {
        next parsed = parse_chunk(parsed, document, i);
    }
    let finalized: ParseStateV1 = finalize_scalar(parsed, document.byte_length);
    return ParseStateV1 {
        ..finalized,
        valid: finalized.valid && !finalized.in_string
            && finalized.depth == 0 && finalized.has_root
    };
}

fn writer_empty() -> (result: JsonOrderWriterV1) {
    return JsonOrderWriterV1 {
        current_bytes: [0; 1024],
        current_length: 0,
        completed: JsonOrderChunkListV1.ChunkNil,
        completed_count: 0,
        length: 0,
        ok: true
    };
}

fn writer_next_chunk(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    let finished: JsonOrderChunkV1 = JsonOrderChunkV1 {
        bytes: writer.current_bytes,
        length: 1024
    };
    let empty: [byte; 1024] = [0; 1024];
    return JsonOrderWriterV1 {
        ..writer,
        current_bytes: replace(empty, 0, value),
        current_length: 1,
        completed: JsonOrderChunkListV1.ChunkCons {
            head: finished,
            tail: writer.completed
        },
        completed_count: writer.completed_count +% 1,
        length: writer.length +% 1
    };
}

fn writer_byte(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    if !writer.ok || writer.length >= 65536 { return JsonOrderWriterV1 { ..writer, ok: false }; }
    if writer.current_length >= 1024 { return writer_next_chunk(writer, value); }
    let updated: [byte; 1024] = replace(writer.current_bytes, writer.current_length, value);
    return JsonOrderWriterV1 {
        ..writer,
        current_bytes: updated,
        current_length: writer.current_length +% 1,
        length: writer.length +% 1
    };
}

fn writer_bytes(writer: JsonOrderWriterV1, input: [byte; up_to 1024]) -> (result: JsonOrderWriterV1) {
    iterate i over input carrying output: JsonOrderWriterV1 = writer {
        next output = writer_append_step(output, input[i]);
    }
    return output;
}

fn writer_append_step(writer: JsonOrderWriterV1, value: byte) -> (result: JsonOrderWriterV1) {
    if writer.ok { return writer_byte(writer, value); }
    return writer;
}

fn is_array_nil(value: JsonValueV1) -> (result: bool) {
    return match value {
        ArrayNil => true,
        Empty => false,
        Null => false,
        Raw { start: raw_start, length: raw_length } => false,
        String { start: raw_start, length: raw_length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn is_object_nil(value: JsonValueV1) -> (result: bool) {
    return match value {
        ObjectNil => true,
        Empty => false,
        Null => false,
        Raw { start: raw_start, length: raw_length } => false,
        String { start: raw_start, length: raw_length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn writer_source_chunk_step(
    state: WriterSourceStateV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64
) -> (result: WriterSourceStateV1) {
    let chunk: JsonTokenInputChunkV1 = document.chunks[index];
    let chunk_start: u64 = state.base;
    let chunk_end: u64 = chunk_start +% chunk.length;
    let range_end: u64 = start +% length;
    let copy_start: u64 = select(start > chunk_start, start, chunk_start);
    let copy_end: u64 = select(range_end < chunk_end, range_end, chunk_end);
    if copy_start < copy_end {
        let source_start: u64 = copy_start -% chunk_start;
        let source_end: u64 = copy_end -% chunk_start;
        let source: [byte; up_to 1024] = chunk.bytes[source_start..source_end];
        return WriterSourceStateV1 {
            writer: writer_bytes(state.writer, source),
            base: chunk_end
        };
    }
    return WriterSourceStateV1 { ..state, base: chunk_end };
}

fn writer_source_range(
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: JsonOrderWriterV1) {
    if length > 65536 || start > document.byte_length || length > document.byte_length -% start {
        return JsonOrderWriterV1 { ..writer, ok: false };
    }
    let initial: WriterSourceStateV1 = WriterSourceStateV1 { writer: writer, base: 0 };
    iterate i over document.chunks carrying output: WriterSourceStateV1 = initial {
        next output = writer_source_chunk_step(output, document, start, length, i);
    }
    return output.writer;
}

fn writer_key(
    writer: JsonOrderWriterV1,
    key: KeyV1,
    document: JsonTokenDocumentV1
) -> (result: JsonOrderWriterV1) {
    let open: JsonOrderWriterV1 = writer_byte(writer, 34);
    let raw: JsonOrderWriterV1 = writer_source_range(open, document, key.raw_start, key.raw_length);
    return writer_byte(raw, 34);
}

fn write_json(
    value: JsonValueV1,
    writer: JsonOrderWriterV1,
    document: JsonTokenDocumentV1
) -> (result: JsonOrderWriterV1) {
    return match value {
        Empty => JsonOrderWriterV1 { ..writer, ok: false },
        Null => writer_bytes(writer, [110, 117, 108, 108]),
        Raw { start: start, length: length } => writer_source_range(writer, document, start, length),
        String { start: start, length: length } => writer_byte(
            writer_source_range(writer_byte(writer, 34), document, start, length),
            34
        ),
        Array { items: items } => writer_byte(write_json(items, writer_byte(writer, 91), document), 93),
        Object { fields: fields } => writer_byte(write_json(fields, writer_byte(writer, 123), document), 125),
        ArrayNil => writer,
        ArrayCons { head: head, tail: tail } => match tail {
            ArrayNil => write_json(head, writer, document),
            Empty => JsonOrderWriterV1 { ..writer, ok: false },
            Null => JsonOrderWriterV1 { ..writer, ok: false },
            Raw { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            String { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            Array { items: items } => JsonOrderWriterV1 { ..writer, ok: false },
            Object { fields: fields } => JsonOrderWriterV1 { ..writer, ok: false },
            ArrayCons { head: next_head, tail: next_tail } => write_json(
                tail,
                writer_byte(write_json(head, writer, document), 44),
                document
            ),
            ObjectNil => JsonOrderWriterV1 { ..writer, ok: false },
            ObjectCons { key: key, value: inner, tail: rest } => JsonOrderWriterV1 { ..writer, ok: false }
        },
        ObjectNil => writer,
        ObjectCons { key: key, value: inner, tail: tail } => match tail {
            ObjectNil => write_json(inner, writer_byte(writer_key(writer, key, document), 58), document),
            Empty => JsonOrderWriterV1 { ..writer, ok: false },
            Null => JsonOrderWriterV1 { ..writer, ok: false },
            Raw { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            String { start: raw_start, length: raw_length } => JsonOrderWriterV1 { ..writer, ok: false },
            Array { items: items } => JsonOrderWriterV1 { ..writer, ok: false },
            Object { fields: fields } => JsonOrderWriterV1 { ..writer, ok: false },
            ArrayNil => JsonOrderWriterV1 { ..writer, ok: false },
            ArrayCons { head: next_head, tail: next_tail } => JsonOrderWriterV1 { ..writer, ok: false },
            ObjectCons { key: next_key, value: next_value, tail: next_tail } => write_json(
                tail,
                writer_byte(
                    write_json(inner, writer_byte(writer_key(writer, key, document), 58), document),
                    44
                ),
                document
            )
        }
    };
}

fn empty_output_chunk() -> (result: JsonOrderChunkV1) {
    return JsonOrderChunkV1 { bytes: [0; 1024], length: 0 };
}

fn output_completed_chunks(
    completed: JsonOrderChunkListV1,
    chunks: [JsonOrderChunkV1; 64],
    index: u64
) -> (result: [JsonOrderChunkV1; 64]) {
    return match completed {
        ChunkNil => chunks,
        ChunkCons { head: head, tail: tail } => output_completed_chunks(
            tail,
            replace(chunks, index, head),
            index -% 1
        )
    };
}

fn output_chunks(writer: JsonOrderWriterV1) -> (result: JsonOrderChunkBuilderV1) {
    let empty: JsonOrderChunkV1 = empty_output_chunk();
    let initial: [JsonOrderChunkV1; 64] = [empty; 64];
    let completed: [JsonOrderChunkV1; 64] = output_completed_chunks(
        writer.completed,
        initial,
        writer.completed_count -% 1
    );
    if writer.current_length == 0 {
        return JsonOrderChunkBuilderV1 {
            chunks: completed,
            count: writer.completed_count
        };
    }
    let current: JsonOrderChunkV1 = JsonOrderChunkV1 {
        bytes: writer.current_bytes,
        length: writer.current_length
    };
    return JsonOrderChunkBuilderV1 {
        chunks: replace(completed, writer.completed_count, current),
        count: writer.completed_count +% 1
    };
}

fn order_result(supported: bool, input_sha256: [byte; up_to 64], writer: JsonOrderWriterV1) -> (result: JsonOrderResultV1) {
    let built: JsonOrderChunkBuilderV1 = output_chunks(writer);
    let ready: bool = supported && writer.ok;
    return JsonOrderResultV1 {
        schema_version: result_schema_v1(),
        supported: ready,
        input_sha256: input_sha256,
        document_length: select(ready, writer.length, 0),
        chunk_count: select(ready, built.count, 0),
        chunks: select(ready, built.chunks[0..built.count], built.chunks[0..0])
    };
}

fn document_digest(document: JsonTokenDocumentV1) -> (result: [byte; up_to 64]) {
    let initial: sha256.DigestState = sha256.init();
    iterate i over document.chunks carrying hashed: sha256.DigestState = initial {
        next hashed = document_digest_chunk(hashed, document.chunks[i]);
    }
    let digest: [byte; 32] = sha256.finalize_standard(hashed);
    return encode_digest(digest);
}

fn document_digest_part(hashed: sha256.DigestState, chunk: JsonTokenInputChunkV1, index: u64) -> (result: sha256.DigestState) {
    let start: u64 = index *% 64;
    if start >= chunk.length { return hashed; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    let part: [byte; up_to 64] = chunk.bytes[start..start +% size];
    return sha256.update_standard(hashed, part, size);
}

fn document_digest_chunk(hashed: sha256.DigestState, chunk: JsonTokenInputChunkV1) -> (result: sha256.DigestState) {
    iterate i up_to 16 carrying current: sha256.DigestState = hashed {
        next current = document_digest_part(current, chunk, i);
    }
    return current;
}

fn hex_digit(value: u64) -> (result: byte) {
    if value < 10 { return (value +% 48) as byte; }
    return (value -% 10 +% 97) as byte;
}

fn encode_digest(raw: [byte; 32]) -> (result: [byte; up_to 64]) {
    let initial: [byte; 64] = [0; 64];
    iterate i over raw carrying encoded: [byte; 64] = initial {
        let value: u64 = raw[i] as u64;
        let high: [byte; 64] = replace(encoded, i *% 2, hex_digit(value / 16));
        next encoded = replace(high, i *% 2 +% 1, hex_digit(value % 16));
    }
    return encoded;
}

fn parse_checked(document: JsonTokenDocumentV1, request_valid: bool) -> (result: ParseStateV1) {
    if request_valid {
        let scanned: json.ScanState = scan_document(document);
        if json.is_valid(scanned) { return parse_document(document); }
    }
    return ParseStateV1 { ..empty_parse_state(), valid: false };
}

fn writer_for_parse(parsed: ParseStateV1, document: JsonTokenDocumentV1) -> (result: JsonOrderWriterV1) {
    if parsed.valid { return write_json(parsed.root, writer_empty(), document); }
    return JsonOrderWriterV1 { ..writer_empty(), ok: false };
}

fn valid_order_request(request: JsonOrderRequestV1, shape: DocumentShapeV1) -> (result: bool) {
    if !same_bytes(request.schema_version, request_schema_v1()) || !shape.valid
        || request.document.byte_length > 65536 || request.input_sha256.len != 64 {
        return false;
    }
    return same_bytes(request.input_sha256, document_digest(request.document));
}

fn public_result_json_key_order_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 107, 101, 121, 45, 111, 114, 100, 101, 114, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: JsonOrderRequestV1 = structured_read(context.argv[0], request_schema_v1());
    let shape: DocumentShapeV1 = document_shape(request.document);
    let request_valid: bool = valid_order_request(request, shape);
    let parsed: ParseStateV1 = parse_checked(request.document, request_valid);
    let writer: JsonOrderWriterV1 = writer_for_parse(parsed, request.document);
    let result: JsonOrderResultV1 = order_result(request_valid && parsed.valid, request.input_sha256, writer);
    let published: u64 = structured_write(context.argv[1], result_schema_v1(), result);
    if published == 0 {
        return failure([112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 107, 101, 121, 45, 111, 114, 100, 101, 114, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
