mncs 0.18;

// Second-provider dogfood: the generic runtime admits this provider through
// the same nominal protocol, while this consumer remains independent of its
// implementation module.
module mncs.test.provider_failure_probe.v1;

use mncs.std.application.v1;
use mncs.test.assertions.v1;
use mncs.test.provider_protocol.v1 as protocol;

fn provider_failure_probe_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability provider_admission
    capability provider_call
    effect provider_call authorized_by provider_call
{
    let empty_test: [byte; up_to 1024] = [0; 0];
    let empty_selection: [[byte; up_to 1024]; up_to 8] = [empty_test; 0];
    let provider_id: [byte; 32] = [154, 15, 43, 79, 128, 118, 74, 20, 172, 54, 43, 112, 43, 95, 8, 149, 194, 97, 104, 45, 42, 215, 53, 70, 139, 27, 58, 191, 64, 219, 14, 39];
    let request: protocol.ProviderRequest = protocol.ProviderRequest {
        inventory_identity: [204; 32],
        selected_test_identities: empty_selection,
        selection_count: 0,
        interface_identity: [248, 196, 234, 203, 185, 248, 169, 177, 32, 192, 38, 54, 172, 38, 246, 123, 224, 40, 155, 254, 62, 119, 15, 151, 61, 80, 110, 132, 161, 143, 209, 87],
        provider_revision_identity: [187; 32]
    };
    let run: protocol.ProviderRun = provider_call(provider_id, request);
    let failed: bool = match run.test_result.native_result.verdict {
        PASS => false,
        FAIL => true,
        SKIP => false,
        UNSUPPORTED => false
    };
    return select(
        failed,
        success([]),
        failure([115, 101, 99, 111, 110, 100, 32, 112, 114, 111, 118, 105, 100, 101, 114, 32, 100, 111, 103, 102, 111, 111, 100, 32, 102, 97, 105, 108, 101, 100], 3)
    );
}
