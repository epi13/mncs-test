mncs 0.18;

// Validate compiler JSON with bounded MNCS cursors and return only the selected
// diagnostic-array span. Diagnostic values stay in the original byte chunks;
// Test decodes that selected public-value fragment once at its API boundary.
module mncs.test.compile_diagnostic_projection_v1;

use mncs.std.json.v1 as json;
use mncs.std.json_cursor.v1 as json_cursor;
use mncs.test.public_result_json_key_order_v1 as json_order;

record DiagnosticProjectionV1 {
    supported: bool,
    diagnostics_json_present: bool,
    diagnostics_json_start: u64,
    diagnostics_json_length: u64,
    count: u64
}

record ProjectionFrameV1 {
    kind: byte,
    role: byte,
    key: byte,
    member_count: u64,
    seen: [bool; 3]
}

record ProjectionScanV1 {
    cursor: json_cursor.Cursor,
    syntax: json.ScanState,
    frames: [ProjectionFrameV1; 12],
    projection: DiagnosticProjectionV1,
    supported: bool,
    selected_kind: byte
}

// Root object key tags: errors=1, diagnostics=2.
fn empty_projection() -> (result: DiagnosticProjectionV1) {
    return DiagnosticProjectionV1 {
        supported: false,
        diagnostics_json_present: false,
        diagnostics_json_start: 0,
        diagnostics_json_length: 0,
        count: 0
    };
}

fn empty_frame() -> (result: ProjectionFrameV1) {
    return ProjectionFrameV1 {
        kind: 0, role: 0, key: 0, member_count: 0,
        seen: [false; 3]
    };
}

fn initial_syntax() -> (result: json.ScanState) {
    return json.ScanState {
        stack: 0, depth: 0, expect: 0, mode: 0, number: 0, literal: 0,
        position: 0, escape: false, unicode: 0, valid: true, error: 0,
        objects: 0, arrays: 0, strings: 0
    };
}

fn initial_projection_scan() -> (result: ProjectionScanV1) {
    return ProjectionScanV1 {
        cursor: json_cursor.init(),
        syntax: initial_syntax(),
        frames: [empty_frame(); 12],
        projection: DiagnosticProjectionV1 {
            ..empty_projection(), supported: true
        },
        supported: true,
        selected_kind: 0
    };
}

fn same_key(cursor: json_cursor.Cursor, expected: [byte; up_to 16]) -> (result: bool) {
    if cursor.key_length != expected.len { return false; }
    iterate i over expected carrying same: bool = true {
        next same = same && cursor.key[i] == expected[i];
    }
    return same;
}

fn root_key_tag(cursor: json_cursor.Cursor) -> (result: byte) {
    if same_key(cursor, [101,114,114,111,114,115]) { return 1; }
    if same_key(cursor, [100,105,97,103,110,111,115,116,105,99,115]) { return 2; }
    return 0;
}

fn root_key_bytes_are_plain_step(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64,
    index: u64,
    plain: bool
) -> (result: bool) {
    if index >= length { return plain; }
    return plain && json_order.located_byte(document, start +% index) != 92;
}

fn root_key_bytes_are_plain(
    document: json_order.JsonTokenDocumentV1,
    cursor: json_cursor.Cursor
) -> (result: bool) {
    let length: u64 = cursor.string_end -% cursor.string_start;
    if length > 64 { return false; }
    iterate i up_to 64 carrying plain: bool = true {
        next plain = root_key_bytes_are_plain_step(
            document, cursor.string_start, length, i, plain
        );
    }
    return plain;
}

fn key_closed(
    state: ProjectionScanV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: ProjectionScanV1) {
    let depth: u64 = state.cursor.depth as u64;
    if depth == 0 { return ProjectionScanV1 { ..state, supported: false }; }
    let index: u64 = depth -% 1;
    let frame: ProjectionFrameV1 = state.frames[index];
    if frame.role != 1 { return state; }
    let tag: byte = root_key_tag(state.cursor);
    let duplicate: bool = tag != 0 && frame.seen[tag as u64];
    let plain: bool = tag == 0 || root_key_bytes_are_plain(document, state.cursor);
    let updated_frame: ProjectionFrameV1 = ProjectionFrameV1 {
        ..frame,
        key: tag,
        seen: select(tag == 0, frame.seen, replace(frame.seen, tag as u64, true))
    };
    return ProjectionScanV1 {
        ..state,
        frames: replace(state.frames, index, updated_frame),
        supported: state.supported && plain && !duplicate
    };
}

fn select_diagnostic_array(
    state: ProjectionScanV1,
    kind: byte
) -> (result: ProjectionScanV1) {
    if kind == 1 || kind == 2
        || (kind == 3 && state.selected_kind != 2) {
        return ProjectionScanV1 {
            ..state,
            selected_kind: kind,
            projection: DiagnosticProjectionV1 {
                ..state.projection,
                diagnostics_json_present: false,
                diagnostics_json_start: 0,
                diagnostics_json_length: 0,
                count: 0
            }
        };
    }
    return state;
}

fn is_json_value_start(value: byte) -> (result: bool) {
    return value == 123 || value == 91 || value == 34 || value == 116
        || value == 102 || value == 110 || value == 45
        || (value >= 48 && value <= 57);
}

fn begins_value(state: ProjectionScanV1, value: byte) -> (result: bool) {
    let expected: bool = state.syntax.expect == 0
        || state.syntax.expect == 3 || state.syntax.expect == 5;
    return state.syntax.mode == 0 && expected && is_json_value_start(value);
}

fn select_root_array_value(
    state: ProjectionScanV1,
    parent: ProjectionFrameV1,
    value: byte
) -> (result: ProjectionScanV1) {
    let errors_array: bool = parent.role == 1 && parent.key == 1 && value == 91;
    if errors_array { return select_diagnostic_array(state, 2); }
    let diagnostics_array: bool = parent.role == 1 && parent.key == 2 && value == 91;
    if diagnostics_array { return select_diagnostic_array(state, 3); }
    return state;
}

fn count_object_member(
    state: ProjectionScanV1,
    parent_index: u64,
    parent: ProjectionFrameV1,
    value: byte
) -> (result: ProjectionScanV1) {
    let updated_parent: ProjectionFrameV1 = ProjectionFrameV1 {
        ..parent, member_count: parent.member_count +% 1
    };
    let counted: ProjectionScanV1 = ProjectionScanV1 {
        ..state, frames: replace(state.frames, parent_index, updated_parent)
    };
    return select_root_array_value(counted, parent, value);
}

fn increment_array_parent(
    state: ProjectionScanV1,
    parent_index: u64,
    parent: ProjectionFrameV1,
    value: byte
) -> (result: ProjectionScanV1) {
    let item_count: u64 = parent.member_count +% 1;
    let diagnostic_object: bool = parent.role == 2 && value == 123;
    let diagnostic_count: u64 = state.projection.count +% (diagnostic_object as u64);
    let within_bounds: bool = parent.role != 2
        || (item_count <= 32 && diagnostic_count <= 32);
    let updated_parent: ProjectionFrameV1 = ProjectionFrameV1 {
        ..parent, member_count: item_count
    };
    let updated_projection: DiagnosticProjectionV1 = note_diagnostic_object(
        state.projection, diagnostic_object, diagnostic_count
    );
    return ProjectionScanV1 {
        ..state,
        frames: replace(state.frames, parent_index, updated_parent),
        projection: updated_projection,
        supported: state.supported && within_bounds
    };
}

fn note_diagnostic_object(
    projection: DiagnosticProjectionV1,
    included: bool,
    count: u64
) -> (result: DiagnosticProjectionV1) {
    if included { return DiagnosticProjectionV1 { ..projection, count: count }; }
    return projection;
}

fn begin_value(state: ProjectionScanV1, value: byte) -> (result: ProjectionScanV1) {
    if !begins_value(state, value) { return state; }
    let depth: u64 = state.cursor.depth as u64;
    if depth == 0 {
        if value == 123 { return state; }
        if value == 91 {
            return select_diagnostic_array(state, 1);
        }
        return ProjectionScanV1 { ..state, supported: false };
    }
    let parent_index: u64 = depth -% 1;
    let parent: ProjectionFrameV1 = state.frames[parent_index];
    if parent.kind == 1 {
        return count_object_member(state, parent_index, parent, value);
    }
    return increment_array_parent(state, parent_index, parent, value);
}

fn role_for_container(
    state: ProjectionScanV1,
    parent_depth: u64,
    value: byte
) -> (result: byte) {
    if parent_depth == 0 {
        if value == 123 { return 1; }
        if value == 91 && state.selected_kind == 1 { return 2; }
        return 0;
    }
    let parent: ProjectionFrameV1 = state.frames[parent_depth -% 1];
    if value == 123 && parent.role == 2 { return 3; }
    if value == 91 && parent.role == 1 && parent.key == 1
        && state.selected_kind == 2 { return 2; }
    if value == 91 && parent.role == 1 && parent.key == 2
        && state.selected_kind == 3 { return 2; }
    return 0;
}

fn begin_diagnostics_span(
    projection: DiagnosticProjectionV1,
    role: byte,
    opening_position: u64
) -> (result: DiagnosticProjectionV1) {
    if role == 2 {
        return DiagnosticProjectionV1 {
            ..projection,
            diagnostics_json_present: true,
            diagnostics_json_start: opening_position,
            diagnostics_json_length: 0
        };
    }
    return projection;
}

fn push_container(
    state: ProjectionScanV1,
    parent_depth: u64,
    value: byte
) -> (result: ProjectionScanV1) {
    if parent_depth >= 12 {
        return ProjectionScanV1 { ..state, supported: false };
    }
    let frame: ProjectionFrameV1 = ProjectionFrameV1 {
        kind: select(value == 123, 1, 2),
        role: role_for_container(state, parent_depth, value),
        key: 0,
        member_count: 0,
        seen: [false; 3]
    };
    return ProjectionScanV1 {
        ..state,
        frames: replace(state.frames, parent_depth, frame),
        projection: begin_diagnostics_span(
            state.projection, frame.role, state.cursor.position -% 1
        )
    };
}

fn close_frame(
    state: ProjectionScanV1,
    parent_depth: u64,
    event: byte
) -> (result: ProjectionScanV1) {
    if parent_depth == 0 { return ProjectionScanV1 { ..state, supported: false }; }
    let frame: ProjectionFrameV1 = state.frames[parent_depth -% 1];
    if event == 8 && frame.role == 2 {
        return ProjectionScanV1 {
            ..state,
            projection: DiagnosticProjectionV1 {
                ..state.projection,
                diagnostics_json_length: state.cursor.position
                    -% state.projection.diagnostics_json_start
            },
            supported: state.supported && frame.member_count <= 32
                && state.projection.count <= 32
        };
    }
    return state;
}

fn observe_event(
    state: ProjectionScanV1,
    parent_depth: u64,
    document: json_order.JsonTokenDocumentV1
) -> (result: ProjectionScanV1) {
    if state.cursor.event == 2 { return key_closed(state, document); }
    if state.cursor.event == 5 || state.cursor.event == 6 {
        return push_container(state, parent_depth, json_order.located_byte(
            document, state.cursor.position -% 1
        ));
    }
    if state.cursor.event == 7 || state.cursor.event == 8 {
        return close_frame(state, parent_depth, state.cursor.event);
    }
    return state;
}

fn scan_byte(
    state: ProjectionScanV1,
    value: byte,
    document: json_order.JsonTokenDocumentV1
) -> (result: ProjectionScanV1) {
    let parent_depth: u64 = state.cursor.depth as u64;
    let started: ProjectionScanV1 = begin_value(state, value);
    let cursor: json_cursor.Cursor = json_cursor.feed_byte(started.cursor, value);
    let syntax: json.ScanState = json.scan_step(started.syntax, value);
    let advanced: ProjectionScanV1 = ProjectionScanV1 {
        ..started, cursor: cursor, syntax: syntax
    };
    return observe_event(advanced, parent_depth, document);
}

fn scan_chunk_part(
    state: ProjectionScanV1,
    chunk: json_order.JsonTokenInputChunkV1,
    part: u64,
    document: json_order.JsonTokenDocumentV1
) -> (result: ProjectionScanV1) {
    let start: u64 = part *% 64;
    if start >= chunk.length { return state; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    let source: [byte; up_to 64] = chunk.bytes[start..start +% size];
    iterate i over source carrying scanned: ProjectionScanV1 = state {
        next scanned = scan_byte(scanned, source[i], document);
    }
    return scanned;
}

fn scan_chunk(
    state: ProjectionScanV1,
    chunk: json_order.JsonTokenInputChunkV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: ProjectionScanV1) {
    iterate i up_to 16 carrying scanned: ProjectionScanV1 = state {
        next scanned = scan_chunk_part(scanned, chunk, i, document);
    }
    return scanned;
}

fn scan_document(
    document: json_order.JsonTokenDocumentV1
) -> (result: ProjectionScanV1) {
    iterate i over document.chunks carrying scanned: ProjectionScanV1 = initial_projection_scan() {
        next scanned = scan_chunk(scanned, document.chunks[i], document);
    }
    return scanned;
}

fn projection_is_valid(
    scanned: ProjectionScanV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: bool) {
    let syntax: json.ScanState = json.scan_finish_end(scanned.syntax);
    let span_in_bounds: bool = scanned.projection.diagnostics_json_present
        && scanned.projection.diagnostics_json_length >= 2
        && scanned.projection.diagnostics_json_start <= document.byte_length
        && scanned.projection.diagnostics_json_length
            <= document.byte_length -% scanned.projection.diagnostics_json_start;
    let span_valid: bool = select(
        scanned.selected_kind == 0,
        !scanned.projection.diagnostics_json_present && scanned.projection.count == 0,
        span_in_bounds && scanned.projection.count <= 32
    );
    return scanned.supported && syntax.valid && syntax.depth == 0
        && syntax.mode == 0 && syntax.expect == 7
        && json_cursor.is_valid(scanned.cursor)
        && scanned.cursor.position == document.byte_length && span_valid;
}

fn project(
    document: json_order.JsonTokenDocumentV1,
    request_valid: bool
) -> (result: DiagnosticProjectionV1) {
    if !request_valid { return empty_projection(); }
    let scanned: ProjectionScanV1 = scan_document(document);
    return DiagnosticProjectionV1 {
        ..scanned.projection,
        supported: projection_is_valid(scanned, document)
    };
}
