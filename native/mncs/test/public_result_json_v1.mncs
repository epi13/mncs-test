mncs 0.18;

// Bounded public Test result serialization. The host supplies a typed value
// tree; MNCS owns ordering, escaping, indentation, numeric emission, and the
// digest of the exact document written by the adapter.
module mncs.test.public_result_json_v1;

use mncs.std.application.v1;
use mncs.std.json_emit.v1 as json;
use mncs.std.sha256.v1 as sha256;

record JsonNodeV1 {
    kind: u64,
    parent: u64,
    key: [byte; up_to 256],
    text: [byte; up_to 1024],
    first_edge: u64,
    child_count: u64,
    integer_value: i64
}

record JsonRequestV1 {
    schema_version: [byte; up_to 64],
    nodes: [JsonNodeV1; up_to 512],
    edge_count: u64,
    edges: [u64; 511]
}

record JsonNumberScanV1 {
    position: u64,
    state: u64,
    valid: bool
}

record JsonNodeScanV1 {
    valid: bool,
    total_children: u64
}

record JsonEdgeScanV1 {
    valid: bool,
    previous_child: u64,
    has_previous: bool
}

record JsonFrameV1 {
    node: u64,
    next_child: u64,
    depth: u64
}

record JsonWriterV1 {
    bytes: [[byte; 1024]; 16],
    length: u64,
    ok: bool
}

record JsonChunkV1 {
    bytes: [byte; 1024],
    length: u64
}

record JsonChunkBuilderV1 {
    chunks: [JsonChunkV1; 16],
    count: u64,
    offset: u64,
    ok: bool
}

record JsonTraversalV1 {
    writer: JsonWriterV1,
    stack: [JsonFrameV1; 64],
    stack_depth: u64,
    visited: u64,
    done: bool
}

record JsonResultV1 {
    schema_version: [byte; up_to 64],
    sha256: [byte; 32],
    byte_length: u64,
    chunk_count: u64,
    chunks: [JsonChunkV1; up_to 16]
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 112, 117, 98, 108, 105, 99, 45, 106, 115, 111, 110, 47, 49];
}

fn same_bytes(left: [byte; up_to 64], right: [byte; up_to 64]) -> (result: bool) {
    if left.len != right.len {
        return false;
    }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn number_start(negative: bool) -> (result: u64) {
    if negative {
        return 1;
    }
    return 0;
}

fn number_initial_state(value: [byte; up_to 1024], start: u64) -> (result: u64) {
    if value[start] == 48 {
        return 2;
    }
    return 3;
}

fn invalid_number_step(scan: JsonNumberScanV1, position: u64) -> (result: JsonNumberScanV1) {
    return JsonNumberScanV1 { ..scan, valid: false, position: position +% 1 };
}

fn scan_number_byte(scan: JsonNumberScanV1, current: byte, position: u64) -> (result: JsonNumberScanV1) {
    let digit: bool = current >= 48 && current <= 57;
    let next_position: u64 = position +% 1;
    if !scan.valid {
        return scan;
    }
    if scan.state == 2 {
        if current == 46 {
            return JsonNumberScanV1 { ..scan, state: 4, position: next_position };
        }
        if current == 101 || current == 69 {
            return JsonNumberScanV1 { ..scan, state: 6, position: next_position };
        }
        return invalid_number_step(scan, position);
    }
    if scan.state == 3 {
        if digit {
            return JsonNumberScanV1 { ..scan, position: next_position };
        }
        if current == 46 {
            return JsonNumberScanV1 { ..scan, state: 4, position: next_position };
        }
        if current == 101 || current == 69 {
            return JsonNumberScanV1 { ..scan, state: 6, position: next_position };
        }
        return invalid_number_step(scan, position);
    }
    if scan.state == 4 {
        if digit {
            return JsonNumberScanV1 { ..scan, state: 5, position: next_position };
        }
        return invalid_number_step(scan, position);
    }
    if scan.state == 5 {
        if digit {
            return JsonNumberScanV1 { ..scan, position: next_position };
        }
        if current == 101 || current == 69 {
            return JsonNumberScanV1 { ..scan, state: 6, position: next_position };
        }
        return invalid_number_step(scan, position);
    }
    if scan.state == 6 {
        if current == 43 || current == 45 {
            return JsonNumberScanV1 { ..scan, state: 7, position: next_position };
        }
        if digit {
            return JsonNumberScanV1 { ..scan, state: 8, position: next_position };
        }
        return invalid_number_step(scan, position);
    }
    if scan.state == 7 {
        if digit {
            return JsonNumberScanV1 { ..scan, state: 8, position: next_position };
        }
        return invalid_number_step(scan, position);
    }
    if scan.state == 8 {
        if digit {
            return JsonNumberScanV1 { ..scan, position: next_position };
        }
    }
    return invalid_number_step(scan, position);
}

fn scan_number_tail(value: [byte; up_to 1024], offset: u64, initial_state: u64) -> (result: JsonNumberScanV1) {
    let seed: JsonNumberScanV1 = JsonNumberScanV1 { position: offset, state: initial_state, valid: true };
    iterate i over value[offset..value.len] carrying scan: JsonNumberScanV1 = seed {
        let position: u64 = i +% offset;
        let step: JsonNumberScanV1 = scan_number_byte(scan, value[position], position);
        next scan = step;
    }
    return scan;
}

fn valid_number(value: [byte; up_to 1024]) -> (result: bool) {
    let length: u64 = value.len;
    if length == 0 {
        return false;
    }
    let negative: bool = value[0] == 45;
    if negative && length == 1 {
        return false;
    }
    let start: u64 = number_start(negative);
    if start >= length || value[start] < 48 || value[start] > 57 {
        return false;
    }
    let state: u64 = number_initial_state(value, start);
    if state == 2 && start +% 1 < length && value[start +% 1] >= 48 && value[start +% 1] <= 57 {
        return false;
    }
    let scanned: JsonNumberScanV1 = scan_number_tail(value, start +% 1, state);
    let final_state: bool = scanned.state == 2 || scanned.state == 3 || scanned.state == 5 || scanned.state == 8;
    return scanned.valid && final_state && scanned.position == length;
}

fn is_container(kind: u64) -> (result: bool) {
    return kind == 1 || kind == 2;
}

fn valid_node(request: JsonRequestV1, index: u64) -> (result: bool) {
    let node: JsonNodeV1 = request.nodes[index];
    let known_kind: bool = node.kind >= 1 && node.kind <= 8;
    let child_range_ok: bool = node.first_edge <= request.edge_count
        && node.child_count <= request.edge_count -% node.first_edge
        && node.child_count <= 511;
    let container: bool = is_container(node.kind);
    let object_ok: bool = node.kind != 1 || node.child_count <= 64;
    let scalar_ok: bool = container || node.child_count == 0;
    let float_ok: bool = node.kind != 5 || valid_number(node.text);
    let non_number_text_ok: bool = node.kind == 3 || node.kind == 5 || node.text.len == 0;
    let root_ok: bool = index != 0 || (node.parent == 0 && node.key.len == 0);
    if !known_kind || !child_range_ok
        || !object_ok || !scalar_ok || !float_ok || !non_number_text_ok || !root_ok {
        return false;
    }
    if index == 0 {
        return true;
    }
    if node.parent >= index {
        return false;
    }
    let parent: JsonNodeV1 = request.nodes[node.parent];
    if parent.kind == 2 && node.key.len != 0 {
        return false;
    }
    return is_container(parent.kind);
}

fn scan_request_nodes(request: JsonRequestV1) -> (result: JsonNodeScanV1) {
    let seed: JsonNodeScanV1 = JsonNodeScanV1 { valid: true, total_children: 0 };
    iterate i over request.nodes carrying scan: JsonNodeScanV1 = seed {
        let node: JsonNodeV1 = request.nodes[i];
        let valid: bool = valid_node(request, i);
        next scan = JsonNodeScanV1 {
            valid: scan.valid && valid,
            total_children: scan.total_children +% node.child_count
        };
    }
    return scan;
}

fn scan_edge_step(request: JsonRequestV1, parent_index: u64, parent_kind: u64, edge_index: u64, scan: JsonEdgeScanV1) -> (result: JsonEdgeScanV1) {
    let child_index: u64 = request.edges[edge_index];
    if child_index >= request.nodes.len {
        return JsonEdgeScanV1 { ..scan, valid: false };
    }
    let child: JsonNodeV1 = request.nodes[child_index];
    let parent_ok: bool = child.parent == parent_index;
    let order_ok: bool = child_index > parent_index && (!scan.has_previous || child_index > scan.previous_child);
    let key_ok: bool = parent_kind == 1 || (parent_kind == 2 && child.key.len == 0);
    return JsonEdgeScanV1 {
        valid: scan.valid && parent_ok && order_ok && key_ok,
        previous_child: child_index,
        has_previous: true
    };
}

fn scan_children(request: JsonRequestV1, parent_index: u64) -> (result: bool) {
    let parent: JsonNodeV1 = request.nodes[parent_index];
    let seed: JsonEdgeScanV1 = JsonEdgeScanV1 { valid: true, previous_child: 0, has_previous: false };
    let child_edges: [u64; up_to 511] = request.edges[parent.first_edge..parent.first_edge +% parent.child_count];
    iterate j over child_edges carrying scan: JsonEdgeScanV1 = seed {
        let edge_index: u64 = parent.first_edge +% j;
        let step: JsonEdgeScanV1 = scan_edge_step(request, parent_index, parent.kind, edge_index, scan);
        next scan = step;
    }
    return scan.valid;
}

fn scan_request_edges(request: JsonRequestV1) -> (result: bool) {
    iterate i over request.nodes carrying valid: bool = true {
        let children_valid: bool = scan_children(request, i);
        next valid = valid && children_valid;
    }
    return valid;
}

fn valid_request(request: JsonRequestV1) -> (result: bool) {
    if !same_bytes(request.schema_version, request_schema())
        || request.nodes.len == 0
        || request.nodes.len > 512
        || request.edge_count +% 1 != request.nodes.len {
        return false;
    }
    let structure: JsonNodeScanV1 = scan_request_nodes(request);
    return structure.valid
        && structure.total_children == request.edge_count
        && scan_request_edges(request);
}

fn key_compare_step(
    comparison: i64,
    left: [byte; up_to 256],
    right: [byte; up_to 256],
    index: u64
) -> (result: i64) {
    if comparison != 0 || left[index] == right[index] {
        return comparison;
    }
    if left[index] < right[index] {
        return -1;
    }
    return 1;
}

fn shared_key_length(left: [byte; up_to 256], right: [byte; up_to 256]) -> (result: u64) {
    if left.len < right.len {
        return left.len;
    }
    return right.len;
}

fn keys_less(request: JsonRequestV1, left_index: u64, right_index: u64) -> (result: bool) {
    let left_node: JsonNodeV1 = request.nodes[left_index];
    let right_node: JsonNodeV1 = request.nodes[right_index];
    let left: [byte; up_to 256] = left_node.key;
    let right: [byte; up_to 256] = right_node.key;
    let shared: u64 = shared_key_length(left, right);
    let compared: [byte; up_to 256] = left[0..shared];
    iterate i over compared carrying comparison: i64 = 0 {
        let step: i64 = key_compare_step(comparison, left, right, i);
        next comparison = step;
    }
    if comparison < 0 {
        return true;
    }
    if comparison > 0 {
        return false;
    }
    return left.len < right.len;
}

fn swap_edges_if_needed(
    request: JsonRequestV1,
    edges: [u64; 511],
    left_position: u64,
    right_position: u64
) -> (result: [u64; 511]) {
    let left_index: u64 = edges[left_position];
    let right_index: u64 = edges[right_position];
    if keys_less(request, right_index, left_index) {
        let swapped: [u64; 511] = replace(edges, left_position, right_index);
        return replace(swapped, right_position, left_index);
    }
    return edges;
}

fn sort_edge_pass(
    request: JsonRequestV1,
    edges: [u64; 511],
    first: u64,
    limit: u64
) -> (result: [u64; 511]) {
    let pass_edges: [u64; up_to 511] = edges[first..first +% limit];
    iterate j over pass_edges carrying sorted: [u64; 511] = edges {
        let left_position: u64 = first +% j;
        let right_position: u64 = left_position +% 1;
        let step: [u64; 511] = swap_edges_if_needed(request, sorted, left_position, right_position);
        next sorted = step;
    }
    return sorted;
}

fn sort_object_edges(
    request: JsonRequestV1,
    edges: [u64; 511],
    first: u64,
    count: u64
) -> (result: [u64; 511]) {
    let passes: [u64; up_to 511] = edges[first..first +% count];
    iterate pass over passes carrying sorted: [u64; 511] = edges {
        let limit: u64 = count -% pass -% 1;
        let step: [u64; 511] = sort_edge_pass(request, sorted, first, limit);
        next sorted = step;
    }
    return sorted;
}

fn sort_node_edges(request: JsonRequestV1, index: u64) -> (result: JsonRequestV1) {
    let node: JsonNodeV1 = request.nodes[index];
    if node.kind == 1 && node.child_count > 1 {
        let edges: [u64; 511] = sort_object_edges(request, request.edges, node.first_edge, node.child_count);
        return JsonRequestV1 { ..request, edges: edges };
    }
    return request;
}

fn sort_all_object_edges(request: JsonRequestV1) -> (result: JsonRequestV1) {
    iterate i over request.nodes carrying sorted: JsonRequestV1 = request {
        let step: JsonRequestV1 = sort_node_edges(sorted, i);
        next sorted = step;
    }
    return sorted;
}

fn writer_empty() -> (result: JsonWriterV1) {
    return JsonWriterV1 { bytes: [[0; 1024]; 16], length: 0, ok: true };
}

fn writer_byte(writer: JsonWriterV1, value: byte) -> (result: JsonWriterV1) {
    if writer.ok && writer.length < 16384 {
        let block: u64 = writer.length / 1024;
        let offset: u64 = writer.length % 1024;
        let original: [byte; 1024] = writer.bytes[block];
        let updated: [byte; 1024] = replace(original, offset, value);
        let chunks: [[byte; 1024]; 16] = replace(writer.bytes, block, updated);
        return JsonWriterV1 {
            ..writer,
            bytes: chunks,
            length: writer.length +% 1
        };
    }
    return JsonWriterV1 { ..writer, ok: false };
}

fn writer_literal<N: Nat>(writer: JsonWriterV1, value: [byte; N]) -> (result: JsonWriterV1) {
    iterate i over value carrying output: JsonWriterV1 = writer {
        next output = writer_byte(output, value[i]);
    }
    return output;
}

fn writer_json_byte(writer: JsonWriterV1, value: byte) -> (result: JsonWriterV1) {
    if value == 8 {
        return writer_byte(writer_byte(writer, 92), 98);
    }
    if value == 9 {
        return writer_byte(writer_byte(writer, 92), 116);
    }
    if value == 10 {
        return writer_byte(writer_byte(writer, 92), 110);
    }
    if value == 12 {
        return writer_byte(writer_byte(writer, 92), 102);
    }
    if value == 13 {
        return writer_byte(writer_byte(writer, 92), 114);
    }
    let encoded: json.Writer = json.put_quoted_byte(json.open(), value);
    iterate i over encoded.buf carrying output: JsonWriterV1 = writer {
        let step: JsonWriterV1 = writer_encoded_byte(output, encoded, i);
        next output = step;
    }
    return output;
}

fn writer_encoded_byte(writer: JsonWriterV1, encoded: json.Writer, index: u64) -> (result: JsonWriterV1) {
    if index < encoded.len {
        return writer_byte(writer, encoded.buf[index]);
    }
    return writer;
}

fn writer_quoted(writer: JsonWriterV1, text: [byte; up_to 1024]) -> (result: JsonWriterV1) {
    let opened: JsonWriterV1 = writer_byte(writer, 34);
    iterate i over text carrying output: JsonWriterV1 = opened {
        let step: JsonWriterV1 = writer_json_byte(output, text[i]);
        next output = step;
    }
    return writer_byte(output, 34);
}

fn writer_indent(writer: JsonWriterV1, depth: u64) -> (result: JsonWriterV1) {
    let padding: [byte; up_to 1024] = writer.bytes[0][0..depth *% 2];
    iterate i over padding carrying output: JsonWriterV1 = writer {
        next output = writer_byte(output, 32);
    }
    return output;
}

fn writer_encoded_integer_byte(writer: JsonWriterV1, encoded: json.Writer, index: u64) -> (result: JsonWriterV1) {
    if index < encoded.len {
        return writer_byte(writer, encoded.buf[index]);
    }
    return writer;
}

fn writer_integer(writer: JsonWriterV1, value: i64) -> (result: JsonWriterV1) {
    let digits: json.Writer = json.int_value(json.open(), value);
    iterate i over digits.buf carrying output: JsonWriterV1 = writer {
        let step: JsonWriterV1 = writer_encoded_integer_byte(output, digits, i);
        next output = step;
    }
    return output;
}

fn writer_float(writer: JsonWriterV1, node: JsonNodeV1) -> (result: JsonWriterV1) {
    let number: [byte; up_to 1024] = node.text;
    iterate i over number carrying output: JsonWriterV1 = writer {
        next output = writer_byte(output, number[i]);
    }
    return output;
}

fn begin_value(state: JsonTraversalV1, request: JsonRequestV1, node_index: u64, depth: u64) -> (result: JsonTraversalV1) {
    let node: JsonNodeV1 = request.nodes[node_index];
    let seen: JsonTraversalV1 = JsonTraversalV1 { ..state, visited: state.visited +% 1 };
    if node.kind == 1 {
        let opened: JsonWriterV1 = writer_byte(state.writer, 123);
        if node.child_count == 0 {
            return JsonTraversalV1 { ..seen, writer: writer_byte(opened, 125) };
        }
        if state.stack_depth >= 64 {
            return JsonTraversalV1 { ..seen, writer: JsonWriterV1 { ..opened, ok: false } };
        }
        let frame: JsonFrameV1 = JsonFrameV1 { node: node_index, next_child: 0, depth: depth };
        return JsonTraversalV1 {
            ..seen,
            writer: opened,
            stack: replace(state.stack, state.stack_depth, frame),
            stack_depth: state.stack_depth +% 1
        };
    }
    if node.kind == 2 {
        let opened: JsonWriterV1 = writer_byte(state.writer, 91);
        if node.child_count == 0 {
            return JsonTraversalV1 { ..seen, writer: writer_byte(opened, 93) };
        }
        if state.stack_depth >= 64 {
            return JsonTraversalV1 { ..seen, writer: JsonWriterV1 { ..opened, ok: false } };
        }
        let frame: JsonFrameV1 = JsonFrameV1 { node: node_index, next_child: 0, depth: depth };
        return JsonTraversalV1 {
            ..seen,
            writer: opened,
            stack: replace(state.stack, state.stack_depth, frame),
            stack_depth: state.stack_depth +% 1
        };
    }
    if node.kind == 3 {
        return JsonTraversalV1 { ..seen, writer: writer_quoted(state.writer, node.text) };
    }
    if node.kind == 4 {
        return JsonTraversalV1 { ..seen, writer: writer_integer(state.writer, node.integer_value) };
    }
    if node.kind == 5 {
        return JsonTraversalV1 { ..seen, writer: writer_float(state.writer, node) };
    }
    if node.kind == 6 {
        return JsonTraversalV1 { ..seen, writer: writer_literal<4>(state.writer, [116, 114, 117, 101]) };
    }
    if node.kind == 7 {
        return JsonTraversalV1 { ..seen, writer: writer_literal<5>(state.writer, [102, 97, 108, 115, 101]) };
    }
    return JsonTraversalV1 { ..seen, writer: writer_literal<4>(state.writer, [110, 117, 108, 108]) };
}

fn writer_child_prefix(writer: JsonWriterV1, first: bool) -> (result: JsonWriterV1) {
    if first {
        return writer_byte(writer, 10);
    }
    return writer_byte(writer_byte(writer, 44), 10);
}

fn writer_object_key_prefix(
    writer: JsonWriterV1,
    request: JsonRequestV1,
    parent_kind: u64,
    child: JsonNodeV1
) -> (result: JsonWriterV1) {
    if parent_kind == 1 {
        let key: JsonWriterV1 = writer_quoted(writer, child.key);
        return writer_byte(writer_byte(key, 58), 32);
    }
    return writer;
}

fn writer_container_close(writer: JsonWriterV1, kind: u64, depth: u64) -> (result: JsonWriterV1) {
    let indented: JsonWriterV1 = writer_indent(writer_byte(writer, 10), depth);
    if kind == 1 {
        return writer_byte(indented, 125);
    }
    return writer_byte(indented, 93);
}

fn traverse_step(state: JsonTraversalV1, request: JsonRequestV1) -> (result: JsonTraversalV1) {
    if state.done || !state.writer.ok {
        return state;
    }
    if state.stack_depth == 0 {
        return JsonTraversalV1 { ..state, done: true };
    }
    let frame_position: u64 = state.stack_depth -% 1;
    let frame: JsonFrameV1 = state.stack[frame_position];
    let parent: JsonNodeV1 = request.nodes[frame.node];
    if frame.next_child < parent.child_count {
        let child_position: u64 = parent.first_edge +% frame.next_child;
        let child_index: u64 = request.edges[child_position];
        let child: JsonNodeV1 = request.nodes[child_index];
        let prefix: JsonWriterV1 = writer_child_prefix(state.writer, frame.next_child == 0);
        let indented: JsonWriterV1 = writer_indent(prefix, frame.depth +% 1);
        let keyed: JsonWriterV1 = writer_object_key_prefix(indented, request, parent.kind, child);
        let advanced: JsonFrameV1 = JsonFrameV1 { ..frame, next_child: frame.next_child +% 1 };
        let parent_updated: JsonTraversalV1 = JsonTraversalV1 {
            ..state,
            writer: keyed,
            stack: replace(state.stack, frame_position, advanced)
        };
        return begin_value(parent_updated, request, child_index, frame.depth +% 1);
    }
    let close: JsonWriterV1 = writer_container_close(state.writer, parent.kind, frame.depth);
    let new_depth: u64 = state.stack_depth -% 1;
    return JsonTraversalV1 { ..state, writer: close, stack_depth: new_depth, done: new_depth == 0 };
}

fn serialize(request: JsonRequestV1) -> (result: JsonTraversalV1) {
    let initial: JsonTraversalV1 = JsonTraversalV1 {
        writer: writer_empty(),
        stack: [JsonFrameV1 { node: 0, next_child: 0, depth: 0 }; 64],
        stack_depth: 0,
        visited: 0,
        done: false
    };
    let root: JsonTraversalV1 = begin_value(initial, request, 0, 0);
    let root_ready: JsonTraversalV1 = JsonTraversalV1 {
        ..root,
        done: root.stack_depth == 0
    };
    iterate step up_to 1024 carrying state: JsonTraversalV1 = root_ready {
        next state = traverse_step(state, request);
    }
    if state.done && state.visited == request.nodes.len {
        return JsonTraversalV1 { ..state, writer: writer_byte(state.writer, 10) };
    }
    return JsonTraversalV1 { ..state, writer: JsonWriterV1 { ..state.writer, ok: false } };
}

fn writer_at(writer: JsonWriterV1, index: u64) -> (result: byte) {
    let block: u64 = index / 1024;
    let offset: u64 = index % 1024;
    return writer.bytes[block][offset];
}

fn hash_block(state: sha256.DigestState, writer: JsonWriterV1, index: u64, blocks: u64) -> (result: sha256.DigestState) {
    if index < blocks {
        let chunk: u64 = index / 16;
        let block: u64 = index % 16;
        let offset: u64 = block *% 64;
        let data: [byte; up_to 64] = writer.bytes[chunk][offset..offset +% 64];
        return sha256.update_standard(state, data, 64);
    }
    return state;
}

fn hash_tail(state: sha256.DigestState, writer: JsonWriterV1, offset: u64, length: u64) -> (result: sha256.DigestState) {
    if length == 0 {
        return state;
    }
    let chunk: u64 = offset / 1024;
    let local_offset: u64 = offset % 1024;
    let tail: [byte; up_to 64] = writer.bytes[chunk][local_offset..local_offset +% length];
    return sha256.update_standard(state, tail, length);
}

fn hash_output(writer: JsonWriterV1) -> (result: [byte; 32]) {
    let blocks: u64 = writer.length / 64;
    let seed: sha256.DigestState = sha256.init();
    iterate i up_to 256 carrying state: sha256.DigestState = seed {
        let step: sha256.DigestState = hash_block(state, writer, i, blocks);
        next state = step;
    }
    let remainder: u64 = writer.length % 64;
    let offset: u64 = blocks *% 64;
    let final_state: sha256.DigestState = hash_tail(state, writer, offset, remainder);
    return sha256.finalize_standard(final_state);
}

fn chunk_candidate(start: u64, total: u64) -> (result: u64) {
    if start +% 1024 < total {
        return start +% 1024;
    }
    return total;
}

fn adjust_chunk_end(writer: JsonWriterV1, total: u64, end: u64) -> (result: u64) {
    if end > 0 && end < total {
        let next_byte: byte = writer_at(writer, end);
        if next_byte >= 128 && next_byte <= 191 {
            return end -% 1;
        }
    }
    return end;
}

fn safe_chunk_end(writer: JsonWriterV1, start: u64, total: u64) -> (result: u64) {
    let candidate: u64 = chunk_candidate(start, total);
    iterate i up_to 4 carrying end: u64 = candidate {
        let step: u64 = adjust_chunk_end(writer, total, end);
        next end = step;
    }
    return end;
}

fn copy_output_byte(chunk: JsonChunkV1, writer: JsonWriterV1, start: u64, index: u64) -> (result: JsonChunkV1) {
    if index < chunk.length {
        let value: byte = writer_at(writer, start +% index);
        return JsonChunkV1 { ..chunk, bytes: replace(chunk.bytes, index, value) };
    }
    return chunk;
}

fn copy_output_chunk(writer: JsonWriterV1, start: u64, length: u64) -> (result: JsonChunkV1) {
    let empty: JsonChunkV1 = JsonChunkV1 { bytes: [0; 1024], length: length };
    iterate i over empty.bytes carrying chunk: JsonChunkV1 = empty {
        let step: JsonChunkV1 = copy_output_byte(chunk, writer, start, i);
        next chunk = step;
    }
    return chunk;
}

fn output_chunk_step(builder: JsonChunkBuilderV1, writer: JsonWriterV1) -> (result: JsonChunkBuilderV1) {
    if builder.offset >= writer.length {
        return builder;
    }
    if builder.count >= 16 {
        return JsonChunkBuilderV1 { ..builder, ok: false };
    }
    let end: u64 = safe_chunk_end(writer, builder.offset, writer.length);
    if end <= builder.offset {
        return JsonChunkBuilderV1 { ..builder, ok: false };
    }
    let length: u64 = end -% builder.offset;
    let chunk: JsonChunkV1 = copy_output_chunk(writer, builder.offset, length);
    let chunks: [JsonChunkV1; 16] = replace(builder.chunks, builder.count, chunk);
    return JsonChunkBuilderV1 {
        ..builder,
        chunks: chunks,
        count: builder.count +% 1,
        offset: end
    };
}

fn output_chunks(writer: JsonWriterV1) -> (result: JsonChunkBuilderV1) {
    let empty: JsonChunkV1 = JsonChunkV1 { bytes: [0; 1024], length: 0 };
    let seed: JsonChunkBuilderV1 = JsonChunkBuilderV1 {
        chunks: [empty; 16],
        count: 0,
        offset: 0,
        ok: true
    };
    iterate i up_to 16 carrying builder: JsonChunkBuilderV1 = seed {
        let step: JsonChunkBuilderV1 = output_chunk_step(builder, writer);
        next builder = step;
    }
    return JsonChunkBuilderV1 { ..builder, ok: builder.ok && builder.offset == writer.length };
}

fn public_result_json_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: JsonRequestV1 = structured_read(context.argv[0], request_schema());
    if !valid_request(request) {
        return failure([105, 110, 118, 97, 108, 105, 100, 32, 112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 114, 101, 113, 117, 101, 115, 116], 4);
    }
    let ordered: JsonRequestV1 = sort_all_object_edges(request);
    let serialized: JsonTraversalV1 = serialize(ordered);
    if !serialized.writer.ok || serialized.writer.length > 16384 {
        return failure([112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 101, 120, 99, 101, 101, 100, 115, 32, 98, 111, 117, 110, 100], 5);
    }
    let chunks: JsonChunkBuilderV1 = output_chunks(serialized.writer);
    if !chunks.ok {
        return failure([112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 99, 104, 117, 110, 107, 32, 98, 111, 117, 110, 100, 32, 102, 97, 105, 108, 101, 100], 5);
    }
    let result: JsonResultV1 = JsonResultV1 {
        schema_version: result_schema(),
        sha256: hash_output(serialized.writer),
        byte_length: serialized.writer.length,
        chunk_count: chunks.count,
        chunks: chunks.chunks[0..chunks.count]
    };
    let published: u64 = structured_write(context.argv[1], result_schema(), result);
    if published == 0 {
        return failure([112, 117, 98, 108, 105, 99, 32, 74, 83, 79, 78, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
