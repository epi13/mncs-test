mncs 0.18;

// mncs.test.obligation_selection — native interpretation of a RAVEL
// verification-obligation plan.
//
// JSON loading, process supervision, and compiler-inventory transport remain
// Python boundaries.  This module owns the deterministic selection law:
// current obligations are reused, every other selected obligation contributes
// its exact test identities, missing identities fail closed, and the final
// test order follows the compiler-owned inventory.
module mncs.test.obligation_selection;

use mncs.std.application.v1;
use mncs.core.sequences.v1 as sequences;
use mncs.commons.family.obligations.v1 as contracts;

record SelectionObligation {
    identity: [byte; up_to 128],
    status: contracts.ObligationStatus,
    test_case_identities: [[byte; up_to 128]; up_to 16]
}

record SelectionRequest {
    schema_version: [byte; up_to 64],
    plan_identity: [byte; up_to 128],
    obligations: [SelectionObligation; up_to 16],
    available_test_identities: [[byte; up_to 128]; up_to 16]
}

record SelectionResult {
    schema_version: [byte; up_to 64],
    plan_identity: [byte; up_to 128],
    selected_test_identities: [[byte; up_to 128]; up_to 16],
    selected_obligation_identities: [[byte; up_to 128]; up_to 16],
    reused_obligation_identities: [[byte; up_to 128]; up_to 16],
    new_execution_obligation_identities: [[byte; up_to 128]; up_to 16],
    selection_unresolved: [[byte; up_to 128]; up_to 16],
    missing_test_identities: [[byte; up_to 128]; up_to 16]
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 111, 98, 108, 105, 103, 97, 116, 105, 111, 110, 45, 115, 101, 108, 101, 99, 116, 105, 111, 110, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 111, 98, 108, 105, 103, 97, 116, 105, 111, 110, 45, 115, 101, 108, 101, 99, 116, 105, 111, 110, 47, 49];
}

fn contains(
    values: [[byte; up_to 128]; up_to 16],
    candidate: [byte; up_to 128]
) -> (result: bool) {
    iterate i over values carrying found: bool = false {
        next found = found || same_identity(values[i], candidate);
    }
    return found;
}

fn same_identity(
    left: [byte; up_to 128],
    right: [byte; up_to 128]
) -> (result: bool) {
    if left.len != right.len {
        return false;
    }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn contains_builder(
    builder: sequences.ByteViewBuilder16,
    candidate: [byte; up_to 128]
) -> (result: bool) {
    iterate i over builder.values carrying found: bool = false {
        next found = found || (i < builder.length && same_identity(builder.values[i], candidate));
    }
    return found;
}

fn push_unique(
    builder: sequences.ByteViewBuilder16,
    value: [byte; up_to 128],
    include: bool
) -> (result: sequences.ByteViewBuilder16) {
    return sequences.byte_view_builder16_push(
        builder,
        value,
        include && value.len > 0 && !contains_builder(builder, value)
    );
}

fn is_current(value: contracts.ObligationStatus) -> (result: bool) {
    return match value {
        contracts.ObligationStatus.required => false,
        contracts.ObligationStatus.current => true,
        contracts.ObligationStatus.new_execution_required => false,
        contracts.ObligationStatus.stale => false,
        contracts.ObligationStatus.contradictory => false,
        contracts.ObligationStatus.selection_unresolved => false,
        contracts.ObligationStatus.escalation_required => false,
        contracts.ObligationStatus.not_selected => false
    };
}

fn needs_execution(value: contracts.ObligationStatus) -> (result: bool) {
    return match value {
        contracts.ObligationStatus.required => false,
        contracts.ObligationStatus.current => false,
        contracts.ObligationStatus.new_execution_required => true,
        contracts.ObligationStatus.stale => true,
        contracts.ObligationStatus.contradictory => true,
        contracts.ObligationStatus.selection_unresolved => true,
        contracts.ObligationStatus.escalation_required => true,
        contracts.ObligationStatus.not_selected => false
    };
}

fn selected_identities(
    request: SelectionRequest
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over request.obligations carrying builder: sequences.ByteViewBuilder16 = seed {
        next builder = push_unique(builder, request.obligations[i].identity, true);
    }
    return builder;
}

fn reused_identities(
    request: SelectionRequest
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over request.obligations carrying builder: sequences.ByteViewBuilder16 = seed {
        next builder = push_unique(builder, request.obligations[i].identity, is_current(request.obligations[i].status));
    }
    return builder;
}

fn new_execution_identities(
    request: SelectionRequest
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over request.obligations carrying builder: sequences.ByteViewBuilder16 = seed {
        next builder = push_unique(builder, request.obligations[i].identity, needs_execution(request.obligations[i].status));
    }
    return builder;
}

fn required_tests(
    request: SelectionRequest
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over request.obligations carrying builder: sequences.ByteViewBuilder16 = seed {
        let obligation: SelectionObligation = request.obligations[i];
        let include: bool = !is_current(obligation.status);
        iterate j over obligation.test_case_identities carrying nested: sequences.ByteViewBuilder16 = builder {
            next nested = push_unique(nested, obligation.test_case_identities[j], include);
        }
        next builder = nested;
    }
    return builder;
}

fn unresolved_obligations(
    request: SelectionRequest
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over request.obligations carrying builder: sequences.ByteViewBuilder16 = seed {
        let obligation: SelectionObligation = request.obligations[i];
        let unresolved: bool = !is_current(obligation.status) && obligation.test_case_identities.len == 0;
        next builder = push_unique(builder, obligation.identity, unresolved);
    }
    return builder;
}

fn selected_tests_in_inventory(
    request: SelectionRequest,
    required: sequences.ByteViewBuilder16
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over request.available_test_identities carrying builder: sequences.ByteViewBuilder16 = seed {
        next builder = push_unique(builder, request.available_test_identities[i], contains_builder(required, request.available_test_identities[i]));
    }
    return builder;
}

fn missing_tests(
    request: SelectionRequest,
    required: sequences.ByteViewBuilder16
) -> (result: sequences.ByteViewBuilder16) {
    let seed: sequences.ByteViewBuilder16 = sequences.byte_view_builder16_empty();
    iterate i over required.values carrying builder: sequences.ByteViewBuilder16 = seed {
        let required_identity: [byte; up_to 128] = required.values[i];
        let in_range: bool = i < required.length;
        let present: bool = contains(request.available_test_identities, required_identity);
        next builder = push_unique(builder, required_identity, in_range && !present);
    }
    return builder;
}

fn build_result(request: SelectionRequest) -> (result: SelectionResult) {
    let required: sequences.ByteViewBuilder16 = required_tests(request);
    let selected: sequences.ByteViewBuilder16 = selected_tests_in_inventory(request, required);
    let selected_obligations: [[byte; up_to 128]; up_to 16] = sequences.byte_view_builder16_finish(selected_identities(request));
    let reused: [[byte; up_to 128]; up_to 16] = sequences.byte_view_builder16_finish(reused_identities(request));
    let new_execution: [[byte; up_to 128]; up_to 16] = sequences.byte_view_builder16_finish(new_execution_identities(request));
    let unresolved: [[byte; up_to 128]; up_to 16] = sequences.byte_view_builder16_finish(unresolved_obligations(request));
    return SelectionResult {
        schema_version: request.schema_version,
        plan_identity: request.plan_identity,
        selected_test_identities: sequences.byte_view_builder16_finish(selected),
        selected_obligation_identities: selected_obligations,
        reused_obligation_identities: reused,
        new_execution_obligation_identities: new_execution,
        selection_unresolved: unresolved,
        missing_test_identities: sequences.byte_view_builder16_finish(missing_tests(request, required))
    };
}

fn selection_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 115, 101, 108, 101, 99, 116, 105, 111, 110, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: SelectionRequest = structured_read(context.argv[0], request_schema());
    let result: SelectionResult = build_result(request);
    let published: u64 = structured_write(context.argv[1], result_schema(), result);
    if published == 0 {
        return failure([115, 101, 108, 101, 99, 116, 105, 111, 110, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
