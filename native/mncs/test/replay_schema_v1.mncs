mncs 0.18;

// Validate the stored Test result schema through the bounded MNCS JSON value
// parser. Text replay returns decoded reproduction commands up to 256 UTF-8
// bytes each; Python retains its full-result fallback for longer values.
module mncs.test.replay_schema_v1;

use mncs.std.application.v1;
use mncs.test.public_result_json_key_order_v1 as json_order;

record ReplaySchemaRequestV1 {
    schema_version: [byte; up_to 64],
    document: json_order.JsonTokenDocumentV1,
    input_sha256: [byte; up_to 64]
}

record ReplaySchemaResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    result_schema_valid: bool,
    text_projection_supported: bool,
    reproduction_command_present: bool,
    reproduction_replay_command_present: bool,
    reproduction_command_text: [byte; up_to 256],
    reproduction_command_text_length: u64,
    reproduction_replay_command_text: [byte; up_to 256],
    reproduction_replay_command_text_length: u64,
    document_length: u64,
    input_sha256: [byte; up_to 64]
}

record SchemaFieldV1 { found: bool, valid: bool }
record FieldLookupV1 { found: bool, value: json_order.JsonValueV1 }
record TextSpanV1 { valid: bool, present: bool, start: u64, length: u64 }
record TextValueV1 { valid: bool, present: bool, bytes: [byte; up_to 256], length: u64 }
record ReplayTextFieldsV1 {
    supported: bool,
    command: TextSpanV1,
    replay_command: TextSpanV1,
    command_value: TextValueV1,
    replay_command_value: TextValueV1
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 114, 101, 112, 108, 97, 121, 45, 115, 99, 104, 101, 109, 97, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 46, 114, 101, 112, 108, 97, 121, 45, 115, 99, 104, 101, 109, 97, 47, 52];
}

fn same_bytes(left: [byte; up_to 64], right: [byte; up_to 64]) -> (result: bool) {
    if left.len != right.len { return false; }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn schema_key() -> (result: json_order.KeyV1) {
    return json_order.KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: [115, 99, 104, 101, 109, 97, 95, 118, 101, 114, 115, 105, 111, 110],
        ordered_length: 14,
        valid: true
    };
}

fn reproduction_key() -> (result: json_order.KeyV1) {
    return json_order.KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: [114, 101, 112, 114, 111, 100, 117, 99, 116, 105, 111, 110],
        ordered_length: 12,
        valid: true
    };
}

fn command_key() -> (result: json_order.KeyV1) {
    return json_order.KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: [99, 111, 109, 109, 97, 110, 100],
        ordered_length: 7,
        valid: true
    };
}

fn replay_command_key() -> (result: json_order.KeyV1) {
    return json_order.KeyV1 {
        raw_start: 0,
        raw_length: 0,
        ordered: [114, 101, 112, 108, 97, 121, 95, 99, 111, 109, 109, 97, 110, 100],
        ordered_length: 14,
        valid: true
    };
}

fn empty_field_lookup() -> (result: FieldLookupV1) {
    return FieldLookupV1 { found: false, value: json_order.JsonValueV1.Empty };
}

fn empty_text_span() -> (result: TextSpanV1) {
    return TextSpanV1 { valid: true, present: false, start: 0, length: 0 };
}

fn empty_text_value() -> (result: TextValueV1) {
    return TextValueV1 { valid: true, present: false, bytes: [], length: 0 };
}

fn unsupported_text_fields() -> (result: ReplayTextFieldsV1) {
    return ReplayTextFieldsV1 {
        supported: false,
        command: empty_text_span(),
        replay_command: empty_text_span(),
        command_value: empty_text_value(),
        replay_command_value: empty_text_value()
    };
}

fn lookup_field(
    fields: json_order.JsonValueV1,
    wanted: json_order.KeyV1
) -> (result: FieldLookupV1) {
    return match fields {
        json_order.JsonValueV1.ObjectCons { key: current, value: value, tail: tail } => match json_order.compare_key(wanted, current) {
            json_order.KeyOrderV1.Equal => FieldLookupV1 { found: true, value: value },
            json_order.KeyOrderV1.Before => empty_field_lookup(),
            json_order.KeyOrderV1.After => lookup_field(tail, wanted)
        },
        Empty => empty_field_lookup(),
        Null => empty_field_lookup(),
        Raw { start: start, length: length } => empty_field_lookup(),
        String { start: start, length: length } => empty_field_lookup(),
        Array { items: items } => empty_field_lookup(),
        Object { fields: nested } => empty_field_lookup(),
        ArrayNil => empty_field_lookup(),
        ArrayCons { head: head, tail: tail } => empty_field_lookup(),
        ObjectNil => empty_field_lookup()
    };
}

fn text_span(field: FieldLookupV1) -> (result: TextSpanV1) {
    return match field.value {
        json_order.JsonValueV1.String { start: start, length: length } => TextSpanV1 {
            valid: true, present: field.found, start: start, length: length
        },
        Empty => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        Null => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        Raw { start: start, length: length } => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        Array { items: items } => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        Object { fields: fields } => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        ArrayNil => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        ArrayCons { head: head, tail: tail } => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        ObjectNil => TextSpanV1 { ..empty_text_span(), valid: !field.found },
        ObjectCons { key: key, value: value, tail: tail } => TextSpanV1 { ..empty_text_span(), valid: !field.found }
    };
}

fn decoded_string_value(document: json_order.JsonTokenDocumentV1, start: u64, length: u64) -> (result: TextValueV1) {
    let decoded: json_order.KeyV1 = json_order.decode_key(document, start, length);
    return TextValueV1 {
        valid: decoded.valid,
        present: true,
        bytes: decoded.ordered,
        length: decoded.ordered_length
    };
}

fn decode_text_value(document: json_order.JsonTokenDocumentV1, field: FieldLookupV1) -> (result: TextValueV1) {
    let span: TextSpanV1 = text_span(field);
    if !span.valid { return TextValueV1 { ..empty_text_value(), valid: false }; }
    if !span.present { return empty_text_value(); }
    return match field.value {
        json_order.JsonValueV1.String { start: start, length: length } => decoded_string_value(document, start, length),
        Empty => TextValueV1 { ..empty_text_value(), valid: false },
        Null => TextValueV1 { ..empty_text_value(), valid: false },
        Raw { start: raw_start, length: raw_length } => TextValueV1 { ..empty_text_value(), valid: false },
        Array { items: items } => TextValueV1 { ..empty_text_value(), valid: false },
        Object { fields: nested } => TextValueV1 { ..empty_text_value(), valid: false },
        ArrayNil => TextValueV1 { ..empty_text_value(), valid: false },
        ArrayCons { head: head, tail: tail } => TextValueV1 { ..empty_text_value(), valid: false },
        ObjectNil => TextValueV1 { ..empty_text_value(), valid: false },
        ObjectCons { key: key, value: value, tail: tail } => TextValueV1 { ..empty_text_value(), valid: false }
    };
}

fn text_fields_from_object(fields: json_order.JsonValueV1, document: json_order.JsonTokenDocumentV1) -> (result: ReplayTextFieldsV1) {
    let command_field: FieldLookupV1 = lookup_field(fields, command_key());
    let replay_command_field: FieldLookupV1 = lookup_field(fields, replay_command_key());
    let command: TextSpanV1 = text_span(command_field);
    let replay_command: TextSpanV1 = text_span(replay_command_field);
    let command_value: TextValueV1 = decode_text_value(document, command_field);
    let replay_command_value: TextValueV1 = decode_text_value(document, replay_command_field);
    return ReplayTextFieldsV1 {
        supported: command.valid && replay_command.valid && command_value.valid && replay_command_value.valid,
        command: command,
        replay_command: replay_command,
        command_value: command_value,
        replay_command_value: replay_command_value
    };
}

fn text_fields_from_root_object(fields: json_order.JsonValueV1, document: json_order.JsonTokenDocumentV1) -> (result: ReplayTextFieldsV1) {
    let reproduction: FieldLookupV1 = lookup_field(fields, reproduction_key());
    if !reproduction.found {
        return ReplayTextFieldsV1 {
            supported: true,
            command: empty_text_span(),
            replay_command: empty_text_span(),
            command_value: empty_text_value(),
            replay_command_value: empty_text_value()
        };
    }
    return match reproduction.value {
        json_order.JsonValueV1.Object { fields: nested } => text_fields_from_object(nested, document),
        Empty => unsupported_text_fields(),
        Null => unsupported_text_fields(),
        Raw { start: start, length: length } => unsupported_text_fields(),
        String { start: start, length: length } => unsupported_text_fields(),
        Array { items: items } => unsupported_text_fields(),
        ArrayNil => unsupported_text_fields(),
        ArrayCons { head: head, tail: tail } => unsupported_text_fields(),
        ObjectNil => unsupported_text_fields(),
        ObjectCons { key: key, value: value, tail: tail } => unsupported_text_fields()
    };
}

fn replay_text_fields(value: json_order.JsonValueV1, document: json_order.JsonTokenDocumentV1) -> (result: ReplayTextFieldsV1) {
    return match value {
        json_order.JsonValueV1.Object { fields: fields } => text_fields_from_root_object(fields, document),
        Empty => unsupported_text_fields(),
        Null => unsupported_text_fields(),
        Raw { start: start, length: length } => unsupported_text_fields(),
        String { start: start, length: length } => unsupported_text_fields(),
        Array { items: items } => unsupported_text_fields(),
        ArrayNil => unsupported_text_fields(),
        ArrayCons { head: head, tail: tail } => unsupported_text_fields(),
        ObjectNil => unsupported_text_fields(),
        ObjectCons { key: key, value: value, tail: tail } => unsupported_text_fields()
    };
}

fn schema_text_matches(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: bool) {
    let expected: [byte; up_to 18] = [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 114, 101, 115, 117, 108, 116, 47, 49];
    if length != expected.len { return false; }
    iterate i over expected carrying matches: bool = true {
        next matches = matches && json_order.located_byte(document, start +% i) == expected[i];
    }
    return matches;
}

fn schema_value_matches(
    document: json_order.JsonTokenDocumentV1,
    value: json_order.JsonValueV1
) -> (result: bool) {
    return match value {
        json_order.JsonValueV1.String { start: start, length: length } => schema_text_matches(document, start, length),
        Empty => false,
        Null => false,
        Raw { start: start, length: length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn find_schema_field(
    fields: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1,
    wanted: json_order.KeyV1
) -> (result: SchemaFieldV1) {
    return match fields {
        json_order.JsonValueV1.ObjectCons { key: current, value: value, tail: tail } => match json_order.compare_key(wanted, current) {
            json_order.KeyOrderV1.Equal => SchemaFieldV1 {
                found: true,
                valid: schema_value_matches(document, value)
            },
            json_order.KeyOrderV1.Before => SchemaFieldV1 { found: false, valid: false },
            json_order.KeyOrderV1.After => find_schema_field(tail, document, wanted)
        },
        Empty => SchemaFieldV1 { found: false, valid: false },
        Null => SchemaFieldV1 { found: false, valid: false },
        Raw { start: start, length: length } => SchemaFieldV1 { found: false, valid: false },
        String { start: start, length: length } => SchemaFieldV1 { found: false, valid: false },
        Array { items: items } => SchemaFieldV1 { found: false, valid: false },
        Object { fields: nested } => SchemaFieldV1 { found: false, valid: false },
        ArrayNil => SchemaFieldV1 { found: false, valid: false },
        ArrayCons { head: head, tail: tail } => SchemaFieldV1 { found: false, valid: false },
        ObjectNil => SchemaFieldV1 { found: false, valid: false }
    };
}

fn object_schema_matches(
    fields: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: bool) {
    let field: SchemaFieldV1 = find_schema_field(fields, document, schema_key());
    return field.found && field.valid;
}

fn root_schema_matches(
    value: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: bool) {
    return match value {
        json_order.JsonValueV1.Object { fields: fields } => object_schema_matches(fields, document),
        Empty => false,
        Null => false,
        Raw { start: start, length: length } => false,
        String { start: start, length: length } => false,
        Array { items: items } => false,
        ObjectNil => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectCons { key: key, value: inner, tail: tail } => false
    };
}

fn replay_schema_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97, 114, 103, 118, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 50, 32, 114, 101, 112, 108, 97, 121, 32, 115, 99, 104, 101, 109, 97, 32, 112, 97, 116, 104, 115], 2);
    }
    let request: ReplaySchemaRequestV1 = structured_read(context.argv[0], request_schema());
    let shape: json_order.DocumentShapeV1 = json_order.document_shape(request.document);
    let request_valid: bool = same_bytes(request.schema_version, request_schema())
        && shape.valid
        && request.document.byte_length <= 16384
        && request.input_sha256.len == 64
        && same_bytes(request.input_sha256, json_order.document_digest(request.document));
    if !request_valid {
        let invalid: ReplaySchemaResultV1 = ReplaySchemaResultV1 {
            schema_version: result_schema(),
            supported: false,
            result_schema_valid: false,
            text_projection_supported: false,
            reproduction_command_present: false,
            reproduction_replay_command_present: false,
            reproduction_command_text: [],
            reproduction_command_text_length: 0,
            reproduction_replay_command_text: [],
            reproduction_replay_command_text_length: 0,
            document_length: 0,
            input_sha256: request.input_sha256
        };
        let published: u64 = structured_write(context.argv[1], result_schema(), invalid);
        if published == 0 { return failure([114, 101, 112, 108, 97, 121, 32, 115, 99, 104, 101, 109, 97, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3); }
        return success([]);
    }
    let parsed: json_order.ParseStateV1 = json_order.parse_document(request.document);
    let supported: bool = parsed.valid && parsed.has_root;
    let result_valid: bool = supported && root_schema_matches(parsed.root, request.document);
    let text_fields: ReplayTextFieldsV1 = replay_text_fields(parsed.root, request.document);
    let response: ReplaySchemaResultV1 = ReplaySchemaResultV1 {
        schema_version: result_schema(),
        supported: supported,
        result_schema_valid: result_valid,
        text_projection_supported: supported && result_valid && text_fields.supported,
        reproduction_command_present: text_fields.command.present,
        reproduction_replay_command_present: text_fields.replay_command.present,
        reproduction_command_text: text_fields.command_value.bytes,
        reproduction_command_text_length: text_fields.command_value.length,
        reproduction_replay_command_text: text_fields.replay_command_value.bytes,
        reproduction_replay_command_text_length: text_fields.replay_command_value.length,
        document_length: request.document.byte_length,
        input_sha256: request.input_sha256
    };
    let published: u64 = structured_write(context.argv[1], result_schema(), response);
    if published == 0 { return failure([114, 101, 112, 108, 97, 121, 32, 115, 99, 104, 101, 109, 97, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3); }
    return success([]);
}
