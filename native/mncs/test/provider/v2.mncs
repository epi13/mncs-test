    let expected: [byte; 123] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 110, 97, 116, 105, 118, 101, 95, 114, 117, 110, 110, 101, 114, 95, 112, 111, 108, 105, 99, 121, 58, 58, 97, 49, 56, 50, 102, 48, 98, 102, 52, 51, 100, 50, 50, 99, 100, 54, 52, 49, 102, 100, 55, 51, 53, 54, 51, 49, 98, 57, 53, 56, 48, 100, 97, 54, 52, 53, 99, 100, 100, 56, 55, 54, 48, 98, 48, 51, 48, 99, 52, 50, 50, 48, 57, 53, 57, 52, 52, 101, 48, 50, 99, 50, 101, 52];
    return equal_identity(value, expected);
}

fn is_property_replay(value: [byte; up_to 1024]) -> (result: bool) {
    let expected: [byte; 118] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 112, 114, 111, 112, 101, 114, 116, 121, 95, 114, 101, 112, 108, 97, 121, 58, 58, 53, 51, 97, 55, 51, 53, 98, 50, 102, 52, 101, 53, 51, 99, 99, 48, 51, 55, 49, 101, 98, 97, 98, 54, 56, 97, 49, 102, 102, 57, 56, 54, 50, 53, 52, 51, 53, 54, 100, 52, 98, 54, 48, 102, 98, 99, 100, 101, 97, 54, 56, 50, 57, 99, 57, 52, 101, 49, 100, 57, 50, 49, 51, 99];
    return equal_identity(value, expected);
}

fn is_skipped(value: [byte; up_to 1024]) -> (result: bool) {
    let expected: [byte; 110] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 115, 107, 105, 112, 112, 101, 100, 58, 58, 53, 97, 56, 48, 98, 99, 48, 50, 97, 97, 102, 48, 52, 51, 101, 53, 49, 53, 56, 102, 54, 98, 98, 56, 57, 98, 49, 97, 55, 55, 57, 99, 49, 56, 102, 100, 102, 48, 102, 100, 49, 102, 101, 99, 51, 54, 54, 102, 51, 49, 57, 48, 50, 97, 50, 99, 50, 101, 52, 56, 55, 55, 53, 57];
    return equal_identity(value, expected);
}

fn is_snapshot_witness(value: [byte; up_to 1024]) -> (result: bool) {
    let expected: [byte; 119] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 115, 110, 97, 112, 115, 104, 111, 116, 95, 119, 105, 116, 110, 101, 115, 115, 58, 58, 49, 98, 53, 54, 48, 51, 54, 101, 99, 54, 98, 49, 48, 98, 53, 98, 98, 101, 102, 102, 97, 48, 99, 101, 56, 48, 55, 52, 56, 49, 53, 54, 55, 51, 99, 57, 98, 49, 56, 98, 55, 57, 101, 97, 50, 97, 53, 54, 48, 57, 97, 52, 99, 97, 51, 97, 102, 51, 99, 97, 102, 57, 97, 55];
    return equal_identity(value, expected);
}

fn is_task_lifecycle(value: [byte; up_to 1024]) -> (result: bool) {
    let expected: [byte; 117] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 116, 97, 115, 107, 95, 108, 105, 102, 101, 99, 121, 99, 108, 101, 58, 58, 97, 99, 100, 49, 51, 54, 53, 102, 57, 57, 51, 54, 49, 54, 99, 54, 52, 53, 55, 56, 101, 53, 48, 54, 102, 99, 55, 57, 51, 102, 48, 55, 50, 57, 55, 98, 57, 48, 52, 57, 99, 55, 55, 97, 57, 97, 49, 102, 48, 97, 51, 99, 51, 100, 97, 49, 56, 56, 56, 57, 50, 100, 97, 101];
    return equal_identity(value, expected);
}

fn known_identity(value: [byte; up_to 1024]) -> (result: bool) {
    return is_arithmetic(value) || is_boolean(value) || is_native_runner_policy(value)
        || is_property_replay(value) || is_skipped(value) || is_snapshot_witness(value)
        || is_task_lifecycle(value);
}

fn inventory_matches(request: ProviderRequest) -> (result: bool) {
    return equal_exact32(request.inventory_identity, inventory_identity())
        && equal_exact32(request.interface_identity, interface_identity())
        && equal_exact32(request.provider_revision_identity, revision_identity());
}

fn duplicate_with(candidate: [byte; up_to 1024], values: [[byte; up_to 1024]; up_to 8], ordinal: u64) -> (result: bool) {
    iterate j over values carrying duplicate: bool = false {
        next duplicate = duplicate || (j != ordinal && equal_views(candidate, values[j]));
    }
    return duplicate;
}

fn duplicate_selection(request: ProviderRequest) -> (result: bool) {
    iterate i over request.selected_test_identities carrying duplicate: bool = false {
        let later: [byte; up_to 1024] = request.selected_test_identities[i];
        next duplicate = duplicate || duplicate_with(later, request.selected_test_identities, i);
    }
    return duplicate;
}

fn verdict_is_fail(value: Verdict) -> (result: bool) {
    return match value {
        PASS => false,
        FAIL => true,
        SKIP => false,
        UNSUPPORTED => false
    };
}

fn run_one(selector: [byte; up_to 1024]) -> (result: TestResult) {
    if is_arithmetic(selector) {
        return arithmetic();
    }
    if is_boolean(selector) {
        return boolean();
    }
    if is_native_runner_policy(selector) {
        return native_runner_policy();
    }
    if is_property_replay(selector) {
        return property_replay();
    }
    if is_skipped(selector) {
        return skipped();
    }
    if is_snapshot_witness(selector) {
        return snapshot_witness();
    }
    if is_task_lifecycle(selector) {
        return task_lifecycle();
    }
    return unsupported(9001);
}

fn empty_accumulator() -> (result: ProviderAccumulator) {
    return ProviderAccumulator {
        verdict: Verdict.PASS,
        verdict_code: 0,
        failure_kind: FailureKind.NoFailure,
        failure_code: 0,
        assertions: 0,
        failures: 0,
        expected: 0,
        actual: 0,
        assertion_code: 0
    };
}

fn observe(accumulator: ProviderAccumulator, test: TestResult) -> (result: ProviderAccumulator) {
    let base: ProviderAccumulator = ProviderAccumulator {
        ..accumulator,
        assertions: accumulator.assertions +% test.assertions,
        failures: accumulator.failures +% test.failures
    };
    return match test.verdict {
        PASS => base,
        SKIP => base,
        FAIL => ProviderAccumulator {
            ..base,
            verdict: Verdict.FAIL,
            verdict_code: 1,
            failure_kind: test.failure_kind,
            failure_code: select(accumulator.failure_code == 0, test.failure_code, accumulator.failure_code),
            expected: select(accumulator.failure_code == 0, test.expected, accumulator.expected),
            actual: select(accumulator.failure_code == 0, test.actual, accumulator.actual),
            assertion_code: select(accumulator.failure_code == 0, test.assertion_code, accumulator.assertion_code)
        },
        UNSUPPORTED => ProviderAccumulator {
            ..base,
            verdict: select(verdict_is_fail(accumulator.verdict), Verdict.FAIL, Verdict.UNSUPPORTED),
            verdict_code: select(verdict_is_fail(accumulator.verdict), 1, 3),
            failure_kind: FailureKind.Unsupported,
            failure_code: select(accumulator.failure_code == 0, test.failure_code, accumulator.failure_code)
        }
    };
}

fn native_result(accumulator: ProviderAccumulator) -> (result: TestResult) {
    return TestResult {
        verdict: accumulator.verdict,
        verdict_code: accumulator.verdict_code,
        failure_kind: accumulator.failure_kind,
        failure_code: accumulator.failure_code,
        assertions: accumulator.assertions,
        failures: accumulator.failures,
        expected: accumulator.expected,
        actual: accumulator.actual,
        assertion_code: accumulator.assertion_code
    };
}

fn fold_selected(request: ProviderRequest) -> (result: ProviderAccumulator) {
    iterate i over request.selected_test_identities carrying accumulator: ProviderAccumulator = empty_accumulator() {
        next accumulator = observe(accumulator, run_one(request.selected_test_identities[i]));
    }
    return accumulator;
}

fn invalid_accumulator(request: ProviderRequest) -> (result: ProviderAccumulator) {
    return ProviderAccumulator {
        ..empty_accumulator(),
        verdict: Verdict.UNSUPPORTED,
        verdict_code: 3,
        failure_kind: FailureKind.Unsupported,
        failure_code: select(inventory_matches(request), 9001, 9002)
    };
}

fn run_selected_batch(request: ProviderRequest) -> (result: ProviderRun)
    capability provider_digest
    effect structured_digest authorized_by provider_digest
{
    let valid_shape: bool = request.selection_count > 0
        && request.selection_count <= 8
        && request.selection_count == request.selected_test_identities.len
        && inventory_matches(request)
        && !duplicate_selection(request);
    iterate i over request.selected_test_identities carrying known: bool = true {
        next known = known && known_identity(request.selected_test_identities[i]);
    }
    let valid: bool = valid_shape && request.selected_test_identities.len > 0 && known;
    let accumulator: ProviderAccumulator = select(valid, fold_selected(request), invalid_accumulator(request));
    let selected_result: TestResult = native_result(accumulator);
    let execution_identity: [byte; 32] = copy_digest(structured_digest(ProviderExecutionMaterial {
        inventory_identity: request.inventory_identity,
        selected_test_identities: request.selected_test_identities,
        selection_count: request.selection_count,
        interface_identity: request.interface_identity,
        provider_revision_identity: request.provider_revision_identity
    }));
    let evidence_identity: [byte; 32] = copy_digest(structured_digest(ProviderEvidenceMaterial {
        execution_identity: execution_identity,
        native_result: selected_result,
        selected_test_identities: request.selected_test_identities
    }));
    let result_identity: [byte; 32] = copy_digest(structured_digest(ProviderResultMaterial {
        provider_identity: provider_identity(),
        provider_revision_identity: request.provider_revision_identity,
        interface_identity: interface_identity(),
        inventory_identity: request.inventory_identity,
        execution_identity: execution_identity,
        evidence_identity: evidence_identity,
        selected_test_identities: request.selected_test_identities,
        selection_count: request.selection_count,
        native_result: selected_result
    }));
    let test_result: ProviderTestResult = ProviderTestResult {
        result_identity: result_identity,
        provider_identity: provider_identity(),
        provider_revision_identity: request.provider_revision_identity,
        interface_identity: interface_identity(),
        inventory_identity: request.inventory_identity,
        execution_identity: execution_identity,
        evidence_identity: evidence_identity,
        selected_test_identities: request.selected_test_identities,
        selection_count: request.selection_count,
        native_result: selected_result
    };
    let check_result: ProviderCheckResult = ProviderCheckResult {
        result_identity: result_identity,
        check_identity: check_identity(),
        provider_identity: provider_identity(),
        provider_revision_identity: request.provider_revision_identity,
        interface_identity: interface_identity(),
        inventory_identity: request.inventory_identity,
        test_result_identity: result_identity,
        execution_identity: execution_identity,
        evidence_identity: evidence_identity,
        verdict: selected_result.verdict
    };
    return ProviderRun { test_result: test_result, check_result: check_result };
}

fn provider_batch_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability provider_artifact
    capability provider_digest
    effect structured_read authorized_by provider_artifact
    effect structured_write authorized_by provider_artifact
    effect structured_digest authorized_by provider_digest
{
    if !context_is_bounded(context) || context.argv_count < 3 {
        return failure([105, 110, 118, 97, 108, 105, 100, 32, 112, 114, 111, 118, 105, 100, 101, 114, 32, 97, 114, 103, 115], 2);
    }
    let request_schema: [byte; up_to 64] = [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 112, 114, 111, 118, 105, 100, 101, 114, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
    let result_schema: [byte; up_to 64] = [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 112, 114, 111, 118, 105, 100, 101, 114, 45, 114, 101, 115, 117, 108, 116, 47, 49];
    let check_schema: [byte; up_to 64] = [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 112, 114, 111, 118, 105, 100, 101, 114, 45, 99, 104, 101, 99, 107, 47, 49];
    let request: ProviderRequest = structured_read(context.argv[0], request_schema);
    let run: ProviderRun = run_selected_batch(request);
    let published_result: u64 = structured_write(context.argv[1], result_schema, run.test_result);
    let published_check: u64 = structured_write(context.argv[2], check_schema, run.check_result);
    if published_result == 0 || published_check == 0 {
        return failure([112, 114, 111, 118, 105, 100, 101, 114, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
