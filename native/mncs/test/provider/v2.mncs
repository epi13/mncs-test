mncs 0.18;

// mncs.test.provider.v2 — production typed provider boundary.
//
// The compiler owns the inventory and its identities. This module is the
// generated/bound dispatch surface for that inventory; Actions supplies only
// a typed bounded selection and never names a host function or a nearby test.
// Compiler inventory identity: f5c2c5664b24e27efdbe5f4e78ac888e96655b550631f8b19caa9731912715db
// Bound test identities are compiler inventory output:
// mncs:0.2:test-case:tests.self_suite::arithmetic::f678e5ec3041e45e78e5ebefe4e87172fd2fbdd385846a2641a8e9cfd212b911
// mncs:0.2:test-case:tests.self_suite::boolean::aed88ee42cd04283f1a415c36c95a3ef6e1db7c20cc63d6b7b28104f90f28500
// mncs:0.2:test-case:tests.self_suite::native_runner_policy::a182f0bf43d22cd641fd735631b9580da645cdd8760b030c422095944e02c2e4
// mncs:0.2:test-case:tests.self_suite::property_replay::53a735b2f4e53cc0371ebab68a1ff986254356d4b60fbcdea6829c94e1d9213c
// mncs:0.2:test-case:tests.self_suite::skipped::5a80bc02aaf043e5158f6bb89b1a779c18fdf0fd1fec366f31902a2c2e487759
// mncs:0.2:test-case:tests.self_suite::snapshot_witness::1b56036ec6b10b5bbeffa0ce8074815673c9b18b79ea2a5609a4ca3af3caf9a7
// mncs:0.2:test-case:tests.self_suite::task_lifecycle::acd1365f993616c64578e506fc793f07297b9049c77a9a1f0a3c3da188892dae
module mncs.test.provider.v2;

use mncs.test.assertions.v1;
use mncs.std.application.v1;
use tests.self_suite;

record ProviderRequest {
    inventory_identity: [byte; 32],
    selected_test_identities: [[byte; up_to 1024]; up_to 8],
    selection_count: u64,
    interface_identity: [byte; 32],
    provider_revision_identity: [byte; 32]
}

record ProviderExecutionMaterial {
    inventory_identity: [byte; 32],
    selected_test_identities: [[byte; up_to 1024]; up_to 8],
    selection_count: u64,
    interface_identity: [byte; 32],
    provider_revision_identity: [byte; 32]
}

record ProviderEvidenceMaterial {
    execution_identity: [byte; 32],
    native_result: TestResult,
    selected_test_identities: [[byte; up_to 1024]; up_to 8]
}

record ProviderResultMaterial {
    provider_identity: [byte; 32],
    provider_revision_identity: [byte; 32],
    interface_identity: [byte; 32],
    inventory_identity: [byte; 32],
    execution_identity: [byte; 32],
    evidence_identity: [byte; 32],
    selected_test_identities: [[byte; up_to 1024]; up_to 8],
    selection_count: u64,
    native_result: TestResult
}

record ProviderTestResult {
    result_identity: [byte; 32],
    provider_identity: [byte; 32],
    provider_revision_identity: [byte; 32],
    interface_identity: [byte; 32],
    inventory_identity: [byte; 32],
    execution_identity: [byte; 32],
    evidence_identity: [byte; 32],
    selected_test_identities: [[byte; up_to 1024]; up_to 8],
    selection_count: u64,
    native_result: TestResult
}

record ProviderCheckResult {
    result_identity: [byte; 32],
    check_identity: [byte; up_to 256],
    provider_identity: [byte; 32],
    provider_revision_identity: [byte; 32],
    interface_identity: [byte; 32],
    inventory_identity: [byte; 32],
    test_result_identity: [byte; 32],
    execution_identity: [byte; 32],
    evidence_identity: [byte; 32],
    verdict: Verdict
}

record ProviderRun {
    test_result: ProviderTestResult,
    check_result: ProviderCheckResult
}

record ProviderAccumulator {
    verdict: Verdict,
    verdict_code: u64,
    failure_kind: FailureKind,
    failure_code: u64,
    assertions: u64,
    failures: u64,
    expected: i64,
    actual: i64,
    assertion_code: u64
}

