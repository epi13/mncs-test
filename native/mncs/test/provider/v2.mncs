    let expected: [byte; 113] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 97, 114, 105, 116, 104, 109, 101, 116, 105, 99, 58, 58, 102, 54, 55, 56, 101, 53, 101, 99, 51, 48, 52, 49, 101, 52, 53, 101, 55, 56, 101, 53, 101, 98, 101, 102, 101, 52, 101, 56, 55, 49, 55, 50, 102, 100, 50, 102, 98, 100, 100, 51, 56, 53, 56, 52, 54, 97, 50, 54, 52, 49, 97, 56, 101, 57, 99, 102, 100, 50, 49, 50, 98, 57, 49, 49];
    return equal_identity(value, expected);
}

