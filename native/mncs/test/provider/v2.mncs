mncs 0.18;

// mncs.test.provider.v2 — production typed provider boundary.
//
// Compiler inventory dispatch is generated into v2_inventory.mncs.
// Actions supplies only a typed bounded selection and never names a
// host function or a nearby test.
module mncs.test.provider.v2;

use mncs.test.assertions.v1;
use mncs.test.provider_protocol.v1 as protocol;
use mncs.core.sequences.v1 as sequences;
use mncs.test.provider.v2_inventory as generated;
use mncs.std.application.v1;

record ProviderExecutionMaterial {
    inventory_identity: [byte; 32],
    selected_test_identities: [[byte; up_to 1024]; up_to 8],
    selection_count: u64,
    interface_identity: [byte; 32],
    provider_revision_identity: [byte; 32]
}

record ProviderEvidenceMaterial {
    execution_identity: [byte; 32],
    native_result: TestResult,
    selected_test_identities: [[byte; up_to 1024]; up_to 8]
}

record ProviderAccumulator {
    verdict: Verdict,
    verdict_code: u64,
    failure_kind: FailureKind,
    failure_code: u64,
    assertions: u64,
    failures: u64,
    expected: i64,
    actual: i64,
    assertion_code: u64
}

fn inventory_identity() -> (result: [byte; 32]) {
    return generated.inventory_identity();
}

fn provider_identity() -> (result: [byte; 32]) {
    return [72, 50, 15, 137, 143, 152, 72, 72, 180, 39, 92, 74, 219, 70, 94, 183, 100, 39, 176, 53, 227, 96, 104, 39, 117, 94, 36, 93, 106, 66, 46, 1];
}

fn interface_identity() -> (result: [byte; 32]) {
    return [5, 42, 22, 169, 138, 85, 229, 86, 155, 67, 181, 63, 215, 22, 222, 186, 14, 140, 217, 134, 193, 35, 128, 75, 21, 196, 32, 131, 7, 255, 114, 234];
}

fn revision_identity() -> (result: [byte; 32]) {
    return generated.revision_identity();
}

fn check_identity() -> (result: [byte; up_to 256]) {
    return [109, 110, 99, 115, 45, 116, 101, 115, 116, 58, 99, 104, 101, 99, 107];
}

// Provider-owned schema labels are exported with the provider interface so a
// consumer cannot silently drift from the provider's artifact boundary.
fn provider_request_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 112, 114, 111, 118, 105, 100, 101, 114, 45, 114, 101, 113, 117, 101, 115, 116, 47, 49];
}

fn provider_result_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 112, 114, 111, 118, 105, 100, 101, 114, 45, 114, 101, 115, 117, 108, 116, 47, 49];
}

fn provider_check_schema() -> (result: [byte; up_to 64]) {
    return [109, 110, 99, 115, 46, 116, 101, 115, 116, 45, 112, 114, 111, 118, 105, 100, 101, 114, 45, 99, 104, 101, 99, 107, 47, 49];
}

fn copy_digest(view: [byte; up_to 64]) -> (result: [byte; 32]) {
    let seed: [byte; 32] = [0; 32];
    return copy_span(seed, 0, view, 0, 32);
}

fn equal_identity<N: Nat>(value: [byte; up_to 1024], expected: [byte; N]) -> (result: bool) {
    return sequences.equals_byte_view<1024>(value, expected[0..expected.len]);
}


fn equal_exact32(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    return sequences.equals_bytes<32>(left, right);
}

fn equal_views(left: [byte; up_to 1024], right: [byte; up_to 1024]) -> (result: bool) {
    return sequences.equals_byte_view<1024>(left, right);
}

fn known_identity(value: [byte; up_to 1024]) -> (result: bool) {
    return generated.known_identity(value);
}

fn inventory_matches(request: protocol.ProviderRequest) -> (result: bool) {
    return equal_exact32(request.inventory_identity, inventory_identity())
        && equal_exact32(request.interface_identity, interface_identity())
        && equal_exact32(request.provider_revision_identity, revision_identity());
}

fn duplicate_with(candidate: [byte; up_to 1024], values: [[byte; up_to 1024]; up_to 8], ordinal: u64) -> (result: bool) {
    iterate j over values carrying duplicate: bool = false {
        next duplicate = duplicate || (j != ordinal && equal_views(candidate, values[j]));
    }
    return duplicate;
}

fn duplicate_selection(request: protocol.ProviderRequest) -> (result: bool) {
    iterate i over request.selected_test_identities carrying duplicate: bool = false {
        let later: [byte; up_to 1024] = request.selected_test_identities[i];
        next duplicate = duplicate || duplicate_with(later, request.selected_test_identities, i);
    }
    return duplicate;
}

// The provider keeps an execution batch bound of eight for resource reasons,
// but the family selection contract is wider. Materialize the validated
// request through the shared bounded builder before dispatch so the provider
// consumes an owned, deterministic sequence rather than relying on a
// request-shaped view. The 64-slot staging bound is not an execution limit.
fn materialize_provider_selection(
    values: [[byte; up_to 1024]; up_to 8]
) -> (result: [[byte; up_to 1024]; up_to 64]) {
    let seed_builder: sequences.ByteViewBuilder64 = sequences.byte_view_builder64_empty();
    iterate i over values carrying builder: sequences.ByteViewBuilder64 = seed_builder {
        next builder = sequences.byte_view_builder64_push(builder, values[i], true);
    }
    return sequences.byte_view_builder64_finish(builder);
}

fn verdict_is_fail(value: Verdict) -> (result: bool) {
    return match value {
        PASS => false,
        FAIL => true,
        SKIP => false,
        UNSUPPORTED => false
    };
}

fn run_one(selector: [byte; up_to 1024]) -> (result: TestResult) {
    return generated.run_one(selector);
}

fn empty_accumulator() -> (result: ProviderAccumulator) {
    return ProviderAccumulator {
        verdict: Verdict.PASS,
        verdict_code: 0,
        failure_kind: FailureKind.NoFailure,
        failure_code: 0,
        assertions: 0,
        failures: 0,
        expected: 0,
        actual: 0,
        assertion_code: 0
    };
}

fn observe(accumulator: ProviderAccumulator, test: TestResult) -> (result: ProviderAccumulator) {
    let base: ProviderAccumulator = ProviderAccumulator {
        ..accumulator,
        assertions: accumulator.assertions +% test.assertions,
        failures: accumulator.failures +% test.failures
    };
    return match test.verdict {
        PASS => base,
        SKIP => base,
        FAIL => ProviderAccumulator {
            ..base,
            verdict: Verdict.FAIL,
            verdict_code: 1,
            failure_kind: test.failure_kind,
            failure_code: select(accumulator.failure_code == 0, test.failure_code, accumulator.failure_code),
            expected: select(accumulator.failure_code == 0, test.expected, accumulator.expected),
            actual: select(accumulator.failure_code == 0, test.actual, accumulator.actual),
            assertion_code: select(accumulator.failure_code == 0, test.assertion_code, accumulator.assertion_code)
        },
        UNSUPPORTED => ProviderAccumulator {
            ..base,
            verdict: select(verdict_is_fail(accumulator.verdict), Verdict.FAIL, Verdict.UNSUPPORTED),
            verdict_code: select(verdict_is_fail(accumulator.verdict), 1, 3),
            failure_kind: FailureKind.Unsupported,
            failure_code: select(accumulator.failure_code == 0, test.failure_code, accumulator.failure_code)
        }
    };
}

fn native_result(accumulator: ProviderAccumulator) -> (result: TestResult) {
    return TestResult {
        verdict: accumulator.verdict,
        verdict_code: accumulator.verdict_code,
        failure_kind: accumulator.failure_kind,
        failure_code: accumulator.failure_code,
        assertions: accumulator.assertions,
        failures: accumulator.failures,
        expected: accumulator.expected,
        actual: accumulator.actual,
        assertion_code: accumulator.assertion_code
    };
}

fn fold_selected(values: [[byte; up_to 1024]; up_to 64]) -> (result: ProviderAccumulator) {
    iterate i over values carrying accumulator: ProviderAccumulator = empty_accumulator() {
        next accumulator = observe(accumulator, run_one(values[i]));
    }
    return accumulator;
}

fn invalid_accumulator(request: protocol.ProviderRequest) -> (result: ProviderAccumulator) {
    return ProviderAccumulator {
        ..empty_accumulator(),
        verdict: Verdict.UNSUPPORTED,
        verdict_code: 3,
        failure_kind: FailureKind.Unsupported,
        failure_code: select(inventory_matches(request), 9001, 9002)
    };
}

fn run_selected_batch(request: protocol.ProviderRequest) -> (result: protocol.ProviderRun)
    capability provider_digest
    effect structured_digest authorized_by provider_digest
{
    let valid_shape: bool = request.selection_count > 0
        && request.selection_count <= 8
        && request.selection_count == request.selected_test_identities.len
        && inventory_matches(request)
        && !duplicate_selection(request);
    iterate i over request.selected_test_identities carrying known: bool = true {
        next known = known && known_identity(request.selected_test_identities[i]);
    }
    let valid: bool = valid_shape && request.selected_test_identities.len > 0 && known;
    let selected: [[byte; up_to 1024]; up_to 64] = materialize_provider_selection(request.selected_test_identities);
    let accumulator: ProviderAccumulator = select(valid, fold_selected(selected), invalid_accumulator(request));
    let selected_result: TestResult = native_result(accumulator);
    let execution_identity: [byte; 32] = copy_digest(structured_digest(ProviderExecutionMaterial {
        inventory_identity: request.inventory_identity,
        selected_test_identities: request.selected_test_identities,
        selection_count: request.selection_count,
        interface_identity: request.interface_identity,
        provider_revision_identity: request.provider_revision_identity
    }));
    let evidence_identity: [byte; 32] = copy_digest(structured_digest(ProviderEvidenceMaterial {
        execution_identity: execution_identity,
        native_result: selected_result,
        selected_test_identities: request.selected_test_identities
    }));
    let test_result_without_identity: protocol.ProviderTestResult = protocol.ProviderTestResult {
        result_identity: [0; 32],
        provider_identity: provider_identity(),
        provider_revision_identity: request.provider_revision_identity,
        interface_identity: interface_identity(),
        inventory_identity: request.inventory_identity,
        execution_identity: execution_identity,
        evidence_identity: evidence_identity,
        selected_test_identities: request.selected_test_identities,
        selection_count: request.selection_count,
        native_result: selected_result
    };
    let result_identity: [byte; 32] = copy_digest(structured_digest(protocol.provider_test_result_identity_material(test_result_without_identity)));
    let test_result: protocol.ProviderTestResult = protocol.ProviderTestResult {
        ..test_result_without_identity,
        result_identity: result_identity
    };
    let check_result_without_identity: protocol.ProviderCheckResult = protocol.ProviderCheckResult {
        result_identity: [0; 32],
        check_identity: check_identity(),
        provider_identity: provider_identity(),
        provider_revision_identity: request.provider_revision_identity,
        interface_identity: interface_identity(),
        inventory_identity: request.inventory_identity,
        test_result_identity: result_identity,
        execution_identity: execution_identity,
        evidence_identity: evidence_identity,
        verdict: selected_result.verdict
    };
    let check_result_identity: [byte; 32] = copy_digest(structured_digest(protocol.provider_check_result_identity_material(check_result_without_identity)));
    let check_result: protocol.ProviderCheckResult = protocol.ProviderCheckResult {
        ..check_result_without_identity,
        result_identity: check_result_identity
    };
    return protocol.ProviderRun { test_result: test_result, check_result: check_result };
}

fn provider_batch_app(context: ApplicationContext) -> (result: ApplicationExit)
    capability provider_artifact
    capability provider_digest
    effect structured_read authorized_by provider_artifact
    effect structured_write authorized_by provider_artifact
    effect structured_digest authorized_by provider_digest
{
    if !context_is_bounded(context) || context.argv_count < 3 {
        return failure([105, 110, 118, 97, 108, 105, 100, 32, 112, 114, 111, 118, 105, 100, 101, 114, 32, 97, 114, 103, 115], 2);
    }
    let request: protocol.ProviderRequest = structured_read(context.argv[0], protocol.provider_request_schema());
    let run: protocol.ProviderRun = run_selected_batch(request);
    let published_result: u64 = structured_write(context.argv[1], protocol.provider_result_schema(), run.test_result);
    let published_check: u64 = structured_write(context.argv[2], protocol.provider_check_schema(), run.check_result);
    if published_result == 0 || published_check == 0 {
        return failure([112, 114, 111, 118, 105, 100, 101, 114, 32, 112, 117, 98, 108, 105, 115, 104, 32, 102, 97, 105, 108, 101, 100], 3);
    }
    return success([]);
}
