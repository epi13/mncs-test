    let expected: [byte; 110] = [109, 110, 99, 115, 58, 48, 46, 50, 58, 116, 101, 115, 116, 45, 99, 97, 115, 101, 58, 116, 101, 115, 116, 115, 46, 115, 101, 108, 102, 95, 115, 117, 105, 116, 101, 58, 58, 98, 111, 111, 108, 101, 97, 110, 58, 58, 97, 101, 100, 56, 56, 101, 101, 52, 50, 99, 100, 48, 52, 50, 56, 51, 102, 49, 97, 52, 49, 53, 99, 51, 54, 99, 57, 53, 97, 51, 101, 102, 54, 101, 49, 100, 98, 55, 99, 50, 48, 99, 99, 54, 51, 100, 54, 98, 55, 98, 50, 56, 49, 48, 52, 102, 57, 48, 102, 50, 56, 53, 48, 48];
    return equal_identity(value, expected);
}

