mncs 0.18;

// Project bounded compiler diagnostics in MNCS. The cursor scan validates the
// document and derives the compile verdict; a bounded cursor pass then selects
// the validated diagnostic-array source span for Test's public result.
module mncs.test.compile_diagnostic_verdict_v1;

use mncs.std.application.v1;
use mncs.std.json.v1 as json;
use mncs.std.json_cursor.v1 as json_cursor;
use mncs.test.compile_verdict_v1 as policy;
use mncs.test.public_result_json_key_order_v1 as json_order;

record CompileDiagnosticVerdictRequestV1 {
    schema_version: [byte; up_to 64],
    document: json_order.JsonTokenDocumentV1,
    compiler_exit_code: i64,
    expects_failure: bool,
    expected_count: u64,
    expected: [policy.DiagnosticCodeV1; up_to 16]
}

record DiagnosticCodeJsonChunkV1 {
    bytes: [byte; up_to 1024],
    length: u64
}

record CompileDiagnosticVerdictResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    projection_supported: bool,
    root_is_object: bool,
    valid_field_present: bool,
    valid_field_is_true: bool,
    diagnostic_count: u64,
    diagnostic_code_count: u64,
    diagnostic_codes_json_chunks: [DiagnosticCodeJsonChunkV1; up_to 16],
    diagnostic_codes_json_length: u64,
    diagnostics_json_present: bool,
    diagnostics_json_start: u64,
    diagnostics_json_length: u64,
    verdict: [byte; up_to 64]
}

record DiagnosticFrameV1 {
    kind: byte,
    role: byte,
    key: byte,
    field_count: u64,
    member_count: u64,
    code_seen: bool,
    code_start: u64,
    code_length: u64
}

record DiagnosticSpanV1 {
    start: u64,
    length: u64
}

record DiagnosticCodesV1 {
    actual: [policy.DiagnosticCodeV1; 32],
    count: u64,
    valid: bool
}

enum DiagnosticCodeJsonChunkListV1 {
    Empty,
    Cons { head: DiagnosticCodeJsonChunkV1, tail: DiagnosticCodeJsonChunkListV1 }
}

record DiagnosticCodesJsonV1 {
    current_bytes: [byte; 1024],
    current_length: u64,
    completed: DiagnosticCodeJsonChunkListV1,
    completed_count: u64,
    length: u64,
    valid: bool
}

record DiagnosticCodeJsonChunkCopyV1 {
    remaining: DiagnosticCodeJsonChunkListV1,
    chunks: [DiagnosticCodeJsonChunkV1; 16]
}

record DiagnosticScanV1 {
    cursor: json_cursor.Cursor,
    syntax: json.ScanState,
    frames: [DiagnosticFrameV1; 12],
    root_is_object: bool,
    valid_field_present: bool,
    valid_field_is_true: bool,
    valid_seen: bool,
    errors_seen: bool,
    diagnostics_seen: bool,
    selection: byte,
    actual_spans: [DiagnosticSpanV1; 32],
    actual_count: u64,
    codes_valid: bool,
    value_count: u64,
    valid_scalar_active: bool,
    valid_scalar_match: bool,
    valid_scalar_length: u64,
    supported: bool,
    projection_supported: bool,
    diagnostics_json_present: bool,
    diagnostics_json_start: u64,
    diagnostics_json_length: u64,
    diagnostic_count: u64
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109,110,99,115,46,116,101,115,116,45,99,111,109,112,105,108,101,45,100,105,97,103,110,111,115,116,105,99,45,118,101,114,100,105,99,116,45,114,101,113,117,101,115,116,47,49];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109,110,99,115,46,116,101,115,116,45,99,111,109,112,105,108,101,45,100,105,97,103,110,111,115,116,105,99,45,118,101,114,100,105,99,116,47,54];
}

fn schema_is(value: [byte; up_to 64], expected: [byte; up_to 64]) -> (result: bool) {
    if value.len != expected.len { return false; }
    iterate i over expected carrying same: bool = true {
        next same = same && value[i] == expected[i];
    }
    return same;
}

fn code_key() -> (result: [byte; up_to 32]) { return [99,111,100,101]; }
fn errors_key() -> (result: [byte; up_to 32]) { return [101,114,114,111,114,115]; }
fn diagnostics_key() -> (result: [byte; up_to 32]) { return [100,105,97,103,110,111,115,116,105,99,115]; }
fn valid_key() -> (result: [byte; up_to 32]) { return [118,97,108,105,100]; }

fn empty_code() -> (result: policy.DiagnosticCodeV1) {
    return policy.DiagnosticCodeV1 { value: [] };
}

fn empty_frame() -> (result: DiagnosticFrameV1) {
    return DiagnosticFrameV1 {
        kind: 0,
        role: 0,
        key: 0,
        field_count: 0,
        member_count: 0,
        code_seen: false,
        code_start: 0,
        code_length: 0
    };
}

fn empty_span() -> (result: DiagnosticSpanV1) {
    return DiagnosticSpanV1 { start: 0, length: 0 };
}

fn empty_decoded_codes() -> (result: DiagnosticCodesV1) {
    return DiagnosticCodesV1 {
        actual: [empty_code(); 32],
        count: 0,
        valid: true
    };
}

fn initial_json_scan() -> (result: json.ScanState) {
    return json.init();
}

fn initial_diagnostic_scan() -> (result: DiagnosticScanV1) {
    return DiagnosticScanV1 {
        cursor: json_cursor.init(),
        syntax: initial_json_scan(),
        frames: [empty_frame(); 12],
        root_is_object: false,
        valid_field_present: false,
        valid_field_is_true: false,
        valid_seen: false,
        errors_seen: false,
        diagnostics_seen: false,
        selection: 0,
        actual_spans: [empty_span(); 32],
        actual_count: 0,
        codes_valid: true,
        value_count: 0,
        valid_scalar_active: false,
        valid_scalar_match: false,
        valid_scalar_length: 0,
        supported: true,
        projection_supported: true,
        diagnostics_json_present: false,
        diagnostics_json_start: 0,
        diagnostics_json_length: 0,
        diagnostic_count: 0
    };
}

fn same_key(cursor: json_cursor.Cursor, expected: [byte; up_to 32]) -> (result: bool) {
    if cursor.key_length != expected.len { return false; }
    iterate i over expected carrying same: bool = true {
        next same = same && cursor.key[i] == expected[i];
    }
    return same;
}

fn key_span_is_plain(cursor: json_cursor.Cursor) -> (result: bool) {
    let raw_length: u64 = cursor.string_end -% cursor.string_start;
    if cursor.key_length >= 32 { return true; }
    return raw_length == cursor.key_length;
}

fn root_key_tag(cursor: json_cursor.Cursor) -> (result: byte) {
    if same_key(cursor, valid_key()) { return 1; }
    if same_key(cursor, errors_key()) { return 2; }
    if same_key(cursor, diagnostics_key()) { return 3; }
    return 0;
}

fn diagnostic_key_tag(cursor: json_cursor.Cursor) -> (result: byte) {
    if same_key(cursor, code_key()) { return 4; }
    return 0;
}

fn empty_codes(state: DiagnosticScanV1, selection: byte) -> (result: DiagnosticScanV1) {
    return DiagnosticScanV1 {
        ..state,
        selection: selection,
        actual_spans: [empty_span(); 32],
        actual_count: 0,
        codes_valid: true,
        diagnostics_json_present: true,
        diagnostics_json_start: state.cursor.position,
        diagnostics_json_length: 0,
        diagnostic_count: 0
    };
}

fn is_selected_array(role: byte, selection: byte) -> (result: bool) {
    return (role == 2 && selection == 1)
        || (role == 4 && selection == 2)
        || (role == 3 && selection == 3);
}

fn true_byte(index: u64) -> (result: byte) {
    if index == 0 { return 116; }
    if index == 1 { return 114; }
    if index == 2 { return 117; }
    if index == 3 { return 101; }
    return 0;
}

fn scalar_boundary(value: byte) -> (result: bool) {
    return json.is_space(value) || value == 44 || value == 93 || value == 125;
}

fn finish_valid_scalar(state: DiagnosticScanV1) -> (result: DiagnosticScanV1) {
    return DiagnosticScanV1 {
        ..state,
        valid_scalar_active: false,
        valid_field_is_true: state.valid_scalar_match && state.valid_scalar_length == 4
    };
}

fn valid_scalar_step(state: DiagnosticScanV1, value: byte) -> (result: DiagnosticScanV1) {
    let expected: byte = true_byte(state.valid_scalar_length);
    return DiagnosticScanV1 {
        ..state,
        valid_scalar_match: state.valid_scalar_match
            && state.valid_scalar_length < 4
            && value == expected,
        valid_scalar_length: state.valid_scalar_length +% 1
    };
}

fn begins_value(state: DiagnosticScanV1, value: byte) -> (result: bool) {
    let expected: bool = state.syntax.expect == 0
        || state.syntax.expect == 3
        || state.syntax.expect == 5;
    return state.syntax.mode == 0 && expected && !json.is_space(value);
}

fn begin_value(
    state: DiagnosticScanV1,
    value: byte,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    if !begins_value(state, value) { return state; }
    let next_count: u64 = state.value_count +% 1;
    let root_value: bool = state.syntax.expect == 0;
    let root_object: bool = root_value && value == 123;
    let entered_root_array: bool = root_value && value == 91;
    let counted: DiagnosticScanV1 = DiagnosticScanV1 {
        ..state,
        root_is_object: state.root_is_object || root_object,
        value_count: next_count,
        supported: state.supported && next_count <= 1024,
        projection_supported: state.projection_supported
            && (!root_value || root_object || entered_root_array)
    };
    let selected_root: DiagnosticScanV1 = select(
        entered_root_array,
        empty_codes(counted, 1),
        counted
    );
    if selected_root.cursor.depth == 0 { return selected_root; }
    let parent_index: u64 = (selected_root.cursor.depth as u64) -% 1;
    let parent: DiagnosticFrameV1 = selected_root.frames[parent_index];
    if parent.kind == 1 {
        let next_fields: u64 = parent.field_count +% 1;
        let fields_valid: bool = parent.role != 1 || next_fields <= 32;
        let codes_fields_valid: bool = parent.role != 5 || next_fields <= 32;
        let updated_parent: DiagnosticFrameV1 = DiagnosticFrameV1 {
            ..parent,
            field_count: next_fields
        };
        let counted_fields: DiagnosticScanV1 = DiagnosticScanV1 {
            ..selected_root,
            frames: replace(selected_root.frames, parent_index, updated_parent),
            supported: selected_root.supported && fields_valid,
            codes_valid: selected_root.codes_valid && codes_fields_valid
        };
        if parent.role == 1 && parent.key == 1 {
            let base: DiagnosticScanV1 = DiagnosticScanV1 {
                ..counted_fields,
                valid_field_present: true,
                valid_field_is_true: false,
                valid_scalar_active: false,
                valid_scalar_match: false,
                valid_scalar_length: 0
            };
            if value == 34 || value == 123 || value == 91 { return base; }
            let started: DiagnosticScanV1 = DiagnosticScanV1 {
                ..base,
                valid_scalar_active: true,
                valid_scalar_match: true
            };
            return valid_scalar_step(started, value);
        }
        if parent.role == 1 && value == 91 {
            if parent.key == 2 { return empty_codes(counted_fields, 3); }
            if parent.key == 3 && counted_fields.selection == 0 {
                return empty_codes(counted_fields, 2);
            }
        }
        if parent.role == 5 && expects_failure && parent.key == 4 && value != 34 {
            return DiagnosticScanV1 { ..counted_fields, codes_valid: false };
        }
        return counted_fields;
    }
    if parent.kind == 2
        && selected_root.syntax.expect == 5
        && is_selected_array(parent.role, selected_root.selection) {
        let next_members: u64 = parent.member_count +% 1;
        let object_count: u64 = selected_root.diagnostic_count +% ((value == 123) as u64);
        let updated_parent: DiagnosticFrameV1 = DiagnosticFrameV1 {
            ..parent,
            member_count: next_members
        };
        let within_projection_bounds: bool = next_members <= 32 && object_count <= 32;
        return DiagnosticScanV1 {
            ..selected_root,
            frames: replace(selected_root.frames, parent_index, updated_parent),
            codes_valid: selected_root.codes_valid
                && (!expects_failure || next_members <= 32),
            projection_supported: selected_root.projection_supported
                && within_projection_bounds,
            diagnostic_count: object_count
        };
    }
    return selected_root;
}

fn container_role(
    state: DiagnosticScanV1,
    parent_depth: u64,
    value: byte,
    expects_failure: bool
) -> (result: byte) {
    if parent_depth == 0 {
        if value == 123 { return 1; }
        if value == 91 { return 2; }
        return 0;
    }
    let parent_index: u64 = parent_depth -% 1;
    let parent: DiagnosticFrameV1 = state.frames[parent_index];
    if parent.role == 1 && value == 91 {
        if parent.key == 2 { return 3; }
        if parent.key == 3 && state.selection == 2 { return 4; }
    }
    if parent.kind == 2 && value == 123 && expects_failure
        && is_selected_array(parent.role, state.selection) {
        return 5;
    }
    return 0;
}

fn push_container(
    state: DiagnosticScanV1,
    parent_depth: u64,
    value: byte,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    if parent_depth >= 12 {
        return DiagnosticScanV1 { ..state, supported: false };
    }
    let kind: byte = select(value == 123, 1, 2);
    let role: byte = container_role(state, parent_depth, value, expects_failure);
    let frame: DiagnosticFrameV1 = DiagnosticFrameV1 {
        ..empty_frame(),
        kind: kind,
        role: role
    };
    return DiagnosticScanV1 {
        ..state,
        frames: replace(state.frames, parent_depth, frame)
    };
}

fn key_closed(state: DiagnosticScanV1) -> (result: DiagnosticScanV1) {
    let depth: u64 = state.cursor.depth as u64;
    if depth == 0 { return DiagnosticScanV1 { ..state, supported: false }; }
    let index: u64 = depth -% 1;
    let frame: DiagnosticFrameV1 = state.frames[index];
    let plain: bool = key_span_is_plain(state.cursor);
    if frame.role == 1 {
        let tag: byte = root_key_tag(state.cursor);
        let duplicate: bool = (tag == 1 && state.valid_seen)
            || (tag == 2 && state.errors_seen)
            || (tag == 3 && state.diagnostics_seen);
        let updated: DiagnosticFrameV1 = DiagnosticFrameV1 { ..frame, key: tag };
        return DiagnosticScanV1 {
            ..state,
            frames: replace(state.frames, index, updated),
            valid_seen: state.valid_seen || tag == 1,
            errors_seen: state.errors_seen || tag == 2,
            diagnostics_seen: state.diagnostics_seen || tag == 3,
            valid_field_present: state.valid_field_present || tag == 1,
            supported: state.supported && plain && !duplicate
        };
    }
    if frame.role == 5 {
        let tag: byte = diagnostic_key_tag(state.cursor);
        let duplicate: bool = tag == 4 && frame.code_seen;
        let updated: DiagnosticFrameV1 = DiagnosticFrameV1 {
            ..frame,
            key: tag,
            code_seen: frame.code_seen || tag == 4
        };
        return DiagnosticScanV1 {
            ..state,
            frames: replace(state.frames, index, updated),
            codes_valid: state.codes_valid && !duplicate && plain
        };
    }
    return state;
}

fn decode_code_string(
    state: DiagnosticScanV1,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    let depth: u64 = state.cursor.depth as u64;
    if !expects_failure || depth == 0 { return state; }
    let index: u64 = depth -% 1;
    let frame: DiagnosticFrameV1 = state.frames[index];
    if frame.role != 5 || frame.key != 4 { return state; }
    let raw_length: u64 = state.cursor.string_end -% state.cursor.string_start;
    let updated_frame: DiagnosticFrameV1 = DiagnosticFrameV1 {
        ..frame,
        code_start: state.cursor.string_start,
        code_length: raw_length
    };
    return DiagnosticScanV1 {
        ..state,
        frames: replace(state.frames, index, updated_frame)
    };
}

fn append_diagnostic(
    state: DiagnosticScanV1,
    index: u64,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    if !expects_failure || index >= 12 { return state; }
    let frame: DiagnosticFrameV1 = state.frames[index];
    if frame.role != 5 { return state; }
    if state.actual_count >= 32 {
        return DiagnosticScanV1 { ..state, codes_valid: false };
    }
    return DiagnosticScanV1 {
        ..state,
        actual_spans: replace(
            state.actual_spans,
            state.actual_count,
            DiagnosticSpanV1 { start: frame.code_start, length: frame.code_length }
        ),
        actual_count: state.actual_count +% 1
    };
}

fn close_diagnostic_array(
    state: DiagnosticScanV1,
    parent_depth: u64
) -> (result: DiagnosticScanV1) {
    if parent_depth == 0 { return state; }
    let frame: DiagnosticFrameV1 = state.frames[parent_depth -% 1];
    if !is_selected_array(frame.role, state.selection) { return state; }
    return DiagnosticScanV1 {
        ..state,
        diagnostics_json_length: state.cursor.position
            -% state.diagnostics_json_start,
        projection_supported: state.projection_supported
            && frame.member_count <= 32 && state.diagnostic_count <= 32
    };
}

fn decode_code_span(
    codes: DiagnosticCodesV1,
    scan: DiagnosticScanV1,
    document: json_order.JsonTokenDocumentV1,
    index: u64
) -> (result: DiagnosticCodesV1) {
    if index >= scan.actual_count { return codes; }
    let span: DiagnosticSpanV1 = scan.actual_spans[index];
    if span.length == 0 {
        return DiagnosticCodesV1 {
            ..codes,
            actual: replace(codes.actual, index, empty_code()),
            count: index +% 1
        };
    }
    let decoded: json_order.JsonDecodedStringV1 = json_order.decode_string(
        document, span.start, span.length
    );
    if !decoded.valid {
        return DiagnosticCodesV1 { ..codes, valid: false };
    }
    return DiagnosticCodesV1 {
        ..codes,
        actual: replace(
            codes.actual,
            index,
            policy.DiagnosticCodeV1 { value: decoded.bytes }
        ),
        count: index +% 1
    };
}

fn decode_code_spans(
    scan: DiagnosticScanV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: DiagnosticCodesV1) {
    iterate i up_to 32 carrying codes: DiagnosticCodesV1 = empty_decoded_codes() {
        next codes = decode_code_span(codes, scan, document, i);
    }
    return codes;
}

fn empty_code_json() -> (result: DiagnosticCodesJsonV1) {
    return DiagnosticCodesJsonV1 {
        current_bytes: [0; 1024],
        current_length: 0,
        completed: DiagnosticCodeJsonChunkListV1.Empty,
        completed_count: 0,
        length: 0,
        valid: true
    };
}

fn code_json_byte(state: DiagnosticCodesJsonV1, value: byte) -> (result: DiagnosticCodesJsonV1) {
    if !state.valid { return state; }
    if state.length >= 16384 { return DiagnosticCodesJsonV1 { ..state, valid: false }; }
    if state.current_length >= 1024 {
        let completed: DiagnosticCodeJsonChunkV1 = DiagnosticCodeJsonChunkV1 {
            bytes: state.current_bytes[0..state.current_length],
            length: state.current_length
        };
        let empty: [byte; 1024] = [0; 1024];
        let updated: [byte; 1024] = replace(empty, 0, value);
        return DiagnosticCodesJsonV1 {
            current_bytes: updated,
            current_length: 1,
            completed: DiagnosticCodeJsonChunkListV1.Cons {
                head: completed,
                tail: state.completed
            },
            completed_count: state.completed_count +% 1,
            length: state.length +% 1,
            valid: true
        };
    }
    return DiagnosticCodesJsonV1 {
        ..state,
        current_bytes: replace(state.current_bytes, state.current_length, value),
        current_length: state.current_length +% 1,
        length: state.length +% 1
    };
}

fn empty_code_json_chunk() -> (result: DiagnosticCodeJsonChunkV1) {
    return DiagnosticCodeJsonChunkV1 { bytes: [], length: 0 };
}

fn copy_code_json_chunk(
    state: DiagnosticCodeJsonChunkCopyV1,
    index: u64,
    completed_count: u64
) -> (result: DiagnosticCodeJsonChunkCopyV1) {
    if index >= completed_count { return state; }
    return match state.remaining {
        Empty => state,
        Cons { head: head, tail: tail } => DiagnosticCodeJsonChunkCopyV1 {
            remaining: tail,
            chunks: replace(state.chunks, completed_count -% index -% 1, head)
        }
    };
}

fn code_json_output_chunks(state: DiagnosticCodesJsonV1) -> (result: [DiagnosticCodeJsonChunkV1; up_to 16]) {
    let initial: DiagnosticCodeJsonChunkCopyV1 = DiagnosticCodeJsonChunkCopyV1 {
        remaining: state.completed,
        chunks: [empty_code_json_chunk(); 16]
    };
    iterate i up_to 16 carrying copied: DiagnosticCodeJsonChunkCopyV1 = initial {
        next copied = copy_code_json_chunk(copied, i, state.completed_count);
    }
    let final_chunk: DiagnosticCodeJsonChunkV1 = DiagnosticCodeJsonChunkV1 {
        bytes: state.current_bytes[0..state.current_length],
        length: state.current_length
    };
    let output: [DiagnosticCodeJsonChunkV1; 16] = replace(
        copied.chunks, state.completed_count, final_chunk
    );
    return output[0..state.completed_count +% 1];
}

fn code_json_hex_digit(value: u64) -> (result: byte) {
    if value < 10 { return (48 +% value) as byte; }
    return (87 +% value) as byte;
}

fn code_json_string_byte(state: DiagnosticCodesJsonV1, value: byte) -> (result: DiagnosticCodesJsonV1) {
    if value == 34 || value == 92 {
        return code_json_byte(code_json_byte(state, 92), value);
    }
    if value == 8 { return code_json_byte(code_json_byte(state, 92), 98); }
    if value == 9 { return code_json_byte(code_json_byte(state, 92), 116); }
    if value == 10 { return code_json_byte(code_json_byte(state, 92), 110); }
    if value == 12 { return code_json_byte(code_json_byte(state, 92), 102); }
    if value == 13 { return code_json_byte(code_json_byte(state, 92), 114); }
    if value < 32 {
        let number: u64 = value as u64;
        let slash: DiagnosticCodesJsonV1 = code_json_byte(state, 92);
        let marker: DiagnosticCodesJsonV1 = code_json_byte(slash, 117);
        let zero_high: DiagnosticCodesJsonV1 = code_json_byte(marker, 48);
        let zero_low: DiagnosticCodesJsonV1 = code_json_byte(zero_high, 48);
        let high: DiagnosticCodesJsonV1 = code_json_byte(
            zero_low, code_json_hex_digit(number / 16)
        );
        return code_json_byte(high, code_json_hex_digit(number % 16));
    }
    return code_json_byte(state, value);
}

fn code_json_item(
    state: DiagnosticCodesJsonV1,
    codes: DiagnosticCodesV1,
    index: u64
) -> (result: DiagnosticCodesJsonV1) {
    if index >= codes.count { return state; }
    let separated: DiagnosticCodesJsonV1 = select(
        index > 0, code_json_byte(state, 44), state
    );
    let code: policy.DiagnosticCodeV1 = codes.actual[index];
    let opened: DiagnosticCodesJsonV1 = code_json_byte(separated, 34);
    iterate i over code.value carrying encoded: DiagnosticCodesJsonV1 = opened {
        next encoded = code_json_string_byte(encoded, code.value[i]);
    }
    return code_json_byte(encoded, 34);
}

fn encode_code_json(codes: DiagnosticCodesV1) -> (result: DiagnosticCodesJsonV1) {
    if !codes.valid || codes.count > 32 {
        return DiagnosticCodesJsonV1 { ..empty_code_json(), valid: false };
    }
    let opened: DiagnosticCodesJsonV1 = code_json_byte(empty_code_json(), 91);
    iterate i up_to 32 carrying encoded: DiagnosticCodesJsonV1 = opened {
        next encoded = code_json_item(encoded, codes, i);
    }
    return code_json_byte(encoded, 93);
}

fn selected_codes(
    scan: DiagnosticScanV1,
    document: json_order.JsonTokenDocumentV1,
    expects_failure: bool
) -> (result: DiagnosticCodesV1) {
    if !expects_failure { return empty_decoded_codes(); }
    return decode_code_spans(scan, document);
}

fn observe_event(
    state: DiagnosticScanV1,
    parent_depth: u64,
    value: byte,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    if state.cursor.event == 2 { return key_closed(state); }
    if state.cursor.event == 4 {
        return decode_code_string(state, expects_failure);
    }
    if state.cursor.event == 5 || state.cursor.event == 6 {
        return push_container(state, parent_depth, value, expects_failure);
    }
    if state.cursor.event == 7 {
        return append_diagnostic(state, state.cursor.depth as u64, expects_failure);
    }
    if state.cursor.event == 8 {
        return close_diagnostic_array(state, parent_depth);
    }
    return state;
}

fn scan_byte(
    state: DiagnosticScanV1,
    value: byte,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    let finished: DiagnosticScanV1 = select(
        state.valid_scalar_active && scalar_boundary(value),
        finish_valid_scalar(state),
        state
    );
    let parent_depth: u64 = finished.cursor.depth as u64;
    let started: DiagnosticScanV1 = begin_value(finished, value, expects_failure);
    let cursor: json_cursor.Cursor = json_cursor.feed_byte(started.cursor, value);
    let syntax: json.ScanState = json.scan_step(started.syntax, value);
    let advanced: DiagnosticScanV1 = DiagnosticScanV1 {
        ..started,
        cursor: cursor,
        syntax: syntax
    };
    if started.valid_scalar_active && !finished.valid_scalar_active {
        let updated: DiagnosticScanV1 = DiagnosticScanV1 { ..advanced };
        return observe_event(updated, parent_depth, value, expects_failure);
    }
    let scalar_updated: DiagnosticScanV1 = select(
        started.valid_scalar_active && !scalar_boundary(value)
            && finished.valid_scalar_active,
        valid_scalar_step(advanced, value),
        advanced
    );
    return observe_event(scalar_updated, parent_depth, value, expects_failure);
}

fn scan_chunk_part(
    state: DiagnosticScanV1,
    chunk: json_order.JsonTokenInputChunkV1,
    part: u64,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    let start: u64 = part *% 64;
    if start >= chunk.length { return state; }
    let remaining: u64 = chunk.length -% start;
    let size: u64 = select(remaining < 64, remaining, 64);
    let source: [byte; up_to 64] = chunk.bytes[start..start +% size];
    iterate i over source carrying scanned: DiagnosticScanV1 = state {
        next scanned = scan_byte(scanned, source[i], expects_failure);
    }
    return scanned;
}

fn scan_chunk(
    state: DiagnosticScanV1,
    chunk: json_order.JsonTokenInputChunkV1,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    iterate i up_to 16 carrying scanned: DiagnosticScanV1 = state {
        next scanned = scan_chunk_part(scanned, chunk, i, expects_failure);
    }
    return scanned;
}

fn scan_document(
    document: json_order.JsonTokenDocumentV1,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    iterate i over document.chunks carrying scanned: DiagnosticScanV1 = initial_diagnostic_scan() {
        next scanned = scan_chunk(scanned, document.chunks[i], expects_failure);
    }
    return select(
        scanned.valid_scalar_active,
        finish_valid_scalar(scanned),
        scanned
    );
}

fn scan_request(
    request_valid: bool,
    document: json_order.JsonTokenDocumentV1,
    expects_failure: bool
) -> (result: DiagnosticScanV1) {
    if !request_valid { return initial_diagnostic_scan(); }
    return scan_document(document, expects_failure);
}

fn scan_is_valid(
    scanned: DiagnosticScanV1,
    expects_failure: bool
) -> (result: bool) {
    let syntax: json.ScanState = json.scan_finish_end(scanned.syntax);
    let syntax_valid: bool = syntax.valid && syntax.depth == 0
        && syntax.mode == 0 && syntax.expect == 7;
    let cursor_valid: bool = json_cursor.is_valid(scanned.cursor);
    return scanned.supported && syntax_valid && cursor_valid
        && (!expects_failure || scanned.codes_valid);
}

fn result(
    supported: bool,
    verdict: [byte; up_to 64],
    scanned: DiagnosticScanV1,
    codes: DiagnosticCodesV1,
    codes_json: DiagnosticCodesJsonV1
) -> (result: CompileDiagnosticVerdictResultV1) {
    let span_in_bounds: bool = scanned.diagnostics_json_present
        && scanned.diagnostics_json_length >= 2
        && scanned.diagnostics_json_start <= scanned.cursor.position
        && scanned.diagnostics_json_length
            <= scanned.cursor.position -% scanned.diagnostics_json_start;
    let no_array: bool = scanned.selection == 0
        && !scanned.diagnostics_json_present && scanned.diagnostic_count == 0;
    let span_valid: bool = select(
        scanned.selection == 0,
        no_array,
        span_in_bounds && scanned.diagnostic_count <= 32
    );
    let projection_supported: bool = supported
        && scanned.projection_supported && span_valid;
    let safe_codes: DiagnosticCodesV1 = select(
        supported && codes.valid, codes, empty_decoded_codes()
    );
    let safe_codes_json: DiagnosticCodesJsonV1 = select(
        supported && codes.valid && codes_json.valid,
        codes_json,
        encode_code_json(empty_decoded_codes())
    );
    return CompileDiagnosticVerdictResultV1 {
        schema_version: result_schema(),
        supported: supported,
        projection_supported: projection_supported,
        root_is_object: supported && scanned.root_is_object,
        valid_field_present: supported && scanned.valid_field_present,
        valid_field_is_true: supported && scanned.valid_field_is_true,
        diagnostic_count: select(projection_supported, scanned.diagnostic_count, 0),
        diagnostic_code_count: safe_codes.count,
        diagnostic_codes_json_chunks: code_json_output_chunks(safe_codes_json),
        diagnostic_codes_json_length: safe_codes_json.length,
        diagnostics_json_present: projection_supported
            && scanned.diagnostics_json_present,
        diagnostics_json_start: select(
            projection_supported, scanned.diagnostics_json_start, 0
        ),
        diagnostics_json_length: select(
            projection_supported, scanned.diagnostics_json_length, 0
        ),
        verdict: verdict
    };
}

fn compile_diagnostic_verdict_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97,114,103,118,32,114,101,113,117,105,114,101,115,32,50,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,112,97,116,104,115], 2);
    }
    let request: CompileDiagnosticVerdictRequestV1 = structured_read(context.argv[0], request_schema());
    let shape: json_order.DocumentShapeV1 = json_order.document_shape(request.document);
    let request_valid: bool = schema_is(request.schema_version, request_schema())
        && request.expected_count == request.expected.len
        && request.expected_count <= 16
        && shape.valid
        && shape.total == request.document.byte_length
        && request.document.byte_length <= 16384;
    let scanned: DiagnosticScanV1 = scan_request(
        request_valid, request.document, request.expects_failure
    );
    if !request_valid || !scan_is_valid(scanned, request.expects_failure) {
        let rejected: CompileDiagnosticVerdictResultV1 = result(
            false, [], scanned, empty_decoded_codes(),
            encode_code_json(empty_decoded_codes())
        );
        let published: u64 = structured_write(context.argv[1], result_schema(), rejected);
        if published == 0 { return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 3); }
        return success([]);
    }

    let codes: DiagnosticCodesV1 = selected_codes(
        scanned, request.document, request.expects_failure
    );
    if !codes.valid {
        let rejected: CompileDiagnosticVerdictResultV1 = result(
            false, [], scanned, empty_decoded_codes(),
            encode_code_json(empty_decoded_codes())
        );
        let published: u64 = structured_write(context.argv[1], result_schema(), rejected);
        if published == 0 { return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 3); }
        return success([]);
    }

    let codes_json: DiagnosticCodesJsonV1 = encode_code_json(codes);
    if !codes_json.valid {
        let rejected: CompileDiagnosticVerdictResultV1 = result(
            false, [], scanned, empty_decoded_codes(),
            encode_code_json(empty_decoded_codes())
        );
        let published: u64 = structured_write(context.argv[1], result_schema(), rejected);
        if published == 0 { return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 3); }
        return success([]);
    }

    let actual_count: u64 = select(request.expects_failure, codes.count, 0);
    let actual: [policy.DiagnosticCodeV1; up_to 32] = select(
        request.expects_failure, codes.actual[0..actual_count], []
    );
    let policy_request: policy.CompileVerdictRequestV1 = policy.CompileVerdictRequestV1 {
        schema_version: [109,110,99,115,46,116,101,115,116,45,99,111,109,112,105,108,101,45,118,101,114,100,105,99,116,45,114,101,113,117,101,115,116,47,49],
        compiler_exit_code: request.compiler_exit_code,
        compiler_result_is_object: scanned.root_is_object,
        valid_field_present: scanned.valid_field_present,
        valid_field_is_true: scanned.valid_field_is_true,
        expects_failure: request.expects_failure,
        expected_count: request.expected_count,
        expected: request.expected,
        actual_count: actual_count,
        actual: actual,
        matched_before: [false; 16],
        all_expected_before: true,
        diagnostics_seen_before: false
    };
    let decision: policy.CompileVerdictResultV1 = policy.evaluate(policy_request);
    let ready: CompileDiagnosticVerdictResultV1 = result(
        true, decision.verdict, scanned, codes, codes_json
    );
    let published: u64 = structured_write(context.argv[1], result_schema(), ready);
    if published == 0 {
        return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 4);
    }
    return success([]);
}
