mncs 0.18;

// Project the compiler's bounded JSON diagnostic document and apply the
// existing Test-owned compile verdict policy without a host diagnostic-code
// tree or a second typed request round trip.
module mncs.test.compile_diagnostic_verdict_v1;

use mncs.std.application.v1;
use mncs.test.compile_verdict_v1 as policy;
use mncs.test.public_result_json_key_order_v1 as json_order;

record CompileDiagnosticVerdictRequestV1 {
    schema_version: [byte; up_to 64],
    document: json_order.JsonTokenDocumentV1,
    compiler_exit_code: i64,
    expects_failure: bool,
    expected_count: u64,
    expected: [policy.DiagnosticCodeV1; up_to 16]
}

record CompileDiagnosticVerdictResultV1 {
    schema_version: [byte; up_to 64],
    supported: bool,
    verdict: [byte; up_to 64]
}

record FieldValueV1 { found: bool, value: json_order.JsonValueV1, complete: bool }
record FieldSearchStateV1 { remaining: json_order.JsonValueV1, field: FieldValueV1 }
record CodeReadV1 { value: policy.DiagnosticCodeV1, valid: bool }
record DiagnosticCodesV1 {
    remaining: json_order.JsonValueV1,
    actual: [policy.DiagnosticCodeV1; 32],
    count: u64,
    valid: bool,
    complete: bool
}

fn request_schema() -> (result: [byte; up_to 64]) {
    return [109,110,99,115,46,116,101,115,116,45,99,111,109,112,105,108,101,45,100,105,97,103,110,111,115,116,105,99,45,118,101,114,100,105,99,116,45,114,101,113,117,101,115,116,47,49];
}

fn result_schema() -> (result: [byte; up_to 64]) {
    return [109,110,99,115,46,116,101,115,116,45,99,111,109,112,105,108,101,45,100,105,97,103,110,111,115,116,105,99,45,118,101,114,100,105,99,116,47,49];
}

fn schema_is(value: [byte; up_to 64], expected: [byte; up_to 64]) -> (result: bool) {
    if value.len != expected.len { return false; }
    iterate i over expected carrying same: bool = true {
        next same = same && value[i] == expected[i];
    }
    return same;
}

fn code_key() -> (result: [byte; up_to 256]) { return [99,111,100,101]; }
fn errors_key() -> (result: [byte; up_to 256]) { return [101,114,114,111,114,115]; }
fn diagnostics_key() -> (result: [byte; up_to 256]) { return [100,105,97,103,110,111,115,116,105,99,115]; }
fn valid_key() -> (result: [byte; up_to 256]) { return [118,97,108,105,100]; }

fn selected_diagnostic_value(
    root: json_order.JsonValueV1,
    root_fields: json_order.JsonValueV1,
    errors_value: FieldValueV1
) -> (result: FieldValueV1) {
    if is_array(root) { return FieldValueV1 { found: true, value: root, complete: true }; }
    if errors_value.found && is_array(errors_value.value) { return errors_value; }
    return find_field(root_fields, diagnostics_key());
}

fn empty_code_state() -> (result: DiagnosticCodesV1) {
    return DiagnosticCodesV1 {
        remaining: json_order.JsonValueV1.ArrayNil,
        actual: [empty_code(); 32],
        count: 0,
        valid: true,
        complete: true
    };
}

fn codes_for_selected_value(
    expects_failure: bool,
    selected_value: FieldValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: DiagnosticCodesV1) {
    if !selected_value.complete { return DiagnosticCodesV1 { ..empty_code_state(), valid: false }; }
    if expects_failure && is_array(selected_value.value) {
        return collect_codes(array_items(selected_value.value), document);
    }
    return empty_code_state();
}

fn same_key(key: json_order.KeyV1, expected: [byte; up_to 256]) -> (result: bool) {
    if key.ordered_length != expected.len { return false; }
    iterate i over expected carrying same: bool = true {
        next same = same && key.ordered[i] == expected[i];
    }
    return same;
}

fn absent_field() -> (result: FieldValueV1) {
    return FieldValueV1 { found: false, value: json_order.JsonValueV1.Empty, complete: true };
}

fn incomplete_field() -> (result: FieldValueV1) {
    return FieldValueV1 { found: false, value: json_order.JsonValueV1.Empty, complete: false };
}

fn field_search_cons(
    key: json_order.KeyV1,
    value: json_order.JsonValueV1,
    tail: json_order.JsonValueV1,
    expected: [byte; up_to 256],
    prior: FieldValueV1
) -> (result: FieldSearchStateV1) {
    if same_key(key, expected) {
        return FieldSearchStateV1 {
            remaining: json_order.JsonValueV1.ObjectNil,
            field: FieldValueV1 { found: true, value: value, complete: true }
        };
    }
    return FieldSearchStateV1 { remaining: tail, field: prior };
}

fn field_search_step(
    search: FieldSearchStateV1,
    expected: [byte; up_to 256]
) -> (result: FieldSearchStateV1) {
    if search.field.found || search.field.complete { return search; }
    return match search.remaining {
        ObjectCons { key: key, value: value, tail: tail } => field_search_cons(key, value, tail, expected, search.field),
        ObjectNil => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Empty => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Null => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Raw { start: start, length: length } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        String { start: start, length: length } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Boolean { value: flag } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Integer { negative: negative, magnitude: magnitude } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Utf8String { start: start, length: length } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Array { items: items } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        Object { fields: nested } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        ArrayNil => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() },
        ArrayCons { head: head, tail: tail } => FieldSearchStateV1 { remaining: json_order.JsonValueV1.ObjectNil, field: absent_field() }
    };
}

fn find_field(
    fields: json_order.JsonValueV1,
    expected: [byte; up_to 256]
) -> (result: FieldValueV1) {
    let initial: FieldSearchStateV1 = FieldSearchStateV1 { remaining: fields, field: incomplete_field() };
    iterate i up_to 32 carrying search: FieldSearchStateV1 = initial {
        next search = field_search_step(search, expected);
    }
    if search.field.found || search.field.complete { return search.field; }
    return FieldValueV1 {
        ..search.field,
        complete: json_order.is_object_nil(search.remaining)
    };
}

fn empty_code() -> (result: policy.DiagnosticCodeV1) {
    return policy.DiagnosticCodeV1 { value: [0; 0] };
}

fn read_code_span(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: CodeReadV1) {
    let decoded: json_order.JsonDecodedStringV1 = json_order.decode_string(document, start, length);
    return CodeReadV1 {
        value: policy.DiagnosticCodeV1 { value: decoded.bytes },
        valid: decoded.valid
    };
}

fn read_code(
    value: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: CodeReadV1) {
    return match value {
        String { start: start, length: length } => read_code_span(document, start, length),
        Empty => CodeReadV1 { value: empty_code(), valid: true },
        Null => CodeReadV1 { value: empty_code(), valid: false },
        Raw { start: start, length: length } => CodeReadV1 { value: empty_code(), valid: false },
        Boolean { value: flag } => CodeReadV1 { value: empty_code(), valid: false },
        Integer { negative: negative, magnitude: magnitude } => CodeReadV1 { value: empty_code(), valid: false },
        Utf8String { start: start, length: length } => CodeReadV1 { value: empty_code(), valid: false },
        Array { items: items } => CodeReadV1 { value: empty_code(), valid: false },
        Object { fields: fields } => CodeReadV1 { value: empty_code(), valid: false },
        ArrayNil => CodeReadV1 { value: empty_code(), valid: false },
        ArrayCons { head: head, tail: tail } => CodeReadV1 { value: empty_code(), valid: false },
        ObjectNil => CodeReadV1 { value: empty_code(), valid: false },
        ObjectCons { key: key, value: nested, tail: tail } => CodeReadV1 { value: empty_code(), valid: false }
    };
}

fn diagnostic_code(
    value: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: CodeReadV1) {
    return match value {
        Object { fields: fields } => diagnostic_code_fields(fields, document),
        Empty => CodeReadV1 { value: empty_code(), valid: false },
        Null => CodeReadV1 { value: empty_code(), valid: false },
        Raw { start: start, length: length } => CodeReadV1 { value: empty_code(), valid: false },
        String { start: start, length: length } => CodeReadV1 { value: empty_code(), valid: false },
        Boolean { value: flag } => CodeReadV1 { value: empty_code(), valid: false },
        Integer { negative: negative, magnitude: magnitude } => CodeReadV1 { value: empty_code(), valid: false },
        Utf8String { start: start, length: length } => CodeReadV1 { value: empty_code(), valid: false },
        Array { items: items } => CodeReadV1 { value: empty_code(), valid: false },
        ArrayNil => CodeReadV1 { value: empty_code(), valid: false },
        ArrayCons { head: head, tail: tail } => CodeReadV1 { value: empty_code(), valid: false },
        ObjectNil => CodeReadV1 { value: empty_code(), valid: false },
        ObjectCons { key: key, value: nested, tail: tail } => CodeReadV1 { value: empty_code(), valid: false }
    };
}

fn diagnostic_code_fields(
    fields: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: CodeReadV1) {
    let code: FieldValueV1 = find_field(fields, code_key());
    if !code.complete { return CodeReadV1 { value: empty_code(), valid: false }; }
    if code.found { return read_code(code.value, document); }
    return CodeReadV1 { value: empty_code(), valid: true };
}

fn empty_codes(remaining: json_order.JsonValueV1) -> (result: DiagnosticCodesV1) {
    return DiagnosticCodesV1 {
        remaining: remaining,
        actual: [empty_code(); 32],
        count: 0,
        valid: true,
        complete: false
    };
}

fn is_object(value: json_order.JsonValueV1) -> (result: bool) {
    return match value {
        Object { fields: fields } => true,
        Empty => false,
        Null => false,
        Raw { start: start, length: length } => false,
        String { start: start, length: length } => false,
        Boolean { value: flag } => false,
        Integer { negative: negative, magnitude: magnitude } => false,
        Utf8String { start: start, length: length } => false,
        Array { items: items } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: nested, tail: tail } => false
    };
}

fn object_fields(value: json_order.JsonValueV1) -> (result: json_order.JsonValueV1) {
    return match value {
        Object { fields: fields } => fields,
        Empty => json_order.JsonValueV1.Empty,
        Null => json_order.JsonValueV1.Empty,
        Raw { start: start, length: length } => json_order.JsonValueV1.Empty,
        String { start: start, length: length } => json_order.JsonValueV1.Empty,
        Boolean { value: flag } => json_order.JsonValueV1.Empty,
        Integer { negative: negative, magnitude: magnitude } => json_order.JsonValueV1.Empty,
        Utf8String { start: start, length: length } => json_order.JsonValueV1.Empty,
        Array { items: items } => json_order.JsonValueV1.Empty,
        ArrayNil => json_order.JsonValueV1.Empty,
        ArrayCons { head: head, tail: tail } => json_order.JsonValueV1.Empty,
        ObjectNil => json_order.JsonValueV1.Empty,
        ObjectCons { key: key, value: nested, tail: tail } => json_order.JsonValueV1.Empty
    };
}

fn collect_object_code(
    state: DiagnosticCodesV1,
    following: DiagnosticCodesV1,
    head: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: DiagnosticCodesV1) {
    if state.count >= 32 { return DiagnosticCodesV1 { ..following, valid: false }; }
    let code: CodeReadV1 = diagnostic_code_fields(object_fields(head), document);
    if !code.valid { return DiagnosticCodesV1 { ..following, valid: false }; }
    return DiagnosticCodesV1 {
        ..following,
        actual: replace(state.actual, state.count, code.value),
        count: state.count +% 1
    };
}

fn collect_array_member(
    state: DiagnosticCodesV1,
    head: json_order.JsonValueV1,
    tail: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: DiagnosticCodesV1) {
    let following: DiagnosticCodesV1 = DiagnosticCodesV1 { ..state, remaining: tail };
    if !is_object(head) { return following; }
    return collect_object_code(state, following, head, document);
}

fn collect_code_step(
    state: DiagnosticCodesV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: DiagnosticCodesV1) {
    if !state.valid || state.complete { return state; }
    return match state.remaining {
        ArrayCons { head: head, tail: tail } => collect_array_member(state, head, tail, document),
        ArrayNil => DiagnosticCodesV1 { ..state, complete: true },
        Empty => DiagnosticCodesV1 { ..state, valid: false },
        Null => DiagnosticCodesV1 { ..state, valid: false },
        Raw { start: start, length: length } => DiagnosticCodesV1 { ..state, valid: false },
        String { start: start, length: length } => DiagnosticCodesV1 { ..state, valid: false },
        Boolean { value: flag } => DiagnosticCodesV1 { ..state, valid: false },
        Integer { negative: negative, magnitude: magnitude } => DiagnosticCodesV1 { ..state, valid: false },
        Utf8String { start: start, length: length } => DiagnosticCodesV1 { ..state, valid: false },
        Array { items: items } => DiagnosticCodesV1 { ..state, valid: false },
        Object { fields: fields } => DiagnosticCodesV1 { ..state, valid: false },
        ObjectNil => DiagnosticCodesV1 { ..state, valid: false },
        ObjectCons { key: key, value: value, tail: tail } => DiagnosticCodesV1 { ..state, valid: false }
    };
}

fn collect_codes(
    items: json_order.JsonValueV1,
    document: json_order.JsonTokenDocumentV1
) -> (result: DiagnosticCodesV1) {
    iterate i up_to 33 carrying collected: DiagnosticCodesV1 = empty_codes(items) {
        next collected = collect_code_step(collected, document);
    }
    return collected;
}

fn is_array(value: json_order.JsonValueV1) -> (result: bool) {
    return match value {
        Array { items: items } => true,
        ArrayNil => true,
        ArrayCons { head: head, tail: tail } => true,
        Empty => false,
        Null => false,
        Raw { start: start, length: length } => false,
        String { start: start, length: length } => false,
        Boolean { value: flag } => false,
        Integer { negative: negative, magnitude: magnitude } => false,
        Utf8String { start: start, length: length } => false,
        Object { fields: fields } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: nested, tail: tail } => false
    };
}

fn raw_is_true(
    document: json_order.JsonTokenDocumentV1,
    start: u64,
    length: u64
) -> (result: bool) {
    if length != 4 { return false; }
    return json_order.located_byte(document, start) == 116
        && json_order.located_byte(document, start +% 1) == 114
        && json_order.located_byte(document, start +% 2) == 117
        && json_order.located_byte(document, start +% 3) == 101;
}

fn is_true(value: json_order.JsonValueV1, document: json_order.JsonTokenDocumentV1) -> (result: bool) {
    return match value {
        Boolean { value: flag } => flag,
        Empty => false,
        Null => false,
        Raw { start: start, length: length } => raw_is_true(document, start, length),
        String { start: start, length: length } => false,
        Integer { negative: negative, magnitude: magnitude } => false,
        Utf8String { start: start, length: length } => false,
        Array { items: items } => false,
        Object { fields: fields } => false,
        ArrayNil => false,
        ArrayCons { head: head, tail: tail } => false,
        ObjectNil => false,
        ObjectCons { key: key, value: nested, tail: tail } => false
    };
}

fn array_items(value: json_order.JsonValueV1) -> (result: json_order.JsonValueV1) {
    return match value {
        Array { items: items } => items,
        ArrayNil => json_order.JsonValueV1.ArrayNil,
        ArrayCons { head: head, tail: tail } => value,
        Empty => json_order.JsonValueV1.Empty,
        Null => json_order.JsonValueV1.Empty,
        Raw { start: start, length: length } => json_order.JsonValueV1.Empty,
        String { start: start, length: length } => json_order.JsonValueV1.Empty,
        Boolean { value: flag } => json_order.JsonValueV1.Empty,
        Integer { negative: negative, magnitude: magnitude } => json_order.JsonValueV1.Empty,
        Utf8String { start: start, length: length } => json_order.JsonValueV1.Empty,
        Object { fields: fields } => json_order.JsonValueV1.Empty,
        ObjectNil => json_order.JsonValueV1.Empty,
        ObjectCons { key: key, value: nested, tail: tail } => json_order.JsonValueV1.Empty
    };
}

fn empty_policy_request() -> (result: policy.CompileVerdictRequestV1) {
    return policy.CompileVerdictRequestV1 {
        schema_version: [0; 0],
        compiler_exit_code: 0,
        compiler_result_is_object: false,
        valid_field_present: false,
        valid_field_is_true: false,
        expects_failure: false,
        expected_count: 0,
        expected: [],
        actual_count: 0,
        actual: [],
        matched_before: [false; 16],
        all_expected_before: true,
        diagnostics_seen_before: false
    };
}

fn result(
    supported: bool,
    verdict: [byte; up_to 64]
) -> (result: CompileDiagnosticVerdictResultV1) {
    return CompileDiagnosticVerdictResultV1 {
        schema_version: result_schema(),
        supported: supported,
        verdict: verdict
    };
}

fn compile_diagnostic_verdict_app_v1(context: ApplicationContext) -> (result: ApplicationExit)
    capability test_artifact
    effect structured_read authorized_by test_artifact
    effect structured_write authorized_by test_artifact
{
    if !context_is_bounded(context) || context.argv_count < 2 {
        return failure([97,114,103,118,32,114,101,113,117,105,114,101,115,32,50,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,112,97,116,104,115], 2);
    }
    let request: CompileDiagnosticVerdictRequestV1 = structured_read(context.argv[0], request_schema());
    let shape: json_order.DocumentShapeV1 = json_order.document_shape(request.document);
    let request_valid: bool = schema_is(request.schema_version, request_schema())
        && request.expected_count == request.expected.len
        && request.expected_count <= 16
        && shape.valid
        && request.document.byte_length <= 16384
        && shape.total == request.document.byte_length;
    let parsed: json_order.ParseStateV1 = json_order.parse_checked(request.document, request_valid);
    let empty: CompileDiagnosticVerdictResultV1 = result(false, []);
    if !request_valid || !parsed.valid {
        let published: u64 = structured_write(context.argv[1], result_schema(), empty);
        if published == 0 { return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 3); }
        return success([]);
    }

    let root: json_order.JsonValueV1 = parsed.root;
    let compiler_is_object: bool = is_object(root);
    let root_fields: json_order.JsonValueV1 = object_fields(root);
    let valid_value: FieldValueV1 = find_field(root_fields, valid_key());
    let valid_is_true: bool = is_true(valid_value.value, request.document);
    let diagnostic_value: FieldValueV1 = find_field(root_fields, errors_key());
    let selected_value: FieldValueV1 = selected_diagnostic_value(root, root_fields, diagnostic_value);
    let codes: DiagnosticCodesV1 = codes_for_selected_value(
        request.expects_failure, selected_value, request.document
    );
    let root_fields_complete: bool = valid_value.complete && diagnostic_value.complete
        && selected_value.complete;
    let codes_valid: bool = codes.valid && codes.complete && root_fields_complete;
    if !codes_valid {
        let published: u64 = structured_write(context.argv[1], result_schema(), empty);
        if published == 0 { return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 3); }
        return success([]);
    }

    let actual_count: u64 = select(request.expects_failure, codes.count, 0);
    let actual: [policy.DiagnosticCodeV1; up_to 32] = select(
        request.expects_failure, codes.actual[0..codes.count], []
    );
    let policy_request: policy.CompileVerdictRequestV1 = policy.CompileVerdictRequestV1 {
        schema_version: [109,110,99,115,46,116,101,115,116,45,99,111,109,112,105,108,101,45,118,101,114,100,105,99,116,45,114,101,113,117,101,115,116,47,49],
        compiler_exit_code: request.compiler_exit_code,
        compiler_result_is_object: compiler_is_object,
        valid_field_present: valid_value.found,
        valid_field_is_true: valid_is_true,
        expects_failure: request.expects_failure,
        expected_count: request.expected_count,
        expected: request.expected,
        actual_count: actual_count,
        actual: actual,
        matched_before: [false; 16],
        all_expected_before: true,
        diagnostics_seen_before: false
    };
    let decision: policy.CompileVerdictResultV1 = policy.evaluate(policy_request);
    let ready: CompileDiagnosticVerdictResultV1 = result(true, decision.verdict);
    let published: u64 = structured_write(context.argv[1], result_schema(), ready);
    if published == 0 {
        return failure([112,117,98,108,105,115,104,32,99,111,109,112,105,108,101,32,100,105,97,103,110,111,115,116,105,99,32,114,101,115,117,108,116,32,102,97,105,108,101,100], 4);
    }
    return success([]);
}
