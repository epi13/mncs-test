#!/usr/bin/env bash
# Canonical executable adapter for the native test digest.
#
# Usage: mncs-test-digest REQUEST.json DIGEST.json
#
# Both paths must be relative to the current directory without `..`
# (run-app structured-artifact rule). The request is a DigestRequest
# projected from one mncs.test-result/1 record; relevance policy lives
# in `mncs.test.digest` and this adapter is transport only.
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "usage: mncs-test-digest REQUEST.json DIGEST.json" >&2
    exit 2
fi

for path in "$1" "$2"; do
    case "$path" in
        /*|*..*)
            echo "error: digest artifact paths must be relative without '..': $path" >&2
            exit 2
            ;;
    esac
done

MNCS_BIN="${MNCS:-mncs}"
if ! command -v "$MNCS_BIN" >/dev/null 2>&1 && [[ ! -x "$MNCS_BIN" ]]; then
    echo "error: native mncs compiler/runtime not found; set MNCS to the trusted bootstrap executable" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DESCRIPTOR="$SCRIPT_DIR/../native-applications/test-digest.json"
if [[ ! -f "$DESCRIPTOR" ]]; then
    echo "error: digest descriptor is unavailable: $DESCRIPTOR" >&2
    exit 3
fi

# Toolchain-scoped artifact cache: debug and release builds of the same
# source produce mutually unvalidating artifacts, so each toolchain binary
# gets its own cache namespace. An explicit
# MNCS_NATIVE_APPLICATION_CACHE_DIR still wins when set.
CACHE_ARGS=()
if [[ -z "${MNCS_NATIVE_APPLICATION_CACHE_DIR:-}" ]]; then
    if command -v sha256sum >/dev/null 2>&1; then
        _MNCS_RESOLVED="$(command -v "$MNCS_BIN" 2>/dev/null || printf '%s' "$MNCS_BIN")"
        _MNCS_CANON="$(realpath -m "$_MNCS_RESOLVED" 2>/dev/null || printf '%s' "$_MNCS_RESOLVED")"
        _MNCS_SCOPE="$(printf '%s' "$_MNCS_CANON" | sha256sum | cut -c1-16)"
        CACHE_ARGS=(--cache-dir "$SCRIPT_DIR/../native-applications/.mncs/toolchains/$_MNCS_SCOPE")
    fi
fi

exec "$MNCS_BIN" run-app "$DESCRIPTOR" \
    ${CACHE_ARGS[@]+"${CACHE_ARGS[@]}"} \
    --grant-structured test_artifact \
    --step-budget 1048576 \
    -- "$1" "$2"
