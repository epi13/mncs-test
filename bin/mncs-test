#!/usr/bin/env bash
# Canonical executable adapter for the MNCS-native runner.
#
# This file is intentionally a small packaging boundary: application
# semantics live in MNCS and the compiler/runtime is the trusted bootstrap.
# The old Python implementation is not a fallback here.  Use the explicitly
# named `bin/mncs-test-compat` adapter when an independent oracle is desired.
set -euo pipefail

if [[ "${1:-}" == "vm" ]]; then
    shift
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    exec "$SCRIPT_DIR/mncs-test-vm" "$@"
fi

if [[ "${1:-}" == "compat" || "${1:-}" == "oracle" ]]; then
    echo "error: the Python compatibility runner is explicit; invoke bin/mncs-test-compat directly" >&2
    exit 2
fi

case "${1:-}" in
    discover|validate-manifest|run|run-check|replay)
        echo "error: legacy mncs-test subcommands are compatibility-only; invoke bin/mncs-test-compat explicitly" >&2
        exit 2
        ;;
esac

MNCS_BIN="${MNCS:-mncs}"
if ! command -v "$MNCS_BIN" >/dev/null 2>&1 && [[ ! -x "$MNCS_BIN" ]]; then
    echo "error: native mncs compiler/runtime not found; set MNCS to the trusted bootstrap executable" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MNCS_PATH="$(command -v "$MNCS_BIN" 2>/dev/null || true)"
if [[ -z "$MNCS_PATH" && -x "$MNCS_BIN" ]]; then
    MNCS_PATH="$MNCS_BIN"
fi
if [[ -n "$MNCS_PATH" ]]; then
    LANGUAGE_ROOT="$(cd "$(dirname "$MNCS_PATH")/../.." && pwd)"
    AUTO_LIBRARY_PATH=""
    # The standard library lives in the mncs-stdlib checkout: an explicit
    # MNCS_STDLIB_ROOT wins (empty disables stdlib derivation for hermetic
    # runs), else a mncs-stdlib sibling of the language checkout, else the
    # legacy in-language tree.
    STDLIB_LIBRARY=""
    if [[ -n "${MNCS_STDLIB_ROOT+x}" ]]; then
        if [[ -n "$MNCS_STDLIB_ROOT" && -d "$MNCS_STDLIB_ROOT/library" ]]; then
            STDLIB_LIBRARY="$MNCS_STDLIB_ROOT/library"
        fi
    elif [[ -d "$LANGUAGE_ROOT/../mncs-stdlib/library" ]]; then
        STDLIB_LIBRARY="$LANGUAGE_ROOT/../mncs-stdlib/library"
    elif [[ -d "$LANGUAGE_ROOT/library" ]]; then
        STDLIB_LIBRARY="$LANGUAGE_ROOT/library"
    fi
    if [[ -n "$STDLIB_LIBRARY" ]]; then
        AUTO_LIBRARY_PATH="$STDLIB_LIBRARY"
    fi
    if [[ -d "$SCRIPT_DIR/../native" ]]; then
        TEST_NATIVE_LIBRARY="$(cd "$SCRIPT_DIR/../native" && pwd)"
        if [[ -n "$AUTO_LIBRARY_PATH" ]]; then
            AUTO_LIBRARY_PATH="$AUTO_LIBRARY_PATH:$TEST_NATIVE_LIBRARY"
        else
            AUTO_LIBRARY_PATH="$TEST_NATIVE_LIBRARY"
        fi
    fi
    if [[ -n "$AUTO_LIBRARY_PATH" ]]; then
        if [[ -n "${MNCS_LIBRARY_PATH:-}" ]]; then
            export MNCS_LIBRARY_PATH="$AUTO_LIBRARY_PATH:$MNCS_LIBRARY_PATH"
        else
            export MNCS_LIBRARY_PATH="$AUTO_LIBRARY_PATH"
        fi
    fi
fi
SOURCE="${MNCS_TEST_SOURCE:-$SCRIPT_DIR/../tests/self_suite.mncs}"
if [[ $# -eq 0 ]]; then
    set -- "$SOURCE"
fi

exec "$MNCS_BIN" test "$@"
