#!/usr/bin/env bash
# Canonical executable adapter for native obligation selection.
#
# Usage: mncs-test-selection REQUEST.json RESULT.json
#
# Both paths must be relative to the current directory without `..`
# (run-app structured-artifact rule). Policy lives in
# `mncs.test.obligation_selection`; this adapter is transport only.
set -euo pipefail

if [[ $# -ne 2 ]]; then
    echo "usage: mncs-test-selection REQUEST.json RESULT.json" >&2
    exit 2
fi

for path in "$1" "$2"; do
    case "$path" in
        /*|*..*)
            echo "error: selection artifact paths must be relative without '..': $path" >&2
            exit 2
            ;;
    esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "${PYTHON:-python3}" "$SCRIPT_DIR/../tools/mncs_test_native.py" \
    --descriptor obligation-selection.json \
    --request "$1" \
    --result "$2" \
    --request-schema mncs.test-obligation-selection-request/1 \
    --result-schema mncs.test-obligation-selection/1 \
    --step-budget 1048576
