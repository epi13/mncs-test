#!/usr/bin/env bash
# Canonical executable adapter for the native test provider.
#
# Usage: mncs-test-provider REQUEST.json RESULT.json CHECK.json
#
# All paths must be relative to the current directory without `..`
# (run-app structured-artifact rule). Batch execution semantics live in
# `mncs.test.provider`; this adapter is transport only.
set -euo pipefail

if [[ $# -ne 3 ]]; then
    echo "usage: mncs-test-provider REQUEST.json RESULT.json CHECK.json" >&2
    exit 2
fi

for path in "$1" "$2" "$3"; do
    case "$path" in
        /*|*..*)
            echo "error: provider artifact paths must be relative without '..': $path" >&2
            exit 2
            ;;
    esac
done

MNCS_BIN="${MNCS:-mncs}"
if ! command -v "$MNCS_BIN" >/dev/null 2>&1 && [[ ! -x "$MNCS_BIN" ]]; then
    echo "error: native mncs compiler/runtime not found; set MNCS to the trusted bootstrap executable" >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DESCRIPTOR="$SCRIPT_DIR/../native-applications/test-provider.json"
if [[ ! -f "$DESCRIPTOR" ]]; then
    echo "error: provider descriptor is unavailable: $DESCRIPTOR" >&2
    exit 3
fi

exec "$MNCS_BIN" run-app "$DESCRIPTOR" \
    --grant-structured provider_artifact \
    --grant-structured provider_digest \
    --step-budget 1048576 \
    -- "$1" "$2" "$3"
