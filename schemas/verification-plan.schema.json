{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/epi13/mncs-test/blob/main/schemas/verification-plan.schema.json",
  "title": "MNCS minimum-sufficient verification plan",
  "description": "A digest-bound, explainable selection produced from compiler semantic impact evidence.",
  "type": "object",
  "required": ["schema_version", "plan_id", "source", "impact", "selection", "proof", "provenance"],
  "properties": {
    "schema_version": {"const": "mncs.verification-plan/1"},
    "plan_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "subject_identity": {"type": "string"},
        "subject_fingerprint": {"type": "string"}
      },
      "additionalProperties": true
    },
    "impact": {
      "type": "object",
      "required": ["graph_identity", "roots", "affected_count", "direct_dependents", "test_identities", "risk_flags", "complete", "limitations"],
      "properties": {
        "graph_identity": {"type": "string", "minLength": 1},
        "roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "affected_count": {"type": "integer", "minimum": 0},
        "direct_dependents": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "test_identities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk_flags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "complete": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "selection": {
      "type": "object",
      "required": ["level", "selected_test_identities", "available_test_count", "escalation_reasons"],
      "properties": {
        "level": {"enum": ["changed_item", "direct_dependents", "affected_subsystem", "repository_canonical", "family"]},
        "selected_test_identities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "available_test_count": {"type": "integer", "minimum": 0},
        "escalation_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["sufficient_to_stop", "required_evidence"],
      "properties": {
        "sufficient_to_stop": {"type": "boolean"},
        "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "provenance": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": true
}
